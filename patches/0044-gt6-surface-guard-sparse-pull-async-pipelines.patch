+/* ---------------------------------------------------------------------------
+ * Surface guard, LD_SURFACE_GUARD=0 turns it off [GT6 0045].
+ *
+ * A render surface here outlives the title's use of its memory: Gran Turismo 6 draws the drivers' name labels
+ * into 200x48 targets during a race, frees that memory afterwards and loads the icons of its menus into it. The
+ * surfaces were still taken as what is at those addresses: a texture that starts where one started was bound to
+ * the old label picture, and the lazy mirror copied label pixels that guest memory "did not have yet" over the
+ * icon bytes the title had just written (the quick menu after a race showed a driver's name and noise where its
+ * icons are; the owner saw the track tiles turn white).
+ *
+ * RPCS3 has the same question and answers it by remembering a few words of the memory under each render target
+ * (render_target_descriptor::sync_tag) and dropping the target as a texture source when they have changed
+ * (test(), in texture_cache upload_texture / get_merged_texture_memory_region). The write watch answers it
+ * exactly here: at the first write the guest commands into a surface in a frame its pages are harvested and the
+ * generation kept (ld_surface_guard_stamp). A page of those bytes with a later generation was written by the
+ * guest after the surface was last drawn - the bytes are the guest's now:
+ *   - a texture at the surface's address is decoded from guest memory, not taken from the surface
+ *     (ld_surface_alias_ok), and the surface is dead until the title draws into it again;
+ *   - pixels the surface was remembered to hold beyond guest memory go down only into the pages the guest has
+ *     not written (ld_mirror_sync_one).
+ * Only pages that lie wholly inside the bytes count when there is one, so a neighbour's write on a shared first
+ * or last page does not take a live render target away. A compressed texture is never a view of a render target.
+ * -----------------------------------------------------------------------*/
+static unsigned long long g_ld_guard_kills, g_ld_guard_refused, g_ld_guard_kept_bytes, g_ld_guard_checks;
+static int ld_surface_guard_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_SURFACE_GUARD"); on = !(e && *e == '0'); }
+    return on;
+}
+static void ld_surface_guard_stamp(surface_t* s)
+{
+    s->guard_frame = g_ld_frames + 1u;
+    s->guard_stamp_frame = g_ld_frames + 1u;
+    s->guard_dead = 0;
+    s->guard_gen = 0;
+    s->guard_ok_frame = 0;
+    s->guard_base = NULL;
+    s->guard_bytes = s->guard_head_n = s->guard_tail_n = 0;
+    if (!ld_surface_guard_on() || !s->pitch || !s->h || s->location > 1u || !ld_ww_enabled()) return;
+    const u64 bytes = (u64)s->pitch * s->h;
+    if (bytes > 0x4000000ull) return;
+    const u8* p = guest_ptr(s->location, s->offset, (u32)bytes);
+    if (!p) return;
+    const u32 gen = ld_ww_harvest(p, (u32)bytes);
+    if (!gen) return;
+    /* The first and the last page can hold a neighbour's bytes too, and the write watch is per page: keep what
+     * the surface's own bytes on them are now, so that a later write there can be told from a write next door. */
+    const u32 head = (u32)((4096u - ((uintptr_t)p & 4095u)) & 4095u);
+    const u32 hn = head < (u32)bytes ? head : (u32)bytes;
+    const u32 tail = (u32)(((uintptr_t)p + (u32)bytes) & 4095u);
+    const u32 tn = (hn < (u32)bytes && tail <= (u32)bytes - hn) ? tail : 0u;
+    if (hn) { if (!s->guard_head) s->guard_head = (u8*)malloc(4096); if (!s->guard_head) return; memcpy(s->guard_head, p, hn); }
+    if (tn) { if (!s->guard_tail) s->guard_tail = (u8*)malloc(4096); if (!s->guard_tail) return; memcpy(s->guard_tail, p + (u32)bytes - tn, tn); }
+    s->guard_head_n = hn; s->guard_tail_n = tn;
+    s->guard_base = p; s->guard_bytes = (u32)bytes;
+    s->guard_gen = gen;
+}
+/* Did the guest write bytes [at, at+n) - inside one page, inside the surface's bytes - after the stamp? */
+static int ld_surface_guard_chunk_written(const surface_t* s, const u8* at, u32 n)
+{
+    if (g_ww_page_gen[((uintptr_t)at - (uintptr_t)vm_base) >> 12] <= s->guard_gen) return 0;
+    const u8* const end = s->guard_base + s->guard_bytes;
+    if (s->guard_head_n && at < s->guard_base + s->guard_head_n)           /* on the shared first page: by content */
+        return memcmp(at, s->guard_head + (at - s->guard_base), n) != 0;
+    if (s->guard_tail_n && at >= end - s->guard_tail_n)                    /* on the shared last page: by content */
+        return memcmp(at, s->guard_tail + (at - (end - s->guard_tail_n)), n) != 0;
+    return 1;                                                             /* a page that is the surface's alone */
+}
+/* The same for any run of the surface's bytes. */
+static int ld_surface_guard_written(const surface_t* s, const u8* p, u32 n)
+{
+    if (!s->guard_gen || !s->guard_base || p < s->guard_base) return 0;
+    if (p >= s->guard_base + s->guard_bytes) return 0;
+    if (n > (u32)(s->guard_base + s->guard_bytes - p)) n = (u32)(s->guard_base + s->guard_bytes - p);
+    if (!n || ld_ww_clean_since(p, n, s->guard_gen)) return 0;
+    for (u32 k = 0; k < n; ) {
+        u32 c = 4096u - (u32)((uintptr_t)(p + k) & 4095u);
+        if (c > n - k) c = n - k;
+        if (ld_surface_guard_chunk_written(s, p + k, c)) return 1;
+        k += c;
+    }
+    return 0;
+}
+static void ld_surface_guard_kill(surface_t* s, const char* what, u32 lo, u32 hi)
+{
+    s->guard_dead = 1;
+    g_ld_guard_kills++;
+    static u32 said;
+    if (PS3_LOG_FIRST(said, 16))
+        fprintf(stderr, "[surface-guard] surface %u:0x%X %ux%u, last drawn in frame %u: the guest has written its bytes since "
+                        "(%s 0x%X-0x%X), so it is not taken for what is at that address any more, frame %u\n",
+                s->location, s->offset, s->w, s->h, s->guard_frame - 1u, what, lo, hi, g_ld_frames);
+}
+/* May texture t, which starts at the address of surface si, be taken from that surface? */
+static int ld_surface_alias_ok(u32 si, const rsx_dsp_texture* t)
+{
+    surface_t* s = &g.surfaces[si];
+    if (!ld_surface_guard_on()) return 1;
+    if (s->guard_dead) { g_ld_guard_refused++; return 0; }
+    { const u32 base = t->format & TEX_FMT_BASE_MASK;
+      if (base == TEX_FMT_DXT1 || base == TEX_FMT_DXT23 || base == TEX_FMT_DXT45) { g_ld_guard_refused++; return 0; } }
+    if (!s->guard_gen || s->guard_frame == g_ld_frames + 1u) return 1;     /* not known, or drawn into in this frame */
+    const u32 span = texture_source_span(t);
+    if (!span) return 1;
+    if (s->guard_ok_frame == g_ld_frames + 1u && span <= s->guard_ok_span) return 1;
+    const u8* p = guest_ptr(t->location, t->offset, span);
+    if (!p || !ld_ww_harvest(p, span)) return 1;
+    g_ld_guard_checks++;
+    if (p != s->guard_base || !ld_surface_guard_written(s, p, span)) {
+        s->guard_ok_frame = g_ld_frames + 1u; s->guard_ok_span = span;
+        return 1;
+    }
+    ld_surface_guard_kill(s, "a texture reads", t->offset, t->offset + span);
+    g_ld_guard_refused++;
+    return 0;
+}
+static void ld_surface_guard_report(void)
+{
+    static unsigned long long told;
+    static u32 at;
+    if (g_ld_frames - at < 1800u || told == g_ld_guard_kills + g_ld_guard_refused) return;
+    at = g_ld_frames; told = g_ld_guard_kills + g_ld_guard_refused;
+    fprintf(stderr, "[surface-guard] up to frame %u: %llu surface(s) found overwritten by the guest, %llu texture binds "
+                    "taken from guest memory instead, %llu bytes of the guest kept under stale surface pixels, %llu checks\n",
+            g_ld_frames, g_ld_guard_kills, g_ld_guard_refused, g_ld_guard_kept_bytes, g_ld_guard_checks);
+}
