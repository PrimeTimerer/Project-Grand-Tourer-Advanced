+                    "(%.1f MB); kept %llu and let go %llu in all\n", at, g_ld_frames, g_tex_made - made0, g_tex_pool_hits - hits0,
+            g_tex_pool_n, (double)g_tex_pool_bytes / 1048576.0, g_tex_pool_puts, g_tex_pool_drops);
+    at = g_ld_frames; made0 = g_tex_made; hits0 = g_tex_pool_hits;
+}
