+/* One asynchronous step for a job: take the pipeline if everything is ready (mode -1 never waits and never
+ * compiles), else hand the workers what can be handed over now (mode 2: the descriptor, once both blobs are
+ * there). g_ld_pw_front puts that descriptor before the start-up recipes. */
+/* 1 = the blob is there or a worker has the source; 0 = the compile queue is full or stopped. */
+static int ld_ap_request(char stage, const char* source)
+{
+    const u32 size = (u32)strlen(source);
+    const u64 hash = fnv1a(source, size, 1469598103934665603ull);
+    shader_blob_cache_t* cache = stage == 'V' ? &g.vs_blobs : &g.ps_blobs;
+    int post = 0, seen = 0;
+    ID3DBlob* blob = shader_blob_cache_find(cache, source, size, hash, &post, &seen);
+    if (!blob) {
+        blob = shader_disk_cache_load_ex(stage, source, size, hash, 0);
+        if (blob) shader_blob_cache_insert_accounted(cache, source, size, hash, blob, stage, seen);
+    }
+    if (blob) { blob->lpVtbl->Release(blob); return 1; }
+    return ld_scj_request(&g_ld_compile_jobs, stage, source, size, hash) != NULL;
+}
+static ID3D12PipelineState* ld_ap_step(const char* vs, const char* ps, const render_state_t* state,
+    const rsx_vertex_layout_plan* layout, int packed, u64 key, int point, int pull)
+{
+    g_ld_ap_refused = 0;
+    g_ld_la_mode = -1;
+    ID3D12PipelineState* pso = build_pso(vs, ps, state, layout, packed, key, point, pull);
+    if (!pso) {
+        g_ld_la_mode = 2; g_ld_pw_front = 1;
+        build_pso(vs, ps, state, layout, packed, key, point, pull);
+        g_ld_pw_front = 0;
+    }
+    g_ld_la_mode = 0;
+    return pso;
+}
+static ID3D12PipelineState* ld_ap_begin(const char* vs, const char* ps, const render_state_t* state,
+    const rsx_vertex_layout_plan* layout, int packed, u64 key, int point, int pull, int* pending)
