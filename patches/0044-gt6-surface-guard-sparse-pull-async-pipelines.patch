+/* Texture resource pool, LD_TEX_POOL=0 turns it off [GT6 0046]. Making a texture resource is a kernel call (about
+ * 0.2 ms; create_texture_mipped was 1.85 ms a frame of the drawing thread in a twelve-car race, sampled). A
+ * texture of the texture cache that was retired - replaced by a new picture or pushed out - is kept when its
+ * fence has passed instead of released, and the next texture of the same kind, format, size and level count
+ * is written into it (ld_tex_reuse_take, the path a refresh in place takes). Only plain 2D textures the cache
+ * retired itself: they are known to rest in the pixel-shader-resource state. */
+#define LD_TEX_POOL_N 384u
+#define LD_TEX_POOL_MARKS 1024u
+static struct { ID3D12Resource* r; u64 key; u32 bytes; } g_tex_pool[LD_TEX_POOL_N];
+static ID3D12Resource* g_tex_pool_mark[LD_TEX_POOL_MARKS];
+static u32 g_tex_pool_n, g_tex_pool_marks, g_tex_pool_took;
+static u64 g_tex_pool_bytes;
+static unsigned long long g_tex_pool_hits, g_tex_pool_puts, g_tex_pool_drops, g_tex_made;
+static int ld_tex_pool_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_TEX_POOL"); on = !(e && *e == '0'); }
+    return on;
+}
+static u64 ld_tex_pool_key(u32 fmt, u64 w, u32 h, u32 layers, u32 mips)
+{
+    return ((u64)fmt << 52) ^ (w << 36) ^ ((u64)h << 20) ^ ((u64)layers << 8) ^ mips;
+}
+/* A texture the cache retires: it may go to the pool when its fence has passed. */
+static void ld_tex_pool_note(ID3D12Resource* tex)
+{
+    if (tex && ld_tex_pool_on() && g_tex_pool_marks < LD_TEX_POOL_MARKS) g_tex_pool_mark[g_tex_pool_marks++] = tex;
+}
+/* The last reference of a retired resource: into the pool, or released. */
+static void ld_tex_final_release(ID3D12Resource* r)
+{
+    if (!r) return;
+    for (u32 i = 0; i < g_tex_pool_marks; i++) {
+        if (g_tex_pool_mark[i] != r) continue;
+        g_tex_pool_mark[i] = g_tex_pool_mark[--g_tex_pool_marks];
+        D3D12_RESOURCE_DESC d;
+        r->lpVtbl->GetDesc(r, &d);
+        const u64 bytes = (u64)d.Width * d.Height * 4u * d.DepthOrArraySize;
+        if (g_tex_pool_n < LD_TEX_POOL_N && d.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D &&
+            d.Flags == D3D12_RESOURCE_FLAG_NONE && d.SampleDesc.Count == 1 && bytes <= (4u << 20) &&
+            g_tex_pool_bytes + bytes <= (192ull << 20)) {
+            g_tex_pool[g_tex_pool_n].r = r;
+            g_tex_pool[g_tex_pool_n].key = ld_tex_pool_key((u32)d.Format, d.Width, d.Height, d.DepthOrArraySize, d.MipLevels);
+            g_tex_pool[g_tex_pool_n].bytes = (u32)bytes;
+            g_tex_pool_n++; g_tex_pool_bytes += bytes; g_tex_pool_puts++;
+            return;
+        }
+        g_tex_pool_drops++;
+        break;
+    }
+    r->lpVtbl->Release(r);
+}
+static ID3D12Resource* ld_tex_pool_take(u32 fmt, u32 w, u32 h, u32 layers, u32 mips)
+{
+    const u64 key = ld_tex_pool_key(fmt, w, h, layers, mips);
+    for (u32 i = g_tex_pool_n; i-- > 0; ) {
+        if (g_tex_pool[i].key != key) continue;
+        ID3D12Resource* r = g_tex_pool[i].r;
+        g_tex_pool_bytes -= g_tex_pool[i].bytes;
+        g_tex_pool[i] = g_tex_pool[--g_tex_pool_n];
+        g_tex_pool_hits++;
+        return r;
+    }
+    return NULL;
+}
