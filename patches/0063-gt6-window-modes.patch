-        return r;
-    if (mw * ph * 100 > mh * pw * 101) {            /* the monitor is wider: bars left and right */
-        const LONG w = (LONG)(mh * pw / ph);
-        r.left = mon.left + (LONG)((mw - w) / 2);
-        r.right = r.left + w;
-    } else if (mw * ph * 101 < mh * pw * 100) {     /* taller: bars above and below */
-        const LONG h = (LONG)(mw * ph / pw);
-        r.top = mon.top + (LONG)((mh - h) / 2);
-        r.bottom = r.top + h;
-    }
-    return r;
-}
