+    const u32 fit_src_w = scanout && scan_w ? scan_w : scanout_copy.width;
+    const u32 fit_src_h = scanout && scan_h ? scan_h : scanout_copy.height;
+    { static int test_w = -1, test_h = 0;
+      if (test_w < 0) { const char* e = getenv("LD_PRESENT_FIT_TEST"); test_w = 0;
+                        if (e && sscanf(e, "%dx%d", &test_w, &test_h) != 2) test_w = test_h = 0; }
+      RECT cr = {0, 0, test_w, test_h};
+      if ((test_w > 0 || (s_ld_hwnd && GetClientRect(s_ld_hwnd, &cr))) && fit_src_w && fit_src_h && g.width && g.height) {
+          const double cw = (double)(cr.right - cr.left), chh = (double)(cr.bottom - cr.top);
+          const double ca = cw / (chh > 0.0 ? chh : 1.0), ba = (double)g.width / (double)g.height;
+          if (cw >= 16.0 && chh >= 16.0 && fabs(ca / ba - 1.0) > 0.005) {
+              double pw = cw, ph = chh;                       /* the picture in the client area */
+              if (ca > ba) pw = chh * ba; else ph = cw / ba;
+              fit_x = (float)((cw - pw) * 0.5 * g.width / cw);  fit_w = (float)(pw * g.width / cw);
+              fit_y = (float)((chh - ph) * 0.5 * g.height / chh); fit_h = (float)(ph * g.height / chh);
+              fitted = 1;
+          }
+          static int last_fit = -1; static LONG last_cw, last_ch;
+          if (fitted != last_fit || (fitted && (last_cw != (LONG)cw || last_ch != (LONG)chh))) {
+              last_fit = fitted; last_cw = (LONG)cw; last_ch = (LONG)chh;
+              if (fitted)
+                  fprintf(stderr, "[present-fit] client area %.0fx%.0f: the picture into back buffer %.1f,%.1f %.1fx%.1f of %ux%u, "
+                                  "black around it, frame %u\n", cw, chh, fit_x, fit_y, fit_w, fit_h, g.width, g.height, g_ld_frames);
+              else
+                  fprintf(stderr, "[present-fit] client area %.0fx%.0f has the picture's shape again, frame %u\n", cw, chh,
+                          g_ld_frames);
+          }
+      } }
 
     /* A scanout of another size than the window, stretched over it [GT6 0058] (rsx_live_draw_present_stretch, the
