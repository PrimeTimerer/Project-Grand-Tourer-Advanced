+                            (float)(fitted ? fit_src_w : stretched ? scan_w : cw) / (float)presented_surface->w,
+                            (float)(fitted ? fit_src_h : stretched ? scan_h : ch) / (float)presented_surface->h};
         g.list->lpVtbl->SetGraphicsRoot32BitConstants(g.list, 0, 4, r, 0);
         if (toned) { const float t[4] = {tone, 0.0f, 0.0f, 0.0f}; g.list->lpVtbl->SetGraphicsRoot32BitConstants(g.list, 0, 4, t, 4); }
         g.list->lpVtbl->SetGraphicsRootDescriptorTable(g.list, 1, stretch_table);
         D3D12_VIEWPORT vp = {0.0f, 0.0f, (float)cw, (float)ch, 0.0f, 1.0f};
         D3D12_RECT sc = {0, 0, (LONG)cw, (LONG)ch};
+        if (fitted) {
+            vp.TopLeftX = fit_x; vp.TopLeftY = fit_y; vp.Width = fit_w; vp.Height = fit_h;
+            sc.left = (LONG)floorf(fit_x); sc.top = (LONG)floorf(fit_y);
+            sc.right = (LONG)ceilf(fit_x + fit_w); sc.bottom = (LONG)ceilf(fit_y + fit_h);
+        }
         g.list->lpVtbl->RSSetViewports(g.list, 1, &vp);
         g.list->lpVtbl->RSSetScissorRects(g.list, 1, &sc);
         g.list->lpVtbl->IASetPrimitiveTopology(g.list, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
diff --git a/libs/video/rsx_null_backend.c b/libs/video/rsx_null_backend.c
