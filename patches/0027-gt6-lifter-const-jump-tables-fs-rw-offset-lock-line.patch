+/* cellFsReadWithOffset / cellFsWriteWithOffset(fd, u64 offset, buf, u64 size, u64* done):
+ * an absolute read or write that leaves the fd's own position alone. Gran
+ * Turismo 6 reads its volume (GT.VOL) and every PDIPFS file this way and never
+ * calls cellFsRead on them; unresolved, the volume header read back as zeros.
+ * Same stream-lock discipline as cellFsAioRead above. */
+static void fs_rw_with_offset(ppu_context* ctx, int writing)
+{
+    int      fd     = (int)(uint32_t)ctx->gpr[3];
+    uint64_t offset = ctx->gpr[4];
+    uint32_t buf    = (uint32_t)ctx->gpr[5];
+    uint64_t size   = ctx->gpr[6];
+    uint32_t done_p = (uint32_t)ctx->gpr[7];
+
+    FILE* f = fd_file(fd);
+    if (!f) {
+        if (done_p) { vm_write32(done_p, 0); vm_write32(done_p + 4, 0); }
+        ctx->gpr[3] = (uint64_t)(int64_t)CELL_FS_EIO; return;   /* as cellFsRead answers a bad fd here */
+    }
+    if (ppu_vm_size && (uint64_t)buf + size > ppu_vm_size) size = ppu_vm_size - buf;
+    if (!writing) fs_prefault(buf, size);
+    size_t n = 0;
+    HOST_LOCKFILE(f);
+    const int64_t pos = (int64_t)HOST_FTELL64(f);
+    if (HOST_FSEEK64(f, offset) == 0)
+        n = writing ? fwrite(vm_base + buf, 1, (size_t)size, f)
+                    : fread(vm_base + buf, 1, (size_t)size, f);
+    if (pos >= 0) HOST_FSEEK64(f, pos);
+    HOST_UNLOCKFILE(f);
+    if (done_p) { vm_write32(done_p, (uint32_t)((uint64_t)n >> 32)); vm_write32(done_p + 4, (uint32_t)n); }
+    if (getenv("PS3_FSLOG")) { static int _n = 0; if (PS3_LOG_FIRST(_n, 40))
+        fprintf(stderr, "[fs] %s fd=%d off=0x%llX size=0x%llX -> 0x%zX\n", writing ? "write@" : "read@",
+                fd, (unsigned long long)offset, (unsigned long long)size, n); }
+    ctx->gpr[3] = CELL_OK;
+}
+static void cellFsReadWithOffset(ppu_context* ctx)  { fs_rw_with_offset(ctx, 0); }
+static void cellFsWriteWithOffset(ppu_context* ctx) { fs_rw_with_offset(ctx, 1); }
+
 extern "C" void ppu_fs_register(void)
 {
+    ps3_hle_register_ctx(0x0D5B4A14u, "cellFsReadWithOffset",  cellFsReadWithOffset);
+    ps3_hle_register_ctx(0x8CB722D5u, "cellFsWriteWithOffset", cellFsWriteWithOffset);
