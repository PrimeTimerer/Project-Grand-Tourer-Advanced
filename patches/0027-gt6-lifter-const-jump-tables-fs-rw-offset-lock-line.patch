+def _fold_const_reg(reg, seq):
+    """The constant `reg` holds after `seq`, when it was built without the TOC:
+    `lis`/`li` followed by any `addi`/`addis`/`ori` of the register onto itself
+    (`lis r9,hi; addi r9,r9,lo`). Instructions that only read the register are
+    skipped; any other definition means it is not a constant. None otherwise.
+
+    Gran Turismo 6 (EMAIN, BCES01893 1.22) addresses every switch table this
+    way -- `lis r9,0xA1; rldic r11,r10,2,30; addi r9,r9,-22080; lwzx r0,r11,r9;
+    extsw r0,r0; add r0,r0,r9; mtctr r0; bctr`, the offset table inline right
+    after the bctr -- so with TOC loads alone 45 of its dispatchers resolved and
+    the rest lifted to unresolved indirect calls.
+    """
+    acc, val = [], None
+    for w in reversed(seq):
+        a = [x.strip() for x in w.operands.split(',')]
+        m = w.mnemonic
+        if not a or a[0] != reg or m.startswith(('st', 'lf', 'cmp', 'mt', 'tw', 'td')):
+            continue
+        try:
+            # `addi rD,rS,lo` with rS != rD keeps the constant in another
+            # register: a base hoisted out of a loop (`lis r9,hi; addi r21,r9,lo`
+            # ahead of the script interpreter's opcode loop). Follow rS from here.
+            if m == 'addi' and len(a) == 3:
+                acc.append(('add', int(a[2], 0))); reg = a[1]
+            elif m == 'addis' and len(a) == 3:
+                v = int(a[2], 0)
+                acc.append(('add', (v - 0x10000 if v & 0x8000 else v) << 16)); reg = a[1]
+            elif m == 'ori' and len(a) == 3:
+                acc.append(('or', int(a[2], 0))); reg = a[1]
+            elif m == 'or' and len(a) == 3 and a[1] == a[2]:
+                reg = a[1]                      # mr rD,rS
+            elif m == 'lis' and len(a) == 2:
+                v = int(a[1], 0)
+                val = (v - 0x10000 if v & 0x8000 else v) << 16
+                break
+            elif m == 'li' and len(a) == 2:
+                val = int(a[1], 0)
+                break
+            else:
+                return None
+        except ValueError:
+            return None
+    if val is None:
+        return None
+    for op, v in reversed(acc):
+        val = (val + v) if op == 'add' else (val | v)
+    return val & 0xFFFFFFFF
+
