+/* A zeta read as an A8R8G8B8 texture at its own address (Gran Turismo 6, 2026-11-15: no text anywhere in its
+ * menus). The game draws each string into the stencil buffer -- colour writes off, a rectangle that zeroes the
+ * stencil, then the glyph outlines as triangle fans with INVERT on stencil bit 7 -- and then draws the string's
+ * rectangle with the depth buffer bound as a texture: A8R8G8B8, linear, texel coordinates, remap 0xAAFF (every
+ * channel from B). D24S8 read that way is A = depth 23-16, R = 15-8, G = 7-0, B = stencil, so the texel is the
+ * stencil value and the fragment program makes the coverage out of it. Guest memory there holds nothing the draws
+ * wrote (the stencil lives in the host's depth resource), so every string came out fully transparent.
+ * The view is a host texture as large as the texture the title declares, filled by a compute pass from both planes
+ * of the zeta with the bind's remap applied (a live texture is sampled without it), and filled again when a draw or
+ * a clear has touched the zeta since. LD_STENCIL_VIEW=0 turns it off. */
+static ID3D12RootSignature* g_zs_rootsig;
+static ID3D12PipelineState* g_zs_pso;
+static u64 g_zs_fills;
+static int zstencil_pipeline(void)
+{
+    static int tried = 0;
+    if (g_zs_pso) return 1;
+    if (tried) return 0;
+    tried = 1;
+    static const char source[] =
+        "Texture2D<float> depth_plane : register(t0);\n"
+        "Texture2D<uint2> stencil_plane : register(t1);\n"
+        "RWTexture2D<float4> view : register(u0);\n"
+        "cbuffer C : register(b0) { uint remap; uint w; uint h; uint pad; };\n"
+        "float pick(uint4 s, uint comp) {\n"
+        "    uint op = (remap >> (8 + comp * 2)) & 3;\n"
+        "    if (op == 0) return 0.0;\n"
+        "    if (op == 1) return 1.0;\n"
+        "    return (float)s[(remap >> (comp * 2)) & 3] / 255.0;\n"
+        "}\n"
+        "[numthreads(8, 8, 1)]\n"
+        "void main(uint3 id : SV_DispatchThreadID) {\n"
+        "    if (id.x >= w || id.y >= h) return;\n"
+        "    uint d = (uint)(saturate(depth_plane.Load(int3(id.xy, 0))) * 16777215.0 + 0.5);\n"
+        "    uint4 s = uint4((d >> 16) & 255, (d >> 8) & 255, d & 255,\n"
+        "                    stencil_plane.Load(int3(id.xy, 0)).g & 255);\n"      /* guest order A, R, G, B */
+        "    view[id.xy] = float4(pick(s, 1), pick(s, 2), pick(s, 3), pick(s, 0));\n"
+        "}\n";
+    ID3DBlob* shader = NULL; ID3DBlob* errors = NULL;
+    if (FAILED(D3DCompile(source, sizeof(source) - 1u, "zstencil_view", NULL, NULL, "main", "cs_5_0",
+                          D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &shader, &errors))) {
+        fprintf(stderr, "[zstencil] shader compile failed: %s\n",
+                errors ? (const char*)errors->lpVtbl->GetBufferPointer(errors) : "?");
+        if (errors) errors->lpVtbl->Release(errors);
+        return 0;
+    }
+    if (errors) errors->lpVtbl->Release(errors);
+    D3D12_DESCRIPTOR_RANGE ranges[2] = {0};
+    ranges[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    ranges[0].NumDescriptors = 2;
+    ranges[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+    ranges[1].NumDescriptors = 1;
+    D3D12_ROOT_PARAMETER parameters[3] = {0};
+    for (u32 i = 0; i < 2; ++i) {
+        parameters[i].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        parameters[i].DescriptorTable.NumDescriptorRanges = 1;
+        parameters[i].DescriptorTable.pDescriptorRanges = &ranges[i];
+        parameters[i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    }
+    parameters[2].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    parameters[2].Constants.ShaderRegister = 0;
+    parameters[2].Constants.Num32BitValues = 4;
+    parameters[2].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    D3D12_ROOT_SIGNATURE_DESC description = {0};
+    description.NumParameters = 3;
+    description.pParameters = parameters;
+    ID3DBlob* serialized = NULL; ID3DBlob* signature_errors = NULL;
+    HRESULT hr = D3D12SerializeRootSignature(&description, D3D_ROOT_SIGNATURE_VERSION_1, &serialized, &signature_errors);
+    if (signature_errors) signature_errors->lpVtbl->Release(signature_errors);
+    if (SUCCEEDED(hr)) {
+        hr = g.dev->lpVtbl->CreateRootSignature(g.dev, 0, serialized->lpVtbl->GetBufferPointer(serialized),
+                                                serialized->lpVtbl->GetBufferSize(serialized),
+                                                &IID_ID3D12RootSignature, (void**)&g_zs_rootsig);
+        serialized->lpVtbl->Release(serialized);
+    }
+    if (SUCCEEDED(hr)) {
+        D3D12_COMPUTE_PIPELINE_STATE_DESC pipeline = {0};
+        pipeline.pRootSignature = g_zs_rootsig;
+        pipeline.CS.pShaderBytecode = shader->lpVtbl->GetBufferPointer(shader);
+        pipeline.CS.BytecodeLength = shader->lpVtbl->GetBufferSize(shader);
+        hr = g.dev->lpVtbl->CreateComputePipelineState(g.dev, &pipeline, &IID_ID3D12PipelineState, (void**)&g_zs_pso);
+    }
+    shader->lpVtbl->Release(shader);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[zstencil] pipeline failed hr=0x%08lX\n", (unsigned long)hr);
+        g_zs_pso = NULL;
+        return 0;
+    }
+    return 1;
+}
