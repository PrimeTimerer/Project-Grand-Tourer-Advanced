+/* The SRV slot of zeta zi's A8R8G8B8 view for a texture of tw x th read through `remap`; 0 when there is none. */
+static u32 zstencil_view(u32 zi, u32 remap, u32 tw, u32 th)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_STENCIL_VIEW"); on = !(e && *e == '0'); }
+    if (!on || zi >= g.n_zdepths) return 0;
+    zdepth_t* z = &g.zdepths[zi];
+    if (!z->tex || !z->snapshot) return 0;   /* the depth-plane descriptor is written along with the snapshot */
+    const u32 w = tw < z->w ? tw : z->w, h = th < z->h ? th : z->h;
+    if (!w || !h || !zstencil_pipeline()) return 0;
+    if (z->sview_src != z->tex) {
+        D3D12_SHADER_RESOURCE_VIEW_DESC sd = {0};
+        sd.Format = DXGI_FORMAT_X32_TYPELESS_G8X24_UINT;
+        sd.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        sd.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        sd.Texture2D.MipLevels = 1;
+        sd.Texture2D.PlaneSlice = 1;
+        g.dev->lpVtbl->CreateShaderResourceView(g.dev, z->tex, &sd, srv_cpu(SRV_ZS_SOURCE_BASE + zi));
+        z->sview_src = z->tex;
+        for (u32 k = 0; k < LD_ZS_VIEWS; k++) z->sview[k].valid = 0;
+    }
+    u32 vi = LD_ZS_VIEWS;
+    for (u32 k = 0; k < LD_ZS_VIEWS; k++)
+        if (z->sview[k].tex && z->sview[k].w == w && z->sview[k].h == h) { vi = k; break; }
+    if (vi == LD_ZS_VIEWS) {
+        vi = 0;                                                    /* an empty one, else the one not used longest */
+        for (u32 k = 0; k < LD_ZS_VIEWS; k++) {
+            if (!z->sview[k].tex) { vi = k; break; }
+            if (z->sview[k].last_use < z->sview[vi].last_use) vi = k;
+        }
+        D3D12_HEAP_PROPERTIES hp = {0};
+        hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC rd = {0};
+        rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        rd.Width = w;
+        rd.Height = h;
+        rd.DepthOrArraySize = 1;
+        rd.MipLevels = 1;
+        rd.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        rd.SampleDesc.Count = 1;
+        rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+        ID3D12Resource* view = NULL;
+        if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+                D3D12_RESOURCE_STATE_UNORDERED_ACCESS, NULL, &IID_ID3D12Resource, (void**)&view))) {
+            fprintf(stderr, "[zstencil] view create failed %u:0x%X %ux%u\n", z->location, z->offset, w, h);
+            return 0;
+        }
+        if (z->sview[vi].tex) retire_texture(z->sview[vi].tex);   /* the open command list may still read it */
+        memset(&z->sview[vi], 0, sizeof z->sview[vi]);
+        z->sview[vi].tex = view;
+        z->sview[vi].w = w;
+        z->sview[vi].h = h;
+        z->sview[vi].state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+        D3D12_UNORDERED_ACCESS_VIEW_DESC ud = {0};
+        ud.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        ud.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+        g.dev->lpVtbl->CreateUnorderedAccessView(g.dev, view, NULL, &ud,
+                                                 srv_cpu(UAV_ZS_VIEW_BASE + zi * LD_ZS_VIEWS + vi));
+        srv_write(SRV_ZS_VIEW_BASE + zi * LD_ZS_VIEWS + vi, view);
+        fprintf(stderr, "[zstencil] zeta #%u %u:0x%X read as an A8R8G8B8 texture %ux%u (remap 0x%04X, view %u)\n",
+                zi, z->location, z->offset, w, h, remap, vi);
+    }
+    const u32 slot = SRV_ZS_VIEW_BASE + zi * LD_ZS_VIEWS + vi;
+    z->sview[vi].last_use = g_ld_frames;
+    if (z->sview[vi].valid && z->sview[vi].gen == z->stencil_gen && z->sview[vi].remap == remap) return slot;
+    if (g.srv_ring_used >= SRV_RING_TABLES) return z->sview[vi].valid ? slot : 0;
+
+    ld_ls_invalidate();   /* sets list state (compute PSO, heaps) the draw path caches */
+    const u32 base = g.srv_ring_used++ * SRV_TABLE_SIZE;
+    D3D12_CPU_DESCRIPTOR_HANDLE cpu;
+    g.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(g.srv_heap, &cpu);
+    cpu.ptr += (size_t)base * g.srv_step;
+    g.dev->lpVtbl->CopyDescriptorsSimple(g.dev, 1, cpu, srv_cpu(SRV_DEPTH_SOURCE_BASE + zi),
+                                         D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    cpu.ptr += g.srv_step;
+    g.dev->lpVtbl->CopyDescriptorsSimple(g.dev, 1, cpu, srv_cpu(SRV_ZS_SOURCE_BASE + zi),
+                                         D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    cpu.ptr += g.srv_step;
+    g.dev->lpVtbl->CopyDescriptorsSimple(g.dev, 1, cpu, srv_cpu(UAV_ZS_VIEW_BASE + zi * LD_ZS_VIEWS + vi),
+                                         D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    D3D12_GPU_DESCRIPTOR_HANDLE source_table, destination_table;
+    g.srv_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(g.srv_heap, &source_table);
+    source_table.ptr += (u64)base * g.srv_step;
+    destination_table = source_table;
+    destination_table.ptr += 2u * (u64)g.srv_step;
+
+    D3D12_RESOURCE_BARRIER bars[2] = {0};
+    u32 nbar = 0;
+    bars[nbar].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    bars[nbar].Transition.pResource = z->tex;
+    bars[nbar].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    bars[nbar].Transition.StateBefore = D3D12_RESOURCE_STATE_DEPTH_WRITE;
+    bars[nbar].Transition.StateAfter = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+    nbar++;
+    if (z->sview[vi].state != D3D12_RESOURCE_STATE_UNORDERED_ACCESS) {
+        bars[nbar].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        bars[nbar].Transition.pResource = z->sview[vi].tex;
+        bars[nbar].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        bars[nbar].Transition.StateBefore = z->sview[vi].state;
+        bars[nbar].Transition.StateAfter = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+        nbar++;
+    }
+    g.list->lpVtbl->ResourceBarrier(g.list, nbar, bars);
+
+    ID3D12DescriptorHeap* heaps[] = {g.srv_heap, g.smp_heap};
+    g.list->lpVtbl->SetDescriptorHeaps(g.list, 2, heaps);
+    g.list->lpVtbl->SetPipelineState(g.list, g_zs_pso);
+    g.list->lpVtbl->SetComputeRootSignature(g.list, g_zs_rootsig);
+    g.list->lpVtbl->SetComputeRootDescriptorTable(g.list, 0, source_table);
+    g.list->lpVtbl->SetComputeRootDescriptorTable(g.list, 1, destination_table);
+    const u32 constants[4] = { remap, w, h, 0u };
+    g.list->lpVtbl->SetComputeRoot32BitConstants(g.list, 2, 4, constants, 0);
+    g.list->lpVtbl->Dispatch(g.list, (w + 7u) / 8u, (h + 7u) / 8u, 1);
+
+    D3D12_RESOURCE_BARRIER uav_done = {0};
+    uav_done.Type = D3D12_RESOURCE_BARRIER_TYPE_UAV;
+    uav_done.UAV.pResource = z->sview[vi].tex;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &uav_done);
+    D3D12_RESOURCE_BARRIER done[2] = {0};
+    done[0].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    done[0].Transition.pResource = z->tex;
+    done[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    done[0].Transition.StateBefore = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+    done[0].Transition.StateAfter = D3D12_RESOURCE_STATE_DEPTH_WRITE;
+    done[1].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    done[1].Transition.pResource = z->sview[vi].tex;
+    done[1].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    done[1].Transition.StateBefore = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    done[1].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    g.list->lpVtbl->ResourceBarrier(g.list, 2, done);
+    z->sview[vi].state = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    z->sview[vi].valid = 1;
+    z->sview[vi].gen = z->stencil_gen;
+    z->sview[vi].remap = remap;
+    g_zs_fills++;
+    return slot;
+}
