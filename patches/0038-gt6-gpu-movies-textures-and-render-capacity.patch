diff --git a/libs/video/rsx_live_texture_metadata.h b/libs/video/rsx_live_texture_metadata.h
new file mode 100644
index 0000000..802c5e9
--- /dev/null
+++ b/libs/video/rsx_live_texture_metadata.h
@@ -0,0 +1,61 @@
+/* Live D3D12 texture colour state. The decompiler already implements these
+ * shader operations; all legacy live draws previously supplied NULL metadata.
+ */
+#ifndef PS3RECOMP_RSX_LIVE_TEXTURE_METADATA_H
+#define PS3RECOMP_RSX_LIVE_TEXTURE_METADATA_H
+#include "rsx_texture_layout.h"
+#include "rsx_texture_typed.h"
+#include "rsx_fp_decompiler.h"
+
+static inline void rsx_live_texture_color_masks(u32 format, u32 remap,
+    u32 filter, u32 address, int native_texture, u8* gamma, u8* expand)
+{
+    *gamma = rsx_texture_gamma_mask(format, remap, filter, address);
+    *expand = rsx_texture_expand_mask(format, remap, filter, address);
+    /* The native X16/Y16 crossbar uses 16-bit block selectors. Only real
+     * source channels expand; constants from the SRV stay zero/one. */
+    const u32 base = format & 0x9Fu;
+    if (*expand && native_texture && (base == 0x94u || base == 0x95u)) {
+        rsx_typed_texture typed;
+        if (rsx_typed_texture_format(format, &typed)) {
+            const u32 control = rsx_typed_texture_control(format, remap);
+            const u32 mapping = rsx_typed_texture_mapping(&typed, format, remap);
+            static const u8 rgba_to_argb[4] = {1,2,3,0};
+            u8 mask = 0;
+            for (u32 lane = 0; lane < 4; ++lane) {
+                const u32 source = (control >> (2u * rgba_to_argb[lane])) & 3u;
+                if (((mapping >> (3u * lane)) & 7u) < 4u &&
+                    !((filter >> (28u + source)) & 1u)) mask |= (u8)(1u << lane);
+            }
+            *expand = mask ? mask | 16u : 0;
+        }
+    }
+    /* Gamma wins per lane. Canonical masks keep ignored sampler flags from
+     * creating another shader/PSO variant with identical pixel behaviour. */
+    *expand &= (u8)~*gamma;
+    if (!(*expand & 15u)) *expand = 0;
+}
+
+/* The generic renderer deliberately rejects unsupported active shadow
+ * layouts. The live renderer is being migrated incrementally: preserve its
+ * prior raw sampling for those units instead of making a formerly visible
+ * draw disappear. Return a diagnostic reason (1=layout, 2=fetch). */
+static inline u32 rsx_live_texture_shadow_filter(rsx_fp_shadow_desc* desc,
+                                                u32 unit, u32 program_units)
+{
+    u32 reason = desc->enabled && desc->enabled != 1 ? 1u : 0u;
+    if (desc->enabled && !reason && !(program_units & (1u << unit))) reason = 2u;
+    if (reason) memset(desc, 0, sizeof(*desc));
+    return reason;
+}
+
+static inline void rsx_live_texture_program_masks(const u8* program, u32 bytes,
+                                                  u32* gamma, u32* expand)
+{
+    static const u8 all[16] = {15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15};
+    *gamma = rsx_fp_texture_gamma_units(program, bytes, all);
+    /* EXP_TEX fetches already apply their instruction-level bx2. A sampler's
+     * biased flag matters only to ordinary (non-bx2) texture instructions. */
+    *expand = rsx_fp_texture_expand_units(program, bytes, all) & *gamma;
+}
+#endif
diff --git a/libs/video/rsx_present_copy.h b/libs/video/rsx_present_copy.h
new file mode 100644
index 0000000..6f1a127
--- /dev/null
+++ b/libs/video/rsx_present_copy.h
@@ -0,0 +1,54 @@
+#ifndef RSX_PRESENT_COPY_H
+#define RSX_PRESENT_COPY_H
+
+#include <stdint.h>
+
+/* Scanout dimensions are independent of the RSX render-target allocation.
+ * CopyResource requires identical dimensions; an oversized allocation needs
+ * an explicit in-bounds CopyTextureRegion, without CPU pixel conversion. */
+typedef struct {
+    uint32_t width, height;
+    int whole_resource;
+    int clear_destination;
+} rsx_present_copy_plan;
+
+static inline rsx_present_copy_plan rsx_present_plan_copy(
+    uint32_t source_width, uint32_t source_height,
+    uint32_t destination_width, uint32_t destination_height,
+    uint32_t display_width, uint32_t display_height)
+{
+    rsx_present_copy_plan p = { source_width, source_height, 0, 0 };
+    if (display_width && p.width > display_width) p.width = display_width;
+    if (display_height && p.height > display_height) p.height = display_height;
+    if (p.width > destination_width) p.width = destination_width;
+    if (p.height > destination_height) p.height = destination_height;
+    p.whole_resource = source_width == destination_width &&
+        source_height == destination_height && p.width == source_width && p.height == source_height;
+    p.clear_destination = p.width < destination_width || p.height < destination_height;
+    return p;
+}
+
+/* Caller owns COPY_SOURCE/COPY_DEST barriers and clears any uncovered area. */
+static inline void rsx_present_record_copy(ID3D12GraphicsCommandList* list,
+    ID3D12Resource* destination, ID3D12Resource* source, rsx_present_copy_plan p)
+{
+    if (!p.width || !p.height) return;
+    if (p.whole_resource) {
+#if defined(__cplusplus) && !defined(CINTERFACE)
+        list->CopyResource(destination, source);
+#else
+        list->lpVtbl->CopyResource(list, destination, source);
+#endif
+    } else {
+        D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+        D3D12_BOX box = {0, 0, 0, p.width, p.height, 1};
+        dst.pResource = destination; dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        src.pResource = source; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+#if defined(__cplusplus) && !defined(CINTERFACE)
+        list->CopyTextureRegion(&dst, 0, 0, 0, &src, &box);
+#else
+        list->lpVtbl->CopyTextureRegion(list, &dst, 0, 0, 0, &src, &box);
+#endif
+    }
+}
+#endif
