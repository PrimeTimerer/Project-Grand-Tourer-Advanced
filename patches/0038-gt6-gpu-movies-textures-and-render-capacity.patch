index 0000000..53b7cef
--- /dev/null
+++ b/libs/video/tests/test_pso_warmup.c
@@ -0,0 +1,180 @@
+/* Disposable WARP pipeline cache fixture. The sole argument is a NEW empty
+ * directory under the test workspace. No game files or player saves are used. */
+#define _WIN32_WINNT 0x0A00
+#define _CRT_SECURE_NO_WARNINGS
+#include <windows.h>
+#include <initguid.h>
+#include <d3d12.h>
+#include <dxgi1_4.h>
+#include <d3dcompiler.h>
+#include <stddef.h>
+#include "../rsx_pso_warmup.h"
+
+static unsigned checks;
+static void check(int good, const char* msg)
+{
+    if (!good) { fprintf(stderr, "FAIL: %s\n", msg); exit(1); }
+    checks++;
+}
+static void ok(HRESULT hr, const char* msg)
+{
+    if (FAILED(hr)) { fprintf(stderr, "FAIL %s: %08lX\n", msg, (unsigned long)hr); exit(1); }
+}
+static ID3DBlob* compile(const char* text, const char* target)
+{
+    ID3DBlob *b = NULL, *e = NULL;
+    HRESULT hr = D3DCompile(text, strlen(text), "fixture", NULL, NULL, "main", target, 0, 0, &b, &e);
+    if (e) { if (FAILED(hr)) fprintf(stderr, "%s\n", (const char*)e->lpVtbl->GetBufferPointer(e)); e->lpVtbl->Release(e); }
+    ok(hr, "compile"); return b;
+}
+
+static void render(ID3D12Device* dev, ID3D12RootSignature* root, ID3D12PipelineState* pso, unsigned char out[64])
+{
+    ID3D12CommandQueue* q = NULL; ID3D12CommandAllocator* a = NULL;
+    ID3D12GraphicsCommandList* l = NULL; ID3D12Resource *rt = NULL, *rb = NULL;
+    ID3D12DescriptorHeap* heap = NULL; ID3D12Fence* fence = NULL;
+    D3D12_COMMAND_QUEUE_DESC qd = {0};
+    ok(dev->lpVtbl->CreateCommandQueue(dev, &qd, &IID_ID3D12CommandQueue, (void**)&q), "queue");
+    ok(dev->lpVtbl->CreateCommandAllocator(dev, D3D12_COMMAND_LIST_TYPE_DIRECT, &IID_ID3D12CommandAllocator, (void**)&a), "allocator");
+    ok(dev->lpVtbl->CreateCommandList(dev, 0, D3D12_COMMAND_LIST_TYPE_DIRECT, a, pso, &IID_ID3D12GraphicsCommandList, (void**)&l), "list");
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC td = {0}; td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D; td.Width = td.Height = 4;
+    td.DepthOrArraySize = td.MipLevels = 1; td.Format = DXGI_FORMAT_R8G8B8A8_UNORM; td.SampleDesc.Count = 1;
+    td.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    ok(dev->lpVtbl->CreateCommittedResource(dev, &hp, 0, &td, D3D12_RESOURCE_STATE_RENDER_TARGET, NULL, &IID_ID3D12Resource, (void**)&rt), "RT");
+    D3D12_RESOURCE_DESC bd = {0}; bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = 1024;
+    bd.Height = bd.DepthOrArraySize = bd.MipLevels = bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    hp.Type = D3D12_HEAP_TYPE_READBACK;
+    ok(dev->lpVtbl->CreateCommittedResource(dev, &hp, 0, &bd, D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&rb), "readback");
+    D3D12_DESCRIPTOR_HEAP_DESC hd = {0}; hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV; hd.NumDescriptors = 1;
+    ok(dev->lpVtbl->CreateDescriptorHeap(dev, &hd, &IID_ID3D12DescriptorHeap, (void**)&heap), "RTV heap");
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv;
+    heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(heap, &rtv);
+    dev->lpVtbl->CreateRenderTargetView(dev, rt, NULL, rtv);
+    l->lpVtbl->SetGraphicsRootSignature(l, root);
+    l->lpVtbl->OMSetRenderTargets(l, 1, &rtv, FALSE, NULL);
+    D3D12_VIEWPORT vp = {0, 0, 4, 4, 0, 1}; D3D12_RECT sc = {0, 0, 4, 4};
+    l->lpVtbl->RSSetViewports(l, 1, &vp); l->lpVtbl->RSSetScissorRects(l, 1, &sc);
+    l->lpVtbl->IASetPrimitiveTopology(l, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    const float clear[4] = {0, 0, 0, 0}; l->lpVtbl->ClearRenderTargetView(l, rtv, clear, 0, NULL);
+    l->lpVtbl->DrawInstanced(l, 3, 1, 0, 0);
+    D3D12_RESOURCE_BARRIER barrier = {0}; barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier.Transition.pResource = rt; barrier.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    barrier.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE; barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    l->lpVtbl->ResourceBarrier(l, 1, &barrier);
+    D3D12_TEXTURE_COPY_LOCATION from = {0}, to = {0}; from.pResource = rt; from.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    to.pResource = rb; to.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    to.PlacedFootprint.Footprint.Format = td.Format; to.PlacedFootprint.Footprint.Width = to.PlacedFootprint.Footprint.Height = 4;
+    to.PlacedFootprint.Footprint.Depth = 1; to.PlacedFootprint.Footprint.RowPitch = 256;
+    l->lpVtbl->CopyTextureRegion(l, &to, 0, 0, 0, &from, NULL);
+    ok(l->lpVtbl->Close(l), "close"); ID3D12CommandList* lists[1] = {(ID3D12CommandList*)l}; q->lpVtbl->ExecuteCommandLists(q, 1, lists);
+    ok(dev->lpVtbl->CreateFence(dev, 0, 0, &IID_ID3D12Fence, (void**)&fence), "fence");
+    HANDLE event = CreateEventA(NULL, FALSE, FALSE, NULL); check(event != NULL, "fence event");
+    ok(q->lpVtbl->Signal(q, fence, 1), "signal"); ok(fence->lpVtbl->SetEventOnCompletion(fence, 1, event), "fence event");
+    check(WaitForSingleObject(event, 10000) == WAIT_OBJECT_0, "GPU completed");
+    void* mapped = NULL; D3D12_RANGE range = {0, 1024}; ok(rb->lpVtbl->Map(rb, 0, &range, &mapped), "map");
+    for (unsigned y = 0; y < 4; ++y) memcpy(out + y * 16, (unsigned char*)mapped + y * 256, 16);
+    D3D12_RANGE empty = {0, 0}; rb->lpVtbl->Unmap(rb, 0, &empty);
+    CloseHandle(event); fence->lpVtbl->Release(fence); heap->lpVtbl->Release(heap);
+    rb->lpVtbl->Release(rb); rt->lpVtbl->Release(rt); l->lpVtbl->Release(l); a->lpVtbl->Release(a); q->lpVtbl->Release(q);
+}
+
+int main(int argc, char** argv)
+{
+    check(argc == 2, "provide new fixture directory");
+    check(CreateDirectoryA(argv[1], NULL), "fixture destination must be new");
+    IDXGIFactory4* factory = NULL; IDXGIAdapter* warp = NULL; ID3D12Device* dev = NULL;
+    ok(CreateDXGIFactory1(&IID_IDXGIFactory4, (void**)&factory), "factory");
+    ok(factory->lpVtbl->EnumWarpAdapter(factory, &IID_IDXGIAdapter, (void**)&warp), "WARP adapter");
+    ok(D3D12CreateDevice((IUnknown*)warp, D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device, (void**)&dev), "WARP device");
+    ID3DBlob *rs = NULL, *error = NULL;
+    D3D12_ROOT_SIGNATURE_DESC rd = {0}; rd.Flags = D3D12_ROOT_SIGNATURE_FLAG_ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT;
+    ok(D3D12SerializeRootSignature(&rd, D3D_ROOT_SIGNATURE_VERSION_1, &rs, &error), "serialize root");
+    ID3D12RootSignature* root = NULL;
+    ok(dev->lpVtbl->CreateRootSignature(dev, 0, rs->lpVtbl->GetBufferPointer(rs), rs->lpVtbl->GetBufferSize(rs), &IID_ID3D12RootSignature, (void**)&root), "root");
+    rs->lpVtbl->Release(rs);
+    ID3DBlob* vs = compile("float4 main(uint i:SV_VertexID):SV_Position {float2 p=float2((i<<1)&2,i&2);return float4(p*2-1,0.5,1);}", "vs_5_0");
+    ID3DBlob* ps = compile("float4 main():SV_Target {return float4(.25,.5,.75,1);}", "ps_5_0");
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = {0}; pd.pRootSignature = root;
+    pd.VS.pShaderBytecode = vs->lpVtbl->GetBufferPointer(vs); pd.VS.BytecodeLength = vs->lpVtbl->GetBufferSize(vs);
+    pd.PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps); pd.PS.BytecodeLength = ps->lpVtbl->GetBufferSize(ps);
+    pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    pd.SampleMask = 0xFFFFFFFFu; pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID; pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    pd.RasterizerState.DepthClipEnable = TRUE; pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    pd.NumRenderTargets = 1; pd.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM; pd.SampleDesc.Count = 1;
+    ld_pw_identity canonical, padded;
+    check(ld_pw_identity_make(&canonical, &pd, 0), "canonical identity");
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC other = pd;
+    for (unsigned i = 0; i < 8; ++i) {
+        unsigned char* p = (unsigned char*)&other.BlendState.RenderTarget[i];
+        const size_t offset = offsetof(D3D12_RENDER_TARGET_BLEND_DESC, RenderTargetWriteMask) + 1;
+        memset(p + offset, 0xA5, sizeof(other.BlendState.RenderTarget[i]) - offset);
+    }
+    unsigned char* depth = (unsigned char*)&other.DepthStencilState;
+    const size_t gap = offsetof(D3D12_DEPTH_STENCIL_DESC, StencilWriteMask) + 1;
+    memset(depth + gap, 0xA5, offsetof(D3D12_DEPTH_STENCIL_DESC, FrontFace) - gap);
+    check(ld_pw_identity_make(&padded, &other, 0) && !memcmp(&canonical, &padded, sizeof(canonical)),
+          "ABI padding never changes pipeline identity");
+    ID3D12PipelineState* direct = NULL;
+    ok(dev->lpVtbl->CreateGraphicsPipelineState(dev, &pd, &IID_ID3D12PipelineState, (void**)&direct), "direct PSO");
+    unsigned char expected[64], got[64]; render(dev, root, direct, expected);
+    check(expected[0] >= 63 && expected[0] <= 64 && expected[3] == 255, "fixture really draws");
+    ld_pw_start(dev, NULL, root, root, argv[1]);
+    check(g_ld_pw.active && g_ld_pw.entry_count == 0, "empty cache starts workers");
+    check(ld_pw_take(&pd, 0) == NULL, "unknown recipe preserves ordinary fallback");
+    ld_pw_remember(&pd, 0, 123); ld_pw_remember(&pd, 0, 123);
+    ld_pw_stop();
+    ID3D12Device1* dev1 = NULL; ID3D12PipelineLibrary* library = NULL;
+    ok(dev->lpVtbl->QueryInterface(dev, &IID_ID3D12Device1, (void**)&dev1), "Device1");
+    ok(dev1->lpVtbl->CreatePipelineLibrary(dev1, NULL, 0, &IID_ID3D12PipelineLibrary, (void**)&library), "pipeline library");
+    ok(library->lpVtbl->StorePipeline(library, L"p000000000000007B", direct), "store library recipe");
+    ld_pw_start(dev, library, root, root, argv[1]);
+    check(g_ld_pw.entry_count == 1, "one complete atomic recipe persisted");
+    for (unsigned waited = 0; !InterlockedCompareExchange(&g_ld_pw.ready, 0, 0) && waited < 10000; ++waited) Sleep(1);
+    check(InterlockedCompareExchange(&g_ld_pw.ready, 0, 0) == 1 && g_ld_pw.library_hits == 1,
+          "background worker loaded exact library PSO before request");
+    ID3D12PipelineState* warmed = ld_pw_take(&pd, 0);
+    check(warmed != NULL, "exact recipe rebuilt on GPU");
+    render(dev, root, warmed, got);
+    check(!memcmp(expected, got, sizeof(got)), "warm and ordinary pipelines produce identical pixels");
+    check(ld_pw_take(&pd, 1) == NULL, "root kind separates point and ordinary pipelines");
+    pd.RasterizerState.CullMode = D3D12_CULL_MODE_FRONT;
+    check(ld_pw_take(&pd, 0) == NULL, "changed render state cannot reuse recipe");
+    pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    ld_pw_record* r = g_ld_pw.entries[0].record;
+    r->identity.desc.BlendState.RenderTarget[0].RenderTargetWriteMask = 0;
+    check(ld_pw_take(&pd, 0) == NULL && g_ld_pw.collisions == 1, "full identity comparison rejects a hash collision");
+    r->identity.desc.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    size_t n = sizeof(*r) + r->payload_size;
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC decoded; D3D12_INPUT_ELEMENT_DESC il[16];
+    check(ld_pw_unpack(r, n, &decoded, il), "recipe unpack valid");
+    check(!ld_pw_unpack(r, n - 1, &decoded, il), "truncated recipe rejected");
+    r->version = 2; check(!ld_pw_unpack(r, n, &decoded, il), "unknown schema rejected"); r->version = 1;
+    r->identity.desc.pRootSignature = (ID3D12RootSignature*)1;
+    check(!ld_pw_unpack(r, n, &decoded, il), "disk root pointer rejected"); r->identity.desc.pRootSignature = NULL;
+    r->identity.desc.InputLayout.NumElements = 17;
+    check(!ld_pw_unpack(r, n, &decoded, il), "oversized input layout rejected"); r->identity.desc.InputLayout.NumElements = 0;
+    ((unsigned char*)(r + 1))[4] ^= 1;
+    check(!ld_pw_unpack(r, n, &decoded, il), "changed DXBC checksum rejected");
+    ((unsigned char*)(r + 1))[4] ^= 1;
+    r->key ^= 1; check(!ld_pw_unpack(r, n, &decoded, il), "changed identity checksum rejected"); r->key ^= 1;
+    warmed->lpVtbl->Release(warmed); ld_pw_stop();
+    /* Failure path: overwrite only the owned fixture recipe with truncation. */
+    char search[MAX_PATH]; snprintf(search, sizeof(search), "%s\\pipelines_v1\\*.gpso", argv[1]);
+    WIN32_FIND_DATAA data; HANDLE h = FindFirstFileA(search, &data); check(h != INVALID_HANDLE_VALUE, "fixture recipe found");
+    FindClose(h); char path[MAX_PATH]; snprintf(path, sizeof(path), "%s\\pipelines_v1\\%s", argv[1], data.cFileName);
+    FILE* bad = fopen(path, "wb"); check(bad != NULL, "fixture truncate open"); fputs("bad", bad); fclose(bad);
+    ld_pw_start(dev, NULL, root, root, argv[1]);
+    check(ld_pw_take(&pd, 0) == NULL, "corrupt disk file safely falls back");
+    ld_pw_remember(&pd, 0, 123); ld_pw_stop();
+    ld_pw_start(dev, NULL, root, root, argv[1]);
+    warmed = ld_pw_take(&pd, 0); check(warmed != NULL, "ordinary successful build repairs invalid recipe");
+    warmed->lpVtbl->Release(warmed); ld_pw_stop();
+    _putenv_s("LD_PSO_PREWARM", "0"); ld_pw_start(dev, NULL, root, root, argv[1]);
+    check(!g_ld_pw.active && ld_pw_take(&pd, 0) == NULL, "rollback leaves ordinary path active");
+    library->lpVtbl->Release(library); dev1->lpVtbl->Release(dev1);
+    direct->lpVtbl->Release(direct); ps->lpVtbl->Release(ps); vs->lpVtbl->Release(vs); root->lpVtbl->Release(root);
+    dev->lpVtbl->Release(dev); warp->lpVtbl->Release(warp); factory->lpVtbl->Release(factory);
+    printf("PSO warmup: %u checks PASS (D3D12 WARP render/readback, lifecycle, rejection, repair)\n", checks);
+    return 0;
+}
diff --git a/libs/video/tests/test_render_state_canonical.c b/libs/video/tests/test_render_state_canonical.c
new file mode 100644
index 0000000..c4c5110
--- /dev/null
+++ b/libs/video/tests/test_render_state_canonical.c
@@ -0,0 +1,87 @@
+/* Run against the exact production apply/hash routines extracted by the
+ * accompanying fixture generator, plus WARP render/readback. */
+#define main pso_warmup_fixture_main
+#include "test_pso_warmup.c"
+#undef main
+#include <math.h>
+typedef uint32_t u32;
+typedef uint64_t u64;
+typedef uint8_t u8;
+static struct { void* depth; } g;
+#include "render_state_fixture.inc"
+#include "../rsx_render_state_canonical.h"
+
+static u32 rng = 0x6A09E667u;
+static u32 random_word(void) { rng ^= rng << 13; rng ^= rng >> 17; rng ^= rng << 5; return rng; }
+
+int main(void)
+{
+    for (unsigned i = 0; i < 100000; ++i) {
+        render_state_t raw;
+        for (unsigned n = 0; n < sizeof(raw) / 4; ++n) ((u32*)&raw)[n] = random_word();
+        raw.alpha_test_enable &= 1; raw.blend_enable &= 1; raw.cull_enable &= 1;
+        raw.stencil_enable &= 1; raw.stencil_two_sided &= 1; raw.depth_test &= 1; raw.depth_write &= 1;
+        render_state_t canonical = raw;
+        ld_render_state_canonicalize(&canonical);
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC a = {0}, b = {0};
+        g.depth = (i & 1) ? (void*)1 : NULL;
+        apply_render_state(&a, &raw); apply_render_state(&b, &canonical);
+        check(!memcmp(&a, &b, sizeof(a)), "raw/canonical production GPU descriptors are identical");
+        render_state_t again = canonical; ld_render_state_canonicalize(&again);
+        check(!memcmp(&again, &canonical, sizeof(again)), "canonicalization is idempotent");
+        check(canonical.depth_test == raw.depth_test && canonical.depth_write == raw.depth_write &&
+              canonical.depth_func == raw.depth_func && canonical.front_face == raw.front_face &&
+              canonical.polygon_offset_units == raw.polygon_offset_units && canonical.polygon_offset_factor == raw.polygon_offset_factor,
+              "depth, winding and offset preserved");
+        if (raw.alpha_test_enable)
+            check(canonical.alpha_func == raw.alpha_func && canonical.alpha_ref_raw == raw.alpha_ref_raw &&
+                  canonical.alpha_ref_format == raw.alpha_ref_format, "enabled alpha test preserved");
+    }
+    render_state_t raw = {0}; raw.rt_count = 1; raw.color_mask = 0x01010101u;
+    raw.sf_rgb = 0x0302; raw.df_rgb = 0x0303; raw.sf_a = 1; raw.df_a = 0; raw.eq_rgb = raw.eq_a = 0x8006;
+    raw.alpha_func = 0x0204; raw.alpha_ref_raw = 128; raw.alpha_ref_format = 8;
+    raw.stencil_two_sided = 1; raw.s_func = 0x0203; raw.s_func_mask = raw.s_write_mask = 255;
+    raw.s_fail = 0x1E01; raw.bs_func = 0x0204; raw.bs_fail = 0x1E03; raw.cull_face = 0x0405;
+    raw.depth_func = 0x0207;
+    render_state_t canonical = raw; ld_render_state_canonicalize(&canonical);
+    const u64 seed = 1469598103934665603ull;
+    check(ld_hash_structural_render_state(&raw, seed) != ld_hash_structural_render_state(&canonical, seed), "legacy ignored-state variants really change keys");
+    render_state_t equivalent = raw;
+    equivalent.sf_rgb = 1; equivalent.df_rgb = 0; equivalent.alpha_func = 0x0201;
+    equivalent.s_func = 0x0201; equivalent.bs_func = 0x0207; equivalent.cull_face = 0x0404;
+    ld_render_state_canonicalize(&equivalent);
+    check(ld_hash_structural_render_state(&equivalent, seed) == ld_hash_structural_render_state(&canonical, seed),
+          "same effective state now shares a key");
+
+    IDXGIFactory4* factory = NULL; IDXGIAdapter* warp = NULL; ID3D12Device* dev = NULL;
+    ok(CreateDXGIFactory1(&IID_IDXGIFactory4, (void**)&factory), "factory");
+    ok(factory->lpVtbl->EnumWarpAdapter(factory, &IID_IDXGIAdapter, (void**)&warp), "WARP adapter");
+    ok(D3D12CreateDevice((IUnknown*)warp, D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device, (void**)&dev), "WARP device");
+    D3D12_ROOT_SIGNATURE_DESC rd = {0}; rd.Flags = D3D12_ROOT_SIGNATURE_FLAG_ALLOW_INPUT_ASSEMBLER_INPUT_LAYOUT;
+    ID3DBlob* rs = NULL; ok(D3D12SerializeRootSignature(&rd, D3D_ROOT_SIGNATURE_VERSION_1, &rs, NULL), "root serialize");
+    ID3D12RootSignature* root = NULL;
+    ok(dev->lpVtbl->CreateRootSignature(dev, 0, rs->lpVtbl->GetBufferPointer(rs), rs->lpVtbl->GetBufferSize(rs), &IID_ID3D12RootSignature, (void**)&root), "root");
+    rs->lpVtbl->Release(rs);
+    ID3DBlob* vs = compile("float4 main(uint i:SV_VertexID):SV_Position {float2 p=float2((i<<1)&2,i&2);return float4(p*2-1,0.5,1);}", "vs_5_0");
+    ID3DBlob* ps = compile("float4 main():SV_Target {return float4(.25,.5,.75,.5);}", "ps_5_0");
+    for (unsigned blend = 0; blend < 2; ++blend) {
+        raw.blend_enable = blend; canonical = raw; ld_render_state_canonicalize(&canonical);
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC desc[2] = {{0}, {0}};
+        g.depth = NULL; apply_render_state(&desc[0], &raw); apply_render_state(&desc[1], &canonical);
+        ID3D12PipelineState* pipeline[2] = {NULL, NULL}; unsigned char pixels[2][64];
+        for (unsigned i = 0; i < 2; ++i) {
+            desc[i].pRootSignature = root; desc[i].VS.pShaderBytecode = vs->lpVtbl->GetBufferPointer(vs);
+            desc[i].VS.BytecodeLength = vs->lpVtbl->GetBufferSize(vs);
+            desc[i].PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps); desc[i].PS.BytecodeLength = ps->lpVtbl->GetBufferSize(ps);
+            desc[i].SampleMask = 0xFFFFFFFFu; desc[i].NumRenderTargets = 1; desc[i].RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
+            desc[i].SampleDesc.Count = 1; desc[i].PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+            ok(dev->lpVtbl->CreateGraphicsPipelineState(dev, &desc[i], &IID_ID3D12PipelineState, (void**)&pipeline[i]), "state pipeline");
+            render(dev, root, pipeline[i], pixels[i]); pipeline[i]->lpVtbl->Release(pipeline[i]);
+        }
+        check(pixels[0][0] && !memcmp(pixels[0], pixels[1], sizeof(pixels[0])), "canonical state preserves WARP draw pixels");
+    }
+    ps->lpVtbl->Release(ps); vs->lpVtbl->Release(vs); root->lpVtbl->Release(root);
+    dev->lpVtbl->Release(dev); warp->lpVtbl->Release(warp); factory->lpVtbl->Release(factory);
+    printf("Render-state canonicalization: %u checks PASS (100000 production descriptor pairs + WARP)\n", checks);
+    return 0;
+}
