+          "cube border mode follows its unit, not the first matching address");
+    rsx_dispatch_method(rsx, 0x1A04, 0x00049A2Du);
+    rsx_dsp_get_texture(rsx, 0, &cube0);
+    CHECK(cube0.border_type == 1 && cube1.border_type == 1,
+          "changing one cube border mode updates the next descriptor");
+
     free(rsx);
     if (g_failures) { printf("%d check(s) FAILED\n", g_failures); return 1; }
