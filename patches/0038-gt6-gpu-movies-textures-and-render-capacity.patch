diff --git a/libs/video/tests/test_write_watch_reharvest.c b/libs/video/tests/test_write_watch_reharvest.c
new file mode 100644
index 0000000..56392a3
--- /dev/null
+++ b/libs/video/tests/test_write_watch_reharvest.c
@@ -0,0 +1,96 @@
+/* Real Windows dirty-bit regression: original full-block harvesting and the
+ * narrowed repeated harvest must both return every intervening byte write.
+ * Uses only private disposable MEM_WRITE_WATCH allocations. */
+#include <windows.h>
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "../rsx_write_watch_plan.h"
+enum { BLOCK = 1024, PAGES = 8192, PAGE = 4096 };
+typedef struct {
+    uint8_t* memory;
+    uint32_t epoch[PAGES], generation[PAGES], seen[PAGES], cached[PAGES];
+    uint32_t block_epoch[PAGES / BLOCK], gen;
+    uint64_t asked, calls, checks;
+    int narrow;
+} fixture;
+static fixture old_path, new_path;
+static uint32_t random_state = 0x718A2031;
+static uint32_t rnd(void) { random_state ^= random_state << 13; random_state ^= random_state >> 17; random_state ^= random_state << 5; return random_state; }
+static void write_page(fixture* f, uint32_t page, uint32_t value, int note)
+{
+    *(uint32_t*)(f->memory + (size_t)page * PAGE) = value;
+    if (note) f->epoch[page] = 0;
+}
+static void read_pages(fixture* f, uint32_t first, uint32_t end, uint32_t epoch)
+{
+    uint32_t p = first;
+    while (p < end && f->epoch[p] == epoch) ++p;
+    if (p != end) {
+        int wide = !f->narrow || rsx_ww_widen_first_block(first, end, BLOCK, epoch, f->block_epoch, PAGES / BLOCK);
+        const uint32_t begin = wide ? first / BLOCK * BLOCK : first;
+        const uint32_t limit = wide ? (end + BLOCK - 1) / BLOCK * BLOCK : end;
+        void* dirty[PAGES]; ULONG_PTR count = PAGES; DWORD gran = 0;
+        assert(GetWriteWatch(WRITE_WATCH_FLAG_RESET, f->memory + (size_t)begin * PAGE,
+                            (size_t)(limit - begin) * PAGE, dirty, &count, &gran) == 0);
+        assert(gran == PAGE);
+        f->asked += limit - begin; ++f->calls;
+        if (count) ++f->gen;
+        for (ULONG_PTR i = 0; i < count; ++i) {
+            size_t pg = ((uint8_t*)dirty[i] - f->memory) / PAGE;
+            assert(pg < PAGES); f->generation[pg] = f->gen;
+        }
+        for (p = begin; p < limit; ++p) f->epoch[p] = epoch;
+        if (wide) for (p = begin / BLOCK; p < limit / BLOCK; ++p) f->block_epoch[p] = epoch;
+    }
+    for (p = first; p < end; ++p) {
+        const uint32_t actual = *(uint32_t*)(f->memory + (size_t)p * PAGE);
+        if (f->generation[p] > f->seen[p]) {
+            f->cached[p] = actual; f->seen[p] = f->generation[p];
+        }
+        assert(f->cached[p] == actual); ++f->checks;
+    }
+}
+int main(void)
+{
+    old_path.memory = VirtualAlloc(NULL, (size_t)PAGES * PAGE, MEM_RESERVE | MEM_COMMIT | MEM_WRITE_WATCH, PAGE_READWRITE);
+    new_path.memory = VirtualAlloc(NULL, (size_t)PAGES * PAGE, MEM_RESERVE | MEM_COMMIT | MEM_WRITE_WATCH, PAGE_READWRITE);
+    assert(old_path.memory && new_path.memory); new_path.narrow = 1;
+    for (uint32_t ep = 1; ep <= 64; ++ep) {
+        /* Producer writes before publishing the next FIFO pass. */
+        for (uint32_t i = 0; i < 300; ++i) {
+            uint32_t page = rnd() % PAGES, value = rnd();
+            write_page(&old_path, page, value, 0); write_page(&new_path, page, value, 0);
+        }
+        for (uint32_t b = 0; b < PAGES / BLOCK; ++b) {
+            read_pages(&old_path, b * BLOCK, b * BLOCK + 1, ep);
+            read_pages(&new_path, b * BLOCK, b * BLOCK + 1, ep);
+        }
+        /* Inline constant patches and overlapping 2D copies within a pass. */
+        for (uint32_t i = 0; i < 256; ++i) {
+            uint32_t page = rnd() % (PAGES - 33), width = 1 + rnd() % 32;
+            for (uint32_t p = page; p < page + width; ++p) {
+                uint32_t value = rnd();
+                write_page(&old_path, p, value, 1); write_page(&new_path, p, value, 1);
+            }
+            read_pages(&old_path, page, page + width, ep);
+            read_pages(&new_path, page, page + width, ep);
+            /* Repeated cache read and a crossing block boundary. */
+            read_pages(&old_path, page, page + width, ep);
+            read_pages(&new_path, page, page + width, ep);
+            uint32_t boundary = (1 + rnd() % 7) * BLOCK;
+            read_pages(&old_path, boundary - 3, boundary + 3, ep);
+            read_pages(&new_path, boundary - 3, boundary + 3, ep);
+        }
+        read_pages(&old_path, 0, PAGES, ep); read_pages(&new_path, 0, PAGES, ep);
+    }
+    assert(new_path.asked * 4 < old_path.asked);
+    assert(new_path.checks == old_path.checks);
+    printf("PASS checks=%llu old_pages=%llu new_pages=%llu reduction=%.2f%% calls=%llu/%llu\n",
+           (unsigned long long)new_path.checks, (unsigned long long)old_path.asked,
+           (unsigned long long)new_path.asked, 100.0 * (1.0 - (double)new_path.asked / old_path.asked),
+           (unsigned long long)old_path.calls, (unsigned long long)new_path.calls);
+    VirtualFree(old_path.memory, 0, MEM_RELEASE); VirtualFree(new_path.memory, 0, MEM_RELEASE);
+    return 0;
+}
