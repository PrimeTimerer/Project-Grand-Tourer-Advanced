@@ -0,0 +1,290 @@
+/* Private callback dispatcher, one FIFO worker per including codec module.
+ * A decoder callback must not run while its caller still holds guest locks.
+ * Completion also must not depend on the game's sysutil/render thread polling.
+ * Owners live in static handle slots; generations cancel queued work on reset.
+ */
+#ifndef PS3RECOMP_CODEC_CALLBACKS_H
+#define PS3RECOMP_CODEC_CALLBACKS_H
+#include "ps3emu/guest_call.h"
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#ifndef CODEC_CB_NAME
+#define CODEC_CB_NAME "codec"
+#endif
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+static SRWLOCK codec_cb_lock = SRWLOCK_INIT;
+static CONDITION_VARIABLE codec_cb_changed = CONDITION_VARIABLE_INIT;
+static DWORD codec_cb_thread_id;
+#define CODEC_CB_LOCK() AcquireSRWLockExclusive(&codec_cb_lock)
+#define CODEC_CB_UNLOCK() ReleaseSRWLockExclusive(&codec_cb_lock)
+#define CODEC_CB_WAIT() SleepConditionVariableSRW(&codec_cb_changed, &codec_cb_lock, INFINITE, 0)
+#define CODEC_CB_WAKE() WakeAllConditionVariable(&codec_cb_changed)
+#define CODEC_CB_SELF() (GetCurrentThreadId() == codec_cb_thread_id)
+#else
+#include <pthread.h>
+#include <time.h>
+#include <unistd.h>
+static pthread_mutex_t codec_cb_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t codec_cb_changed = PTHREAD_COND_INITIALIZER;
+static pthread_t codec_cb_thread_id;
+#define CODEC_CB_LOCK() pthread_mutex_lock(&codec_cb_lock)
+#define CODEC_CB_UNLOCK() pthread_mutex_unlock(&codec_cb_lock)
+#define CODEC_CB_WAIT() pthread_cond_wait(&codec_cb_changed, &codec_cb_lock)
+#define CODEC_CB_WAKE() pthread_cond_broadcast(&codec_cb_changed)
+#define CODEC_CB_SELF() pthread_equal(pthread_self(), codec_cb_thread_id)
+#endif
+static u64 codec_clock_us(void)
+{
+#ifdef _WIN32
+    LARGE_INTEGER ticks, frequency;
+    QueryPerformanceCounter(&ticks); QueryPerformanceFrequency(&frequency);
+    return (u64)(ticks.QuadPart / frequency.QuadPart) * 1000000u +
+           (u64)(ticks.QuadPart % frequency.QuadPart) * 1000000u / (u64)frequency.QuadPart;
+#else
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (u64)ts.tv_sec * 1000000u + (u64)ts.tv_nsec / 1000u;
+#endif
+}
+static void codec_role_name(const char* role)
+{
+#ifdef _WIN32
+    static __declspec(thread) const char* previous;
+    if (previous == role) return;
+    typedef HRESULT (WINAPI *SetDescriptionFn)(HANDLE, PCWSTR);
+    SetDescriptionFn set = (SetDescriptionFn)GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "SetThreadDescription");
+    char utf8[64]; wchar_t name[64];
+    snprintf(utf8, sizeof(utf8), "GT6 " CODEC_CB_NAME " %s", role);
+    if (set && MultiByteToWideChar(CP_UTF8, 0, utf8, -1, name, 64)) set(GetCurrentThread(), name);
+    previous = role;
+#else
+    (void)role;
+#endif
+}
+static void codec_thread_name(int stats) { codec_role_name(stats ? "statistics" : "callbacks"); }
+typedef struct {
+    u64 input, produced, consumed, bytes, busy, work_us;
+    u64 in_pts, out_pts, get_pts;
+    u32 queue;
+} CodecDiagnostics;
+typedef struct {
+    u32 generation;
+    unsigned active;
+    int enabled;
+    const char* label;
+    u32 handle;
+    u64 posted, completed, cancelled, active_since, callback_us, callback_max_us;
+    CodecDiagnostics diag;
+} CodecCallbackOwner;
+typedef struct CodecCallbackItem {
+    struct CodecCallbackItem* next;
+    CodecCallbackOwner* owner;
+    u32 generation, opd;
+    u64 args[8];
+    u32 message_ea, message_type;
+    u64 message_data;
+} CodecCallbackItem;
+static CodecCallbackItem *codec_cb_head, *codec_cb_tail;
+static unsigned codec_cb_count;
+static int codec_cb_started;
+static int codec_stats_enabled;
+static CodecCallbackOwner* codec_stats_owners[32];
+static unsigned codec_stats_count;
+
+enum { CODEC_DIAG_INPUT, CODEC_DIAG_PRODUCED, CODEC_DIAG_CONSUMED, CODEC_DIAG_BUSY, CODEC_DIAG_WORK };
+/* Counters are opt-in, protected by the callback lock and read on a separate
+ * timer thread. They still report once a second if guest dispatch is blocked. */
+static void codec_diag_event(CodecCallbackOwner* owner, int event, u64 pts, u64 bytes, u32 queue)
+{
+    if (!codec_stats_enabled) return;
+    CODEC_CB_LOCK(); CodecDiagnostics* d = &owner->diag;
+    if (event == CODEC_DIAG_INPUT) { d->input++; d->bytes += bytes; d->in_pts = pts; }
+    else if (event == CODEC_DIAG_PRODUCED) { d->produced++; d->out_pts = pts; }
+    else if (event == CODEC_DIAG_CONSUMED) { d->consumed++; d->get_pts = pts; }
+    else if (event == CODEC_DIAG_BUSY) d->busy++;
+    else if (event == CODEC_DIAG_WORK) d->work_us += bytes;
+    d->queue = queue; CODEC_CB_UNLOCK();
+}
+static void codec_diag_label(CodecCallbackOwner* owner, const char* label, u32 handle)
+{
+    if (!codec_stats_enabled) return;
+    CODEC_CB_LOCK(); owner->label = label; owner->handle = handle; CODEC_CB_UNLOCK();
+}
+static void codec_diag_reset(CodecCallbackOwner* owner)
+{
+    if (!codec_stats_enabled) return;
+    CODEC_CB_LOCK(); memset(&owner->diag, 0, sizeof(owner->diag));
+    owner->diag.in_pts = owner->diag.out_pts = owner->diag.get_pts = ~(u64)0;
+    CODEC_CB_UNLOCK();
+}
+#ifdef _WIN32
+static DWORD WINAPI codec_stats_worker(LPVOID unused)
+#else
+static void* codec_stats_worker(void* unused)
+#endif
+{
+    (void)unused; codec_thread_name(1);
+    for (;;) {
+#ifdef _WIN32
+        Sleep(1000);
+#else
+        usleep(1000000);
+#endif
+        CodecCallbackOwner snapshots[32]; unsigned pending[32] = {0}, count;
+        CODEC_CB_LOCK(); count = codec_stats_count;
+        for (unsigned i = 0; i < count; i++) {
+            snapshots[i] = *codec_stats_owners[i];
+            for (CodecCallbackItem* it = codec_cb_head; it; it = it->next)
+                if (it->owner == codec_stats_owners[i]) pending[i]++;
+        }
+        CODEC_CB_UNLOCK();
+        u64 now = codec_clock_us();
+        for (unsigned i = 0; i < count; i++) {
+            const CodecCallbackOwner* o = &snapshots[i]; const CodecDiagnostics* d = &o->diag;
+            if (!o->enabled && !o->active) continue;
+            fprintf(stderr, "[movie-stat] qpc_us=%llu codec=" CODEC_CB_NAME " kind=%s h=%u gen=%u in=%llu out=%llu get=%llu bytes=%llu busy=%llu work_ms=%.3f q=%u pts=%lld/%lld/%lld cb=%llu/%llu pending=%u active=%u active_ms=%.3f callback_ms=%.3f max_ms=%.3f cancelled=%llu\n",
+                (unsigned long long)now, o->label ? o->label : "callback", o->handle, o->generation,
+                (unsigned long long)d->input, (unsigned long long)d->produced, (unsigned long long)d->consumed,
+                (unsigned long long)d->bytes, (unsigned long long)d->busy, d->work_us / 1000.0, d->queue,
+                (long long)d->in_pts, (long long)d->out_pts, (long long)d->get_pts,
+                (unsigned long long)o->posted, (unsigned long long)o->completed, pending[i], o->active,
+                o->active && o->active_since ? (now - o->active_since) / 1000.0 : 0.0,
+                o->callback_us / 1000.0, o->callback_max_us / 1000.0, (unsigned long long)o->cancelled);
+        }
+    }
+}
+
+#ifdef _WIN32
+static DWORD WINAPI codec_cb_worker(LPVOID unused)
+#else
+static void* codec_cb_worker(void* unused)
+#endif
+{
+    (void)unused; codec_thread_name(0);
+    for (;;) {
+        CODEC_CB_LOCK();
+        while (!codec_cb_head) CODEC_CB_WAIT();
+        CodecCallbackItem* item = codec_cb_head;
+        codec_cb_head = item->next; if (!codec_cb_head) codec_cb_tail = NULL;
+        codec_cb_count--;
+        CodecCallbackOwner* owner = item->owner;
+        int dispatch = owner->enabled && owner->generation == item->generation;
+        if (dispatch) { owner->active++; if (codec_stats_enabled) owner->active_since = codec_clock_us(); }
+        CODEC_CB_UNLOCK();
+        if (dispatch && g_ps3_guest_caller) {
+            /* Write a message immediately before its callback, not when
+             * queued: later DEMUX_DONE events can carry different userData. */
+            if (item->message_ea) {
+                vm_write32(item->message_ea, item->message_type);
+                vm_write32(item->message_ea + 4, 0);
+                vm_write64(item->message_ea + 8, item->message_data);
+            }
+            g_ps3_guest_caller(item->opd, item->args[0], item->args[1], item->args[2], item->args[3],
+                              item->args[4], item->args[5], item->args[6], item->args[7]);
+        }
+        CODEC_CB_LOCK();
+        if (dispatch) {
+            owner->active--;
+            if (codec_stats_enabled) {
+                u64 elapsed = codec_clock_us() - owner->active_since;
+                owner->completed++; owner->callback_us += elapsed;
+                if (elapsed > owner->callback_max_us) owner->callback_max_us = elapsed;
+                owner->active_since = 0;
+            }
+        }
+        CODEC_CB_WAKE();
+        CODEC_CB_UNLOCK();
+        free(item);
+    }
+}
+/* Must be called outside the codec's state mutex: an in-flight guest callback
+ * may itself call GetPicture/GetPcm/ReleaseAu before it returns. */
+static u32 codec_cb_cancel_ex(CodecCallbackOwner* owner, int disable, int wait_active)
+{
+    CODEC_CB_LOCK();
+    owner->generation++; if (!owner->generation) owner->generation++;
+    if (disable) owner->enabled = 0;
+    CodecCallbackItem** link = &codec_cb_head;
+    codec_cb_tail = NULL;
+    while (*link) {
+        CodecCallbackItem* item = *link;
+        if (item->owner == owner) { *link = item->next; free(item); codec_cb_count--; owner->cancelled++; }
+        else { codec_cb_tail = item; link = &item->next; }
+    }
+    /* Close/reset from inside this very callback is allowed. The worker only
+     * touches the permanent owner counter after guest code returns. */
+    while (wait_active && owner->active && !CODEC_CB_SELF()) CODEC_CB_WAIT();
+    u32 generation = owner->generation;
+    CODEC_CB_UNLOCK(); return generation;
+}
+static u32 codec_cb_cancel(CodecCallbackOwner* owner, int disable)
+{ return codec_cb_cancel_ex(owner, disable, 1); }
+static void codec_cb_wait_owner(CodecCallbackOwner* owner)
+{
+    CODEC_CB_LOCK();
+    for (;;) {
+        int pending = 0;
+        for (CodecCallbackItem* it = codec_cb_head; it; it = it->next)
+            if (it->owner == owner) { pending = 1; break; }
+        if (CODEC_CB_SELF() || (!pending && !owner->active)) break;
+        CODEC_CB_WAIT();
+    }
+    CODEC_CB_UNLOCK();
+}
+static u32 codec_cb_open(CodecCallbackOwner* owner)
+{
+    codec_cb_cancel(owner, 1);
+    CODEC_CB_LOCK();
+    if (!codec_cb_started) {
+        const char* stats = getenv("GT6_MOVIE_STATS");
+        codec_stats_enabled = stats && !strcmp(stats, "1");
+#ifdef _WIN32
+        HANDLE thread = CreateThread(NULL, 0, codec_cb_worker, NULL, 0, &codec_cb_thread_id);
+        if (thread) { CloseHandle(thread); codec_cb_started = 1; }
+#else
+        if (pthread_create(&codec_cb_thread_id, NULL, codec_cb_worker, NULL) == 0) {
+            pthread_detach(codec_cb_thread_id); codec_cb_started = 1;
+        }
+#endif
+        if (codec_cb_started && codec_stats_enabled) {
+#ifdef _WIN32
+            HANDLE stats_thread = CreateThread(NULL, 0, codec_stats_worker, NULL, 0, NULL);
+            if (stats_thread) CloseHandle(stats_thread);
+#else
+            pthread_t stats_thread;
+            if (!pthread_create(&stats_thread, NULL, codec_stats_worker, NULL)) pthread_detach(stats_thread);
+#endif
+        }
+    }
+    if (codec_stats_enabled) {
+        unsigned i = 0; while (i < codec_stats_count && codec_stats_owners[i] != owner) i++;
+        if (i == codec_stats_count && i < 32) codec_stats_owners[codec_stats_count++] = owner;
+        memset(&owner->diag, 0, sizeof(owner->diag));
+        owner->diag.in_pts = owner->diag.out_pts = owner->diag.get_pts = ~(u64)0;
+    }
+    owner->enabled = codec_cb_started;
+    u32 generation = owner->enabled ? owner->generation : 0;
+    CODEC_CB_UNLOCK(); return generation;
+}
+static int codec_cb_post(CodecCallbackOwner* owner, u32 generation, u32 opd, const u64 args[8],
+                         u32 message_ea, u32 message_type, u64 message_data)
+{
+    if (!opd) return 1;
+    CodecCallbackItem* item = (CodecCallbackItem*)malloc(sizeof(*item));
+    if (!item) return 0;
+    item->owner = owner; item->generation = generation; item->opd = opd; item->next = NULL;
+    memcpy(item->args, args, sizeof(item->args));
+    item->message_ea = message_ea; item->message_type = message_type; item->message_data = message_data;
+    CODEC_CB_LOCK();
+    if (!owner->enabled || owner->generation != generation) { CODEC_CB_UNLOCK(); free(item); return 1; }
+    if (codec_cb_count >= 4096) { CODEC_CB_UNLOCK(); free(item); return 0; }
+    if (codec_cb_tail) codec_cb_tail->next = item; else codec_cb_head = item;
+    codec_cb_tail = item; codec_cb_count++;
+    if (codec_stats_enabled) owner->posted++;
+    CODEC_CB_WAKE(); CODEC_CB_UNLOCK(); return 1;
+}
+#endif
diff --git a/libs/codec/h264_sps.h b/libs/codec/h264_sps.h
new file mode 100644
index 0000000..6ffe032
--- /dev/null
+++ b/libs/codec/h264_sps.h
@@ -0,0 +1,104 @@
+/* Small bounded SPS/VUI reader for crop and timing metadata. The hardware
+ * decoder owns all actual H.264 decoding. All lengths come from the AU. */
+#ifndef PS3RECOMP_H264_SPS_H
+#define PS3RECOMP_H264_SPS_H
+#include <stdint.h>
+#include <stddef.h>
+typedef struct {
+    uint32_t width, height, rate_num, rate_den;
+    uint32_t full_range, matrix, colour, transfer;
+} H264SpsInfo;
+typedef struct { const uint8_t* p; size_t bits, at; int failed; } H264Bits;
+static uint32_t h264_bits(H264Bits* b, unsigned n)
+{
+    if (n > 32 || b->at + n > b->bits) { b->failed = 1; return 0; }
+    uint32_t v = 0;
+    for (unsigned i = 0; i < n; ++i, ++b->at) v = (v << 1) | ((b->p[b->at / 8] >> (7 - b->at % 8)) & 1);
+    return v;
+}
+static uint32_t h264_ue(H264Bits* b)
+{
+    unsigned zeroes = 0;
+    while (!b->failed && !h264_bits(b, 1)) if (++zeroes > 30) { b->failed = 1; return 0; }
+    return zeroes ? ((1u << zeroes) - 1u) + h264_bits(b, zeroes) : 0;
+}
+static int32_t h264_se(H264Bits* b)
+{ uint32_t n = h264_ue(b); return n & 1 ? (int32_t)((n + 1) / 2) : -(int32_t)(n / 2); }
+static int h264_read_sps(const uint8_t* nal, size_t len, H264SpsInfo* out)
+{
+    uint8_t rbsp[4096]; size_t bytes = 0; unsigned zeros = 0;
+    if (!nal || !out || !len || (nal[0] & 31) != 7 || len > sizeof(rbsp)) return 0;
+    for (size_t i = 1; i < len; ++i) {
+        uint8_t c = nal[i];
+        if (zeros >= 2 && c == 3) { zeros = 0; continue; }
+        rbsp[bytes++] = c; zeros = c ? 0 : zeros + 1;
+    }
+    H264Bits b = {rbsp, bytes * 8, 0, 0};
+    H264SpsInfo info = {0};
+    uint32_t profile = h264_bits(&b, 8); h264_bits(&b, 16); h264_ue(&b);
+    uint32_t chroma = 1, separate = 0;
+    switch (profile) {
+    case 100: case 110: case 122: case 244: case 44: case 83: case 86:
+    case 118: case 128: case 138: case 139: case 134: case 135:
+        chroma = h264_ue(&b); if (chroma > 3) return 0;
+        if (chroma == 3) separate = h264_bits(&b, 1);
+        h264_ue(&b); h264_ue(&b); h264_bits(&b, 1);
+        if (h264_bits(&b, 1)) for (unsigned i = 0; i < (chroma == 3 ? 12u : 8u); i++) if (h264_bits(&b, 1)) {
+            int last = 8, next = 8;
+            for (unsigned j = 0; j < (i < 6 ? 16u : 64u); j++) {
+                if (next) next = (last + h264_se(&b) + 256) & 255;
+                last = next ? next : last;
+            }
+        }
+        break;
+    default: break;
+    }
+    h264_ue(&b);
+    uint32_t poc = h264_ue(&b);
+    if (poc == 0) h264_ue(&b);
+    else if (poc == 1) {
+        h264_bits(&b, 1); h264_se(&b); h264_se(&b);
+        uint32_t cycle = h264_ue(&b); if (cycle > 256) return 0;
+        for (uint32_t i = 0; i < cycle; i++) h264_se(&b);
+    } else if (poc > 2) return 0;
+    h264_ue(&b); h264_bits(&b, 1);
+    uint32_t mw = h264_ue(&b), mh = h264_ue(&b);
+    uint32_t frame = h264_bits(&b, 1); if (!frame) h264_bits(&b, 1);
+    h264_bits(&b, 1);
+    uint32_t left = 0, right = 0, top = 0, bottom = 0;
+    if (h264_bits(&b, 1)) { left = h264_ue(&b); right = h264_ue(&b); top = h264_ue(&b); bottom = h264_ue(&b); }
+    if (mw > 255 || mh > 255) return 0;
+    uint32_t chromaArray = separate ? 0 : chroma;
+    uint32_t cropX = chromaArray == 1 || chromaArray == 2 ? 2 : 1;
+    uint32_t cropY = (chromaArray == 1 ? 2 : 1) * (2 - frame);
+    uint32_t codedW = (mw + 1) * 16, codedH = (mh + 1) * 16 * (2 - frame);
+    if (((uint64_t)left + right) * cropX >= codedW || ((uint64_t)top + bottom) * cropY >= codedH || left || top) return 0;
+    info.width = codedW - (left + right) * cropX;
+    info.height = codedH - (top + bottom) * cropY;
+    if (h264_bits(&b, 1)) {
+        if (h264_bits(&b, 1)) { uint32_t aspect = h264_bits(&b, 8); if (aspect == 255) h264_bits(&b, 32); }
+        if (h264_bits(&b, 1)) h264_bits(&b, 1);
+        if (h264_bits(&b, 1)) {
+            h264_bits(&b, 3); info.full_range = h264_bits(&b, 1);
+            if (h264_bits(&b, 1)) { info.colour = h264_bits(&b, 8); info.transfer = h264_bits(&b, 8); info.matrix = h264_bits(&b, 8); }
+        }
+        if (h264_bits(&b, 1)) { h264_ue(&b); h264_ue(&b); }
+        if (h264_bits(&b, 1)) {
+            uint32_t num = h264_bits(&b, 32), scale = h264_bits(&b, 32); h264_bits(&b, 1);
+            if (num && num <= UINT32_MAX / 2 && scale) { info.rate_num = scale; info.rate_den = num * 2; }
+        }
+    }
+    if (b.failed) return 0;
+    *out = info; return 1;
+}
+static int h264_find_sps(const uint8_t* au, size_t n, H264SpsInfo* info)
+{
+    for (size_t i = 0; i + 4 <= n; i++) if (!au[i] && !au[i+1] && au[i+2] == 1 && (au[i+3] & 31) == 7) {
+        size_t end = i + 4;
+        while (end + 3 <= n && (au[end] || au[end+1] || au[end+2] != 1)) end++;
+        if (end + 3 > n) end = n;
+        return h264_read_sps(au + i + 3, end - i - 3, info);
+    }
+    return 0;
+}
+#endif
diff --git a/libs/codec/movie_capture.h b/libs/codec/movie_capture.h
new file mode 100644
index 0000000..9aa11a3
--- /dev/null
+++ b/libs/codec/movie_capture.h
@@ -0,0 +1,21 @@
+/* Opt-in bounded capture at the title's decoded PAMF/PS boundary.
+ * No disc-file changes: useful for diagnosing the actual stream handed to HLE. */
+#ifndef PS3RECOMP_MOVIE_CAPTURE_H
+#define PS3RECOMP_MOVIE_CAPTURE_H
+#include <stdlib.h>
+#include <stdio.h>
+#include <stdint.h>
+static void movie_capture_bytes(const char* name, const void* bytes, size_t n,
+                                int append, size_t* used, size_t limit)
+{
+    const char* dir = getenv("GT6_MOVIE_CAPTURE");
+    if (!dir || !*dir || !bytes || *used >= limit) return;
+    if (n > limit - *used) n = limit - *used;
+    char path[2048];
+    if (snprintf(path, sizeof(path), "%s/%s", dir, name) >= (int)sizeof(path)) return;
+    FILE* f = fopen(path, append && *used ? "ab" : "wb");
+    if (!f) return;
+    *used += fwrite(bytes, 1, n, f);
+    fclose(f);
+}
+#endif
diff --git a/libs/codec/tests/test_adec_atrac.c b/libs/codec/tests/test_adec_atrac.c
new file mode 100644
index 0000000..5d829b0
--- /dev/null
+++ b/libs/codec/tests/test_adec_atrac.c
@@ -0,0 +1,101 @@
+/* Explicit captured ATRAC fixture, disposable guest memory, no game/save I/O. */
+#include "../cellAdec.c"
+#include <stdint.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+uint32_t ppu_hle_inject_base = 0x01000000;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+PPU_THREAD_LOCAL ppu_context* g_active_ctx;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+#define CHECK(x) do { if (!(x)) { fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x);exit(1); } } while (0)
+static volatile LONG callbacks[4];
+static SRWLOCK guest_mutex = SRWLOCK_INIT;
+static void callback(u32 opd,u64 handle,u64 type,u64 data,u64 arg,u64 e,u64 f,u64 g,u64 h)
+{
+    AcquireSRWLockExclusive(&guest_mutex);
+    CHECK(opd==0x1000 && handle==1 && type<4 && arg==0x5678 && !(e|f|g|h));
+    if(type==0) CHECK(data==0x1400); else CHECK(data==0);
+    if(type==1) CHECK(cellAdecGetPcmItem(1,(const CellAdecPcmItem**)0x1700)==0);
+    InterlockedIncrement(&callbacks[type]);
+    ReleaseSRWLockExclusive(&guest_mutex);
+}
+ps3_guest_caller_fn g_ps3_guest_caller = callback;
+static void wait_callbacks(u32 type,u32 count)
+{
+    ULONGLONG deadline=GetTickCount64()+3000;
+    while((u32)InterlockedCompareExchange(&callbacks[type],0,0)<count) { CHECK(GetTickCount64()<deadline);Sleep(1); }
+}
+static u64 run(const u8* input,u32 count,u32 frame_size,u32 channels,u32 config)
+{
+    memset((void*)callbacks,0,sizeof(callbacks));
+    vm_write32(0x1100, channels==2?13:14);vm_write32(0x1120,0x1000);vm_write32(0x1124,0x5678);
+    CHECK(cellAdecOpenEx((CellAdecType*)0x1100,0,(CellAdecCb*)0x1120,(u32*)0x1140)==0);
+    CHECK(vm_read32(0x1140)==1);
+    vm_write32(0x1200,48000);vm_write32(0x1204,config);vm_write32(0x1208,channels);
+    vm_write32(0x120c,frame_size-8);vm_write32(0x1214,0x84);vm_write8(0x1219,1);
+    u64 hashes[2]={0,0};
+    for(u32 seq=0;seq<2;seq++) {
+        /* GT6's OpenEx path leaves ATS-carried fields zero in StartSeq. */
+        if(seq) { vm_write32(0x1200,0);vm_write32(0x1204,0);vm_write32(0x120c,0); }
+        CHECK(cellAdecStartSeq(1,(void*)0x1200)==0);
+        int align=frame_size-8;void* reference=at3p_open(channels,&align);CHECK(reference);
+        float planar[8][2048];float* planes[8];for(u32 c=0;c<8;c++)planes[c]=planar[c];
+        u64 hash=14695981039346656037ull,nonzero=0;double peak=0;
+        for(u32 i=0;i<count;i++) {
+            memcpy(vm_base+0x100000,input+i*frame_size,frame_size);
+            vm_write32(0x1400,0x100000);vm_write32(0x1404,frame_size);
+            vm_write64(0x1408,i?~(u64)0:90000);vm_write64(0x1410,0x1234567800000000ull+i);
+            /* A real callback re-enters both the submitting guest mutex and
+             * cellAdecGetPcmItem. Synchronous dispatch would deadlock here. */
+            AcquireSRWLockExclusive(&guest_mutex);
+            CHECK(cellAdecDecodeAu(1,(CellAdecAuInfo*)0x1400)==0);
+            ReleaseSRWLockExclusive(&guest_mutex);
+            wait_callbacks(1,count*seq+i+1);
+            int samples=0;CHECK(at3p_decode_planar(reference,planes,&samples,input+i*frame_size+8,frame_size-8)>=0 && samples==2048);
+            CHECK(cellAdecGetPcmItem(1,(const CellAdecPcmItem**)0x1600)==0);
+            u32 item=vm_read32(0x1600),bsi=vm_read32(item+16);
+            CHECK(vm_read32(item+12)==channels*2048*4 && vm_read32(item+24)==0x100000);
+            CHECK(vm_read64(item+32)==90000+i*3840ull && vm_read64(item+40)==0x1234567800000000ull+i);
+            CHECK(vm_read32(bsi)==48000 && vm_read32(bsi+4)==config && vm_read32(bsi+8)==frame_size-8);
+            CHECK(cellAdecGetPcm(1,(void*)0x200000)==0);
+            CHECK(cellAdecGetPcm(1,0)==(s32)CELL_ADEC_ERROR_EMPTY);
+            for(u32 s=0;s<2048;s++)for(u32 c=0;c<channels;c++) {
+                u32 got=vm_read32(0x200000+4*(s*channels+c)),want;memcpy(&want,&planar[c][s],4);
+                CHECK(got==want && isfinite(planar[c][s]));
+                nonzero+=planar[c][s]!=0;double v=fabs(planar[c][s]);if(v>peak)peak=v;
+                hash=(hash^got)*1099511628211ull;
+            }
+        }
+        CHECK(nonzero && callbacks[0]==count*(seq+1) && callbacks[1]==count*(seq+1));
+        CHECK(cellAdecEndSeq(1)==0);
+        wait_callbacks(3,seq+1);
+        CHECK(cellAdecDecodeAu(1,(CellAdecAuInfo*)0x1400)==(s32)CELL_ADEC_ERROR_SEQ);
+        at3p_close(reference);hashes[seq]=hash;
+        printf("channels=%u sequence=%u frames=%u nonzero=%llu peak=%.9f hash=%016llx\n",channels,seq+1,count,(unsigned long long)nonzero,peak,(unsigned long long)hash);
+    }
+    CHECK(hashes[0]==hashes[1]);
+    CHECK(cellAdecStartSeq(1,(void*)0x1200)==0);
+    for(u32 i=0;i<AT3_PCM_QUEUE;i++)CHECK(cellAdecDecodeAu(1,(CellAdecAuInfo*)0x1400)==0);
+    CHECK(cellAdecDecodeAu(1,(CellAdecAuInfo*)0x1400)==(s32)CELL_ADEC_ERROR_BUSY);
+    CHECK(cellAdecGetPcm(1,0)==0);
+    CHECK(cellAdecDecodeAu(1,(CellAdecAuInfo*)0x1400)==0);
+    CHECK(cellAdecClose(1)==0);
+    return hashes[0];
+}
+int main(int argc,char** argv)
+{
+    if(argc!=3){fprintf(stderr,"usage: test_adec_atrac stereo_atrac.bin surround_atrac.bin\n");return 2;}
+    vm_base=(u8*)calloc(1,64u*1024u*1024u);ppu_vm_size=64u*1024u*1024u;CHECK(vm_base);
+    for(u32 i=0;i<2;i++) {
+        FILE* f=fopen(argv[i+1],"rb");CHECK(f);u32 n=i?1720:696,frames=400;
+        u8* bytes=(u8*)malloc(n*frames);CHECK(bytes && fread(bytes,n,frames,f)==frames);fclose(f);
+        run(bytes,frames,n,i?6:2,i?5:2);free(bytes);
+    }
+    free(vm_base);puts("PASS ATRAC3plus cellAdec 2/6-channel PCM, PTS, restart and backpressure");return 0;
+}
