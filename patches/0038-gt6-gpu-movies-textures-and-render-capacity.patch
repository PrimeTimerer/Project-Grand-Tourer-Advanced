+        b=barrier(destination.Get(),D3D12_RESOURCE_STATE_COPY_DEST,D3D12_RESOURCE_STATE_COPY_SOURCE);list->ResourceBarrier(1,&b);
+        D3D12_TEXTURE_COPY_LOCATION rc{},dc{};rc.pResource=readback.Get();rc.Type=D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;rc.PlacedFootprint=dstfp;
+        dc.pResource=destination.Get();dc.Type=D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;list->CopyTextureRegion(&rc,0,0,0,&dc,nullptr);
+        hr(list->Close(),"close");ID3D12CommandList* submit[]={list.Get()};queue->ExecuteCommandLists(1,submit);
+        hr(queue->Signal(fence.Get(),ci+1),"signal");hr(fence->SetEventOnCompletion(ci+1,event),"set fence event");
+        check(WaitForSingleObject(event,10000)==WAIT_OBJECT_0,"GPU completed");
+        hr(readback->Map(0,nullptr,(void**)&data),"readback map");
+        for(unsigned y=0;y<c[3];y++)for(unsigned x=0;x<c[2];x++) {
+            const auto* p=data+dstfp.Offset+size_t(y)*dstfp.Footprint.RowPitch+x*4;
+            const bool in=x<plan.width && y<plan.height;
+            const unsigned char expected[]={static_cast<unsigned char>(in?((x*13+y*7)&255):0),
+                static_cast<unsigned char>(in?((x*3+y*11)&255):0),static_cast<unsigned char>(in?((x^y)&255):0),255};
+            check(std::memcmp(p,expected,4)==0,"GPU copied visible pixels / cleared uncovered region");components+=4;
+        }
+        readback->Unmap(0,&none);check(error_count(info.Get())==0,"corrected copy has no debug errors");info->ClearStoredMessages();
+        std::printf("case %u: %ux%u -> %ux%u visible %ux%u whole=%d clear=%d PASS\n",ci,c[0],c[1],c[2],c[3],plan.width,plan.height,plan.whole_resource,plan.clear_destination);
+    }
+    CloseHandle(event);std::printf("PASS 6 GPU cases, %llu exact RGBA components, corrected debug errors 0\n",(unsigned long long)components);
+}
diff --git a/libs/video/tests/test_pso_warmup.c b/libs/video/tests/test_pso_warmup.c
