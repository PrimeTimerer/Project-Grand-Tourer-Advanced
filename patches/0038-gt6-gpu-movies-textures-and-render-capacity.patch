+    for(size_t i=0;i<actual.size();++i)if(actual[i]!=original[i]){
+        if(errors++<8)fprintf(stderr,"byte=%zu original=%u gpu=%u\n",i,original[i],actual[i]);
+        unsigned e=unsigned(abs(int(actual[i])-int(original[i]))); if(e>maxError)maxError=e;
+    }
+    printf("GPU original equivalence %s %ux%u bytes=%zu mismatch=%zu max_error=%u\n",argv[4],w,h,actual.size(),errors,maxError);
+    return errors?1:0;
+}
diff --git a/libs/codec/tests/test_gt6_movie_post_spu.cpp b/libs/codec/tests/test_gt6_movie_post_spu.cpp
