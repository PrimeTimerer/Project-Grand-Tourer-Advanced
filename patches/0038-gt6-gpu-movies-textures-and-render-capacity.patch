+        const u32 w1 = rsx_fp_read_word(ucode + off + 4);
+        const u32 w2 = rsx_fp_read_word(ucode + off + 8);
+        const u32 w3 = rsx_fp_read_word(ucode + off + 12);
+        const u32 op = (w0 >> FP_OPCODE_SHIFT) & 63u;
+        if (!(w2 & FP_BRANCH)) {
+            const u32 unit = 1u << ((w0 >> FP_TEX_UNIT_SHIFT) & 15u);
+            if (op == OP_TEX || op == OP_TXP) supported |= unit;
+            else if (op == OP_TXB || op == OP_TXL || op == OP_TXD ||
+                     op == OP_TEXBEM || op == OP_TXPBEM) unsupported |= unit;
+        }
+        off += 16;
+        if (!(w2 & FP_BRANCH) && ((w1 & 3u) == 2 || (w2 & 3u) == 2 || (w3 & 3u) == 2)) {
+            if (max_bytes - off < 16) return 0;
+            off += 16;
+        }
+        if (w0 & FP_END) return supported & ~unsupported;
+    }
+    return 0;
+}
