+    else if(type==CELL_VDEC_MSG_TYPE_PICOUT) {
+        CHECK(cellVdecGetPicItem(1,(const CellVdecPicItem**)0x1400)==0);
+        u32 item=vm_read32(0x1400);CHECK(vm_read64(item+16)==90000+1502ull*picture_in_sequence);
+        CHECK(vm_read8(vm_read32(item+0x48)+0x1c)==6);
+        CHECK(cellVdecGetPicture(1,(void*)0x1500,(void*)0x1600)==0);
+        picture_in_sequence++;CHECK(vm_read8(0x1600)==(picture_in_sequence&255));
+        CHECK(audone==pictures+1);InterlockedIncrement(&pictures);
+    } else if(type==CELL_VDEC_MSG_TYPE_ERROR)InterlockedIncrement(&errors);
+    else {CHECK(type==CELL_VDEC_MSG_TYPE_SEQDONE);InterlockedIncrement(&seqdone);}
+    ReleaseSRWLockExclusive(&guest_mutex);
+}
+ps3_guest_caller_fn g_ps3_guest_caller=callback;
+static void wait_for(volatile LONG* value,LONG wanted)
+{ULONGLONG deadline=GetTickCount64()+3000;while(InterlockedCompareExchange(value,0,0)<wanted){CHECK(GetTickCount64()<deadline);Sleep(1);}}
+int main(void)
+{
+    _putenv_s("VDEC_IDLE_DRAIN_MS","0");vm_base=(u8*)calloc(1,32u*1024u*1024u);ppu_vm_size=32u*1024u*1024u;CHECK(vm_base);
+    vm_write32(0x1100,1);vm_write32(0x1120,0x1000);vm_write32(0x1124,0x1234);vm_write32(0x1500,3);
+    CHECK(cellVdecOpen((CellVdecType*)0x1100,0,(CellVdecCb*)0x1120,(u32*)0x1140)==0&&vm_read32(0x1140)==1);
+    for(u32 seq=0;seq<2;seq++) {
+        CHECK(cellVdecStartSeq(1)==0);picture_in_sequence=0;
+        for(u32 i=0;i<100;i++) {
+            vm_write32(0x1200,0x2000);vm_write32(0x1204,4);vm_write64(0x1208,i?~(u64)0:90000);vm_write64(0x1210,~(u64)0);
+            AcquireSRWLockExclusive(&guest_mutex);
+            CHECK(cellVdecDecodeAu(1,0,(CellVdecAuInfo*)0x1200)==0);
+            ReleaseSRWLockExclusive(&guest_mutex);
+            wait_for(&pictures,(LONG)(seq*100+i+1));
