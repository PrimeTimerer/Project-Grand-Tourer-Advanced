new file mode 100644
index 0000000..68b55d2
--- /dev/null
+++ b/libs/video/rsx_pso_warmup.h
@@ -0,0 +1,470 @@
+/* Persist exact GPU pipeline recipes and prepare them before their next draw.
+ * The renderer owns this instance. The workers never touch guest state, shader
+ * translation, command lists, or the renderer's live caches. A missed recipe
+ * always uses the normal complete pipeline; no draw is skipped for warmup.
+ */
+#ifndef RSX_PSO_WARMUP_H
+#define RSX_PSO_WARMUP_H
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <windows.h>
+#include <d3d12.h>
+#if defined(_MSC_VER)
+#pragma comment(lib, "synchronization.lib")
+#endif
+
+#define LD_PW_LIMIT 8192u
+#define LD_PW_HASH (LD_PW_LIMIT * 2u)
+#define LD_PW_MAGIC 0x31575047u /* GPW1 */
+#define LD_PW_MAX_SHADER (4u * 1024u * 1024u)
+#define LD_PW_MAX_RETAINED (256ull * 1024u * 1024u)
+#define LD_PW_MAX_QUEUED (32u * 1024u * 1024u)
+
+typedef struct ld_pw_identity {
+    uint32_t root_kind;
+    uint32_t reserved;
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC desc;
+    D3D12_INPUT_ELEMENT_DESC inputs[16];
+    char semantics[16][32];
+} ld_pw_identity;
+
+typedef struct ld_pw_record {
+    uint32_t magic, version, header_size, payload_size;
+    uint64_t key, library_id;
+    ld_pw_identity identity;
+    /* VS, PS, GS bytes follow; all pointers in identity are NULL. */
+} ld_pw_record;
+
+typedef struct ld_pw_entry {
+    uint64_t key;
+    volatile LONG state; /* 0 queued, 1 building, 2 ready, 3 rejected */
+    ld_pw_record* record;
+    ID3D12PipelineState* pso;
+} ld_pw_entry;
+
+typedef struct ld_pw_job {
+    struct ld_pw_job* next;
+    ld_pw_entry* entry; /* non-NULL: load/build. NULL: write record. */
+    ld_pw_record* record;
+} ld_pw_job;
+
+static struct {
+    int active;
+    volatile LONG stop;
+    ID3D12Device* device;
+    ID3D12PipelineLibrary* library;
+    ID3D12RootSignature* roots[2];
+    char dir[MAX_PATH];
+    HANDLE threads[4];
+    unsigned thread_count, entry_count, new_records;
+    ld_pw_entry entries[LD_PW_LIMIT];
+    uint16_t index[LD_PW_HASH];
+    uint64_t recorded[LD_PW_HASH];
+    SRWLOCK lock;
+    CONDITION_VARIABLE wake;
+    ld_pw_job *head, *tail;
+    uint64_t retained, queued_bytes;
+    volatile LONG ready, rejected, saved, failed_writes, library_hits, driver_builds;
+    uint64_t hits, waits, misses, collisions, skipped_records;
+} g_ld_pw;
+/* Microsoft documents that concurrent loads of the same library entry need
+ * caller synchronization. Both ordinary loads and prewarming use this lock. */
+/* Lock only a small name bucket, rather than blocking a requested pipeline
+ * behind every unrelated background load. Zero is SRWLOCK_INIT on Windows. */
+static SRWLOCK g_ld_pw_library_locks[8192];
+
+static HRESULT ld_pw_library_load(ID3D12PipelineLibrary* library, LPCWSTR name,
+    const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd, ID3D12PipelineState** out)
+{
+    uint32_t bucket = 2166136261u;
+    for (const WCHAR* p = name; *p; ++p) bucket = (bucket ^ (uint32_t)*p) * 16777619u;
+    SRWLOCK* lock = &g_ld_pw_library_locks[bucket & 8191u];
+    AcquireSRWLockExclusive(lock);
+    const HRESULT hr = library->lpVtbl->LoadGraphicsPipeline(
+        library, name, pd, &IID_ID3D12PipelineState, (void**)out);
+    ReleaseSRWLockExclusive(lock);
+    return hr;
+}
+
+static uint64_t ld_pw_hash(const void* data, size_t n, uint64_t h)
+{
+    const unsigned char* p = (const unsigned char*)data;
+    for (size_t i = 0; i < n; ++i) { h ^= p[i]; h *= 1099511628211ull; }
+    return h;
+}
+
+static int ld_pw_identity_make(ld_pw_identity* out,
+    const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd, unsigned root_kind)
+{
+    if (root_kind > 1 || pd->InputLayout.NumElements > 16 ||
+        pd->StreamOutput.NumEntries || pd->StreamOutput.NumStrides ||
+        pd->HS.BytecodeLength || pd->DS.BytecodeLength ||
+        !pd->VS.BytecodeLength || !pd->PS.BytecodeLength ||
+        pd->VS.BytecodeLength > LD_PW_MAX_SHADER ||
+        pd->PS.BytecodeLength > LD_PW_MAX_SHADER ||
+        pd->GS.BytecodeLength > LD_PW_MAX_SHADER ||
+        !pd->VS.pShaderBytecode || !pd->PS.pShaderBytecode ||
+        (pd->GS.BytecodeLength && !pd->GS.pShaderBytecode) ||
+        (pd->InputLayout.NumElements && !pd->InputLayout.pInputElementDescs)) return 0;
+    memset(out, 0, sizeof(*out));
+    out->root_kind = root_kind;
+    /* Copy semantic fields into zeroed storage: C struct padding must never
+     * decide persistent identity (notably blend write-mask and stencil masks). */
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC* d = &out->desc;
+    d->VS.BytecodeLength = pd->VS.BytecodeLength;
+    d->PS.BytecodeLength = pd->PS.BytecodeLength;
+    d->GS.BytecodeLength = pd->GS.BytecodeLength;
+    d->BlendState.AlphaToCoverageEnable = pd->BlendState.AlphaToCoverageEnable;
+    d->BlendState.IndependentBlendEnable = pd->BlendState.IndependentBlendEnable;
+    for (unsigned i = 0; i < 8; ++i) {
+        const D3D12_RENDER_TARGET_BLEND_DESC* a = &pd->BlendState.RenderTarget[i];
+        D3D12_RENDER_TARGET_BLEND_DESC* b = &d->BlendState.RenderTarget[i];
+        b->BlendEnable = a->BlendEnable; b->LogicOpEnable = a->LogicOpEnable;
+        b->SrcBlend = a->SrcBlend; b->DestBlend = a->DestBlend; b->BlendOp = a->BlendOp;
+        b->SrcBlendAlpha = a->SrcBlendAlpha; b->DestBlendAlpha = a->DestBlendAlpha;
+        b->BlendOpAlpha = a->BlendOpAlpha; b->LogicOp = a->LogicOp;
+        b->RenderTargetWriteMask = a->RenderTargetWriteMask;
+    }
+    d->SampleMask = pd->SampleMask;
+#define LD_PW_RASTER(field) d->RasterizerState.field = pd->RasterizerState.field
+    LD_PW_RASTER(FillMode); LD_PW_RASTER(CullMode); LD_PW_RASTER(FrontCounterClockwise);
+    LD_PW_RASTER(DepthBias); LD_PW_RASTER(DepthBiasClamp); LD_PW_RASTER(SlopeScaledDepthBias);
+    LD_PW_RASTER(DepthClipEnable); LD_PW_RASTER(MultisampleEnable); LD_PW_RASTER(AntialiasedLineEnable);
+    LD_PW_RASTER(ForcedSampleCount); LD_PW_RASTER(ConservativeRaster);
+#undef LD_PW_RASTER
+#define LD_PW_DEPTH(field) d->DepthStencilState.field = pd->DepthStencilState.field
+    LD_PW_DEPTH(DepthEnable); LD_PW_DEPTH(DepthWriteMask); LD_PW_DEPTH(DepthFunc);
+    LD_PW_DEPTH(StencilEnable); LD_PW_DEPTH(StencilReadMask); LD_PW_DEPTH(StencilWriteMask);
+    LD_PW_DEPTH(FrontFace.StencilFailOp); LD_PW_DEPTH(FrontFace.StencilDepthFailOp);
+    LD_PW_DEPTH(FrontFace.StencilPassOp); LD_PW_DEPTH(FrontFace.StencilFunc);
+    LD_PW_DEPTH(BackFace.StencilFailOp); LD_PW_DEPTH(BackFace.StencilDepthFailOp);
+    LD_PW_DEPTH(BackFace.StencilPassOp); LD_PW_DEPTH(BackFace.StencilFunc);
+#undef LD_PW_DEPTH
+    d->InputLayout.NumElements = pd->InputLayout.NumElements;
+    d->IBStripCutValue = pd->IBStripCutValue;
+    d->PrimitiveTopologyType = pd->PrimitiveTopologyType;
+    d->NumRenderTargets = pd->NumRenderTargets;
+    memcpy(d->RTVFormats, pd->RTVFormats, sizeof(d->RTVFormats));
+    d->DSVFormat = pd->DSVFormat; d->SampleDesc.Count = pd->SampleDesc.Count;
+    d->SampleDesc.Quality = pd->SampleDesc.Quality;
+    d->NodeMask = pd->NodeMask; d->Flags = pd->Flags;
+    for (unsigned i = 0; i < pd->InputLayout.NumElements; ++i) {
+        const D3D12_INPUT_ELEMENT_DESC* in = &pd->InputLayout.pInputElementDescs[i];
+        if (!in->SemanticName || strlen(in->SemanticName) >= sizeof(out->semantics[i])) return 0;
+        out->inputs[i].SemanticIndex = in->SemanticIndex;
+        out->inputs[i].Format = in->Format;
+        out->inputs[i].InputSlot = in->InputSlot;
+        out->inputs[i].AlignedByteOffset = in->AlignedByteOffset;
+        out->inputs[i].InputSlotClass = in->InputSlotClass;
+        out->inputs[i].InstanceDataStepRate = in->InstanceDataStepRate;
+        strcpy(out->semantics[i], in->SemanticName);
+    }
+    return 1;
+}
+
+static uint64_t ld_pw_key(const ld_pw_identity* id,
+    const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd)
+{
+    uint64_t k = ld_pw_hash(id, sizeof(*id), 1469598103934665603ull);
+    k = ld_pw_hash(pd->VS.pShaderBytecode, pd->VS.BytecodeLength, k);
+    k = ld_pw_hash(pd->PS.pShaderBytecode, pd->PS.BytecodeLength, k);
+    k = ld_pw_hash(pd->GS.pShaderBytecode, pd->GS.BytecodeLength, k);
+    return k ? k : 1ull;
+}
+
+static int ld_pw_path(char* path, size_t size, uint64_t key)
+{
+    const int n = snprintf(path, size, "%s\\%016llX.gpso", g_ld_pw.dir, (unsigned long long)key);
+    return n > 0 && (size_t)n < size;
+}
+
+static ld_pw_entry* ld_pw_find(uint64_t key)
+{
+    for (unsigned i = (unsigned)(key ^ (key >> 32)) & (LD_PW_HASH - 1u);
+         g_ld_pw.index[i]; i = (i + 1u) & (LD_PW_HASH - 1u)) {
+        ld_pw_entry* e = &g_ld_pw.entries[g_ld_pw.index[i] - 1u];
+        if (e->key == key) return e;
+    }
+    return NULL;
+}
+
+/* Validate before handing anything to D3D12. In particular never load a
+ * pointer from disk. Rebuild every pointer from the bounded owned allocation. */
+static int ld_pw_unpack(ld_pw_record* r, size_t size,
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd, D3D12_INPUT_ELEMENT_DESC il[16])
+{
+    if (size < sizeof(*r) || r->magic != LD_PW_MAGIC || r->version != 1 ||
+        r->header_size != sizeof(*r) || r->payload_size != size - sizeof(*r)) return 0;
+    const ld_pw_identity* id = &r->identity;
+    *pd = id->desc;
+    if (id->root_kind > 1 || id->reserved || pd->pRootSignature ||
+        pd->VS.pShaderBytecode || pd->PS.pShaderBytecode || pd->GS.pShaderBytecode ||
+        pd->HS.pShaderBytecode || pd->DS.pShaderBytecode || pd->HS.BytecodeLength || pd->DS.BytecodeLength ||
+        pd->CachedPSO.pCachedBlob || pd->CachedPSO.CachedBlobSizeInBytes ||
+        pd->StreamOutput.pSODeclaration || pd->StreamOutput.NumEntries ||
+        pd->StreamOutput.pBufferStrides || pd->StreamOutput.NumStrides || pd->StreamOutput.RasterizedStream ||
+        pd->InputLayout.pInputElementDescs || pd->InputLayout.NumElements > 16 ||
+        !pd->VS.BytecodeLength || !pd->PS.BytecodeLength ||
+        pd->VS.BytecodeLength > LD_PW_MAX_SHADER || pd->PS.BytecodeLength > LD_PW_MAX_SHADER ||
+        pd->GS.BytecodeLength > LD_PW_MAX_SHADER ||
+        pd->VS.BytecodeLength + pd->PS.BytecodeLength + pd->GS.BytecodeLength != r->payload_size) return 0;
+    const unsigned char* b = (const unsigned char*)(r + 1);
+    pd->VS.pShaderBytecode = b; b += pd->VS.BytecodeLength;
+    pd->PS.pShaderBytecode = b; b += pd->PS.BytecodeLength;
+    pd->GS.pShaderBytecode = pd->GS.BytecodeLength ? b : NULL;
+    for (unsigned i = 0; i < pd->InputLayout.NumElements; ++i) {
+        if (id->inputs[i].SemanticName || !memchr(id->semantics[i], 0, sizeof(id->semantics[i]))) return 0;
+        il[i] = id->inputs[i];
+        il[i].SemanticName = id->semantics[i];
+    }
+    pd->InputLayout.pInputElementDescs = pd->InputLayout.NumElements ? il : NULL;
+    if (ld_pw_key(id, pd) != r->key) return 0;
+    pd->pRootSignature = g_ld_pw.roots[id->root_kind];
+    return pd->pRootSignature != NULL;
+}
+
+static void ld_pw_prepare(ld_pw_entry* e)
+{
+    if (InterlockedCompareExchange(&e->state, 1, 0) != 0) return;
+    char path[MAX_PATH]; FILE* f = NULL; ld_pw_record* r = NULL;
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+    D3D12_INPUT_ELEMENT_DESC il[16];
+    ID3D12PipelineState* pso = NULL;
+    size_t n = 0; int reserved = 0;
+    if (!ld_pw_path(path, sizeof(path), e->key) || !(f = fopen(path, "rb"))) goto done;
+    if (fseek(f, 0, SEEK_END)) goto done;
+    const long bytes = ftell(f);
+    if (bytes < (long)sizeof(*r) || bytes > (long)(sizeof(*r) + 3u * LD_PW_MAX_SHADER)) goto done;
+    n = (size_t)bytes;
+    AcquireSRWLockExclusive(&g_ld_pw.lock);
+    const int room = g_ld_pw.retained + n <= LD_PW_MAX_RETAINED;
+    if (room) { g_ld_pw.retained += n; reserved = 1; }
+    ReleaseSRWLockExclusive(&g_ld_pw.lock);
+    if (!room) goto done;
+    r = (ld_pw_record*)malloc(n);
+    if (!r) goto done;
+    rewind(f);
+    if (fread(r, 1, n, f) != n || r->key != e->key || !ld_pw_unpack(r, n, &pd, il)) goto done;
+    if (g_ld_pw.library) {
+        WCHAR name[40]; swprintf(name, 40, L"p%016llX", (unsigned long long)r->library_id);
+        if (SUCCEEDED(ld_pw_library_load(g_ld_pw.library, name, &pd, &pso)))
+            InterlockedIncrement(&g_ld_pw.library_hits);
+    }
+    if (!pso) {
+        InterlockedIncrement(&g_ld_pw.driver_builds);
+        g_ld_pw.device->lpVtbl->CreateGraphicsPipelineState(
+            g_ld_pw.device, &pd, &IID_ID3D12PipelineState, (void**)&pso);
+    }
+done:
+    if (f) fclose(f);
+    if (pso) {
+        e->record = r; e->pso = pso;
+        InterlockedIncrement(&g_ld_pw.ready);
+        InterlockedExchange(&e->state, 2);
+    } else {
+        free(r);
+        if (reserved) {
+            AcquireSRWLockExclusive(&g_ld_pw.lock); g_ld_pw.retained -= n; ReleaseSRWLockExclusive(&g_ld_pw.lock);
+        }
+        InterlockedIncrement(&g_ld_pw.rejected);
+        InterlockedExchange(&e->state, 3);
+    }
+    WakeByAddressAll((PVOID)&e->state);
+}
+
+static void ld_pw_write(ld_pw_record* r)
+{
+    char path[MAX_PATH], tmp[MAX_PATH + 48]; int ok = 0;
+    const size_t n = sizeof(*r) + r->payload_size;
+    if (ld_pw_path(path, sizeof(path), r->key)) {
+        snprintf(tmp, sizeof(tmp), "%s.%lu.%lu.tmp", path,
+                 (unsigned long)GetCurrentProcessId(), (unsigned long)GetCurrentThreadId());
+        FILE* f = fopen(tmp, "wb");
+        if (f) {
+            ok = fwrite(r, 1, n, f) == n;
+            if (fclose(f)) ok = 0;
+            if (ok) ok = MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING) != 0;
+            if (!ok) DeleteFileA(tmp); /* only this writer's exact temporary file */
+        }
+    }
+    InterlockedIncrement(ok ? &g_ld_pw.saved : &g_ld_pw.failed_writes);
+    AcquireSRWLockExclusive(&g_ld_pw.lock);
+    g_ld_pw.queued_bytes -= n;
+    ReleaseSRWLockExclusive(&g_ld_pw.lock);
+    free(r);
+}
+
+static DWORD WINAPI ld_pw_worker(LPVOID unused)
+{
+    (void)unused;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    for (;;) {
+        AcquireSRWLockExclusive(&g_ld_pw.lock);
+        while (!g_ld_pw.head && !g_ld_pw.stop)
+            SleepConditionVariableSRW(&g_ld_pw.wake, &g_ld_pw.lock, INFINITE, 0);
+        ld_pw_job* job = g_ld_pw.head;
+        if (job) { g_ld_pw.head = job->next; if (!g_ld_pw.head) g_ld_pw.tail = NULL; }
+        const int stop = g_ld_pw.stop;
+        ReleaseSRWLockExclusive(&g_ld_pw.lock);
+        if (!job) break;
+        if (job->entry) {
+            if (stop) {
+                if (InterlockedCompareExchange(&job->entry->state, 3, 0) == 0)
+                    WakeByAddressAll((PVOID)&job->entry->state);
+            } else ld_pw_prepare(job->entry);
+        } else ld_pw_write(job->record);
+        free(job);
+    }
+    return 0;
+}
+
+static int ld_pw_enqueue(ld_pw_entry* entry, ld_pw_record* record)
+{
+    ld_pw_job* job = (ld_pw_job*)calloc(1, sizeof(*job));
+    if (!job) return 0;
+    job->entry = entry; job->record = record;
+    AcquireSRWLockExclusive(&g_ld_pw.lock);
+    if (g_ld_pw.tail) g_ld_pw.tail->next = job; else g_ld_pw.head = job;
+    g_ld_pw.tail = job;
+    WakeConditionVariable(&g_ld_pw.wake);
+    ReleaseSRWLockExclusive(&g_ld_pw.lock);
+    return 1;
+}
+
+static void ld_pw_start(ID3D12Device* dev, ID3D12PipelineLibrary* lib,
+    ID3D12RootSignature* root, ID3D12RootSignature* point_root, const char* cache_dir)
+{
+    const char* setting = getenv("LD_PSO_PREWARM");
+    if (g_ld_pw.active || (setting && *setting == '0') || !cache_dir || !*cache_dir) return;
+    memset(&g_ld_pw, 0, sizeof(g_ld_pw));
+    InitializeSRWLock(&g_ld_pw.lock); InitializeConditionVariable(&g_ld_pw.wake);
+    const int chars = snprintf(g_ld_pw.dir, sizeof(g_ld_pw.dir), "%s\\pipelines_v1", cache_dir);
+    if (chars < 0 || (size_t)chars >= sizeof(g_ld_pw.dir) ||
+        (!CreateDirectoryA(g_ld_pw.dir, NULL) && GetLastError() != ERROR_ALREADY_EXISTS)) return;
+    g_ld_pw.device = dev; g_ld_pw.library = lib;
+    g_ld_pw.roots[0] = root; g_ld_pw.roots[1] = point_root;
+    unsigned count = 2;
+    setting = getenv("LD_PSO_PREWARM_THREADS");
+    if (setting) { const int n = atoi(setting); if (n >= 1 && n <= 4) count = (unsigned)n; }
+    for (unsigned i = 0; i < count; ++i) {
+        HANDLE t = CreateThread(NULL, 0, ld_pw_worker, NULL, 0, NULL);
+        if (t) g_ld_pw.threads[g_ld_pw.thread_count++] = t;
+    }
+    if (!g_ld_pw.thread_count) return;
+    g_ld_pw.active = 1;
+    char search[MAX_PATH]; snprintf(search, sizeof(search), "%s\\*.gpso", g_ld_pw.dir);
+    WIN32_FIND_DATAA data; HANDLE find = FindFirstFileA(search, &data);
+    if (find != INVALID_HANDLE_VALUE) {
+        do {
+            if (g_ld_pw.entry_count == LD_PW_LIMIT) break;
+            if (data.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) continue;
+            if (strlen(data.cFileName) != 21 || strcmp(data.cFileName + 16, ".gpso")) continue;
+            char* end; const uint64_t key = _strtoui64(data.cFileName, &end, 16);
+            if (!key || end != data.cFileName + 16 || ld_pw_find(key)) continue;
+            ld_pw_entry* e = &g_ld_pw.entries[g_ld_pw.entry_count]; e->key = key;
+            unsigned slot = (unsigned)(key ^ (key >> 32)) & (LD_PW_HASH - 1u);
+            while (g_ld_pw.index[slot]) slot = (slot + 1u) & (LD_PW_HASH - 1u);
+            g_ld_pw.index[slot] = (uint16_t)(++g_ld_pw.entry_count);
+            if (!ld_pw_enqueue(e, NULL)) InterlockedExchange(&e->state, 3);
+        } while (FindNextFileA(find, &data));
+        FindClose(find);
+    }
+    fprintf(stderr, "[pso-prewarm] queued %u exact recipes, %u workers, '%s'\n",
+            g_ld_pw.entry_count, g_ld_pw.thread_count, g_ld_pw.dir);
+}
+
+static ID3D12PipelineState* ld_pw_take(const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd, unsigned root_kind)
+{
+    ld_pw_identity id;
+    if (!g_ld_pw.active || !ld_pw_identity_make(&id, pd, root_kind)) return NULL;
+    const uint64_t key = ld_pw_key(&id, pd);
+    ld_pw_entry* e = ld_pw_find(key);
+    if (!e) { g_ld_pw.misses++; return NULL; }
+    /* Promote a requested queued recipe: prepare it on this thread instead of
+     * waiting behind unrelated tracks. An already running job has sole ownership. */
+    if (InterlockedCompareExchange(&e->state, 0, 0) == 0) ld_pw_prepare(e);
+    LONG state;
+    if ((state = InterlockedCompareExchange(&e->state, 0, 0)) == 1) g_ld_pw.waits++;
+    while ((state = InterlockedCompareExchange(&e->state, 0, 0)) == 1)
+        WaitOnAddress(&e->state, &state, sizeof(state), 1000);
+    if (state != 2 || !e->record || !e->pso) { g_ld_pw.misses++; return NULL; }
+    const ld_pw_record* r = e->record;
+    const unsigned char* b = (const unsigned char*)(r + 1);
+    if (memcmp(&r->identity, &id, sizeof(id)) ||
+        memcmp(b, pd->VS.pShaderBytecode, pd->VS.BytecodeLength) ||
+        memcmp(b + pd->VS.BytecodeLength, pd->PS.pShaderBytecode, pd->PS.BytecodeLength) ||
+        (pd->GS.BytecodeLength && memcmp(b + pd->VS.BytecodeLength + pd->PS.BytecodeLength,
+                                       pd->GS.pShaderBytecode, pd->GS.BytecodeLength))) {
+        g_ld_pw.collisions++; return NULL;
+    }
+    e->pso->lpVtbl->AddRef(e->pso); g_ld_pw.hits++;
+    if (g_ld_pw.hits <= 4 || !(g_ld_pw.hits & 255u))
+        fprintf(stderr, "[pso-prewarm] hits=%llu ready=%ld/%u waits=%llu rejected=%ld\n",
+                (unsigned long long)g_ld_pw.hits, g_ld_pw.ready, g_ld_pw.entry_count,
+                (unsigned long long)g_ld_pw.waits, g_ld_pw.rejected);
+    return e->pso;
+}
+
+static void ld_pw_remember(const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd, unsigned root_kind, uint64_t library_id)
+{
+    ld_pw_identity id;
+    if (!g_ld_pw.active || !ld_pw_identity_make(&id, pd, root_kind)) return;
+    const uint64_t key = ld_pw_key(&id, pd);
+    const int existing = ld_pw_find(key) != NULL;
+    if (!existing && g_ld_pw.entry_count + g_ld_pw.new_records >= LD_PW_LIMIT) {
+        g_ld_pw.skipped_records++; return;
+    }
+    unsigned slot = (unsigned)(key ^ (key >> 32)) & (LD_PW_HASH - 1u);
+    for (unsigned n = 0; n < LD_PW_HASH; ++n) {
+        if (g_ld_pw.recorded[slot] == key) return;
+        if (!g_ld_pw.recorded[slot]) break;
+        slot = (slot + 1u) & (LD_PW_HASH - 1u);
+        if (n + 1 == LD_PW_HASH) return;
+    }
+    const size_t payload = pd->VS.BytecodeLength + pd->PS.BytecodeLength + pd->GS.BytecodeLength;
+    const size_t n = sizeof(ld_pw_record) + payload;
+    AcquireSRWLockExclusive(&g_ld_pw.lock);
+    const int room = g_ld_pw.queued_bytes + n <= LD_PW_MAX_QUEUED;
+    if (room) g_ld_pw.queued_bytes += n;
+    ReleaseSRWLockExclusive(&g_ld_pw.lock);
+    if (!room) { g_ld_pw.skipped_records++; return; }
+    ld_pw_record* r = (ld_pw_record*)calloc(1, n);
+    if (r) {
+        r->magic = LD_PW_MAGIC; r->version = 1; r->header_size = sizeof(*r);
+        r->payload_size = (uint32_t)payload; r->key = key; r->library_id = library_id; r->identity = id;
+        unsigned char* b = (unsigned char*)(r + 1);
+        memcpy(b, pd->VS.pShaderBytecode, pd->VS.BytecodeLength); b += pd->VS.BytecodeLength;
+        memcpy(b, pd->PS.pShaderBytecode, pd->PS.BytecodeLength); b += pd->PS.BytecodeLength;
+        if (pd->GS.BytecodeLength) memcpy(b, pd->GS.pShaderBytecode, pd->GS.BytecodeLength);
+        if (ld_pw_enqueue(NULL, r)) {
+            g_ld_pw.recorded[slot] = key;
+            if (!existing) g_ld_pw.new_records++;
+            return;
+        }
+        free(r);
+    }
+    AcquireSRWLockExclusive(&g_ld_pw.lock); g_ld_pw.queued_bytes -= n; ReleaseSRWLockExclusive(&g_ld_pw.lock);
+    g_ld_pw.skipped_records++;
+}
+
+static void ld_pw_stop(void)
+{
+    if (!g_ld_pw.active) return;
+    AcquireSRWLockExclusive(&g_ld_pw.lock); g_ld_pw.stop = 1;
+    WakeAllConditionVariable(&g_ld_pw.wake); ReleaseSRWLockExclusive(&g_ld_pw.lock);
+    WaitForMultipleObjects(g_ld_pw.thread_count, g_ld_pw.threads, TRUE, INFINITE);
+    for (unsigned i = 0; i < g_ld_pw.thread_count; ++i) CloseHandle(g_ld_pw.threads[i]);
+    fprintf(stderr, "[pso-prewarm] ready=%ld rejected=%ld hits=%llu waits=%llu misses=%llu collisions=%llu saved=%ld writefail=%ld skipped=%llu library=%ld builds=%ld\n",
+            g_ld_pw.ready, g_ld_pw.rejected, (unsigned long long)g_ld_pw.hits,
+            (unsigned long long)g_ld_pw.waits, (unsigned long long)g_ld_pw.misses,
+            (unsigned long long)g_ld_pw.collisions, g_ld_pw.saved, g_ld_pw.failed_writes,
+            (unsigned long long)g_ld_pw.skipped_records, g_ld_pw.library_hits, g_ld_pw.driver_builds);
+    for (unsigned i = 0; i < g_ld_pw.entry_count; ++i) {
+        if (g_ld_pw.entries[i].pso) g_ld_pw.entries[i].pso->lpVtbl->Release(g_ld_pw.entries[i].pso);
+        free(g_ld_pw.entries[i].record);
+    }
+    memset(&g_ld_pw, 0, sizeof(g_ld_pw));
+}
+#endif
diff --git a/libs/video/rsx_render_state_canonical.h b/libs/video/rsx_render_state_canonical.h
new file mode 100644
index 0000000..87d3cc9
--- /dev/null
+++ b/libs/video/rsx_render_state_canonical.h
@@ -0,0 +1,24 @@
+#ifndef RSX_RENDER_STATE_CANONICAL_H
+#define RSX_RENDER_STATE_CANONICAL_H
+/* Included after render_state_t. Only discard fields whose enable gates make
+ * both apply_render_state and shader generation ignore them. In particular
+ * keep depth state and front-face winding: other passes use that information.
+ */
+static void ld_render_state_canonicalize(render_state_t* rs)
+{
+    if (!rs->alpha_test_enable)
+        rs->alpha_func = rs->alpha_ref_raw = rs->alpha_ref_format = 0;
+    if (!rs->blend_enable) {
+        rs->sf_rgb = rs->df_rgb = rs->sf_a = rs->df_a = 0;
+        rs->eq_rgb = rs->eq_a = 0;
+    }
+    if (!rs->cull_enable) rs->cull_face = 0;
+    if (!rs->stencil_enable) {
+        rs->stencil_two_sided = 0;
+        rs->s_func = rs->s_func_mask = rs->s_write_mask = 0;
+        rs->s_fail = rs->s_zfail = rs->s_zpass = 0;
+    }
+    if (!rs->stencil_enable || !rs->stencil_two_sided)
+        rs->bs_func = rs->bs_fail = rs->bs_zfail = rs->bs_zpass = 0;
+}
+#endif
diff --git a/libs/video/rsx_texture_typed.h b/libs/video/rsx_texture_typed.h
new file mode 100644
index 0000000..97fe1e6
--- /dev/null
+++ b/libs/video/rsx_texture_typed.h
@@ -0,0 +1,150 @@
+/* Native texture payloads for the D3D12 live renderer.
+ * Keep normalized 16-bit and floating-point texels at their original precision;
+ * the SRV crossbar does the channel replication/remap on the GPU. The CPU only
+ * rearranges guest byte order and Morton addressing, never clamps float values.
+ * Format/component facts: RPCS3 VKFormats.cpp get_component_mapping and
+ * get_compatible_sampler_format; D3D12_SHADER_COMPONENT_MAPPING.
+ */
+#ifndef PS3RECOMP_RSX_TEXTURE_TYPED_H
+#define PS3RECOMP_RSX_TEXTURE_TYPED_H
+
+#include "ps3emu/ps3types.h"
+#include <dxgiformat.h>
+#include <string.h>
+
+typedef struct {
+    DXGI_FORMAT dxgi;
+    u32 bytes, component_bytes;
+    u8 argb[4]; /* source ARGB selector -> raw uploaded component, 4=0, 5=1 */
+} rsx_typed_texture;
+
+static inline int rsx_typed_texture_format(u32 format, rsx_typed_texture* f)
+{
+    memset(f, 0, sizeof(*f));
+    f->component_bytes = 1;
+    f->argb[0] = 3; f->argb[1] = 0; f->argb[2] = 1; f->argb[3] = 2;
+    switch (format & 0x9Fu) {
+    case 0x81: /* B8 */
+        f->dxgi = DXGI_FORMAT_R8_UNORM; f->bytes = 1;
+        f->argb[0] = 5; f->argb[1] = f->argb[2] = f->argb[3] = 0; break;
+    case 0x85: case 0x9E: /* raw guest A,R,G,B bytes; no CPU colour shuffle */
+        f->dxgi = DXGI_FORMAT_R8G8B8A8_UNORM; f->bytes = 4;
+        f->argb[0] = (format & 0x9Fu) == 0x9Eu ? 5 : 0;
+        f->argb[1] = 1; f->argb[2] = 2; f->argb[3] = 3; break;
+    case 0x8B: /* G8B8: two physical bytes, presented as G,R,G,R */
+        f->dxgi = DXGI_FORMAT_R8G8_UNORM; f->bytes = 2;
+        f->argb[0] = f->argb[2] = 1; f->argb[1] = f->argb[3] = 0; break;
+    case 0x92: /* DEPTH16 */
+        f->dxgi = DXGI_FORMAT_R16_UNORM; f->bytes = f->component_bytes = 2;
+        memset(f->argb, 0, sizeof(f->argb)); break;
+    case 0x94: /* X16 is UNORM, not half-float */
+        f->dxgi = DXGI_FORMAT_R16_UNORM; f->bytes = f->component_bytes = 2;
+        f->argb[0] = f->argb[2] = 0; f->argb[1] = f->argb[3] = 5; break;
+    case 0x95: /* Y16_X16 */
+        f->dxgi = DXGI_FORMAT_R16G16_UNORM; f->bytes = 4; f->component_bytes = 2;
+        f->argb[0] = f->argb[2] = 1; f->argb[1] = f->argb[3] = 0; break;
+    case 0x9A:
+        f->dxgi = DXGI_FORMAT_R16G16B16A16_FLOAT; f->bytes = 8; f->component_bytes = 2; break;
+    case 0x9B:
+        f->dxgi = DXGI_FORMAT_R32G32B32A32_FLOAT; f->bytes = 16; f->component_bytes = 4; break;
+    case 0x9C:
+        f->dxgi = DXGI_FORMAT_R32_FLOAT; f->bytes = f->component_bytes = 4;
+        memset(f->argb, 0, sizeof(f->argb)); break;
+    case 0x9F: /* Y16_X16_FLOAT presents X,Y,X,Y in ARGB order */
+        f->dxgi = DXGI_FORMAT_R16G16_FLOAT; f->bytes = 4; f->component_bytes = 2;
+        f->argb[0] = f->argb[2] = 0; f->argb[1] = f->argb[3] = 1; break;
+    default: return 0;
+    }
+    return 1;
+}
+
+/* GPU depth snapshots store one float rather than guest D16/X16 bytes. Keep
+ * the guest texture view's crossbar (including X16 constant lanes) intact. */
+static inline int rsx_typed_depth_snapshot_format(u32 format, rsx_typed_texture* f)
+{
+    const u32 base = format & 0x9Fu;
+    if (base != 0x90u && base != 0x92u && base != 0x94u) return 0;
+    rsx_typed_texture_format(base == 0x94u ? 0x94u : 0x92u, f);
+    f->dxgi = DXGI_FORMAT_R32_FLOAT;
+    f->bytes = f->component_bytes = 4;
+    return 1;
+}
+
+static inline u32 rsx_typed_texture_control(u32 format, u32 remap)
+{
+    /* X16/Y16_X16 crossbars select 16-bit blocks. The high-word override
+     * makes the second component available only as alpha. */
+    const u32 base = format & 0x9Fu;
+    if (base == 0x9Au || base == 0x9Bu || base == 0x9Cu) {
+        /* Real RSX float formats keep their channel order. The force-zero /
+         * force-one fields remain meaningful, while selectors are ignored. */
+        remap = (remap & ~0xFFu) | 0xE4u;
+    } else if (base == 0x9Fu) {
+        remap = (remap & ~0xFFu) | ((remap >> 16) ? 0x56u : 0x66u);
+    } else if (base == 0x94u || base == 0x95u) {
+        u32 lo = remap & 0xFFu;
+        const int override = (remap >> 16) != 0;
+        if (lo == 0xE4u) lo = override ? 0x56u : 0x66u;
+        else if (lo == 0x4Eu) lo = override ? 0xA9u : 0x99u;
+        else if (lo == 0xEEu) lo = 0xAAu;
+        else if (lo == 0x44u) lo = 0x55u;
+        remap = (remap & ~0xFFu) | lo;
+    }
+    return remap;
+}
+
+static inline u32 rsx_typed_texture_mapping(const rsx_typed_texture* f,
+                                           u32 format, u32 remap)
+{
+    remap = rsx_typed_texture_control(format, remap);
+    static const u8 rgba_to_argb[4] = { 1, 2, 3, 0 };
+    u32 mapping = 1u << 12; /* D3D12 always-set component mapping bit */
+    for (u32 lane = 0; lane < 4; ++lane) {
+        const u32 comp = rgba_to_argb[lane];
+        const u32 op = (remap >> (8u + comp * 2u)) & 3u;
+        const u32 sel = (remap >> (comp * 2u)) & 3u;
+        const u32 value = op == 0 ? 4u : op == 1 ? 5u : f->argb[sel];
+        mapping |= value << (lane * 3u);
+    }
+    return mapping;
+}
+
+/* The rows may have a border and a larger Morton backing image. The caller
+ * checks the complete guest span before calling. Destination rows are packed.
+ */
+static inline void rsx_typed_texture_decode(u8* dst, const u8* src,
+    u32 width, u32 height, u32 pitch, int linear,
+    u32 log2w, u32 log2h, u32 border, const rsx_typed_texture* f)
+{
+    u32 xmask = 0, shift = 0;
+    for (u32 bit = 0; bit < log2w || bit < log2h; ++bit) {
+        if (bit < log2w) { xmask |= 1u << shift; ++shift; }
+        if (bit < log2h) ++shift;
+    }
+    for (u32 y = 0; y < height; ++y) {
+        u8* row = dst + (size_t)y * width * f->bytes;
+        if (linear && f->component_bytes == 1) {
+            memcpy(row, src + (size_t)y * pitch, (size_t)width * f->bytes);
+            continue;
+        }
+        u32 yoff = 0, xoff = 0;
+        if (!linear) {
+            u32 yy = y + border, xx = border, dstbit = 0;
+            for (u32 bit = 0; bit < log2w || bit < log2h; ++bit) {
+                if (bit < log2w) { xoff |= ((xx >> bit) & 1u) << dstbit; ++dstbit; }
+                if (bit < log2h) { yoff |= ((yy >> bit) & 1u) << dstbit; ++dstbit; }
+            }
+        }
+        for (u32 x = 0; x < width; ++x) {
+            const u8* p = src + (linear ? (size_t)y * pitch + (size_t)x * f->bytes
+                                      : (size_t)(xoff | yoff) * f->bytes);
+            u8* q = row + (size_t)x * f->bytes;
+            for (u32 c = 0; c < f->bytes; c += f->component_bytes)
+                for (u32 b = 0; b < f->component_bytes; ++b)
+                    q[c + b] = p[c + f->component_bytes - 1u - b];
+            xoff = (xoff - xmask) & xmask;
+        }
+    }
+}
+
+#endif
diff --git a/libs/video/rsx_vertex_pull.h b/libs/video/rsx_vertex_pull.h
new file mode 100644
index 0000000..123b3b5
--- /dev/null
+++ b/libs/video/rsx_vertex_pull.h
@@ -0,0 +1,135 @@
+/* Dense array snapshots for the optional live GPU vertex decoder.
+ * This is storage conversion only; the NV40 vertex program is unchanged.
+ * Snapshot bytes must remain immutable until the referencing GPU fence.
+ */
+#ifndef PS3RECOMP_RSX_VERTEX_PULL_H
+#define PS3RECOMP_RSX_VERTEX_PULL_H
+#include "rsx_vertex_compact.h"
+#include "rsx_vertex_formats.h"
+#include <stdint.h>
+#include <string.h>
+
+/* Little-endian host metadata; the payload retains guest big-endian bytes.
+ * Keep the shader offsets below in sync. No host pointers enter the buffer. */
+typedef struct rsx_vertex_pull_attr {
+    u32 offset, stride, type, size;
+    float fallback[4];
+} rsx_vertex_pull_attr;
+typedef char rsx_vertex_pull_attr_must_be_32_bytes[(sizeof(rsx_vertex_pull_attr) == 32) ? 1 : -1];
+typedef struct rsx_vertex_pull_range {
+    const u8* source;
+    u32 bytes, offset;
+} rsx_vertex_pull_range;
+typedef struct rsx_vertex_pull_plan {
+    rsx_vertex_pull_attr attr[16];
+    rsx_vertex_pull_range ranges[16];
+    u32 range_count, bytes;
+} rsx_vertex_pull_plan;
+
+/* first already includes the guest base index. The native IB is rebased to
+ * zero, so SV_VertexID needs neither guest base nor first added a second time.
+ * Return zero BEFORE upload/recording for any unsupported or invalid range. */
+static inline int rsx_vertex_pull_plan_init(rsx_vertex_pull_plan* out,
+    const rsx_vertex_fetch_plan* pl, u32 first, u32 count)
+{
+    if (!out || !pl || !pl->guest_ptr || pl->inline_data || !count ||
+        (u64)first + count > 0x100000ull) return 0;
+    memset(out, 0, sizeof(*out));
+    const u8* sources[16] = {0};
+    for (u32 slot = 0; slot < pl->layout.count; ++slot) {
+        const u32 a = pl->layout.attrs[slot];
+        if (a >= 16) return 0;
+        const rsx_vertex_fetch_attr* f = &pl->attr[a];
+        rsx_vertex_pull_attr* d = &out->attr[a];
+        memcpy(d->fallback, f->default_value, 16);
+        if (!f->desc.type || !f->desc.size) continue;
+        if (f->desc.type > 7 || f->desc.size > 4 || !f->elem_size || !f->stride ||
+            !rsx_vertex_freq_plain(f->desc.frequency, (pl->divider_mask >> a) & 1u)) return 0;
+        const u64 start = rsx_dsp_resolve_vertex_offset(pl->base_offset, f->desc.offset) +
+            (u64)first * f->stride;
+        const u64 end = start + (u64)(count - 1u) * f->stride + f->elem_size;
+        if (end > 0x100000000ull || end <= start || end - start > UINT32_MAX ||
+            (f->desc.location == 0 && end > 0x10000000ull)) return 0;
+        const u8* p = pl->guest_ptr(pl->guest_user, f->desc.location, (u32)start, (u32)(end - start));
+        if (!p || pl->guest_ptr(pl->guest_user, f->desc.location, (u32)(end - 1u), 1) !=
+            p + (size_t)(end - start - 1u)) return 0;
+        d->stride = f->stride; d->type = f->desc.type; d->size = f->desc.size;
+        sources[a] = p;
+        rsx_vertex_pull_range r = { p, (u32)(end - start), 0 };
+        u32 at = out->range_count++;
+        while (at && (uintptr_t)out->ranges[at - 1].source > (uintptr_t)p) {
+            out->ranges[at] = out->ranges[at - 1]; --at;
+        }
+        out->ranges[at] = r;
+    }
+    u32 merged = 0;
+    for (u32 i = 0; i < out->range_count; ++i) {
+        const rsx_vertex_pull_range r = out->ranges[i];
+        if (merged && (uintptr_t)r.source <= (uintptr_t)out->ranges[merged - 1].source + out->ranges[merged - 1].bytes) {
+            rsx_vertex_pull_range* prev = &out->ranges[merged - 1];
+            const uintptr_t end = (uintptr_t)r.source + r.bytes;
+            if (end > (uintptr_t)prev->source + prev->bytes) {
+                if (end - (uintptr_t)prev->source > UINT32_MAX) return 0;
+                prev->bytes = (u32)(end - (uintptr_t)prev->source);
+            }
+        } else out->ranges[merged++] = r;
+    }
+    out->range_count = merged;
+    u64 bytes = sizeof(out->attr);
+    for (u32 i = 0; i < merged; ++i) {
+        rsx_vertex_pull_range* r = &out->ranges[i];
+        r->offset = (u32)bytes;
+        /* Four zero bytes protect the second aligned word of an unaligned
+         * load. Never read padding from guest memory. */
+        bytes += ((u64)r->bytes + 7u) & ~3ull;
+        if (bytes > UINT32_MAX) return 0;
+    }
+    for (u32 a = 0; a < 16; ++a) if (sources[a]) {
+        for (u32 i = 0; i < merged; ++i) {
+            const rsx_vertex_pull_range* r = &out->ranges[i];
+            const uintptr_t delta = (uintptr_t)sources[a] - (uintptr_t)r->source;
+            if (delta < r->bytes) { out->attr[a].offset = r->offset + (u32)delta; break; }
+        }
+        if (!out->attr[a].offset) return 0;
+    }
+    bytes = (bytes + 15u) & ~15ull;
+    if (bytes > UINT32_MAX) return 0;
+    out->bytes = (u32)bytes;
+    return merged != 0;
+}
+
+static inline void rsx_vertex_pull_snapshot(const rsx_vertex_pull_plan* pl, u8* destination)
+{
+    memcpy(destination, pl->attr, sizeof(pl->attr));
+    for (u32 i = 0; i < pl->range_count; ++i) {
+        const rsx_vertex_pull_range* r = &pl->ranges[i];
+        const u32 next = i + 1 < pl->range_count ? pl->ranges[i + 1].offset : pl->bytes;
+        memcpy(destination + r->offset, r->source, r->bytes);
+        memset(destination + r->offset + r->bytes, 0, next - r->offset - r->bytes);
+    }
+}
+
+/* t19 is vertex texture unit 3. Callers must retain the ordinary IA path
+ * whenever that unit is enabled; root-signature/cache formats stay intact. */
+static const char rsx_vertex_pull_hlsl[] =
+    "ByteAddressBuffer rsx_vpull : register(t19);\n"
+    "uint vp_byte(uint p) { return (rsx_vpull.Load(p & ~3u) >> ((p & 3u)*8u)) & 255u; }\n"
+    "uint vp_be16(uint p) { return (vp_byte(p)<<8u) | vp_byte(p+1u); }\n"
+    "uint vp_be32(uint p) { uint q=p&~3u, s=(p&3u)*8u; uint x=rsx_vpull.Load(q);"
+    " if(s!=0u) x=(x>>s)|(rsx_vpull.Load(q+4u)<<(32u-s));"
+    " return ((x&255u)<<24u)|((x&65280u)<<8u)|((x>>8u)&65280u)|(x>>24u); }\n"
+    "float vp_half(uint h) { uint s=(h&32768u)<<16u, e=(h>>10u)&31u, m=h&1023u;"
+    " return asfloat(e==0u?s:(e==31u?(s|2139095040u|(m<<13u)):(s|((e+112u)<<23u)|(m<<13u)))); }\n"
+    "float4 vp_pull(uint a, uint id) { uint4 d=rsx_vpull.Load4(a*32u);"
+    " if(d.z==0u) return asfloat(rsx_vpull.Load4(a*32u+16u));"
+    " uint p=d.x+id*d.y; float4 v=float4(0,0,0,1);"
+    " if(d.z==6u) { uint x=vp_be32(p); int sx=(int)(x<<21u)>>21, sy=(int)(x<<10u)>>21, sz=(int)x>>22;"
+    " return float4((float)sx/1023.0,(float)sy/1023.0,(float)sz/511.0,1); }"
+    " [unroll] for(uint c=0;c<4u;c++) if(c<d.w) {"
+    " if(d.z==2u) v[c]=asfloat(vp_be32(p+c*4u));"
+    " else if(d.z==3u) v[c]=vp_half(vp_be16(p+c*2u));"
+    " else if(d.z==4u) v[c]=(float)vp_byte(p+c)/255.0;"
+    " else if(d.z==7u) v[c]=(float)vp_byte(p+c);"
+    " else { int x=(int)(vp_be16(p+c*2u)<<16u)>>16; v[c]=d.z==1u?(float)x/32767.0:(float)x; }"
+    " } return v; }\n";
+#endif
