     CHECK(vt.offset == 0x00100000u, "vertex unit 1 offset 0x80100000 decodes to 0x00100000 (got 0x%08X)", vt.offset);
 
+    /* Same cube payload address, distinct hardware views. Resolving the border
+     * from the first matching address loses unit 1's layout and walks the wrong
