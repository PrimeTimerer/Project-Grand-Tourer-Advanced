+static void vm_write64(u32 a,u64 v){vm_write32(a,(u32)(v>>32));vm_write32(a+4,(u32)v);}
+static u32 read32(u32 a){return (u32)memory[a]<<24|(u32)memory[a+1]<<16|(u32)memory[a+2]<<8|memory[a+3];}
+#include "../codec_callbacks.h"
+#define CHECK(x) do{if(!(x)){fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x);exit(1);}}while(0)
+static CodecCallbackOwner owner;
+static SRWLOCK guest_mutex=SRWLOCK_INIT;
+static HANDLE entered,delivered,cancelled;
+static volatile LONG count;
+static unsigned order[64];
+static u32 generation_after_cancel;
+static int disable_on_cancel;
+static void callback(u32 opd,u64 id,u64 b,u64 c,u64 d,u64 e,u64 f,u64 g,u64 h)
+{
+ CHECK(opd==0x1000 && !(b|c|d|e|f|g|h));SetEvent(entered);
+ AcquireSRWLockExclusive(&guest_mutex);
+ CHECK(read32(16)==(u32)id && read32(28)==(u32)(id+100));
+ order[count]=(unsigned)id;InterlockedIncrement(&count);
+ if(id==40)codec_cb_cancel(&owner,1);
+ ReleaseSRWLockExclusive(&guest_mutex);SetEvent(delivered);
+}
+ps3_guest_caller_fn g_ps3_guest_caller=callback;
+static void post(u32 gen,u32 id){u64 args[8]={id};CHECK(codec_cb_post(&owner,gen,0x1000,args,16,id,id+100));}
+static void wait_count(LONG want){ULONGLONG deadline=GetTickCount64()+3000;while(InterlockedCompareExchange(&count,0,0)<want){CHECK(GetTickCount64()<deadline);WaitForSingleObject(delivered,10);}}
+static DWORD WINAPI cancel_thread(LPVOID ignored){(void)ignored;generation_after_cancel=codec_cb_cancel(&owner,disable_on_cancel);SetEvent(cancelled);return 0;}
+static HANDLE launch_cancel(int disable){disable_on_cancel=disable;ResetEvent(cancelled);HANDLE thread=CreateThread(0,0,cancel_thread,0,0,0);CHECK(thread);return thread;}
+int main(void)
+{
+ entered=CreateEvent(0,FALSE,FALSE,0);delivered=CreateEvent(0,FALSE,FALSE,0);cancelled=CreateEvent(0,TRUE,FALSE,0);CHECK(entered&&delivered&&cancelled);
+ u32 gen=codec_cb_open(&owner);CHECK(gen);
+ AcquireSRWLockExclusive(&guest_mutex);ULONGLONG start=GetTickCount64();post(gen,1);post(gen,2);post(gen,3);
+ CHECK(GetTickCount64()-start<100 && WaitForSingleObject(entered,1000)==WAIT_OBJECT_0 && count==0);
+ ReleaseSRWLockExclusive(&guest_mutex);wait_count(3);CHECK(order[0]==1&&order[1]==2&&order[2]==3);
+ ResetEvent(entered);AcquireSRWLockExclusive(&guest_mutex);post(gen,10);CHECK(WaitForSingleObject(entered,1000)==WAIT_OBJECT_0);post(gen,11);
+ HANDLE thread=launch_cancel(0);CHECK(WaitForSingleObject(cancelled,30)==WAIT_TIMEOUT);ReleaseSRWLockExclusive(&guest_mutex);CHECK(WaitForSingleObject(thread,1000)==WAIT_OBJECT_0);CloseHandle(thread);
+ post(gen,12);gen=generation_after_cancel;post(gen,13);wait_count(5);CHECK(order[3]==10&&order[4]==13);
+ ResetEvent(entered);AcquireSRWLockExclusive(&guest_mutex);post(gen,20);CHECK(WaitForSingleObject(entered,1000)==WAIT_OBJECT_0);post(gen,21);
+ thread=launch_cancel(1);CHECK(WaitForSingleObject(cancelled,30)==WAIT_TIMEOUT);ReleaseSRWLockExclusive(&guest_mutex);CHECK(WaitForSingleObject(thread,1000)==WAIT_OBJECT_0);CloseHandle(thread);CHECK(count==6&&order[5]==20&&!owner.enabled&&!owner.active);
+ post(gen,22);gen=codec_cb_open(&owner);post(gen,30);wait_count(7);CHECK(order[6]==30);
+ post(gen,40);wait_count(8);codec_cb_cancel(&owner,1);CHECK(count==8&&!owner.active&&!owner.enabled);
+ puts("PASS asynchronous guest-mutex reentry, FIFO, message identity, generation cancellation, close wait, self-close, reopen");return 0;
+}
