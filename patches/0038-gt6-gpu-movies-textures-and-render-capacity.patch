diff --git a/libs/video/gcm_blocked_write_watch.h b/libs/video/gcm_blocked_write_watch.h
new file mode 100644
index 0000000..4c15f83
--- /dev/null
+++ b/libs/video/gcm_blocked_write_watch.h
@@ -0,0 +1,82 @@
+/* One FIFO reader publishes its blocked word; many completed DMA writers
+ * may report overlapping ranges. This is a wake hint, never permission to
+ * consume a command. Only the FIFO reader dereferences guest memory.
+ *
+ * Publication carries a generation: a writer holding an old snapshot cannot
+ * disarm a later watch, even if the same address/value was reused. Fields are
+ * atomic to make concurrent snapshots defined; the generation validates that
+ * they came from one publication. No allocation, lock, or busy wait is used.
+ */
+#ifndef GCM_BLOCKED_WRITE_WATCH_H
+#define GCM_BLOCKED_WRITE_WATCH_H
+#include <stdint.h>
+#include <stdatomic.h>
+
+typedef struct gcm_blocked_write_watch {
+    _Atomic(uint64_t) generation; /* low bit: armed; upper bits: publication */
+    _Atomic(uint32_t) address, value, kind;
+} gcm_blocked_write_watch;
+
+typedef struct gcm_blocked_write_ticket {
+    uint64_t generation;
+    uint32_t address, value, kind; /* 1: semaphore acquire; 2: self-JUMP */
+} gcm_blocked_write_ticket;
+
+/* The FIFO reader is the sole arm/clear caller. It already holds its walker
+ * lock. Producers can only clear the low bit with an exact-generation CAS. */
+static inline void gcm_bww_clear(gcm_blocked_write_watch* watch)
+{
+    const uint64_t current = atomic_load_explicit(&watch->generation, memory_order_relaxed);
+    atomic_store_explicit(&watch->generation, (current + 2u) & ~UINT64_C(1), memory_order_release);
+}
+
+static inline gcm_blocked_write_ticket gcm_bww_arm(gcm_blocked_write_watch* watch,
+                                                  uint32_t address, uint32_t value,
+                                                  uint32_t kind)
+{
+    gcm_blocked_write_ticket ticket;
+    gcm_bww_clear(watch);
+    ticket.generation = atomic_load_explicit(&watch->generation, memory_order_relaxed) | 1u;
+    ticket.address = address; ticket.value = value; ticket.kind = kind;
+    /* Acquiring any newer field also observes the preceding disarm. This
+     * makes the final generation check reject mixed snapshots on weak hosts. */
+    atomic_store_explicit(&watch->address, address, memory_order_release);
+    atomic_store_explicit(&watch->value, value, memory_order_release);
+    atomic_store_explicit(&watch->kind, kind, memory_order_release);
+    atomic_store_explicit(&watch->generation, ticket.generation, memory_order_release);
+    return ticket;
+}
+
+static inline int gcm_bww_snapshot(const gcm_blocked_write_watch* watch,
+                                    gcm_blocked_write_ticket* ticket)
+{
+    ticket->generation = atomic_load_explicit(&watch->generation, memory_order_acquire);
+    if (!(ticket->generation & 1u)) return 0;
+    ticket->address = atomic_load_explicit(&watch->address, memory_order_acquire);
+    ticket->value = atomic_load_explicit(&watch->value, memory_order_acquire);
+    ticket->kind = atomic_load_explicit(&watch->kind, memory_order_acquire);
+    return ticket->generation == atomic_load_explicit(&watch->generation, memory_order_acquire);
+}
+
+static inline int gcm_bww_claim(gcm_blocked_write_watch* watch,
+                               const gcm_blocked_write_ticket* ticket)
+{
+    uint64_t expected = ticket->generation;
+    return (expected & 1u) && atomic_compare_exchange_strong_explicit(
+        &watch->generation, &expected, expected & ~UINT64_C(1),
+        memory_order_acq_rel, memory_order_acquire);
+}
+
+/* Returns the kind only for the one producer that owns this wake. The write
+ * has finished before this call. Do not dereference ticket.address here: the
+ * reader may already have cleared it and unmapped/reused the old storage. */
+static inline unsigned gcm_bww_written(gcm_blocked_write_watch* watch,
+                                      uint32_t address, uint32_t size)
+{
+    gcm_blocked_write_ticket ticket;
+    if (!size || !gcm_bww_snapshot(watch, &ticket)) return 0;
+    if ((uint64_t)address >= (uint64_t)ticket.address + 4u ||
+        (uint64_t)address + size <= ticket.address) return 0;
+    return gcm_bww_claim(watch, &ticket) ? ticket.kind : 0;
+}
+#endif
