+    CHECK(cellVdecStartSeq(1)==0);fail_decode=1;
+    CHECK(cellVdecDecodeAu(1,0,(CellVdecAuInfo*)0x1200)==(s32)CELL_VDEC_ERROR_FATAL);wait_for(&errors,1);
