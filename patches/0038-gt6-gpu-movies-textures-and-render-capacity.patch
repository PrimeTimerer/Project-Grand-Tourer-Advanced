index 0000000..b74db07
--- /dev/null
+++ b/libs/codec/tests/test_gt6_movie_post_spu.cpp
@@ -0,0 +1,124 @@
+/* Independent original-SPU oracle for GT6's movie type-8 postprocess.
+ * Only the exact embedded, already-lifted image runs. DMA copies real input
+ * bytes to LS and real output back; unknown channels/commands are fatal.
+ * No game process, player files, scheduler, renderer, or codec is linked. */
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cstdint>
+#include <vector>
+#include <cassert>
+#include "../../../../build-release/generated_spu/spu_3f8bd8e4cf635018a2eefb22cffb703b691f6097627dd6cb049a81857812c9aa/spu_recomp.c"
+
+static std::vector<uint8_t> guest(32 * 1024 * 1024);
+static uint32_t lsa, eal, eah, dma_size, tag_mask;
+static uint64_t dma_get, dma_put;
+int g_spu_ls_watch_n = 0;
+volatile int g_spu_direct = 1;
+uint8_t g_spu_stack_reset_hint[1024] = {};
+SPU_THREAD_LOCAL void (*g_spu_trampoline_fn)(spu_context*) = nullptr;
+void spu_ls_watch_slow(uint32_t, int, const uint8_t*, uint32_t, uint32_t) { abort(); }
+void spu_overlay_note_ls_write(spu_context*, uint32_t, uint32_t) { abort(); }
+void spu_img_restore(spu_context* c, int32_t image) { c->image_id = image; }
+void spu_direct_init() {}
+void spu_stop(spu_context*) { abort(); }
+void spu_halt(spu_context*) { abort(); }
+void spu_indirect_branch(spu_context* c)
+{
+    for (const auto& entry : spu_function_table)
+        if (entry.addr == c->pc) { entry.func(c); return; }
+    std::fprintf(stderr, "unexpected indirect pc=%08x\n", c->pc); abort();
+}
+void spu_drain_call(spu_context* c, uint32_t ret)
+{
+    while (g_spu_trampoline_fn) {
+        auto fn = g_spu_trampoline_fn; g_spu_trampoline_fn = nullptr; fn(c);
+    }
+    if (c->pc != ret) { std::fprintf(stderr, "return pc=%08x expected=%08x\n", c->pc, ret); abort(); }
+}
+void spu_register_function(uint32_t, void (*)(spu_context*)) {}
+void spu_wrch(spu_context* c, uint32_t ch, u128 v)
+{
+    const uint32_t x = v._u32[0];
+    switch (ch) {
+    case MFC_LSA: lsa = x; return;
+    case MFC_EAL: eal = x; return;
+    case MFC_EAH: eah = x; return;
+    case MFC_Size: dma_size = x; return;
+    case MFC_TagID: return;
+    case MFC_WrTagMask: tag_mask = x; return;
+    case MFC_WrTagUpdate: return;
+    case MFC_Cmd:
+        if (eah || uint64_t(eal) + dma_size > guest.size() || uint64_t(lsa) + dma_size > SPU_LS_SIZE) abort();
+        if (getenv("GT6_POST_ORACLE_TRACE")) fprintf(stderr, "DMA %02x LS%05x EA%08x size%u\n",x,lsa,eal,dma_size);
+        if (x == 0x40) { memcpy(c->ls + lsa, guest.data() + eal, dma_size); dma_get += dma_size; return; }
+        if (x == 0x20) { memcpy(guest.data() + eal, c->ls + lsa, dma_size); dma_put += dma_size; return; }
+        std::fprintf(stderr, "unexpected DMA cmd=%x\n", x); abort();
+    default: std::fprintf(stderr, "unexpected write channel=%u\n", ch); abort();
+    }
+}
+u128 spu_rdch(spu_context*, uint32_t ch)
+{
+    u128 result{};
+    if (ch != MFC_RdTagStat) { std::fprintf(stderr, "unexpected read channel=%u\n", ch); abort(); }
+    result._u32[0] = tag_mask; return result;
+}
+uint32_t spu_rchcnt(spu_context*, uint32_t) { abort(); }
+static uint32_t be32(const uint8_t* p) { return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3]; }
+static std::vector<uint8_t> load(const char* path)
+{
+    FILE* f = fopen(path, "rb"); if (!f) { perror(path); exit(2); }
+    fseek(f, 0, SEEK_END); const long n = ftell(f); rewind(f);
+    std::vector<uint8_t> data(n); if (fread(data.data(), 1, n, f) != size_t(n)) abort(); fclose(f); return data;
+}
+static std::vector<uint8_t> elf;
+static void run(uint32_t w, uint32_t h, uint32_t ow, uint32_t oh, uint32_t flags)
+{
+    auto c = new spu_context;
+    spu_context_init(c, 0);
+    for (unsigned i = 0, n = unsigned(elf[44]) << 8 | elf[45], off = be32(elf.data() + 28); i < n; ++i) {
+        const uint8_t* p = elf.data() + off + i * 32;
+        if (be32(p) != 1) continue;
+        const uint32_t file = be32(p + 4), addr = be32(p + 8), size = be32(p + 16);
+        if (uint64_t(file) + size > elf.size() || uint64_t(addr) + size > SPU_LS_SIZE) abort();
+        memcpy(c->ls + addr, elf.data() + file, size);
+    }
+    c->image_id = 335068558; c->steps = 1; c->host_depth = 1;
+    c->gpr[0]._u32[0] = 0x3fff0; c->gpr[1]._u32[0] = 0x3ff00;
+    c->gpr[3]._u32[0] = 0x10000; c->gpr[4]._u32[0] = 0x1000000;
+    c->gpr[5]._u32[0] = w; c->gpr[6]._u32[0] = h;
+    c->gpr[7]._u32[0] = ow; c->gpr[8]._u32[0] = oh; c->gpr[9]._u32[0] = flags;
+    // Give the original leaf its own 64 KiB scratch allocation and DMA tags.
+    spu_ls_write32(c, 0x6e80, 0x10000);
+    spu_ls_write32(c, 0x6e50, 1); spu_ls_write32(c, 0x6e60, 2);
+    g_spu_trampoline_fn = nullptr;
+    spu_3f8bd8e4cf635018a2eefb22cffb703b691f6097627dd6cb049a81857812c9aa_spu_func_00003980(c);
+    spu_drain_call(c, 0x3fff0);
+    delete c;
+}
+int main(int argc, char** argv)
+{
+    if (argc != 5 && argc != 6) { fprintf(stderr, "usage: test image.elf descriptor.bin input.bin expected.bin|- [oracle.bin]\n"); return 2; }
+    g_spu_ls_rdiag = g_spu_ls_wdiag = 0;
+    elf = load(argv[1]); auto desc = load(argv[2]); auto in = load(argv[3]);
+    if (desc.size() != 512 || be32(desc.data()) != 8) return 3;
+    if (in.size() > 15 * 1024 * 1024) return 4;
+    memcpy(guest.data() + 0x10000, in.data(), in.size());
+    const uint32_t w = be32(desc.data()+16), h = be32(desc.data()+20), ow = be32(desc.data()+24), oh = be32(desc.data()+28);
+    if (uint64_t(ow)*oh*4 > 16 * 1024 * 1024) return 5;
+    memset(guest.data() + 0x1000000, 0xcd, ow*oh*4);
+    for (unsigned j=0; j<4; ++j) run(w,h,ow,oh,be32(desc.data()+j*128+4));
+    if (argc == 6) {
+        FILE* out = fopen(argv[5], "wb"); if (!out) return 7;
+        if (fwrite(guest.data()+0x1000000, 1, size_t(ow)*oh*4, out) != size_t(ow)*oh*4) abort(); fclose(out);
+    }
+    if (!strcmp(argv[4], "-")) { printf("SPU oracle output %ux%u -> %ux%u DMA get=%llu put=%llu\n",w,h,ow,oh,dma_get,dma_put); return 0; }
+    auto expected = load(argv[4]);
+    if (expected.size() != size_t(ow)*oh*4) return 6;
+    size_t errors = 0;
+    for (size_t i=0; i<expected.size(); ++i) if (guest[0x1000000+i] != expected[i]) {
+        if (errors++ < 8) fprintf(stderr,"byte=%zu original=%u replay=%u\n",i,expected[i],guest[0x1000000+i]);
+    }
+    printf("SPU oracle %ux%u -> %ux%u bytes=%zu mismatch=%zu dma_get=%llu dma_put=%llu\n",w,h,ow,oh,expected.size(),errors,dma_get,dma_put);
+    return errors ? 1 : 0;
+}
