@@ -0,0 +1,53 @@
+/* Feed length-prefixed H.264 access units to the native Windows decoder.
+ * The input is an explicitly captured (or generated) test stream, never a
+ * player's live HDD. The output includes token/order and pixel checksums. */
+#include "../vdec_mf.h"
+#include "../cellVdec.h"
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+#include <set>
+#include <algorithm>
+#include <chrono>
+struct Stats { unsigned count = 0, varied = 0; std::set<unsigned> tokens; const char* raw = nullptr; };
+static void emit(void* ctx, const VdecFfPicture* p)
+{
+    Stats* s = (Stats*)ctx;
+    size_t n = (size_t)p->width * p->height;
+    unsigned lo = 255, hi = 0; unsigned long long sum = 0, hash = 14695981039346656037ull;
+    for (size_t i = 0; i < n; i++) { unsigned v = p->yuv[i]; lo = std::min(lo, v); hi = std::max(hi, v); sum += v; hash = (hash ^ v) * 1099511628211ull; }
+    s->count++; s->varied += hi > lo + 16; s->tokens.insert(p->token);
+    std::printf("frame=%u token=%u %ux%u ticks=%u luma=%u..%u sum=%llu hash=%016llx\n", s->count, p->token, p->width, p->height, p->frame_ticks, lo, hi, sum, hash);
+    if (s->raw) {
+        FILE* f = std::fopen(s->raw, s->count == 1 ? "wb" : "ab");
+        if (f) { std::fwrite(p->yuv, 1, n + 2 * ((p->width + 1) / 2ull) * ((p->height + 1) / 2ull), f); std::fclose(f); }
+    }
+    std::free(p->yuv);
+}
+int main(int argc, char** argv)
+{
+    if (argc < 2) { std::fprintf(stderr, "usage: test_vdec_mf input.aus [decoded.i420]\n"); return 2; }
+    FILE* f = std::fopen(argv[1], "rb"); if (!f) return 3;
+    std::vector<std::vector<u8>> packets;
+    for (;;) {
+        u32 n = 0; if (std::fread(&n, 4, 1, f) != 1) break;
+        if (!n || n > 4u * 1024u * 1024u) return 4;
+        packets.emplace_back(n);
+        if (std::fread(packets.back().data(), 1, n, f) != n) return 5;
+    }
+    std::fclose(f);
+    VdecMf* d = vdec_mf_open(CELL_VDEC_CODEC_TYPE_AVC);
+    if (!d) return 6;
+    for (unsigned sequence = 0; sequence < 2; sequence++) {
+        Stats s; s.raw = sequence == 0 && argc > 2 ? argv[2] : nullptr;
+        auto start = std::chrono::steady_clock::now();
+        vdec_mf_reset(d);
+        for (u32 i = 0; i < packets.size(); i++)
+            if (vdec_mf_decode(d, packets[i].data(), (u32)packets[i].size(), i + 1, emit, &s) < 0) return 7;
+        vdec_mf_drain(d, emit, &s);
+        double ms = std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now() - start).count();
+        std::printf("sequence=%u inputs=%zu pictures=%u unique_tokens=%zu varied=%u elapsed_ms=%.3f\n", sequence, packets.size(), s.count, s.tokens.size(), s.varied, ms);
+        if (!s.count || s.count != packets.size() || s.tokens.size() != s.count || *s.tokens.begin() != 1 || *s.tokens.rbegin() != packets.size()) return 8;
+    }
+    vdec_mf_close(d); return 0;
+}
