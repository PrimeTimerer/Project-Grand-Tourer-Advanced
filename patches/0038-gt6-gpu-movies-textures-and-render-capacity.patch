diff --git a/libs/video/rsx_draw_batches.h b/libs/video/rsx_draw_batches.h
new file mode 100644
index 0000000..00d4877
--- /dev/null
+++ b/libs/video/rsx_draw_batches.h
@@ -0,0 +1,34 @@
+/* Growable draw-command spans. Capacity is retained between BEGIN/END groups;
+ * never submit a truncated prefix if allocation fails. */
+#ifndef PS3RECOMP_RSX_DRAW_BATCHES_H
+#define PS3RECOMP_RSX_DRAW_BATCHES_H
+#include "ps3emu/ps3types.h"
+#include <stdint.h>
+#include <stdlib.h>
+
+typedef struct rsx_draw_batch { u32 first, count; } rsx_draw_batch;
+#ifndef RSX_DRAW_BATCH_REALLOC
+#define RSX_DRAW_BATCH_REALLOC realloc
+#endif
+
+/* Failure leaves the pointer, live count, capacity and existing spans intact.
+ * The sink must mark the whole primitive incomplete rather than draw a prefix. */
+static inline int rsx_draw_batch_push(rsx_draw_batch** data, u32* count, u32* capacity,
+                                     u32 first, u32 vertices)
+{
+    if (!data || !count || !capacity || *count > *capacity ||
+        (*capacity && !*data) || *count == UINT32_MAX) return 0;
+    if (*count == *capacity) {
+        u64 next = *capacity ? (u64)*capacity * 2u : 256u;
+        if (next > UINT32_MAX) next = UINT32_MAX;
+        if (next > SIZE_MAX / sizeof(**data)) return 0;
+        rsx_draw_batch* grown = (rsx_draw_batch*)RSX_DRAW_BATCH_REALLOC(*data, (size_t)next * sizeof(**data));
+        if (!grown) return 0;
+        *data = grown; *capacity = (u32)next;
+    }
+    (*data)[*count].first = first;
+    (*data)[*count].count = vertices;
+    ++*count;
+    return 1;
+}
+#endif
