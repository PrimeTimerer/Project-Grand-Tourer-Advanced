diff --git a/libs/video/rsx_write_watch_plan.h b/libs/video/rsx_write_watch_plan.h
new file mode 100644
index 0000000..9fccf29
--- /dev/null
+++ b/libs/video/rsx_write_watch_plan.h
@@ -0,0 +1,21 @@
+#ifndef RSX_WRITE_WATCH_PLAN_H
+#define RSX_WRITE_WATCH_PLAN_H
+#include <stdint.h>
+
+/* An inline GPU command can invalidate a few pages after a whole block was
+ * harvested. In that epoch, collect those pages rather than the whole block
+ * again. The page generations and dirty-bit reset still happen at the draw
+ * that consumes the bytes; no new frame-level coherence assumption is made. */
+static int rsx_ww_widen_first_block(uint32_t first, uint32_t end,
+                                  uint32_t block_pages, uint32_t epoch,
+                                  const uint32_t* block_epochs,
+                                  uint32_t block_count)
+{
+    if (!block_pages || first >= end) return 0;
+    const uint32_t b0 = first / block_pages, b1 = (end - 1u) / block_pages;
+    if (b1 >= block_count) return 0;
+    for (uint32_t b = b0; b <= b1; ++b)
+        if (block_epochs[b] == epoch) return 0;
+    return 1;
+}
+#endif
diff --git a/libs/video/tests/generate_render_state_fixture.py b/libs/video/tests/generate_render_state_fixture.py
new file mode 100644
index 0000000..886d8e9
--- /dev/null
+++ b/libs/video/tests/generate_render_state_fixture.py
@@ -0,0 +1,33 @@
+"""Extract exact production render-state routines for the isolated C fixture.
+
+Usage: python generate_render_state_fixture.py <existing disposable output dir>
+Compile test_render_state_canonical.c with that directory on the include path.
+"""
+from pathlib import Path
+import hashlib
+import re
+import sys
+
+source = Path(__file__).resolve().parents[1] / "rsx_live_draw.c"
+destination = Path(sys.argv[1]).resolve()
+if not destination.is_dir():
+    raise SystemExit("Fixture output directory must already exist")
+text = source.read_text(encoding="utf-8")
+end = text.index("} render_state_t;") + len("} render_state_t;")
+start = text.rfind("typedef struct {", 0, end)
+parts = ["/* Exact production routines; generated, do not edit. */", text[start:end]]
+for name in ("gcm_cmp", "gcm_blend_factor", "gcm_blend_op", "gcm_stencil_op",
+             "apply_render_state", "fnv1a", "ld_hash_structural_render_state"):
+    found = next((match for match in re.finditer(r"^static [^\n]+\b" + name + r"\s*\(", text, re.M)
+                  if text.index("{", match.end()) < text.index(";", match.end())), None)
+    if found is None:
+        raise SystemExit("Missing production function: " + name)
+    first = text.index("{", found.end())
+    balance = 1
+    last = first + 1
+    while balance:
+        balance += (text[last] == "{") - (text[last] == "}")
+        last += 1
+    parts.append(text[found.start():last])
+(destination / "render_state_fixture.inc").write_text("\n\n".join(parts) + "\n", encoding="utf-8")
+(destination / "state_source_sha256.txt").write_text(hashlib.sha256(source.read_bytes()).hexdigest() + "\n")
diff --git a/libs/video/tests/test_fp_compile_init.c b/libs/video/tests/test_fp_compile_init.c
new file mode 100644
index 0000000..492cdfd
--- /dev/null
+++ b/libs/video/tests/test_fp_compile_init.c
@@ -0,0 +1,50 @@
+#include "../rsx_fp_compile_init.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+#ifdef FP_INIT_DLL
+__declspec(dllexport) int trim_fp(char* text, size_t length, rsx_fp_init_reduction* result)
+{ return rsx_fp_reduce_unused_init(text, length, result); }
+#else
+static unsigned checks, failures;
+static void check(int ok, const char* what)
+{ ++checks; failures += !ok; printf("[%s] %s\n", ok ? "PASS" : "FAIL", what); }
+static void exercise(const char* body, unsigned declared, unsigned wanted, const char* what)
+{
+    char source[4096], before[4096];
+    snprintf(source, sizeof(source), "float4 r[%u]; float4 h[%u];\n"
+             "[unroll] for (int _i = 0; _i < %u; _i++) { r[_i] = (float4)0; h[_i] = (float4)0; }\n%s\n",
+             declared, declared, declared, body);
+    strcpy(before, source);
+    rsx_fp_init_reduction info;
+    const int changed = rsx_fp_reduce_unused_init(source, strlen(source), &info);
+    check(wanted ? changed && info.initialized_registers == wanted &&
+                   info.declared_registers == declared && info.source_length == strlen(source)
+                 : !changed && !strcmp(source, before), what);
+    if (wanted) {
+        char declaration[80];
+        snprintf(declaration, sizeof(declaration), "float4 r[%u]; float4 h[%u];", declared, declared);
+        check(strstr(source, declaration) != NULL, "array declarations unchanged");
+    }
+}
+int main(void)
+{
+    exercise("return r[0];", 48, 1, "one used register");
+    exercise("r[8].x = h[4].x; return r[8];", 48, 9, "both register files are counted");
+    exercise("return h[23];", 48, 24, "two-digit initializer bound");
+    exercise("return r[52] + h[50];", 64, 53, "large-register program keeps all used indices");
+    exercise("return h[47];", 48, 0, "full register file remains intact");
+    exercise("return r[48];", 48, 0, "out-of-bounds source remains intact");
+    exercise("return r[-1];", 48, 0, "negative index rejected");
+    exercise("return r[index];", 48, 0, "dynamic index rejected");
+    exercise("return r[1+2];", 48, 0, "expression index rejected");
+    exercise("return fn(r);", 48, 0, "array alias rejected");
+    exercise("return value.r * r[ 2 ];", 48, 3, "swizzles and whitespace handled");
+    exercise("/* r[47] */ // h[46]\nreturn h[1];", 48, 2, "comments do not create register reads");
+    exercise("return 1;", 48, 0, "unrecognized register-free program remains intact");
+    char unknown[] = "float4 main() : SV_TARGET { return 1; }";
+    check(!rsx_fp_reduce_unused_init(unknown, strlen(unknown), NULL), "unknown emitter shape remains intact");
+    printf("FP compile initializer: %u checks, %u failures\n", checks, failures);
+    return failures ? 1 : 0;
+}
+#endif
diff --git a/libs/video/tests/test_gcm_blocked_write_kick.c b/libs/video/tests/test_gcm_blocked_write_kick.c
new file mode 100644
index 0000000..9358158
--- /dev/null
+++ b/libs/video/tests/test_gcm_blocked_write_kick.c
@@ -0,0 +1,244 @@
+/* Production FIFO walker + real Win32 event; disposable guest VM. */
+#include <windows.h>
+static void (*test_before_set_event)(HANDLE);
+static BOOL WINAPI test_set_event(HANDLE event)
+{
+    if (test_before_set_event) test_before_set_event(event);
+    return SetEvent(event);
+}
+#define SetEvent test_set_event
+#include "../cellGcmSys.c"
+#undef SetEvent
+#include <stdio.h>
+#include <stdlib.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+ps3_guest_caller_fn g_ps3_guest_caller;
+/* The walker's other consumers: no graphics backend, no lifted program. */
+PPU_THREAD_LOCAL ppu_context* g_active_ctx;
+u32 g_rsx_last_reference;
+void (*g_spu_put_hook)(uint32_t ea, uint32_t size);
+void ppu_dump_bctrl_ring(uint32_t n, const char* why) { (void)n; (void)why; }
+void ppu_dump_guest_stack(ppu_context* c, const char* why) { (void)c; (void)why; }
+void rsx_state_init(rsx_state* state) { (void)state; }
+/* Counts the probe methods the walker executed. */
+#define PROBE_METHOD 0x1EE0u
+static u32 seen_n;
+int  rsx_process_method(rsx_state* state, u32 method, u32 data)
+{
+    (void)state; (void)data;
+    if (method == PROBE_METHOD) seen_n++;
+    return 0;
+}
+int  rsx_draw_engine_enabled(void) { return 0; }
+/* The walker hands vertex-program runs here (#554) and asks for a vtable
+ * backend (#466); this fixture has neither. */
+int  rsx_process_vp_run(rsx_state* state, u32 method, const u8* src, u32 count)
+{ (void)state; (void)method; (void)src; (void)count; return 0; }
+rsx_backend* rsx_get_backend(void) { return NULL; }
+void rsx_draw_engine_method(u32 method, u32 arg) { (void)method; (void)arg; }
+void rsx_draw_engine_note_flip(u32 buffer_id) { (void)buffer_id; }
+void rsx_draw_engine_guest_read(u32 l, u32 o, u32 p, u32 w, u32 h) { (void)l; (void)o; (void)p; (void)w; (void)h; }
+void rsx_draw_engine_guest_wrote(u32 l, u32 o, u32 p, u32 w, u32 h) { (void)l; (void)o; (void)p; (void)w; (void)h; }
+int  rsx_live_draw_enabled(void) { return 0; }
+void rsx_live_draw_method(u32 method, u32 arg) { (void)method; (void)arg; }
+int  rsx_live_draw_blit(u32 a, u32 b, u32 c, u32 d, u32 e, u32 f, u32 w, u32 h)
+{ (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)w; (void)h; return 0; }
+void rsx_live_draw_note_resolve(u32 a, u32 b, u32 c, u32 d) { (void)a; (void)b; (void)c; (void)d; }
+int  rsx_live_draw_resolve_blit(u32 a, u32 b, u32 c, u32 d, u32 e, u32 f, u32 g, u32 h,
+                                u32 i, u32 j, u32 k, u32 l)
+{ (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)g; (void)h; (void)i; (void)j; (void)k; (void)l; return 0; }
+
+void rsx_raise_user_cmd(uint32_t arg) { (void)arg; }
+void rsx_draw_engine_set_display_buffer(u32 id, u32 location, u32 offset, u32 pitch, u32 width, u32 height)
+{ (void)id; (void)location; (void)offset; (void)pitch; (void)width; (void)height; }
+void rsx_ww_note_write(u32 ea, u32 bytes) { (void)ea; (void)bytes; }
+
+#define IO_ADDR   0x00100000u
+#define IO_SIZE   0x00100000u
+#define CMD_SIZE  0x00010000u
+#define SEG_B     0x00008000u
+
+static uint32_t g_heap = 0x00400000u;
+static u32 host_alloc(u32 size, u32 align)
+{
+    if (!align) align = 4;
+    g_heap = (g_heap + align - 1u) & ~(align - 1u);
+    u32 r = g_heap;
+    g_heap += size;
+    return r;
+}
+static void gw32(uint32_t ea, uint32_t v)
+{
+    uint8_t* p = vm_base + ea;
+    p[0] = (uint8_t)(v >> 24); p[1] = (uint8_t)(v >> 16); p[2] = (uint8_t)(v >> 8); p[3] = (uint8_t)v;
+}
+static void host_w32(u32 ea, u32 v) { gw32(ea, v); }
+
+static int fails;
+static void check(int ok, const char* what)
+{
+    printf("[%s] %s\n", ok ? "PASS" : "FAIL", what);
+    fails += !ok;
+}
+
+/* One method, count 1, subchannel 0. */
+static u32 put_probe(u32 io, u32 arg)
+{
+    gw32(IO_ADDR + io, (1u << 18) | PROBE_METHOD);
+    gw32(IO_ADDR + io + 4, arg);
+    return io + 8;
+}
+
+
+static unsigned nchecks;
+static void checked(int ok, const char* what) { ++nchecks; check(ok, what); }
+static void drain_event(HANDLE event) { while (WaitForSingleObject(event, 0) == WAIT_OBJECT_0) {} }
+static unsigned metadata_dirty, metadata_signals;
+static int metadata_expect_block;
+static u32 metadata_start, metadata_end;
+static void metadata_dirty_note(u32 location, u32 offset, u32 size)
+{
+    (void)location; (void)offset; (void)size;
+    ++metadata_dirty;
+}
+/* Observe at the actual SetEvent call, before a resumed consumer can run. */
+static void metadata_before_signal(HANDLE event)
+{
+    (void)event;
+    ++metadata_signals;
+    checked(metadata_dirty == 1, "dirty notification completes before native wake");
+    if (metadata_expect_block)
+        checked(gcm_spu_block_for_put(metadata_end) == metadata_start,
+                "IO block metadata completes before native wake");
+}
+static void verify_notify_order(HANDLE event, int enabled)
+{
+    const u32 saved_local = s_config.localAddress;
+    s_config.localAddress = IO_ADDR;
+    g_gcm_guest_write_note = metadata_dirty_note;
+    memset(s_spu_blk, 0, sizeof s_spu_blk); s_spu_blk_w = 0;
+    /* New record, contiguous fragment, unmapped write, then an oversized
+     * write: every nonempty completed PUT can wake its blocked consumer. */
+    const u32 addresses[] = { IO_ADDR+0xA000, IO_ADDR+0xA010,
+                              IO_ADDR+IO_SIZE+0x8000, IO_ADDR+0xB000 };
+    const u32 sizes[] = { 16, 16, 4, 0x40001 };
+    for (unsigned i=0; i!=4; ++i) {
+        const u32 ea=addresses[i], old=0x20000000u|(ea-IO_ADDR);
+        drain_event(event); gw32(ea,old);
+        gcm_blocked_write_arm(ea,old,2);
+        metadata_dirty=metadata_signals=0;
+        metadata_expect_block=i<2;
+        metadata_start=0xA000;
+        metadata_end=i ? 0xA020 : 0xA010;
+        test_before_set_event=metadata_before_signal;
+        gw32(ea,0); gcm_note_spu_put(ea,sizes[i]);
+        test_before_set_event=NULL;
+        checked(metadata_dirty==1, "completed PUT retains dirty notification");
+        checked(metadata_signals==(unsigned)enabled, "all completed PUT paths wake only when enabled");
+        checked(WaitForSingleObject(event,0)==(enabled?WAIT_OBJECT_0:WAIT_TIMEOUT),
+                "metadata-ordered notification reaches real event");
+        if (i<2)
+            checked(gcm_spu_block_for_put(metadata_end)==metadata_start,
+                    "new and coalesced IO records remain correct");
+    }
+    drain_event(event); gw32(IO_ADDR+0xA000,0x2000A000u);
+    gcm_blocked_write_arm(IO_ADDR+0xA000,0x2000A000u,2);
+    metadata_dirty=metadata_signals=0;
+    test_before_set_event=metadata_before_signal;
+    gcm_note_spu_put(IO_ADDR+0xA000,0);
+    test_before_set_event=NULL;
+    checked(!metadata_dirty && !metadata_signals && WaitForSingleObject(event,0)==WAIT_TIMEOUT,
+            "empty PUT does not dirty or wake");
+    gcm_blocked_write_clear();
+    g_gcm_guest_write_note=NULL; s_config.localAddress=saved_local;
+}
+static DWORD WINAPI delayed_park_patch(void* arg)
+{
+    const u32 park = (u32)(uintptr_t)arg;
+    Sleep(10);
+    gw32(IO_ADDR + park, 0x20000000u | SEG_B);
+    gcm_note_spu_put(IO_ADDR + park, 4);
+    return 0;
+}
+int main(int argc, char** argv)
+{
+    const int enabled = argc > 1 && atoi(argv[1]) != 0;
+    _putenv_s("GCM_BLOCKED_WRITE_KICK", enabled ? "1" : "0");
+    _putenv_s("GCM_SEMA_ACQUIRE", "1");
+    _putenv_s("GCM_SEMA_ACQUIRE_MS", "0");
+    _putenv_s("GCM_PARK_GRACE_MS", "600000");
+    _putenv_s("GCM_LABEL_BANK", "-1");
+    const u32 vm_size = ppu_hle_inject_base + 0x10000u;
+    vm_base = (u8*)calloc(1, vm_size); ppu_vm_size = vm_size;
+    if (!vm_base) return 2;
+    u32 ctx_out = host_alloc(4,4);
+    (void)cellGcmSetupContext(ctx_out, CMD_SIZE, IO_SIZE, IO_ADDR, host_alloc, host_w32);
+    const u32 ctrl = (u32)(uintptr_t)cellGcmGetControlRegister();
+    HANDLE event = (HANDLE)cellGcm_fifo_kick_event();
+    const u32 park = put_probe(0,0), put = put_probe(SEG_B,1);
+    gw32(IO_ADDR+park, 0x20000000u | park);
+    vm_write32(ctrl, put); s_fifo_getoff=0;
+    cellGcm_rsx_process_fifo();
+    checked(seen_n==1 && s_fifo_getoff==park, "actual walker stops on self-JUMP");
+    gcm_blocked_write_ticket ticket;
+    checked(gcm_bww_snapshot(&s_gcm_blocked_write,&ticket)==enabled, "watch follows switch");
+    if (enabled) checked(ticket.address==IO_ADDR+park && ticket.kind==2, "watch is actual blocked park EA");
+    drain_event(event);
+    gcm_note_spu_put(IO_ADDR+0x9000, 16);
+    checked(WaitForSingleObject(event,0)==WAIT_TIMEOUT, "unrelated PUT gives no event");
+    gw32(IO_ADDR+park, 0x20000000u | SEG_B);
+    gcm_note_spu_put(IO_ADDR+park,4);
+    checked(WaitForSingleObject(event,0)==(enabled?WAIT_OBJECT_0:WAIT_TIMEOUT), "matching completed PUT wakes only when enabled");
+    cellGcm_rsx_process_fifo();
+    checked(seen_n==2 && s_fifo_getoff==put, "same full commands execute with either wake policy");
+    checked(!gcm_bww_snapshot(&s_gcm_blocked_write,&ticket), "unblocked pass clears old address");
+
+    /* Real semaphore method: OFFSET 0x530 then ACQUIRE 0x77, then probe. */
+    const u32 semio=0x9000, label=GCM_LABEL_GUEST_BASE+0x530;
+    gw32(IO_ADDR+semio,(2u<<18)|0x64u);
+    gw32(IO_ADDR+semio+4,0x530); gw32(IO_ADDR+semio+8,0x77);
+    const u32 semput=put_probe(semio+12,2);
+    vm_write32(label,0); vm_write32(ctrl,semput); s_fifo_getoff=semio;
+    cellGcm_rsx_process_fifo();
+    checked(s_fifo_getoff==semio && seen_n==2, "real ACQUIRE remains blocked");
+    if (enabled) checked(gcm_bww_snapshot(&s_gcm_blocked_write,&ticket) && ticket.address==label && ticket.kind==1,
+                          "watch is actual blocked label EA");
+    drain_event(event); vm_write32(label,0x77); gcm_note_spu_put(label,4);
+    checked(WaitForSingleObject(event,0)==(enabled?WAIT_OBJECT_0:WAIT_TIMEOUT), "label PUT signals event");
+    cellGcm_rsx_process_fifo();
+    checked(s_fifo_getoff==semput && seen_n==3 && vm_read32(label)==0x77, "acquire and commands retain guest semantics");
+
+    /* Producer lands after blocked read but before arm: re-read closes gap. */
+    drain_event(event); gw32(IO_ADDR+park,0x20000000u|SEG_B);
+    gcm_blocked_write_arm(IO_ADDR+park,0x20000000u|park,2);
+    checked(WaitForSingleObject(event,0)==(enabled?WAIT_OBJECT_0:WAIT_TIMEOUT), "write-before-arm is caught by re-read");
+    drain_event(event); vm_write32(label,0x77);
+    gcm_blocked_write_arm(label,0x77,1);
+    checked(WaitForSingleObject(event,0)==(enabled?WAIT_OBJECT_0:WAIT_TIMEOUT), "label-before-arm is caught by re-read");
+
+    verify_notify_order(event, enabled);
+
+    /* Existing wait API actually wakes from the native producer event. */
+    if (enabled) {
+        drain_event(event); gw32(IO_ADDR+park,0x20000000u|park);
+        gcm_blocked_write_arm(IO_ADDR+park,0x20000000u|park,2);
+        HANDLE thread=CreateThread(NULL,0,delayed_park_patch,(void*)(uintptr_t)park,0,NULL);
+        LARGE_INTEGER a,b,f; QueryPerformanceFrequency(&f); QueryPerformanceCounter(&a);
+        cellGcm_fifo_kick_wait(1000); QueryPerformanceCounter(&b);
+        const double waited=(b.QuadPart-a.QuadPart)*1000.0/f.QuadPart;
+        checked(waited < 500, "native wait wakes before 1000 ms timeout");
+        checked(WaitForSingleObject(thread,1000)==WAIT_OBJECT_0, "producer joined"); CloseHandle(thread);
+        printf("native delayed-PUT wake %.3f ms (producer sleeps 10 ms)\n",waited);
+    }
+    printf("gcm blocked write kick=%d: %u checks, %d failures\n",enabled,nchecks,fails);
+    free(vm_base); return fails?1:0;
+}
diff --git a/libs/video/tests/test_gcm_blocked_write_watch.c b/libs/video/tests/test_gcm_blocked_write_watch.c
new file mode 100644
index 0000000..98db25a
--- /dev/null
+++ b/libs/video/tests/test_gcm_blocked_write_watch.c
@@ -0,0 +1,101 @@
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "../gcm_blocked_write_watch.h"
+
+static gcm_blocked_write_watch watch;
+static atomic_uint claims, snapshots, bad_snapshots, stop_reader;
+static HANDLE wake;
+static unsigned checks, failures;
+static void check(int condition, const char* name)
+{
+    ++checks;
+    if (!condition) { ++failures; fprintf(stderr, "FAIL %s\n", name); }
+}
+static DWORD WINAPI writer(void* unused)
+{
+    (void)unused;
+    if (gcm_bww_written(&watch, 0x10000, 16)) {
+        atomic_fetch_add(&claims, 1);
+        SetEvent(wake);
+    }
+    return 0;
+}
+static DWORD WINAPI snapshot_reader(void* unused)
+{
+    (void)unused;
+    while (!atomic_load(&stop_reader)) {
+        gcm_blocked_write_ticket t;
+        if (!gcm_bww_snapshot(&watch, &t)) continue;
+        atomic_fetch_add(&snapshots, 1);
+        if (!((t.address == 0x10000 && t.value == 0x11111111 && t.kind == 1) ||
+              (t.address == 0x20000 && t.value == 0x22222222 && t.kind == 2)))
+            atomic_fetch_add(&bad_snapshots, 1);
+    }
+    return 0;
+}
+int main(void)
+{
+    wake = CreateEventA(NULL, FALSE, FALSE, NULL);
+    check(wake != NULL, "native event created");
+    gcm_blocked_write_ticket t = gcm_bww_arm(&watch, 0x10000, 0x55, 2);
+    check(!gcm_bww_written(&watch, 0x10004, 4), "right edge does not overlap");
+    check(!gcm_bww_written(&watch, 0xFFFF, 1), "left edge does not overlap");
+    check(!gcm_bww_written(&watch, 0x10000, 0), "zero length does not notify");
+    check(gcm_bww_written(&watch, 0x10003, 1) == 2, "last byte overlap notifies");
+    check(!gcm_bww_written(&watch, 0x10000, 16), "one notification per arm");
+    check(!gcm_bww_claim(&watch, &t), "consumed ticket cannot claim twice");
+    t = gcm_bww_arm(&watch, 0x10000, 0x55, 2);
+    gcm_bww_clear(&watch);
+    check(!gcm_bww_claim(&watch, &t), "teardown invalidates pending writer");
+    gcm_blocked_write_ticket next = gcm_bww_arm(&watch, 0x10000, 0x55, 2);
+    check(next.generation != t.generation && !gcm_bww_claim(&watch, &t),
+          "same-address same-value reuse rejects old generation");
+    check(gcm_bww_claim(&watch, &next), "new publication survives stale claim");
+    t = gcm_bww_arm(&watch, 0x10000, 0x55, 1);
+    next = gcm_bww_arm(&watch, 0x20000, 0xAA, 2);
+    check(!gcm_bww_claim(&watch, &t), "different-address replacement rejects old generation");
+    check(!gcm_bww_written(&watch, 0x10000, 4), "old-address DMA cannot consume new target");
+    check(gcm_bww_written(&watch, 0x20000, 4) == 2, "replacement target notified");
+    gcm_bww_arm(&watch, 0xFFFFFFFC, 0, 2);
+    check(gcm_bww_written(&watch, 0xFFFFFFFE, 2) == 2, "top address overlap does not wrap");
+    gcm_bww_arm(&watch, 0, 0, 1);
+    check(!gcm_bww_written(&watch, 0xFFFFFFFC, 4), "top range does not alias zero");
+
+    /* Eight simultaneous producers: only one owns the event and state CAS. */
+    gcm_bww_arm(&watch, 0x10000, 0, 1);
+    HANDLE workers[8];
+    for (unsigned i=0; i!=8; ++i) workers[i] = CreateThread(NULL, 0, writer, NULL, 0, NULL);
+    check(WaitForMultipleObjects(8, workers, TRUE, 3000) == WAIT_OBJECT_0, "all producers joined");
+    for (unsigned i=0; i!=8; ++i) CloseHandle(workers[i]);
+    check(atomic_load(&claims) == 1, "simultaneous writes produce one wake");
+    check(WaitForSingleObject(wake, 0) == WAIT_OBJECT_0, "write-before-wait event is retained");
+    check(WaitForSingleObject(wake, 0) == WAIT_TIMEOUT, "auto reset consumes once");
+
+    gcm_bww_arm(&watch, 0x10000, 0x11111111, 1);
+    HANDLE reader = CreateThread(NULL, 0, snapshot_reader, NULL, 0, NULL);
+    while (!atomic_load(&snapshots)) SwitchToThread();
+    for (unsigned i=0; i!=200000; ++i) {
+        if (i & 1) gcm_bww_arm(&watch, 0x10000, 0x11111111, 1);
+        else gcm_bww_arm(&watch, 0x20000, 0x22222222, 2);
+    }
+    atomic_store(&stop_reader, 1);
+    check(WaitForSingleObject(reader, 3000) == WAIT_OBJECT_0, "snapshot reader joined");
+    CloseHandle(reader);
+    check(atomic_load(&snapshots) && !atomic_load(&bad_snapshots), "concurrent snapshots never mix publications");
+
+    /* A million unrelated completions must keep the watch and never signal. */
+    t = gcm_bww_arm(&watch, 0x10000, 0, 1);
+    LARGE_INTEGER begin, end, frequency;
+    QueryPerformanceFrequency(&frequency); QueryPerformanceCounter(&begin);
+    unsigned false_wakes = 0;
+    for (unsigned i=0; i!=1000000; ++i) false_wakes += gcm_bww_written(&watch, 0x20000 + (i & 255) * 16, 16);
+    QueryPerformanceCounter(&end);
+    check(false_wakes == 0 && gcm_bww_claim(&watch, &t), "unrelated DMA preserves watch with zero wakes");
+    printf("unrelated PUT checks: %.3f ms / 1M; snapshot samples %u\n",
+           (end.QuadPart-begin.QuadPart)*1000.0/frequency.QuadPart, atomic_load(&snapshots));
+    CloseHandle(wake);
+    printf("gcm blocked write watch: %u checks, %u failures\n", checks, failures);
+    return failures ? 1 : 0;
+}
