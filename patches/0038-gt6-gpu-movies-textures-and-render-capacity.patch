+++ b/libs/codec/tests/test_pamf_dmux.c
@@ -0,0 +1,158 @@
+/* Guest ABI, chunk-boundary and bounded-queue test against an explicit PAMF
+ * capture. The memory below is disposable and has no access to a game save. */
+#include "../cellPamf.c"
+#include "../cellDmux.c"
+#include <stdint.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+uint32_t ppu_hle_inject_base = 0x01000000;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;
+void ppu_resv_break_store(uint64_t ea) { (void)ea; }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+#define CHECK(x) do { if (!(x)) { fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x); exit(1); } } while (0)
+static unsigned callback_count, demux_done, es_notifications, flush_done;
+static SRWLOCK guest_mutex = SRWLOCK_INIT;
+static HANDLE callback_entered;
+static void callback(u32 opd, u64 a0, u64 a1, u64 a2, u64 a3, u64 a4, u64 a5, u64 a6, u64 a7)
+{
+    SetEvent(callback_entered);
+    AcquireSRWLockExclusive(&guest_mutex);
+    const u64 args[8] = {a0,a1,a2,a3,a4,a5,a6,a7};
+    callback_count++;
+    if (opd == 0x1000) {
+        CHECK(args[0] == 1 && args[2] == 0x12345678 && args[3] == 0);
+        CHECK(vm_read32(args[1]) != CELL_DMUX_MSG_TYPE_FATAL_ERR);
+        demux_done += vm_read32(args[1]) == CELL_DMUX_MSG_TYPE_DEMUX_DONE;
+    } else {
+        CHECK(opd == 0x2000);
+        CHECK(args[0] == 1 && args[1] >= 1 && args[1] <= 3 && args[3] == 0x87654321);
+        es_notifications += vm_read32(args[2]) == CELL_DMUX_ES_MSG_TYPE_AU_FOUND;
+        flush_done += vm_read32(args[2]) == CELL_DMUX_ES_MSG_TYPE_FLUSH_DONE;
+    }
+    ReleaseSRWLockExclusive(&guest_mutex);
+}
+ps3_guest_caller_fn g_ps3_guest_caller = callback;
+static void wait_callbacks(void)
+{
+    CODEC_CB_LOCK();
+    for (;;) {
+        unsigned active = 0;
+        for (u32 i=0;i<CELL_DMUX_MAX_HANDLES;i++) active += s_dmux_callbacks[i].active;
+        for (u32 i=0;i<CELL_DMUX_MAX_ES;i++) active += s_dmux_es_callbacks[i].active;
+        if (!codec_cb_head && !active) break;
+        CODEC_CB_WAIT();
+    }
+    CODEC_CB_UNLOCK();
+}
+typedef struct { uint64_t hash, bytes; unsigned count, timed; } Result;
+static Result result[3];
+static unsigned drain(void)
+{
+    unsigned total = 0;
+    for (u32 es = 1; es <= 3; es++) {
+        while (cellDmuxGetAu(es, (CellDmuxAuInfo**)0x1400, (void**)0x1404) == CELL_OK) {
+            u32 item = vm_read32(0x1400), data = vm_read32(item), n = vm_read32(item + 4);
+            CHECK(item >= 0x2000000 && data >= 0x2000000 && n && data + n < 64u*1024u*1024u);
+            CHECK(vm_read32(0x1404) == item + 48);
+            if (es == 1) CHECK(n > 4 && vm_read8(data) == 0 && vm_read8(data+1) == 0);
+            else CHECK(vm_read8(data) == 0x0f && vm_read8(data+1) == 0xd0 && n == (es == 2 ? 696 : 1720));
+            Result* r = &result[es-1]; r->count++; r->bytes += n;
+            r->timed += vm_read64(item + 24) != ~(u64)0;
+            for (u32 i = 0; i < n; i++) r->hash = (r->hash ^ vm_read8(data+i)) * 1099511628211ull;
+            CHECK(cellDmuxReleaseAu(es) == 0); total++;
+        }
+    }
+    return total;
+}
+static void run(const u8* bytes, u32 size, u32 chunk)
+{
+    memset(result,0,sizeof(result)); for (unsigned i=0;i<3;i++) result[i].hash=14695981039346656037ull;
+    demux_done = es_notifications = flush_done = callback_count = 0;
+    vm_write32(0x1100,1); vm_write32(0x1120,0x1800); vm_write32(0x1124,65536);
+    vm_write32(0x1140,0x1000); vm_write32(0x1144,0x12345678);
+    CHECK(cellDmuxOpen((CellDmuxType*)0x1100,(CellDmuxResource*)0x1120,(CellDmuxCb*)0x1140,(u32*)0x1160)==0);
+    CHECK(vm_read32(0x1160)==1);
+    for (u32 i=0;i<3;i++) {
+        CHECK(cellPamfReaderSetStreamWithIndex((CellPamfReader*)0x500,i)==0);
+        CHECK(cellPamfReaderGetEsFilterId((CellPamfReader*)0x500,(void*)0x1200)==0);
+        vm_write32(0x1240,0x2000000+i*0xa00000);vm_write32(0x1244,i?0x200000:0x800000);
+        vm_write32(0x1260,0x2000);vm_write32(0x1264,0x87654321);
+        CHECK(cellDmuxEnableEs(1,(CellDmuxEsFilterId*)0x1200,(CellDmuxEsResource*)0x1240,(CellDmuxCb*)0x1260,0,(u32*)0x1280)==0);
+        CHECK(vm_read32(0x1280)==i+1);
+    }
+    /* Cancel while an input still owns queued AUs, then replay from the start.
+     * Callback lifetime is settled before the test counters are reused. */
+    u32 first = size < 262144 ? size : 262144;
+    memcpy(vm_base+0x100000,bytes,first);
+    ResetEvent(callback_entered); AcquireSRWLockExclusive(&guest_mutex);
+    CHECK(cellDmuxSetStream(1,0x100000,first,1,0x1234)==0);
+    CHECK(WaitForSingleObject(callback_entered,1000)==WAIT_OBJECT_0);
+    CHECK(s_dmux[0].busy);
+    ULONGLONG reset_start=GetTickCount64();
+    CHECK(cellDmuxResetStream(1)==0);
+    CHECK(GetTickCount64()-reset_start<100);
+    ReleaseSRWLockExclusive(&guest_mutex);
+    wait_callbacks();
+    CHECK(demux_done==1);
+    CHECK(cellDmuxResetStream(1)==(s32)CELL_DMUX_ERROR_SEQ);
+    for(u32 i=1;i<=3;i++) CHECK(cellDmuxGetAu(i,(CellDmuxAuInfo**)0x1400,(void**)0x1404)==(s32)CELL_DMUX_ERROR_EMPTY);
+    demux_done = es_notifications = flush_done = callback_count = 0;
+    unsigned submitted=0,busy=0;
+    for (u32 at=0;at<size;) {
+        u32 n=size-at<chunk?size-at:chunk;memcpy(vm_base+0x100000,bytes+at,n);
+        CHECK(cellDmuxSetStream(1,0x100000,n,at==0,0x1122334455667788ull)==0);submitted++;at+=n;
+        if(s_dmux[0].busy) { CHECK(cellDmuxSetStream(1,0x100000,n,0,0)==(s32)CELL_DMUX_ERROR_BUSY);busy++; }
+        while(drain()) {}
+        CHECK(!s_dmux[0].busy);
+    }
+    for (u32 i=1;i<=3;i++) {
+        /* The capture can end in a partial AU. Discard that unclosed tail;
+         * all complete AUs emitted before it are the comparison contract. */
+        s_es[i-1].size=0;
+        CHECK(cellDmuxFlushEs(i)==0);
+    }
+    wait_callbacks();
+    CHECK(demux_done==submitted && flush_done==3);
+    CHECK(es_notifications==result[0].count+result[1].count+result[2].count);
+    printf("chunk=%u submits=%u busy=%u callbacks=%u\n",chunk,submitted,busy,callback_count);
+    for(unsigned i=0;i<3;i++)printf("es=%u AUs=%u bytes=%llu pts=%u hash=%016llx\n",i+1,result[i].count,(unsigned long long)result[i].bytes,result[i].timed,(unsigned long long)result[i].hash);
+    CHECK(cellDmuxClose(1)==0);
+}
+static u8* read(const char* path,u32* n)
+{
+    FILE* f=fopen(path,"rb");CHECK(f);fseek(f,0,SEEK_END);long size=ftell(f);rewind(f);CHECK(size>0&&size<128u*1024u*1024u);
+    u8* b=(u8*)malloc(size);CHECK(b&&fread(b,1,size,f)==(size_t)size);fclose(f);*n=(u32)size;return b;
+}
+int main(int argc,char** argv)
+{
+    CHECK(argc==3);u32 hn,pn;u8* header=read(argv[1],&hn);u8* stream=read(argv[2],&pn);
+    callback_entered=CreateEvent(NULL,FALSE,FALSE,NULL);CHECK(callback_entered);
+    vm_base=(u8*)calloc(1,64u*1024u*1024u);CHECK(vm_base);ppu_vm_size=64u*1024u*1024u;
+    memcpy(vm_base+0x10000,header,hn);memset(vm_base+0x500,0xa5,128);
+    CHECK(cellPamfReaderInitialize((CellPamfReader*)0x500,(void*)0x10000,535508992,0)==0);
+    CHECK(cellPamfReaderGetNumberOfStreams((CellPamfReader*)0x500)==3);
+    CHECK(cellPamfReaderGetNumberOfSpecificStreams((CellPamfReader*)0x500,20)==1);
+    CHECK(cellPamfReaderGetNumberOfSpecificStreams((CellPamfReader*)0x500,21)==2);
+    CHECK(cellPamfReaderGetStreamInfo((CellPamfReader*)0x500,(void*)0x700,32)==0);
+    CHECK(vm_read16(0x70a)==1920 && vm_read16(0x70c)==1088 && vm_read8(0x704)==6);
+    CHECK(cellPamfReaderGetNumberOfEp((CellPamfReader*)0x500)==333);
+    CHECK(cellPamfReaderGetPresentationStartTime((CellPamfReader*)0x500,(u64*)0x800)==0 && vm_read64(0x800)==89310);
+    CHECK(cellPamfReaderGetEpIteratorWithTimeStamp((CellPamfReader*)0x500,(void*)0x800,(void*)0x820)==0);
+    CHECK(cellPamfEpIteratorGetEp((void*)0x820,(void*)0x840)==0);
+    CHECK(vm_read64(0x848)>=89310 && vm_read64(0x850)<535508992);
+    for(u32 i=0;i<128;i++)CHECK(vm_read8(0x500+i)==0xa5);
+    /* Malformed stream count cannot overrun the declared header. */
+    vm_write8(0x10087,255);CHECK(cellPamfVerify((void*)0x10000,535508992)!=0);vm_write8(0x10087,3);
+    if(pn>4u*1024u*1024u)pn=4u*1024u*1024u;
+    run(stream,pn,262144);Result expected[3];memcpy(expected,result,sizeof(result));
+    run(stream,pn,113);CHECK(!memcmp(expected,result,sizeof(result)));
+    run(stream,pn,65537);CHECK(!memcmp(expected,result,sizeof(result)));
+    CHECK(cellDmuxSetStream(0,0x100000,100,0,0)==(s32)CELL_DMUX_ERROR_ARG);
+    printf("PASS PAMF ABI, AVC/ATRAC framing, chunk boundaries, AU payload identity, queue backpressure, reset/close\n");
+    free(header);free(stream);free(vm_base);return 0;
+}
