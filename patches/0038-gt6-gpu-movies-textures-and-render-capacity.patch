diff --git a/libs/codec/adec_atrac.h b/libs/codec/adec_atrac.h
new file mode 100644
index 0000000..9e7b412
--- /dev/null
+++ b/libs/codec/adec_atrac.h
@@ -0,0 +1,206 @@
+/* ATRAC3plus movie audio. Included only by cellAdec.c after AdecSlot.
+ * The CPU codec is the existing standalone decoder; this is not GPU audio.
+ * Guest PCM and timestamps use the cellAdec ABI, not cellAtrac's RIFF API. */
+#include "../../third_party/at3_standalone/at3_bridge.h"
+#include <math.h>
+#ifdef _WIN32
+#include <windows.h>
+static SRWLOCK s_adec_at3_lock = SRWLOCK_INIT;
+#define AT3_LOCK() AcquireSRWLockExclusive(&s_adec_at3_lock)
+#define AT3_UNLOCK() ReleaseSRWLockExclusive(&s_adec_at3_lock)
+#else
+#include <pthread.h>
+static pthread_mutex_t s_adec_at3_lock = PTHREAD_MUTEX_INITIALIZER;
+#define AT3_LOCK() pthread_mutex_lock(&s_adec_at3_lock)
+#define AT3_UNLOCK() pthread_mutex_unlock(&s_adec_at3_lock)
+#endif
+
+#define AT3_PCM_QUEUE 16u
+#define AT3_PCM_SAMPLES 2048u
+#define AT3_ITEM_EA(h) (VM_HLE_INJECT_BASE + 0x60000u + (h) * 0x20000u)
+#define AT3_PCM_EA(h) (AT3_ITEM_EA(h) + 0x100u)
+typedef struct {
+    u8* bytes;
+    u32 size, au_addr, au_size;
+    u64 pts, userdata;
+} AdecAt3Pcm;
+typedef struct {
+    void* decoder;
+    u32 rate, config, channels, output_channels, word_size, frame_bytes;
+    u32 head, count;
+    u64 next_pts, remainder;
+    int has_pts;
+    float planes[8][AT3_PCM_SAMPLES];
+    AdecAt3Pcm queue[AT3_PCM_QUEUE];
+} AdecAt3;
+static AdecAt3 s_adec_at3[MAX_ADEC];
+static int adec_is_at3(u32 type)
+{
+    return type == CELL_ADEC_TYPE_ATRACX || (type >= CELL_ADEC_TYPE_ATRACX_2CH && type <= CELL_ADEC_TYPE_ATRACX_8CH);
+}
+static void adec_at3_clear(u32 handle)
+{
+    AdecAt3* d = &s_adec_at3[handle];
+    if (d->decoder) at3p_close(d->decoder);
+    for (u32 i = 0; i < AT3_PCM_QUEUE; i++) free(d->queue[i].bytes);
+    memset(d, 0, sizeof(*d));
+}
+static u32 adec_at3_channels(u32 config)
+{
+    static const u8 channels[8] = {0, 1, 2, 3, 4, 6, 7, 8};
+    return config < 8 ? channels[config] : 0;
+}
+static s32 adec_at3_start(u32 handle, u32 param)
+{
+    if (!param) return (s32)CELL_ADEC_ERROR_ARG;
+    u32 rate = vm_read32(param), config = vm_read32(param + 4);
+    u32 channels = adec_at3_channels(config), out = vm_read32(param + 8);
+    u32 bytes = vm_read32(param + 12), word = vm_read32(param + 20);
+    u32 ats = vm_read8(param + 25);
+    /* GT6 supplies zero rate/config/size with ATS=1. Those fields are then
+     * carried by each 0FD0 access-unit header, not by StartSeq. */
+    if ((rate != 48000 && rate != 44100 && !(rate == 0 && ats == 1)) || config > 7 || out > 8 ||
+        (word != 0x84 && word != 2 && word != 3 && word != 4) || bytes > 65536)
+        return (s32)CELL_ADEC_ERROR_ARG;
+    if (!out) out = channels;
+    if (channels && out != channels && out != 2) return (s32)CELL_ADEC_ERROR_ARG;
+    u32 generation = codec_cb_cancel(&s_adec_callbacks[handle], 0);
+    codec_diag_reset(&s_adec_callbacks[handle]);
+    AT3_LOCK();
+    /* The bundled decoder's flush is a no-op; recreate its overlap state. */
+    adec_at3_clear(handle);
+    AdecAt3* d = &s_adec_at3[handle];
+    d->rate = rate; d->config = config; d->channels = channels;
+    d->output_channels = out; d->word_size = word; d->frame_bytes = bytes;
+    s_adec[handle].itemEa = AT3_ITEM_EA(handle);
+    s_adec[handle].cbGeneration = generation;
+    s_adec[handle].pcmEa = AT3_PCM_EA(handle);
+    s_adec[handle].seqStarted = 1; s_adec[handle].hasPcm = 0;
+    AT3_UNLOCK();
+    printf("[cellAdec] ATRAC3plus rate=%u config=%u channels=%u out=%u frame=%u word=0x%X ATS=%u\n",
+           rate, config, channels, out, bytes, word, ats);
+    return CELL_OK;
+}
+static void adec_at3_item(u32 handle)
+{
+    AdecAt3* d = &s_adec_at3[handle];
+    if (!d->count) return;
+    AdecAt3Pcm* p = &d->queue[d->head];
+    u32 item = AT3_ITEM_EA(handle), bsi = item + 0x40;
+    vm_write32(item, handle); vm_write32(item + 4, CELL_OK);
+    vm_write32(item + 8, AT3_PCM_EA(handle)); vm_write32(item + 12, p->size);
+    vm_write32(item + 16, bsi); vm_write32(item + 20, 0);
+    vm_write32(item + 24, p->au_addr); vm_write32(item + 28, p->au_size);
+    vm_write64(item + 32, p->pts); vm_write64(item + 40, p->userdata);
+    vm_write32(bsi, d->rate); vm_write32(bsi + 4, d->config); vm_write32(bsi + 8, d->frame_bytes);
+    memcpy(vm_ptr8(AT3_PCM_EA(handle)), p->bytes, p->size);
+}
+static float adec_at3_sample(const AdecAt3* d, u32 ch, u32 i)
+{
+    if (d->output_channels == d->channels) return d->planes[ch][i];
+    if (d->channels == 1) return d->planes[0][i];
+    /* ATRAC's 5.1 plane order is L,R,C,SL,SR,LFE. The normal GT6 movie
+     * track has its own stereo stream; this only serves explicit downmix. */
+    float value = d->planes[ch][i];
+    if (d->channels >= 3) value += 0.70710678f * d->planes[2][i];
+    if (d->channels >= 5) value += 0.70710678f * d->planes[3 + ch][i];
+    if (d->channels >= 6) value += 0.5f * d->planes[5][i];
+    if (d->channels >= 8) value += 0.5f * d->planes[6 + ch][i];
+    return value;
+}
+static void adec_at3_pack(u8* out, float sample, u32 word)
+{
+    u32 bits;
+    if (!isfinite(sample)) sample = 0;
+    if (word == 0x84) { memcpy(&bits, &sample, 4); word = 4; }
+    else {
+        double value = sample;
+        if (value < -1.0) value = -1.0;
+        if (value > 1.0) value = 1.0;
+        double scale = word == 2 ? 32768.0 : word == 3 ? 8388608.0 : 2147483648.0;
+        if (value >= 1.0) bits = (u32)(scale - 1.0);
+        else bits = (u32)(s32)(value * scale);
+    }
+    for (u32 b = 0; b < word; b++) out[b] = (u8)(bits >> ((word - 1 - b) * 8));
+}
+static s32 adec_at3_decode(u32 handle, u32 au)
+{
+    AdecSlot* slot = &s_adec[handle];
+    AT3_LOCK();
+    AdecAt3* d = &s_adec_at3[handle];
+    if (!slot->seqStarted) { AT3_UNLOCK(); return (s32)CELL_ADEC_ERROR_SEQ; }
+    if (d->count == AT3_PCM_QUEUE) {
+        codec_diag_event(&s_adec_callbacks[handle], CODEC_DIAG_BUSY, 0, 0, d->count);
+        AT3_UNLOCK(); return (s32)CELL_ADEC_ERROR_BUSY;
+    }
+    u32 addr = vm_read32(au), n = vm_read32(au + 4), skip = 0;
+    if (!addr || !n || n > 65544 || (u64)addr + n > 0x100000000ull) { AT3_UNLOCK(); return (s32)CELL_ADEC_ERROR_ARG; }
+    const u8* bytes = vm_ptr8(addr);
+    if (n >= 8 && bytes[0] == 0x0f && bytes[1] == 0xd0) {
+        static const u32 sample_rates[8] = {32000, 44100, 48000, 88200, 96000, 0, 0, 0};
+        u32 expected = ((((u32)bytes[2] & 3) << 8) | bytes[3]) * 8 + 16;
+        u32 config = (bytes[2] >> 2) & 7;
+        u32 rate = sample_rates[bytes[2] >> 5];
+        if (expected != n || !rate || (d->rate && d->rate != rate) || !adec_at3_channels(config) || (d->config && config != d->config)) { AT3_UNLOCK(); return (s32)CELL_ADEC_ERROR_ARG; }
+        d->rate = rate;
+        d->config = config; d->channels = adec_at3_channels(config); skip = 8;
+        if (!d->output_channels) d->output_channels = d->channels;
+    }
+    if (!d->rate || !d->channels || !d->output_channels || (d->output_channels != d->channels && d->output_channels != 2)) { AT3_UNLOCK(); return (s32)CELL_ADEC_ERROR_ARG; }
+    if (!d->decoder) {
+        int align = (int)(n - skip);
+        d->decoder = at3p_open((int)d->channels, &align);
+        if (!d->decoder) { AT3_UNLOCK(); return (s32)CELL_ADEC_ERROR_FATAL; }
+        d->frame_bytes = n - skip;
+    }
+    u32 word_bytes = d->word_size == 0x84 ? 4 : d->word_size;
+    u32 pcm_bytes = AT3_PCM_SAMPLES * d->output_channels * word_bytes;
+    u8* pcm = (u8*)malloc(pcm_bytes);
+    if (!pcm) { AT3_UNLOCK(); return (s32)CELL_ADEC_ERROR_FATAL; }
+    float* planes[8]; for (u32 c = 0; c < 8; c++) planes[c] = d->planes[c];
+    u64 decode_start = codec_stats_enabled ? codec_clock_us() : 0;
+    int samples = 0, consumed = at3p_decode_planar(d->decoder, planes, &samples, bytes + skip, (int)(n - skip));
+    if (consumed < 0 || samples != AT3_PCM_SAMPLES) {
+        free(pcm); AT3_UNLOCK();
+        fprintf(stderr, "[cellAdec] ATRAC3plus invalid AU bytes=%u decode=%d samples=%d\n", n, consumed, samples);
+        return (s32)CELL_ADEC_ERROR_AU;
+    }
+    for (u32 i = 0; i < AT3_PCM_SAMPLES; i++) for (u32 c = 0; c < d->output_channels; c++)
+        adec_at3_pack(pcm + (i * d->output_channels + c) * word_bytes, adec_at3_sample(d, c, i), d->word_size);
+    u64 pts = vm_read64(au + 8);
+    if (pts != ~(u64)0) { d->next_pts = pts; d->has_pts = 1; d->remainder = 0; }
+    else pts = d->has_pts ? d->next_pts : ~(u64)0;
+    if (d->has_pts) {
+        u64 duration = AT3_PCM_SAMPLES * 90000ull + d->remainder;
+        d->next_pts += duration / d->rate; d->remainder = duration % d->rate;
+    }
+    AdecAt3Pcm* p = &d->queue[(d->head + d->count) % AT3_PCM_QUEUE];
+    p->bytes = pcm; p->size = pcm_bytes; p->au_addr = addr; p->au_size = n;
+    p->pts = pts; p->userdata = vm_read64(au + 16);
+    d->count++; slot->hasPcm = 1; slot->auCount++;
+    codec_diag_event(&s_adec_callbacks[handle], CODEC_DIAG_INPUT, vm_read64(au + 8), n, d->count);
+    codec_diag_event(&s_adec_callbacks[handle], CODEC_DIAG_PRODUCED, pts, 0, d->count);
+    if (decode_start) codec_diag_event(&s_adec_callbacks[handle], CODEC_DIAG_WORK, 0, codec_clock_us() - decode_start, d->count);
+    adec_notify(handle, CELL_ADEC_MSG_TYPE_AUDONE, (s32)au);
+    adec_notify(handle, CELL_ADEC_MSG_TYPE_PCMOUT, CELL_OK);
+    AT3_UNLOCK();
+    return CELL_OK;
+}
+static s32 adec_at3_get(u32 handle, u32 out, int item)
+{
+    if (codec_stats_enabled && !item) codec_role_name("output");
+    AT3_LOCK(); AdecAt3* d = &s_adec_at3[handle];
+    if (!d->count) { AT3_UNLOCK(); return (s32)CELL_ADEC_ERROR_EMPTY; }
+    if (item) {
+        if (!out) { AT3_UNLOCK(); return (s32)CELL_ADEC_ERROR_ARG; }
+        adec_at3_item(handle); vm_write32(out, AT3_ITEM_EA(handle));
+    } else {
+        AdecAt3Pcm* p = &d->queue[d->head];
+        codec_diag_event(&s_adec_callbacks[handle], CODEC_DIAG_CONSUMED, p->pts, 0, d->count - 1);
+        if (out) memcpy(vm_ptr8(out), p->bytes, p->size);
+        free(p->bytes); memset(p, 0, sizeof(*p));
+        d->head = (d->head + 1) % AT3_PCM_QUEUE; d->count--;
+        s_adec[handle].hasPcm = d->count != 0;
+    }
+    AT3_UNLOCK(); return CELL_OK;
+}
