diff --git a/libs/codec/vdec_mf.cpp b/libs/codec/vdec_mf.cpp
new file mode 100644
index 0000000..84df6f7
--- /dev/null
+++ b/libs/codec/vdec_mf.cpp
@@ -0,0 +1,261 @@
+/* Windows H.264 decoding with the system MFT and a D3D11 video device.
+ * Compressed frames are decoded by DXVA; only the final NV12 surface is
+ * downloaded to satisfy cellVdec's guest-memory picture contract. The RSX
+ * renderer still owns the title's composition and presentation timestamps.
+ * See https://learn.microsoft.com/windows/win32/medfound/supporting-direct3d-11-video-decoding-in-media-foundation
+ */
+#include "vdec_mf.h"
+#include "cellVdec.h"
+#include "h264_sps.h"
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <d3d11.h>
+#include <d3d10.h>
+#include <mfapi.h>
+#include <mfidl.h>
+#include <mferror.h>
+#include <mftransform.h>
+#include <wmcodecdsp.h>
+#include <wrl/client.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+using Microsoft::WRL::ComPtr;
+struct VdecMf {
+    ComPtr<IMFTransform> decoder;
+    ComPtr<ID3D11Device> device;
+    ComPtr<ID3D11DeviceContext> context;
+    ComPtr<IMFDXGIDeviceManager> manager;
+    ComPtr<ID3D11Texture2D> staging;
+    UINT width = 0, height = 0;
+    UINT stageWidth = 0, stageHeight = 0;
+    UINT rateNum = 0, rateDen = 0;
+    UINT pictures = 0;
+    bool outputReady = false;
+    H264SpsInfo sps{};
+};
+
+static bool mf_thread_ready()
+{
+    /* The system H.264 MFT is free-threaded. Each calling PPU host thread
+     * joins the MTA once; cellVdec serializes all calls to the decoder. */
+    struct Apartment {
+        HRESULT hr = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+        ~Apartment() { if (SUCCEEDED(hr)) CoUninitialize(); }
+    };
+    thread_local Apartment apartment;
+    return SUCCEEDED(apartment.hr) || apartment.hr == RPC_E_CHANGED_MODE;
+}
+
+static HRESULT mf_output_type(VdecMf* d)
+{
+    for (DWORD i = 0; ; ++i) {
+        ComPtr<IMFMediaType> type;
+        HRESULT hr = d->decoder->GetOutputAvailableType(0, i, &type);
+        if (FAILED(hr)) return hr;
+        GUID subtype{};
+        if (FAILED(type->GetGUID(MF_MT_SUBTYPE, &subtype)) || subtype != MFVideoFormat_NV12) continue;
+        hr = d->decoder->SetOutputType(0, type.Get(), 0);
+        if (FAILED(hr)) continue;
+        UINT w = 0, h = 0;
+        hr = MFGetAttributeSize(type.Get(), MF_MT_FRAME_SIZE, &w, &h);
+        if (FAILED(hr) || !w || !h || w > 4096 || h > 4096) return E_INVALIDARG;
+        d->width = w; d->height = h;
+        MFGetAttributeRatio(type.Get(), MF_MT_FRAME_RATE, &d->rateNum, &d->rateDen);
+        d->outputReady = true;
+        return S_OK;
+    }
+}
+
+extern "C" VdecMf* vdec_mf_open(u32 codec_type)
+{
+    const char* setting = std::getenv("PS3_VDEC_MF");
+    if (codec_type != CELL_VDEC_CODEC_TYPE_AVC || (setting && !std::strcmp(setting, "0"))) return nullptr;
+    if (!mf_thread_ready()) return nullptr;
+    static std::once_flag init;
+    static HRESULT startup = E_FAIL;
+    std::call_once(init, [] { startup = MFStartup(MF_VERSION, MFSTARTUP_LITE); });
+    if (FAILED(startup)) return nullptr;
+    VdecMf* d = new (std::nothrow) VdecMf;
+    if (!d) return nullptr;
+    const D3D_FEATURE_LEVEL levels[] = {D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0};
+    HRESULT hr = D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr,
+        D3D11_CREATE_DEVICE_VIDEO_SUPPORT | D3D11_CREATE_DEVICE_BGRA_SUPPORT,
+        levels, 2, D3D11_SDK_VERSION, &d->device, nullptr, &d->context);
+    if (SUCCEEDED(hr)) {
+        ComPtr<ID3D10Multithread> multithread;
+        if (SUCCEEDED(d->device.As(&multithread))) multithread->SetMultithreadProtected(TRUE);
+        UINT token = 0;
+        hr = MFCreateDXGIDeviceManager(&token, &d->manager);
+        if (SUCCEEDED(hr)) hr = d->manager->ResetDevice(d->device.Get(), token);
+    }
+    if (SUCCEEDED(hr)) hr = CoCreateInstance(CLSID_CMSH264DecoderMFT, nullptr,
+        CLSCTX_INPROC_SERVER, IID_PPV_ARGS(&d->decoder));
+    if (SUCCEEDED(hr)) {
+        ComPtr<IMFAttributes> attrs;
+        UINT aware = 0;
+        hr = d->decoder->GetAttributes(&attrs);
+        if (SUCCEEDED(hr)) hr = attrs->GetUINT32(MF_SA_D3D11_AWARE, &aware);
+        if (SUCCEEDED(hr) && !aware) hr = MF_E_UNSUPPORTED_D3D_TYPE;
+        if (SUCCEEDED(hr)) hr = d->decoder->ProcessMessage(MFT_MESSAGE_SET_D3D_MANAGER,
+            reinterpret_cast<ULONG_PTR>(d->manager.Get()));
+    }
+    if (SUCCEEDED(hr)) {
+        ComPtr<IMFMediaType> input;
+        hr = MFCreateMediaType(&input);
+        if (SUCCEEDED(hr)) hr = input->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Video);
+        if (SUCCEEDED(hr)) hr = input->SetGUID(MF_MT_SUBTYPE, MFVideoFormat_H264);
+        if (SUCCEEDED(hr)) hr = input->SetUINT32(MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive);
+        if (SUCCEEDED(hr)) hr = d->decoder->SetInputType(0, input.Get(), 0);
+    }
+    if (SUCCEEDED(hr)) hr = d->decoder->ProcessMessage(MFT_MESSAGE_NOTIFY_BEGIN_STREAMING, 0);
+    if (SUCCEEDED(hr)) hr = d->decoder->ProcessMessage(MFT_MESSAGE_NOTIFY_START_OF_STREAM, 0);
+    if (FAILED(hr)) {
+        std::fprintf(stderr, "[cellVdec-MF] D3D11 H.264 initialization failed: %08lx\n", (unsigned long)hr);
+        delete d;
+        return nullptr;
+    }
+    std::fprintf(stderr, "[cellVdec-MF] H.264 system MFT with D3D11 video device; awaiting a DXGI decoded surface\n");
+    return d;
+}
+
+static HRESULT mf_emit_picture(VdecMf* d, IMFSample* sample, vdec_ff_emit_fn emit, void* ctx)
+{
+    ComPtr<IMFMediaBuffer> buffer;
+    HRESULT hr = sample->GetBufferByIndex(0, &buffer);
+    ComPtr<IMFDXGIBuffer> dxgi;
+    if (SUCCEEDED(hr)) hr = buffer.As(&dxgi);
+    if (FAILED(hr)) return hr; /* Never label a CPU-buffer fallback as hardware decode. */
+    ComPtr<ID3D11Texture2D> texture;
+    if (SUCCEEDED(hr)) hr = dxgi->GetResource(IID_PPV_ARGS(&texture));
+    UINT subresource = 0;
+    if (SUCCEEDED(hr)) hr = dxgi->GetSubresourceIndex(&subresource);
+    if (FAILED(hr)) return hr;
+    D3D11_TEXTURE2D_DESC desc{};
+    texture->GetDesc(&desc);
+    if (desc.Format != DXGI_FORMAT_NV12 || desc.Width < d->width || desc.Height < d->height)
+        return MF_E_INVALIDMEDIATYPE;
+    if (!d->staging || desc.Width != d->stageWidth || desc.Height != d->stageHeight) {
+        d->staging.Reset();
+        D3D11_TEXTURE2D_DESC stage = desc;
+        stage.MipLevels = stage.ArraySize = 1;
+        stage.BindFlags = stage.MiscFlags = 0;
+        stage.Usage = D3D11_USAGE_STAGING;
+        stage.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        hr = d->device->CreateTexture2D(&stage, nullptr, &d->staging);
+        if (FAILED(hr)) return hr;
+        d->stageWidth = desc.Width; d->stageHeight = desc.Height;
+    }
+    d->context->CopySubresourceRegion(d->staging.Get(), 0, 0, 0, 0, texture.Get(), subresource, nullptr);
+    D3D11_MAPPED_SUBRESOURCE map{};
+    hr = d->context->Map(d->staging.Get(), 0, D3D11_MAP_READ, 0, &map);
+    if (FAILED(hr)) return hr;
+    const UINT w = d->sps.width && d->sps.width <= d->width ? d->sps.width : d->width;
+    const UINT h = d->sps.height && d->sps.height <= d->height ? d->sps.height : d->height;
+    const UINT cw = (w + 1) / 2, ch = (h + 1) / 2;
+    VdecFfPicture pic{};
+    pic.yuv = static_cast<u8*>(std::malloc(static_cast<size_t>(w) * h + 2ull * cw * ch));
+    if (!pic.yuv) { d->context->Unmap(d->staging.Get(), 0); return E_OUTOFMEMORY; }
+    const u8* src = static_cast<const u8*>(map.pData);
+    for (UINT y = 0; y < h; ++y) std::memcpy(pic.yuv + static_cast<size_t>(y) * w, src + static_cast<size_t>(y) * map.RowPitch, w);
+    src += static_cast<size_t>(map.RowPitch) * desc.Height;
+    u8* u = pic.yuv + static_cast<size_t>(w) * h;
+    u8* v = u + static_cast<size_t>(cw) * ch;
+    for (UINT y = 0; y < ch; ++y) {
+        const u8* row = src + static_cast<size_t>(y) * map.RowPitch;
+        for (UINT x = 0; x < cw; ++x) { u[y * cw + x] = row[x * 2]; v[y * cw + x] = row[x * 2 + 1]; }
+    }
+    d->context->Unmap(d->staging.Get(), 0);
+    LONGLONG timestamp = 0;
+    sample->GetSampleTime(&timestamp);
+    pic.token = static_cast<u32>(timestamp);
+    pic.width = w; pic.height = h;
+    pic.key = MFGetAttributeUINT32(sample, MFSampleExtension_CleanPoint, 0) != 0;
+    pic.pict_type = pic.key ? 1 : 0;
+    const UINT rateNum = d->sps.rate_num ? d->sps.rate_num : d->rateNum;
+    const UINT rateDen = d->sps.rate_den ? d->sps.rate_den : d->rateDen;
+    pic.frame_ticks = rateNum && rateDen ? static_cast<u32>((90000ull * rateDen + rateNum / 2) / rateNum) : 0;
+    if (++d->pictures == 1)
+        std::fprintf(stderr, "[cellVdec-MF] verified DXGI NV12 output %ux%u, rate=%u/%u; guest output uses staging readback\n", w, h, rateNum, rateDen);
+    emit(ctx, &pic);
+    return S_OK;
+}
+
+static HRESULT mf_receive(VdecMf* d, vdec_ff_emit_fn emit, void* ctx)
+{
+    for (unsigned guard = 0; guard < 128; ++guard) {
+        if (!d->outputReady) {
+            HRESULT hr = mf_output_type(d);
+            if (FAILED(hr)) return hr == MF_E_TRANSFORM_TYPE_NOT_SET ? S_OK : hr;
+        }
+        MFT_OUTPUT_STREAM_INFO info{};
+        HRESULT hr = d->decoder->GetOutputStreamInfo(0, &info);
+        if (FAILED(hr)) return hr;
+        MFT_OUTPUT_DATA_BUFFER out{};
+        ComPtr<IMFSample> supplied;
+        if (!(info.dwFlags & (MFT_OUTPUT_STREAM_PROVIDES_SAMPLES | MFT_OUTPUT_STREAM_CAN_PROVIDE_SAMPLES))) {
+            /* DXVA MFT output must own its decoder surfaces. */
+            return MF_E_UNSUPPORTED_D3D_TYPE;
+        }
+        DWORD status = 0;
+        hr = d->decoder->ProcessOutput(0, 1, &out, &status);
+        if (out.pEvents) out.pEvents->Release();
+        ComPtr<IMFSample> sample;
+        sample.Attach(out.pSample);
+        if (hr == MF_E_TRANSFORM_NEED_MORE_INPUT) return S_OK;
+        if (hr == MF_E_TRANSFORM_STREAM_CHANGE) { d->outputReady = false; continue; }
+        if (FAILED(hr)) return hr;
+        if (sample) {
+            hr = mf_emit_picture(d, sample.Get(), emit, ctx);
+            if (FAILED(hr)) return hr;
+        }
+    }
+    return E_UNEXPECTED;
+}
+
+extern "C" int vdec_mf_decode(VdecMf* d, const u8* au, u32 size, u32 token,
+                               vdec_ff_emit_fn emit, void* ctx)
+{
+    if (!d || !au || !size || !emit || !mf_thread_ready()) return static_cast<int>(E_INVALIDARG);
+    h264_find_sps(au, size, &d->sps);
+    ComPtr<IMFMediaBuffer> buffer;
+    ComPtr<IMFSample> sample;
+    HRESULT hr = MFCreateMemoryBuffer(size, &buffer);
+    BYTE* dst = nullptr;
+    if (SUCCEEDED(hr)) hr = buffer->Lock(&dst, nullptr, nullptr);
+    if (SUCCEEDED(hr)) { std::memcpy(dst, au, size); buffer->Unlock(); hr = buffer->SetCurrentLength(size); }
+    if (SUCCEEDED(hr)) hr = MFCreateSample(&sample);
+    if (SUCCEEDED(hr)) hr = sample->AddBuffer(buffer.Get());
+    if (SUCCEEDED(hr)) hr = sample->SetSampleTime(token);
+    if (SUCCEEDED(hr)) hr = sample->SetSampleDuration(1);
+    if (SUCCEEDED(hr)) {
+        hr = d->decoder->ProcessInput(0, sample.Get(), 0);
+        if (hr == MF_E_NOTACCEPTING) {
+            hr = mf_receive(d, emit, ctx);
+            if (SUCCEEDED(hr)) hr = d->decoder->ProcessInput(0, sample.Get(), 0);
+        }
+    }
+    if (SUCCEEDED(hr)) hr = mf_receive(d, emit, ctx);
+    if (FAILED(hr)) std::fprintf(stderr, "[cellVdec-MF] AU token=%u size=%u failed: %08lx\n", token, size, (unsigned long)hr);
+    return FAILED(hr) ? static_cast<int>(hr) : 0;
+}
+
+extern "C" void vdec_mf_reset(VdecMf* d)
+{
+    if (!d || !mf_thread_ready()) return;
+    d->decoder->ProcessMessage(MFT_MESSAGE_COMMAND_FLUSH, 0);
+    d->decoder->ProcessMessage(MFT_MESSAGE_NOTIFY_START_OF_STREAM, 0);
+}
+extern "C" void vdec_mf_drain(VdecMf* d, vdec_ff_emit_fn emit, void* ctx)
+{
+    if (!d || !mf_thread_ready()) return;
+    d->decoder->ProcessMessage(MFT_MESSAGE_NOTIFY_END_OF_STREAM, 0);
+    d->decoder->ProcessMessage(MFT_MESSAGE_COMMAND_DRAIN, 0);
+    mf_receive(d, emit, ctx);
+    vdec_mf_reset(d);
+}
+extern "C" void vdec_mf_close(VdecMf* d) { delete d; }
+#endif
