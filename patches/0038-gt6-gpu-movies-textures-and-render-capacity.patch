+/* Reduce FXC's work on cold decompiled pixel shaders without changing the
+ * shader's register declarations, compiler flags, or disk-cache identity.
+ * Call only on a private compile-input copy. Unsupported source is untouched. */
+#ifndef RSX_FP_COMPILE_INIT_H
+#define RSX_FP_COMPILE_INIT_H
+#include <stddef.h>
+#include <string.h>
+
+typedef struct rsx_fp_init_reduction {
+    size_t source_length;
+    unsigned declared_registers, initialized_registers;
+} rsx_fp_init_reduction;
+
+static int rsx_fp_init_space(unsigned c)
+{ return c == ' ' || c == '\t' || c == '\r' || c == '\n'; }
+static int rsx_fp_init_ident(unsigned c)
+{ return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'; }
+static int rsx_fp_init_digit(unsigned c) { return c >= '0' && c <= '9'; }
+
+static int rsx_fp_reduce_unused_init(char* text, size_t length,
+                                     rsx_fp_init_reduction* result)
+{
+    static const char decl48[] = "float4 r[48]; float4 h[48];";
+    static const char decl64[] = "float4 r[64]; float4 h[64];";
+    static const char loop48[] = "[unroll] for (int _i = 0; _i < 48; _i++) { r[_i] = (float4)0; h[_i] = (float4)0; }";
+    static const char loop64[] = "[unroll] for (int _i = 0; _i < 64; _i++) { r[_i] = (float4)0; h[_i] = (float4)0; }";
+    if (result) memset(result, 0, sizeof(*result));
+    if (!text || !length || length > 256u * 1024u || text[length]) return 0;
+    char* d48 = strstr(text, decl48), *d64 = strstr(text, decl64);
+    if ((!d48 && !d64) || (d48 && d64)) return 0;
+    char* decl = d48 ? d48 : d64;
+    const char* declaration = d48 ? decl48 : decl64;
+    const char* initialization = d48 ? loop48 : loop64;
+    const unsigned declared = d48 ? 48u : 64u;
+    char* loop = strstr(text, initialization);
+    if (!loop || strstr(decl + 1, declaration) || strstr(loop + 1, initialization)) return 0;
+    const size_t decl_len = strlen(declaration), loop_len = strlen(initialization);
+    unsigned needed = 0;
+    /* Every use must be an explicit constant subscript. If future emitter
+     * output aliases an array or adds indirect addressing, retain the entire
+     * original initialization. Member swizzles such as value.r are unrelated. */
+    for (const char* p = text; *p; ) {
+        if (p == decl) { p += decl_len; continue; }
+        if (p == loop) { p += loop_len; continue; }
+        if (p[0] == '/' && p[1] == '/') {
+            p += 2; while (*p && *p != '\n') ++p; continue;
+        }
+        if (p[0] == '/' && p[1] == '*') {
+            const char* end = strstr(p + 2, "*/");
+            if (!end) return 0;
+            p = end + 2; continue;
+        }
+        if (*p == '"' || *p == '\'') {
+            const char quote = *p++;
+            while (*p && *p != quote) { if (*p == '\\' && p[1]) ++p; ++p; }
+            if (!*p) return 0;
+            ++p; continue;
+        }
+        if (!rsx_fp_init_ident((unsigned char)*p)) { ++p; continue; }
+        const char* word = p++;
+        while (rsx_fp_init_ident((unsigned char)*p) || rsx_fp_init_digit((unsigned char)*p)) ++p;
+        if (p != word + 1 || (*word != 'r' && *word != 'h')) continue;
+        const char* previous = word;
+        while (previous > text && rsx_fp_init_space((unsigned char)previous[-1])) --previous;
+        if (previous > text && previous[-1] == '.') continue;
+        const char* q = p;
+        while (rsx_fp_init_space((unsigned char)*q)) ++q;
+        if (*q++ != '[') return 0;
+        while (rsx_fp_init_space((unsigned char)*q)) ++q;
+        if (!rsx_fp_init_digit((unsigned char)*q)) return 0;
+        unsigned index = 0;
