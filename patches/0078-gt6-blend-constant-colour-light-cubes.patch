+ * cube are written out (the lamps' places and fall-off, which the road's shader divides the cube's value by) */
+static u32 g_ld_light_units;                       /* the units of the draw being bound that hold such a cube */
+static int ld_light_diag_gate(void)
+{
+    static int on = -1; static const char* gate; static u32 frame = 0xFFFFFFFFu; static int open;
+    if (on < 0) { const char* e = getenv("LD_LIGHT_DIAG"); on = (e && *e == '1') ? 1 : 0; gate = getenv("LD_FRAME_DUMP_GATE"); }
+    if (!on) return 0;
+    if (frame != g_ld_frames) {
+        frame = g_ld_frames; open = 1;
+        if (gate && *gate) { FILE* f = fopen(gate, "rb"); open = f != NULL; if (f) fclose(f); }
+    }
+    return open;
+}
