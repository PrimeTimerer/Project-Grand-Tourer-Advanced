+/* GCM_LABEL_BANK=<hex label offset>: a RELEASE of that label is not lost when the previous one has not been
+ * taken yet.
+ *
+ * Gran Turismo 6 uses label 0x53 (offset 0x530) as a handshake between the RSX and its SPU render jobs. Every
+ * frame's list ends with RELEASE (label := 1); the last of the frame's five parallel jobs waits until the label is
+ * 1, clears it and only then lets the job queue go on. On the console the take of frame N always comes before the
+ * release of list N -- the RSX needs most of a frame for the list, the jobs end within microseconds of each other
+ * -- so every take finds the release of list N-1 waiting and never depends on its own list. Here the walker can
+ * finish list N before the slower SPU side has taken: that release lands on a label that is still 1 and is gone,
+ * the take clears the label, and from then on the last job of every frame waits for the release of its OWN list,
+ * which comes only after the serial job (SPURS workload 6, SPU 0 only) has opened that list's gate. In the first
+ * frame whose last job happens to run on SPU 0 the serial job can never start, and the title stands still.
+ *
+ * It cannot be left like that: as soon as a frame has jobs BEHIND that wait which fill parts of the list (the
+ * menu's 3D scene), the list cannot end before the take, and a take that waits for its own list never comes.
+ *
+ * So for this one label a release that finds the label already set is kept and written back when an SPU clears
+ * the label: every release is consumed by exactly one take, in order, as on the console (the SPU side can be
+ * several lists behind in the light frames before the 3D scene, so the count is not capped at one). While nobody
+ * takes (64 releases in a row) at most one release is kept, so that the first frame with parallel jobs
+ * -- whose list the walker has usually finished before its last job takes -- starts in step. When that first
+ * take comes before its list's release instead, the title is one release ahead of the console from then on:
+ * its jobs wait for the list before the previous one. That costs no correctness here (nothing is drawn from a
+ * list before the RSX has it), only a frame of the title's own throttle. */
+/* A port's trace sink for walker events (GCM_PARK_LOG / GCM_LABEL_LOG): NULL unless the port sets it, e.g. to the
+ * SPU runtime's spu_atom_ring_note so that RSX and SPU events share one clock. */
+void (*g_gcm_trace_note)(const char* fmt, ...) = 0;
+
+static long s_bank_off = -2;                /* label offset; -1 = off */
+static u32  s_bank_val = 1;
+static int  s_bank_count = 0;               /* releases kept for the next take(s) */
+static int  s_bank_rel_since_take = 100;    /* releases since the last take; large = nobody takes */
+static char s_bank_lock = 0;
+unsigned long g_gcm_label_bank_kept = 0, g_gcm_label_bank_given = 0;
+
+static long gcm_label_bank_off(void)
+{
+    if (s_bank_off == -2) { const char* e = getenv("GCM_LABEL_BANK"); s_bank_off = (e && *e) ? strtol(e, NULL, 16) : -1; }
+    return s_bank_off;
+}
+static void gcm_bank_lock(void)   { while (__atomic_test_and_set(&s_bank_lock, __ATOMIC_ACQUIRE)) { } }
+static void gcm_bank_unlock(void) { __atomic_clear(&s_bank_lock, __ATOMIC_RELEASE); }
+
+/* The walker's RELEASE of the banked label. Returns 1 when the release was kept instead of written. */
+static int gcm_label_bank_release(u32 la, u32 v)
+{
+    int kept = 0;
+    gcm_bank_lock();
+    const u32 was = vm_read32(la);
+    if (was != v) vm_write32(la, v);
+    else if (s_bank_rel_since_take < 64) { if (s_bank_count < 1024) s_bank_count++; s_bank_val = v; g_gcm_label_bank_kept++; kept = 1; }
+    else { s_bank_count = 1; s_bank_val = v; }      /* nobody takes: one is kept, never more (see above) */
+    if (s_bank_rel_since_take < 100) s_bank_rel_since_take++;
+    /* GCM_LABEL_BANK_LOG=<n> (diagnostic): the first n releases and takes of the banked label. */
+    { static int want = -1, n = 0;
+      if (want < 0) { const char* e = getenv("GCM_LABEL_BANK_LOG"); want = e ? atoi(e) : 0; }
+      if (n < want) { n++;
+          fprintf(stderr, "[gcm-bank] release: label was %u -> %s, kept %d, releases since the last take %d, t=%llu ms\n",
+                  was, was != v ? "set" : kept ? "kept" : "one kept (nobody takes)", s_bank_count, s_bank_rel_since_take, ps3_ms_now()); } }
+    gcm_bank_unlock();
+    return kept;
+}
+
+/* An SPU PUT that covers the banked label is a take: if it left the label cleared and a release is kept, the
+ * label gets that release now. */
+static void gcm_label_bank_take(u32 ea, u32 size)
+{
+    const long off = gcm_label_bank_off();
+    if (off < 0) return;
+    const u32 la = GCM_LABEL_GUEST_BASE + ((u32)off & 0xFFFFu);
+    if (ea > la || la + 4u > ea + size) return;
+    gcm_bank_lock();
+    const int since = s_bank_rel_since_take;
+    const u32 now_v = vm_read32(la);
+    int given = 0;
+    s_bank_rel_since_take = 0;
+    if (s_bank_count > 0 && now_v != s_bank_val) { vm_write32(la, s_bank_val); s_bank_count--; g_gcm_label_bank_given++; given = 1; }
+    { static int want = -1, n = 0;
+      if (want < 0) { const char* e = getenv("GCM_LABEL_BANK_LOG"); want = e ? atoi(e) : 0; }
+      if (n < want) { n++;
+          fprintf(stderr, "[gcm-bank] take: SPU PUT ea=0x%08X size=%u left the label %u -> %s, kept %d, releases since the previous take %d, t=%llu ms\n",
+                  ea, size, now_v, given ? "a kept release is given" : "nothing given", s_bank_count, since, ps3_ms_now()); } }
+    gcm_bank_unlock();
+}
+
 void gcm_note_spu_put(u32 ea, u32 size)
 {
+    gcm_label_bank_take(ea, size);
     if (!size || size > 0x40000u) return;
     u32 room = 0;
     u32 io = gcm_ea2io_range(ea, &room);
@@ -2554,6 +2640,7 @@ static void gcm_rsx_process_fifo_unlocked(void)
                     if (want < 0) { const char* e = getenv("GCM_PARK_LOG"); want = e ? atoi(e) : 0; }
                     if (want > 0 && last_park != s_fifo_getoff && n < want) {
                         n++; last_park = s_fifo_getoff;
+                        if (g_gcm_trace_note) g_gcm_trace_note("RSX walker stands at io %08X", s_fifo_getoff);
                         fprintf(stderr, "[park] walker stands at io 0x%08X (ea 0x%08X) put=0x%08X t=%llu ms\n",
                                 s_fifo_getoff, gcm_io2ea(s_fifo_getoff), put, ps3_ms_now());
                     } }
@@ -2668,12 +2755,22 @@ static void gcm_rsx_process_fifo_unlocked(void)
                         if (!gcm_get_eq_put())
                             vm_write32(GCM_CONTROL_GUEST_ADDR + 4, s_fifo_getoff + 4 + count * 4);
                         atomic_thread_fence(memory_order_release);
+                        if (gcm_label_bank_off() == (long)s_sema_offset) {      /* GCM_LABEL_BANK */
+                            if (gcm_label_bank_release(la, v)) {
+                                static int kn = 0;
+                                if (PS3_LOG_FIRST(kn, 8))
+                                    fprintf(stderr, "[cellGcmSys] label off 0x%X: release at get=0x%08X kept for the next take"
+                                            " (the previous one was not taken yet)\n", s_sema_offset, s_fifo_getoff);
+                            }
+                        } else
                         vm_write32(la, v);
                         { static int rn = 0; if (s_sema_offset != 0x400u && PS3_LOG_FIRST(rn, 40))   /* TEMP */
                             fprintf(stderr, "[SEMA-REL] get=0x%08X off=0x%X val=0x%08X\n", s_fifo_getoff, s_sema_offset, v); }
                         /* GCM_LABEL_LOG=<hex offset> (diagnostic): every release of that label (first 400). */
                         { static long want = -2; static int n = 0;
                           if (want == -2) { const char* e = getenv("GCM_LABEL_LOG"); want = e ? strtol(e, NULL, 16) : -1; }
+                          if (want >= 0 && (u32)want == s_sema_offset && g_gcm_trace_note)
+                              g_gcm_trace_note("RSX releases label off %X := %08X at get %08X", s_sema_offset, v, s_fifo_getoff);
                           if (want >= 0 && (u32)want == s_sema_offset && n++ < 400)
                               fprintf(stderr, "[SEMA-REL] label off 0x%X := 0x%08X at get=0x%08X (was 0x%08X) t=%llu ms\n", s_sema_offset, v,
                                       s_fifo_getoff, vm_read32(GCM_LABEL_GUEST_BASE + (s_sema_offset & 0xFFFFu)), ps3_ms_now()); }
