index 0adbdf0..61b118d 100644
--- a/runtime/spu/spu_channels.c
+++ b/runtime/spu/spu_channels.c
@@ -576,6 +576,137 @@ volatile unsigned g_spu_putllc_sync_hit = 0;
  * completion. Chosen above the context/descriptor we park near the top of LS. */
 #define SPU_JOB_RETURN_LS   0x3FF00u
 
+/* SPU_ATOM_RING=<hex ea>[,<hex ea>]: keep the last SPU_ATOM_RING_N lock-line atomics on those 128-byte lines --
+ * SPU, command, pc, lr, the line as it is in memory and, for a PUT, the line being stored and whether it
+ * committed -- and print them with the SPU thread report (spu_atom_ring_dump). Unlike SPU_ATOM_EA nothing is
+ * printed while the title runs, so the timing of a stall stays as it is and the history right before it is kept. */
+#include <stdlib.h>
+#include <time.h>
+#define SPU_ATOM_RING_N 4096
+typedef struct {
+    uint64_t us; uint32_t ea, pc, lr; uint8_t spu, cmd, verdict, pad;
+    uint8_t ram[MFC_ATOMIC_LINE], put[MFC_ATOMIC_LINE];
+} spu_atom_rec;
+static spu_atom_rec* s_ring;
+static long s_ring_n;
+static uint32_t s_ring_ea[2];
+static int s_ring_on = -1;
+
+static int spu_atom_ring_ready(void)
+{
+    if (s_ring_on < 0) {
+        const char* e = getenv("SPU_ATOM_RING");
+        char* end = NULL;
+        if (e && *e) {
+            s_ring_ea[0] = (uint32_t)strtoul(e, &end, 16) & ~127u;
+            s_ring_ea[1] = (end && *end == ',') ? ((uint32_t)strtoul(end + 1, NULL, 16) & ~127u) : 0xFFFFFFFFu;
+            s_ring = (spu_atom_rec*)calloc(SPU_ATOM_RING_N, sizeof(spu_atom_rec));
+        }
+        s_ring_on = s_ring ? 1 : 0;
+    }
+    return s_ring_on;
+}
+
+static uint64_t spu_atom_ring_us(void)
+{
+    struct timespec ts; timespec_get(&ts, TIME_UTC);
+    return (uint64_t)ts.tv_sec * 1000000ull + (uint64_t)(ts.tv_nsec / 1000);
+}
+
+/* A line of text on the same clock, from anywhere (the RSX walker, a watched DMA): spu_atom_ring_note("..."). */
+#include <stdarg.h>
+void spu_atom_ring_note(const char* fmt, ...)
+{
+    if (!spu_atom_ring_ready()) return;
+    const long i = __atomic_fetch_add(&s_ring_n, 1, __ATOMIC_RELAXED);
+    spu_atom_rec* r = &s_ring[(unsigned long)i % SPU_ATOM_RING_N];
+    r->us = spu_atom_ring_us(); r->ea = 0; r->cmd = 0;
+    va_list ap; va_start(ap, fmt);
+    vsnprintf((char*)r->put, sizeof r->put, fmt, ap);
+    va_end(ap);
+}
+
+static spu_atom_rec* spu_atom_ring_add(spu_context* ctx, uint32_t cmd, uint32_t ea, const uint8_t* mem, const uint8_t* ls)
+{
+    if (!spu_atom_ring_ready()) return NULL;
+    if (ea != s_ring_ea[0] && ea != s_ring_ea[1]) {
+        /* SPU_ATOM_RING_PC=<lo>,<hi> (hex LS addresses): also every atomic issued from that code range,
+         * whatever line it is on -- for a helper whose target address is not known yet. */
+        static int pc_on = -1; static uint32_t pc_lo, pc_hi;
+        if (pc_on < 0) {
+            const char* e = getenv("SPU_ATOM_RING_PC"); char* end = NULL;
+            uint32_t lo = 0, hi = 0;
+            if (e && *e) { lo = (uint32_t)strtoul(e, &end, 16); hi = (end && *end == ',') ? (uint32_t)strtoul(end + 1, NULL, 16) : 0; }
+            pc_lo = lo; pc_hi = hi; pc_on = hi > lo ? 1 : 0;
+        }
+        const uint32_t pc = (uint32_t)ctx->pc & SPU_LS_MASK;
+        if (!pc_on || pc < pc_lo || pc >= pc_hi) return NULL;
+    }
+    const long i = __atomic_fetch_add(&s_ring_n, 1, __ATOMIC_RELAXED);
+    spu_atom_rec* r = &s_ring[(unsigned long)i % SPU_ATOM_RING_N];
+    r->us = spu_atom_ring_us();
+    r->ea = ea; r->pc = (uint32_t)ctx->pc & SPU_LS_MASK; r->lr = ctx->gpr[0]._u32[0] & SPU_LS_MASK;
+    r->spu = (uint8_t)(ctx->spu_id & 7u); r->cmd = (uint8_t)cmd; r->verdict = 0xFF;
+    memcpy(r->ram, mem, MFC_ATOMIC_LINE);
+    if (cmd != MFC_GETLLAR_CMD) memcpy(r->put, ls, MFC_ATOMIC_LINE);
+    return r;
+}
+
+static int spu_atom_ring_diff(char* buf, int p, int cap, const uint8_t* a, const uint8_t* b)
+{
+    for (int o = 0; o < MFC_ATOMIC_LINE && p < cap - 24; o += 4)
+        if (memcmp(a + o, b + o, 4))
+            p += snprintf(buf + p, cap - p, " +%02X:%02X%02X%02X%02X>%02X%02X%02X%02X", o,
+                          a[o], a[o + 1], a[o + 2], a[o + 3], b[o], b[o + 1], b[o + 2], b[o + 3]);
+    return p;
+}
+
+void spu_atom_ring_dump(void)
+{
+    if (s_ring_on != 1) return;
+    const long n = s_ring_n, first = n > SPU_ATOM_RING_N ? n - SPU_ATOM_RING_N : 0;
+    fprintf(stderr, "[atom-ring] %ld atomics on 0x%08X / 0x%08X, printing from %ld\n", n, s_ring_ea[0], s_ring_ea[1], first);
+    static uint8_t cur[3][MFC_ATOMIC_LINE];
+    int have[3] = { 0, 0, 0 };
+    uint32_t other_ea = 0;      /* slot 2: lines recorded because of SPU_ATOM_RING_PC */
+    uint64_t t0 = 0;
+    long rep = 0; uint32_t rep_key = 0xFFFFFFFFu;
+    char buf[1600];
+    for (long i = first; i < n; i++) {
+        const spu_atom_rec* r = &s_ring[(unsigned long)i % SPU_ATOM_RING_N];
+        const int k = (r->ea == s_ring_ea[1]) ? 1 : (r->ea == s_ring_ea[0] || r->cmd == 0) ? 0 : 2;
+        if (k == 2 && r->ea != other_ea) { other_ea = r->ea; have[2] = 0; }
+        if (!t0) t0 = r->us;
+        if (r->cmd == 0) {      /* a note */
+            if (rep) { fprintf(stderr, "[atom-ring]      ... the same GETLLAR %ld more time(s)\n", rep); rep = 0; }
+            rep_key = 0xFFFFFFFFu;
+            fprintf(stderr, "[atom-ring] +%10.3f ms      %.127s\n", (double)(r->us - t0) / 1000.0, (const char*)r->put);
+            continue;
+        }
+        const int outside = have[k] && memcmp(cur[k], r->ram, MFC_ATOMIC_LINE) != 0;
+        const uint32_t key = ((uint32_t)r->spu << 28) | ((uint32_t)k << 27) | r->pc;
+        if (r->cmd == MFC_GETLLAR_CMD && !outside && key == rep_key) { rep++; continue; }   /* an unchanged poll */
+        if (rep) { fprintf(stderr, "[atom-ring]      ... the same GETLLAR %ld more time(s)\n", rep); rep = 0; }
+        rep_key = (r->cmd == MFC_GETLLAR_CMD) ? key : 0xFFFFFFFFu;
+        if (outside) {      /* changed by somebody this ring does not see: the PPU, or an SPU's plain DMA */
+            int p = snprintf(buf, sizeof buf, "[atom-ring]      (line %08X changed outside these atomics)", r->ea);
+            p = spu_atom_ring_diff(buf, p, (int)sizeof buf, cur[k], r->ram);
+            fprintf(stderr, "%s\n", buf);
+        }
+        const int committed = r->cmd != MFC_GETLLAR_CMD && (r->cmd != MFC_PUTLLC_CMD || r->verdict == 0);
+        int p = snprintf(buf, sizeof buf, "[atom-ring] +%10.3f ms spu%u %-11s ea=%08X pc=%05X lr=%05X",
+                         (double)(r->us - t0) / 1000.0, r->spu,
+                         r->cmd == MFC_GETLLAR_CMD ? "GETLLAR" : r->cmd != MFC_PUTLLC_CMD ? "PUTLLUC"
+                             : r->verdict == 0 ? "PUTLLC ok" : "PUTLLC FAIL", r->ea, r->pc, r->lr);
+        if (committed) p = spu_atom_ring_diff(buf, p, (int)sizeof buf, r->ram, r->put);
+        fprintf(stderr, "%s\n", buf);
+        memcpy(cur[k], committed ? r->put : r->ram, MFC_ATOMIC_LINE);
+        have[k] = 1;
+    }
+    if (rep) fprintf(stderr, "[atom-ring]      ... the same GETLLAR %ld more time(s)\n", rep);
+    fflush(stderr);
+}
+
 /* Returns 1 if `cmd` is an atomic line op and was handled here, else 0. */
 static int spu_mfc_atomic(spu_context* ctx, uint32_t cmd)
 {
@@ -653,6 +784,8 @@ static int spu_mfc_atomic(spu_context* ctx, uint32_t cmd)
         return 1;
     }
 
+    spu_atom_rec* const ring_rec = spu_atom_ring_add(ctx, cmd, ea, mem, ls);   /* SPU_ATOM_RING */
+
     /* SPU_ATOM_EA=<hex>: log every lock-line atomic touching that EA`s 128B line.
      * SPU_ATOM_FULL=1 additionally dumps 32 bytes of the line before and after.
      *
@@ -926,6 +1059,7 @@ static int spu_mfc_atomic(spu_context* ctx, uint32_t cmd)
               fprintf(stderr, "[atom-ea] PUTLLC %s lr=0x%05X ea=0x%08X\n",
                       ctx->atomic_stat ? "FAIL" : "OK",
                       ctx->gpr[0]._u32[0] & SPU_LS_MASK, ea); }
+        if (ring_rec) ring_rec->verdict = (uint8_t)ctx->atomic_stat;
         ctx->resv_valid = 0;                           /* reservation consumed */
         spu_lockline_unlock();
