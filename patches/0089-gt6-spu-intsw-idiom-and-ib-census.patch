+def compute_intsw_sites(insns) -> dict:
+    """[GT6 0186] The interrupt-switch idiom: `brsl $rT, .+4; ai $rT, $rT, imm; bid/bie/bi $rT` - the SPU has no
+    instruction that only turns interrupts off or on, so the compiler branches to the next instruction (imm = 8) with
+    the D or E bit. Lifted as a computed branch, every pass went through spu_indirect_branch: in Gran Turismo 6's
+    16-car start about three quarters of all indirect branches (census [GT6 0186], ~9 million a second).
+    Returns {bi address: the address rT then holds}. The lifted branch compares rT with it at run time and goes there
+    directly when equal (g_spu_intsw, spu_helpers.h) - any other value takes the generic dispatch as before."""
+    by_addr = {i.addr: i for i in insns}
+    out = {}
+    for i in insns:
+        if i.mnemonic != "bi":
+            continue
+        t = (i.raw >> 7) & 0x7F                      # RR: RA = the register branched to
+        a, b = by_addr.get(i.addr - 4), by_addr.get(i.addr - 8)
+        if a is None or b is None or a.mnemonic != "ai" or b.mnemonic != "brsl" or t == 0:
+            continue
+        if (a.raw & 0x7F) != t or ((a.raw >> 7) & 0x7F) != t or (b.raw & 0x7F) != t:
+            continue
+        if SPULifter._branch_target(b) != a.addr:   # `brsl $rT, .+4`: rT = the ai's own address
+            continue
+        imm = (a.raw >> 14) & 0x3FF
+        if imm & 0x200:
+            imm -= 0x400
+        nxt = (a.addr + imm) & 0x3FFFF
+        if nxt & 3:
+            continue
+        out[i.addr] = nxt
+    return out
+
