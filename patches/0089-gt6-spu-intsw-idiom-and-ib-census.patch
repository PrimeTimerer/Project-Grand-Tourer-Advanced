+/* [GT6 0186] SPU_IB_COUNT=1 (main.cpp sets g_spu_ib_count and prints "[ib]" / "[ibsite]" every 5 s): the census of the
+ * indirect branches. A ring of the last 4096 calls of spu_indirect_branch, two words a call: the lifted function the
+ * branch lands in through the fast path (or, when it does not, 1 << 62 | image << 32 | pc), and where it was called
+ * from - the drain loop for a queued branch (a return at host depth 0, a computed bi), the lifted function itself for
+ * its bisl. Racy on purpose (a census, not a count); g_spu_ib_ring_n also gives the rate. Off: one load, one branch. */
+int g_spu_ib_count = 0;
+volatile uintptr_t g_spu_ib_ring[4096 * 2];
+volatile unsigned g_spu_ib_ring_n = 0;
+#if defined(_MSC_VER) && !defined(__clang__)
+static __declspec(noinline) void spu_ib_note(const spu_context* ctx, spu_fn fn, void* from)
+#else
+static __attribute__((noinline)) void spu_ib_note(const spu_context* ctx, spu_fn fn, void* from)
+#endif
+{
+    const unsigned i = (g_spu_ib_ring_n++ & 4095u) * 2u;
+    g_spu_ib_ring[i] = fn ? (uintptr_t)fn
+                          : (uintptr_t)((1ull << 62) | ((uint64_t)(uint16_t)ctx->image_id << 32) | (ctx->pc & SPU_LS_MASK));
+    g_spu_ib_ring[i + 1] = (uintptr_t)from;
+}
