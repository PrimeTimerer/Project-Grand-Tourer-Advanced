+/* GCM_ZPASS_TEST=1 (tests) [GT6 0056]: the value an unmeasured ZPASS report is answered with goes 0xFFFF / 0 in
+ * turn, 4 s each, with a line at every change. A paused scene dumped in both turns shows what a title does with the
+ * answer - whether anything in the picture depends on it at all. */
+static u32 gcm_zpass_unmeasured(void)
+{
+    static int on = -1, last = -1;
+    if (on < 0) on = getenv("GCM_ZPASS_TEST") != NULL;
+    if (!on) return 0xFFFFu;
+    const int zero = (int)((GetTickCount64() / 4000u) & 1u);
+    if (zero != last) {
+        LARGE_INTEGER q, f;
+        QueryPerformanceCounter(&q); QueryPerformanceFrequency(&f);
+        last = zero;
+        fprintf(stderr, "[zpass-test] reports answered %s from qpc_s=%.3f\n", zero ? "0" : "0xFFFF",
+                (double)q.QuadPart / (double)f.QuadPart);
+    }
+    return zero ? 0u : 0xFFFFu;
+}
