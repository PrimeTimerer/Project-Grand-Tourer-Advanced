+/* ---------------------------------------------------------------------------
+ * ZPASS pixel count [GT6 0056]: NV4097_CLEAR_REPORT_VALUE (0x17C8), SET_ZPASS_PIXEL_COUNT_ENABLE (0x17CC) and
+ * GET_REPORT (0x1800, type 1). A title asks the RSX how many pixels of what it drew passed the depth test - Gran
+ * Turismo 6 does it for the lights it draws a glow for, and shows the glow by the answer. Until now the walker
+ * answered 0xFFFF ("visible") without measuring, so at night the glows of lights behind walls and hills stood in
+ * the picture (2026-11-19: at night, lights far away showed through walls).
+ * Measured with D3D12 occlusion queries: while the enable register is set, the draws of sink_end_impl run inside a
+ * query (one heap slot from the first such draw to the next GET_REPORT, CLEAR, uncounted draw or submit). The
+ * count is known only when the GPU has run that command list, so GET_REPORT hands the report over
+ * (ld_zq_report) and the value is written into the title's report area once the fence of the submit has passed
+ * (ld_zq_poll, at every submit and every report) - a frame late at most; on the console the RSX runs behind the
+ * PPU too. The counter is the RSX's: CLEAR starts it again (an "epoch"), GET_REPORT reads it without clearing. No
+ * counted draw since the CLEAR = 0, at once. Whenever the count cannot be trusted - a group that was left out
+ * while counting (pipeline still being made, a dropped group), no free slot, movie or debug-layer mode - the
+ * report falls back to the slot's last measured count, or to the old answer, "visible".
+ * LD_ZPASS_QUERY=1: on; =ab: measured and "visible" in turn, 4 s each (tests); unset or 0: OFF, everything as
+ * before - see ld_zq_mode for why it is not the default yet. */
+#define LD_ZQ_SLOTS   2048u
+#define LD_ZQ_REPORTS 1024u
+#define LD_ZQ_PER     12u
+enum { LD_ZQ_FREE = 0, LD_ZQ_OPEN, LD_ZQ_ENDED, LD_ZQ_RESOLVED };
+typedef struct { u8 state; u32 epoch; u64 fence; } ld_zq_slot;
+typedef struct { u8 used, main_mem, n; u32 off; u64 sum; u16 slot[LD_ZQ_PER]; } ld_zq_rep_t;
+static struct {
+    int mode;                               /* -1 not read yet, 0 off, 1 on, 2 measured / "visible" in turn */
+    int failed, open;                       /* open: the slot with a BeginQuery in the current list, -1 none */
+    ID3D12QueryHeap* heap;
+    ID3D12Resource* rb;                     /* one u64 a slot, read back */
+    const u64* rb_map;
+    ld_zq_slot slot[LD_ZQ_SLOTS];
+    ld_zq_rep_t rep[LD_ZQ_REPORTS];
+    u32 next, n_ended, n_resolved, n_rep, rep_hi;
+    u32 epoch, issued;                      /* issued: groups drawn inside a query */
+    u64 epoch_sum;                          /* the counts of this epoch that have been read back ... */
+    u16 epoch_slot[LD_ZQ_PER];              /* ... and its slots that have not */
+    u8 epoch_n, epoch_unsure;
+    u32 st_reports, st_now, st_later, st_unsure, st_hidden, st_visible, st_left_out, st_no_slot, st_draws;
+    LONGLONG st_t0;
+    u64 n_reports_total, idle_act;          /* rsx_live_draw_reports_tick: the traffic seen at the last look ... */
+    LONGLONG idle_since;                    /* ... and since when it has stood still with reports waiting (0 = not) */
+    u32 st_idle, st_kept, st_clears;
+    u64 polled_done;                        /* the fence value ld_zq_poll has read the counts up to */
+} zq = { -1, 0, -1 };
+extern void gcm_zpass_report_store(int main_mem, u32 off, u32 value);   /* cellGcmSys.c */
+
+static int ld_zq_mode(void)
+{
+    if (zq.mode < 0) {
+        /* OFF unless asked for [2026-11-20]: Gran Turismo 6 waits for the answer of every report before it goes on
+         * (garage and race, every frame), so an answer that comes when the GPU has the count costs frames - test
+         * drive z3: garage 36 fps, race 18..55 - and what it counts on a daytime track never came out "hidden".
+         * Next step before this may be the default: answer at once with the slot's last measured count. */
+        const char* e = getenv("LD_ZPASS_QUERY");
+        /* =count (mode 3): no query, no answer of ours - only the [zpass] line: how many reports, clears and
+         * counted groups the title sends in a scene (a measuring run costs nothing and changes nothing) */
+        zq.mode = !e ? 0 : *e == '0' ? 0 : (*e == 'a' || *e == 'A') ? 2 : (*e == 'c' || *e == 'C') ? 3 : 1;
+    }
+    return zq.mode;
+}
+
+/* LD_ZPASS_SEQ=<frame> (tests): from that frame on, the first 900 events of the title's pixel counting in the order
+ * they come - C a clear, D a counted group, R a report and what it was answered with, S a count stored when the GPU
+ * had it. How a title uses the counter (one clear a frame or one a light, the same report slots frame after frame)
+ * is read off this. */
+static int ld_zq_seq(void)
+{
+    static int from = -2;
+    static u32 left = 900;
+    if (from == -2) { const char* e = getenv("LD_ZPASS_SEQ"); from = e ? atoi(e) : -1; }
+    if (from < 0 || (int)g_ld_frames < from || !left) return 0;
+    left--;
+    return 1;
+}
+
+static int ld_zq_ready(void)
+{
+    if (zq.heap) return 1;
+    if (zq.failed) return 0;
+    D3D12_QUERY_HEAP_DESC qd; memset(&qd, 0, sizeof qd);
+    qd.Type = D3D12_QUERY_HEAP_TYPE_OCCLUSION; qd.Count = LD_ZQ_SLOTS;
+    D3D12_HEAP_PROPERTIES hp; memset(&hp, 0, sizeof hp);
+    hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC bd; memset(&bd, 0, sizeof bd);
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = (UINT64)LD_ZQ_SLOTS * 8u;
+    bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+    bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    void* p = NULL;
+    HRESULT hr = g.dev->lpVtbl->CreateQueryHeap(g.dev, &qd, &IID_ID3D12QueryHeap, (void**)&zq.heap);
+    if (SUCCEEDED(hr))
+        hr = g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd, D3D12_RESOURCE_STATE_COPY_DEST,
+                                                    NULL, &IID_ID3D12Resource, (void**)&zq.rb);
+    if (SUCCEEDED(hr)) hr = zq.rb->lpVtbl->Map(zq.rb, 0, NULL, &p);
+    if (FAILED(hr) || !p) {
+        fprintf(stderr, "[zpass] no occlusion queries (hr=0x%08lX): reports stay \"visible\"\n", (unsigned long)hr);
+        if (zq.rb) zq.rb->lpVtbl->Release(zq.rb);
+        if (zq.heap) zq.heap->lpVtbl->Release(zq.heap);
+        zq.rb = NULL; zq.heap = NULL; zq.failed = 1;
+        return 0;
+    }
+    zq.rb_map = (const u64*)p;
+    fprintf(stderr, "[zpass] occlusion queries on: %u slots, mode %d (LD_ZPASS_QUERY=0 turns them off)\n", LD_ZQ_SLOTS, zq.mode);
+    return 1;
+}
+
+static void ld_zq_end_open(void)
+{
+    if (zq.open < 0) return;
+    g.list->lpVtbl->EndQuery(g.list, zq.heap, D3D12_QUERY_TYPE_OCCLUSION, (UINT)zq.open);
+    zq.slot[zq.open].state = LD_ZQ_ENDED;
+    zq.n_ended++;
+    zq.open = -1;
+}
+
+/* Right before the draw call(s) of a group (sink_end_impl). */
+static void ld_zq_before_draw(void)
+{
+    if (zq.mode == 0) return;
+    if (!(g.rsx.regs[0x17CCu >> 2] & 1u)) { if (zq.open >= 0) ld_zq_end_open(); return; }
+    if (ld_zq_mode() == 0) return;
+    zq.issued++; zq.st_draws++;
+    if (ld_zq_seq()) fprintf(stderr, "[zseq] f%u D counted group %u epoch %u\n", g_ld_frames, zq.issued, zq.epoch);
+    if (zq.mode == 3) return;               /* counting only */
+    if (zq.open >= 0) {
+        if (zq.slot[zq.open].epoch == zq.epoch) return;
+        ld_zq_end_open();                   /* a CLEAR since: that count belongs to the epoch before */
+    }
+    if (zq.epoch_unsure) return;
+    if (zq.epoch_n >= LD_ZQ_PER || !ld_zq_ready()) { zq.epoch_unsure = 1; return; }
+    u32 k = zq.next, i;
+    for (i = 0; i < LD_ZQ_SLOTS && zq.slot[k].state != LD_ZQ_FREE; i++) k = (k + 1u) % LD_ZQ_SLOTS;
+    if (i == LD_ZQ_SLOTS) { zq.epoch_unsure = 1; zq.st_no_slot++; return; }
+    zq.next = (k + 1u) % LD_ZQ_SLOTS;
+    zq.slot[k].state = LD_ZQ_OPEN; zq.slot[k].epoch = zq.epoch;
+    zq.epoch_slot[zq.epoch_n++] = (u16)k;
+    g.list->lpVtbl->BeginQuery(g.list, zq.heap, D3D12_QUERY_TYPE_OCCLUSION, k);
+    zq.open = (int)k;
+}
+
+/* ld_flush, before the list is closed: a query cannot stay open across lists, and the counts taken in this list
+ * are resolved in it (a later counted draw of the same epoch takes a new slot). */
+static void ld_zq_before_close(void)
+{
+    if (!zq.heap) return;
+    ld_zq_end_open();
+    const u64 fence = g.fence_value + 1u;   /* what ld_flush signals after this list */
+    for (u32 k = 0; k < LD_ZQ_SLOTS && zq.n_ended; ) {
+        if (zq.slot[k].state != LD_ZQ_ENDED) { k++; continue; }
+        u32 n = 1;
+        while (k + n < LD_ZQ_SLOTS && zq.slot[k + n].state == LD_ZQ_ENDED) n++;
+        g.list->lpVtbl->ResolveQueryData(g.list, zq.heap, D3D12_QUERY_TYPE_OCCLUSION, k, n, zq.rb, (UINT64)k * 8u);
+        for (u32 j = 0; j < n; j++) { zq.slot[k + j].state = LD_ZQ_RESOLVED; zq.slot[k + j].fence = fence; }
+        zq.n_ended -= n; zq.n_resolved += n;
+        k += n;
+    }
+}
+
+/* (tests) LD_ZPASS_QUERY=ab: 1 while the old answer has its turn, 4 s each. */
+static int ld_zq_ab_old(void)
+{
+    if (zq.mode != 2) return 0;
+    static int last = -1;
+    const int old = (int)((GetTickCount64() / 4000u) & 1u);
+    if (old != last) {
+        last = old;
+        fprintf(stderr, "[zpass] ab: %s from frame %u\n", old ? "\"visible\" (as before)" : "measured", g_ld_frames);
+    }
+    return old;
+}
+
+/* The last measured count of a report slot (the title asks about the same lights at the same slots frame after
+ * frame): what a report that cannot be measured this once is answered with, so that a hidden light does not
+ * flash "visible" for a frame whenever a group is left out. */
+static struct { u32 key, value; } g_zq_last[8192];
+static u32 ld_zq_last_key(int main_mem, u32 off) { return ((off & 0x00FFFFFFu) | (main_mem ? 0x40000000u : 0u)) + 1u; }
+
+static void ld_zq_store(int main_mem, u32 off, u64 count)
+{
+    u32 value = count > 0xFFFFFFFFull ? 0xFFFFFFFFu : (u32)count;
+    if (value) zq.st_visible++; else zq.st_hidden++;
+    if (ld_zq_seq()) fprintf(stderr, "[zseq] f%u S off 0x%X = %u\n", g_ld_frames, off, value);
+    g_zq_last[(off >> 4) & 8191u].key = ld_zq_last_key(main_mem, off);
+    g_zq_last[(off >> 4) & 8191u].value = value;
+    if (ld_zq_ab_old()) value = 0xFFFFu;
+    gcm_zpass_report_store(main_mem, off, value);
+}
+
+/* A report that cannot be measured: 1 = answered with the slot's last measured count, 0 = none known - the walker
+ * answers "visible", as it always did. */
+static int ld_zq_unsure(int main_mem, u32 off)
+{
+    zq.st_unsure++;
+    if (ld_zq_ab_old()) return 0;
+    const u32 i = (off >> 4) & 8191u;
+    if (g_zq_last[i].key != ld_zq_last_key(main_mem, off)) return 0;
+    zq.st_kept++;
+    gcm_zpass_report_store(main_mem, off, g_zq_last[i].value);
+    return 1;
+}
+
+/* The counts of the submits the GPU has finished: into their epoch and their reports. Costs one read of the
+ * fence while the GPU has finished nothing new. */
+static void ld_zq_poll(void)
+{
+    if (!zq.n_resolved) return;
+    const u64 done = g.fence->lpVtbl->GetCompletedValue(g.fence);
+    if (done == zq.polled_done) return;
+    zq.polled_done = done;
+    for (u32 k = 0; k < LD_ZQ_SLOTS && zq.n_resolved; k++) {
+        ld_zq_slot* s = &zq.slot[k];
+        if (s->state != LD_ZQ_RESOLVED || s->fence > done) continue;
+        const u64 count = zq.rb_map[k];
+        s->state = LD_ZQ_FREE; zq.n_resolved--;
+        if (s->epoch == zq.epoch)
+            for (u32 j = 0; j < zq.epoch_n; j++)
+                if (zq.epoch_slot[j] == k) { zq.epoch_slot[j] = zq.epoch_slot[--zq.epoch_n]; zq.epoch_sum += count; break; }
+        for (u32 r = 0; r < zq.rep_hi && zq.n_rep; r++) {
+            ld_zq_rep_t* p = &zq.rep[r];
+            if (!p->used) continue;
+            for (u32 j = 0; j < p->n; j++)
+                if (p->slot[j] == k) {
+                    p->slot[j] = p->slot[--p->n]; p->sum += count;
