+void (*g_gcm_live_zpass_clear)(u32 type) = NULL;
+/* One report into the title's report area: CellGcmReportData, big-endian u64 timer, u32 value, u32 padding. */
+void gcm_zpass_report_store(int main_mem, u32 off, u32 value)
+{
+    const u64 ts = gcm_report_timestamp();
+    if (main_mem) {
+        const u32 rea = gcm_io2ea(off);
+        if (!rea) return;
+        vm_write32(rea, (u32)(ts >> 32));
+        vm_write32(rea + 4u, (u32)ts);
+        vm_write32(rea + 8u, value);
+        vm_write32(rea + 12u, 0u);
+    } else if (off / 16u < CELL_GCM_MAX_REPORT_COUNT) {
+        s_report_data[off / 16u].timestamp = ts;
+        s_report_data[off / 16u].value = value;
+    }
+}
