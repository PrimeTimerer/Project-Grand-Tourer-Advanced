+/* ---------------------------------------------------------------------------
+ * DPI [GT6 0104]
+ *
+ * The process is per-monitor DPI aware (V2), set before the window is made: Windows no longer stretches the window's
+ * picture by the display's scale - at 150 % a 1920x1080 window was 2880x1620 pixels, bigger than a 2560x1600 screen,
+ * and blurred - and every coordinate here is a real pixel. The back buffer follows the client area
+ * (rsx_live_draw.c, ld_backbuffer_follow). GT6_DPI_AWARE=0 = as before.
+ * -----------------------------------------------------------------------*/
+static UINT s_dpi = 96;     /* the system's, when the window was made */
+static void dpi_aware(void)
+{
+    const char* e = getenv("GT6_DPI_AWARE");
+    HMODULE u = GetModuleHandleA("user32.dll");
+    typedef BOOL (WINAPI* set_ctx_fn)(HANDLE);
+    typedef UINT (WINAPI* sys_dpi_fn)(void);
+    if (e && *e == '0') {
+        fprintf(stderr, "[window] per-monitor DPI aware: off (GT6_DPI_AWARE=0)\n");
+        return;
+    }
+    set_ctx_fn set = u ? (set_ctx_fn)GetProcAddress(u, "SetProcessDpiAwarenessContext") : NULL;
+    const BOOL ok = set ? set((HANDLE)(LONG_PTR)-4) : FALSE;      /* DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2 */
+    const DWORD err = ok ? 0 : GetLastError();
+    sys_dpi_fn sys = u ? (sys_dpi_fn)GetProcAddress(u, "GetDpiForSystem") : NULL;
+    if (ok && sys) s_dpi = sys();
+    fprintf(stderr, "[window] per-monitor DPI aware: %s (system DPI %u = %u %%)\n",
+            ok ? "yes" : set ? "refused" : "not offered by this Windows", s_dpi, s_dpi * 100u / 96u);
+    if (!ok && set) fprintf(stderr, "[window] SetProcessDpiAwarenessContext error %lu\n", (unsigned long)err);
+}
+
+/* The frame and the caption around a client area at a DPI (0 = the window's own, or the system's). */
+static void frame_extra(HWND hwnd, DWORD style, DWORD exstyle, LONG* fw, LONG* fh)
+{
+    typedef BOOL (WINAPI* adj_fn)(LPRECT, DWORD, BOOL, DWORD, UINT);
+    typedef UINT (WINAPI* win_dpi_fn)(HWND);
+    static adj_fn adj = (adj_fn)-1;
+    static win_dpi_fn wdpi = (win_dpi_fn)-1;
+    if (adj == (adj_fn)-1) {
+        HMODULE u = GetModuleHandleA("user32.dll");
+        adj = u ? (adj_fn)GetProcAddress(u, "AdjustWindowRectExForDpi") : NULL;
+        wdpi = u ? (win_dpi_fn)GetProcAddress(u, "GetDpiForWindow") : NULL;
+    }
+    RECT nc = {0, 0, 0, 0};
+    const UINT dpi = hwnd && wdpi ? wdpi(hwnd) : s_dpi;
+    if (adj && dpi) adj(&nc, style, FALSE, exstyle, dpi);
+    else AdjustWindowRectEx(&nc, style, FALSE, exstyle);
+    *fw = nc.right - nc.left;
+    *fh = nc.bottom - nc.top;
+}
