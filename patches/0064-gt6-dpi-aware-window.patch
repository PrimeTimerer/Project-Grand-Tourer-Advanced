+/* ---- The back buffer follows the window [GT6 0104] ---------------------------------------------------------------
+ * The swap chain was made at the picture's size (g.width x g.height) and the compositor stretched it over whatever the
+ * window's client area was - a second, blurring resample in a maximized window or in full screen, and a third on a
+ * high-DPI monitor while the game window was not DPI aware (a 1920x1080 window was 2880x1620 physical pixels at 150 %).
+ * Now the window is per-monitor DPI aware (rsx_null_backend.c) and the back buffer is the client area's size: when that
+ * changes, the GPU is waited for and ResizeBuffers makes the two back buffers again. The present draws the picture once,
+ * into the biggest rectangle of the picture's shape (black around it): 1:1 when the window and the scanout have the
+ * same size (a 1920x1080 window in 1080p mode, full screen at a real resolution that matches the monitor).
+ * g.width x g.height stay the picture's size - the guest canvas uses them. LD_BACKBUFFER_FOLLOW=0 = the fixed size,
+ * as before. LD_PRESENT_FIT_TEST=<w>x<h> takes that as the client area (a hidden test window has the picture's). */
+static u32 g_bb_w, g_bb_h;          /* the back buffers' size */
+static int ld_bb_follow_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_BACKBUFFER_FOLLOW"); on = !(e && *e == '0'); }
+    return on;
+}
+static int ld_client_size(LONG* cw, LONG* ch)
+{
+    static int test_w = -1, test_h = 0;
+    if (test_w < 0) { const char* e = getenv("LD_PRESENT_FIT_TEST"); test_w = 0;
+                      if (e && sscanf(e, "%dx%d", &test_w, &test_h) != 2) test_w = test_h = 0; }
+    if (test_w > 0 && test_h > 0) { *cw = test_w; *ch = test_h; return 1; }
+    RECT cr;
+    if (!s_ld_hwnd || !GetClientRect(s_ld_hwnd, &cr)) return 0;
+    *cw = cr.right - cr.left; *ch = cr.bottom - cr.top;
+    return 1;
+}
+static void ld_backbuffer_follow(void)
+{
+    LONG cw = 0, ch = 0;
+    if (!ld_bb_follow_on() || !g.swap || !ld_client_size(&cw, &ch)) return;
+    if (cw < 64 || ch < 64 || cw > 16384 || ch > 16384) return;     /* minimized, or no size yet */
+    if ((u32)cw == g_bb_w && (u32)ch == g_bb_h) return;
+    static LONG fail_w, fail_h;         /* a size ResizeBuffers refused is not tried again every frame */
+    if (cw == fail_w && ch == fail_h) return;
+    ld_flush(LD_FLUSH_RESIZE);          /* everything recorded so far, and every frame before, done on the GPU */
+    if (!g.ready) return;
+    for (u32 i = 0; i < LD_SWAP_BUFFERS; i++)
+        if (g.backbuf[i]) { g.backbuf[i]->lpVtbl->Release(g.backbuf[i]); g.backbuf[i] = NULL; }
+    const HRESULT hr = g.swap->lpVtbl->ResizeBuffers(g.swap, LD_SWAP_BUFFERS, (UINT)cw, (UINT)ch, DXGI_FORMAT_R8G8B8A8_UNORM, 0);
+    for (u32 i = 0; i < LD_SWAP_BUFFERS; i++) {
+        g.swap->lpVtbl->GetBuffer(g.swap, i, &IID_ID3D12Resource, (void**)&g.backbuf[i]);
+        if (g.backbuf[i]) g.dev->lpVtbl->CreateRenderTargetView(g.dev, g.backbuf[i], NULL, rtv_handle(i));
+    }
+    if (FAILED(hr)) {
+        fprintf(stderr, "[backbuffer] ResizeBuffers %ldx%ld failed hr=0x%08lX: stays %ux%u\n", (long)cw, (long)ch,
+                (unsigned long)hr, g_bb_w, g_bb_h);
+        fail_w = cw; fail_h = ch;
+        return;
+    }
+    fprintf(stderr, "[backbuffer] %ux%u -> %ldx%ld: the window's client area, frame %u\n", g_bb_w, g_bb_h, (long)cw, (long)ch,
+            g_ld_frames);
+    g_bb_w = (u32)cw; g_bb_h = (u32)ch;
+    ld_ls_invalidate();
+}
