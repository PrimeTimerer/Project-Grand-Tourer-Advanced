+/* ---- a burst of state headers [GT6 0055] ------------------------------- */
+
+/* In a twelve-car Gran Turismo 6 race a frame is 67,000 method headers with 260,000 words (GCM_RUN_STATS), about
+ * forty headers a draw, and all but four of each forty only store state. Every header went through the walker's
+ * whole loop body, the live engine's gates and rsx_dispatch_run, and the 110,000 vertex program words a frame
+ * went through rsx_dispatch_method one by one: 4.4 ms of a 24 ms frame on the drawing thread. Here the headers
+ * between two draws are decoded in one loop.
+ *
+ * What a word does is rsx_dispatch_method's, restated per kind (the reference is that function):
+ *   1  seen++, regs = word                                  (every method that function has no case for)
+ *   2  ... and constants[CONST_ID + word/4][word%4] = word  (the transform constant window)
+ *   3  ... and vp[UPLOAD_FROM_ID * 4 + lane] = word, the load pointer moving on after lane 3 (the program window)
+ *   0  not here: the immediate vertex data it folds into the constant attributes (DATA1F/2F/3F/2S/4UB/4S and
+ *      SCALED4S), DATA4F W of attribute 0, BEGIN/END, the two batches, the inline array, CLEAR - and what the
+ *      caller keeps. rsx_dispatch_run's own table is coarser (all of 0x1800..0x19FC is 0 there); the methods in
+ *      0x1600..0x187C other than those five are plain stores in rsx_dispatch_method, and are 1 here. */
+int g_rsx_vp_gen_on_change = 1;
+static u8  s_bkind[0x800];
+static u16 s_blen[0x800];              /* how many methods from this one on are all of a burst kind */
+static u16 s_klen[0x800];              /* ... and how many from this one on are of this one's kind */
+static const u8* s_burst_stop;
+static int s_burst_ready, s_burst_refuse;
+
+static void rsx_burst_tables(const u8* stop)
+{
+    for (u32 m = 0; m < 0x2000u; m += 4u) {
+        u8 k = 1;
+        if ((m >= 0x0A80u && m < 0x0B00u) || (m >= 0x1500u && m < 0x1600u) || (m >= 0x1880u && m < 0x1A00u) ||
+            (m >= 0x1E40u && m < 0x1E80u) || m == 0x1C0Cu ||
+            m == M_VERTEX_BEGIN_END || m == M_VB_VERTEX_BATCH || m == M_INLINE_ARRAY || m == M_VB_INDEX_BATCH ||
+            m == M_CLEAR_BUFFERS || (stop && stop[m >> 2]))
+            k = 0;
+        else if (m >= M_VP_UPLOAD_CONST && m < M_VP_UPLOAD_CONST + 32u * 4u) k = 2;
+        else if (m >= M_VP_UPLOAD_INST && m < M_VP_UPLOAD_INST + 32u * 4u) k = 3;
+        s_bkind[m >> 2] = k;
+    }
+    for (int i = 0x7FF; i >= 0; i--) {
+        s_blen[i] = s_bkind[i] ? (u16)(1u + (i < 0x7FF ? s_blen[i + 1] : 0u)) : (u16)0;
+        s_klen[i] = (u16)(1u + (i < 0x7FF && s_bkind[i + 1] == s_bkind[i] ? s_klen[i + 1] : 0u));
+    }
+    s_burst_refuse = getenv("RSX_CONST_LOG") ? 1 : 0;    /* rsx_dispatch_method prints each constant word then */
+    s_burst_stop = stop;
+    s_burst_ready = 1;
+}
