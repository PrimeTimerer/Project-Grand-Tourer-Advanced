+/* Consecutive method HEADERS with their words, straight from FIFO memory [GT6 0055]: as long as the next word at
+ * `be` is the header of a subchannel-0 run whose words all only store state (a register, a transform constant, a
+ * vertex program word), the run is taken as rsx_dispatch_run would take it and the next header is looked at. It
+ * stops, without touching it, at anything else: a run with a method that has an effect of its own or that the caller
+ * keeps for itself (`stop`), another subchannel, a control word (jump, call, return, no-op, marker), a run that
+ * would pass `max_bytes`, or after `max_headers`. Nothing is called from inside, so nothing of the caller's can be
+ * observed while it runs. Returns the bytes taken (0 = the first word is not such a header, or BEGIN/END is open). */
+typedef struct rsx_fifo_burst {
+    const u8* stop;        /* in: 0x800 flags by (canonical method >> 2), 1 = the caller takes this method itself; or NULL */
+    u32  max_headers;      /* in */
+    u32* trace_off;        /* in, or NULL: the caller's ring of the last decoded words - offset, word, write index */
+    u32* trace_w;
+    u32* trace_i;
+    u32  trace_mask;       /*     ring size - 1 */
+    u32  io;               /*     the offset the caller knows `be` by (what trace_off receives) */
+    u32  headers;          /* out: headers taken */
+    u32  last;             /* out: byte position of the last header taken */
+} rsx_fifo_burst;
