+u32 rsx_dispatch_fifo_burst(rsx_dispatch* rsx, const void* be, u32 max_bytes, rsx_fifo_burst* b)
+{
+    b->headers = 0; b->last = 0;
+    if (rsx->in_begin_end) return 0;
+    if (!s_burst_ready || b->stop != s_burst_stop) rsx_burst_tables(b->stop);
+    if (s_burst_refuse) return 0;
+    const u8* p = (const u8*)be;
+    u32* const regs = rsx->regs;
+    u32* const seen = rsx->seen;
+    u32* const vp = rsx->vp;
+    /* everything the loop needs in locals: the stores below go through u32 pointers, and the compiler has to assume
+     * each of them may have written a field of *b or of *rsx */
+    const u32 max_headers = b->max_headers, tr_mask = b->trace_mask, io = b->io;
+    u32* const tr_off = b->trace_off;
+    u32* const tr_w = b->trace_w;
+    u32 tr_i = tr_off ? *b->trace_i : 0u;
+    u32 off = 0, nh = 0, last = 0, n_const = 0, n_vp = 0, vp_changed = 0;
+    while (nh < max_headers && off + 8u <= max_bytes) {
+        const u32 w = rsx_run_word(p + off, 0);
+        const u32 count = (w >> 18) & 0x7FFu, m = w & 0x1FFCu;
+        const u32 top = w & 0xE000E003u;                     /* run type, subchannel, the two low bits */
+        if (!count || off + 4u + count * 4u > max_bytes) break;
+        const u8* d = p + off + 4u;
+        /* the stream ahead: SPU jobs on other cores wrote it, and its lines are in their caches */
+        __builtin_prefetch(d + count * 4u + 512u);
+        __builtin_prefetch(d + count * 4u + 576u);
+        if (top == 0u) {                                     /* incrementing, subchannel 0 */
+            if (count > s_blen[m >> 2]) break;
+            u32 i = 0, mi = m >> 2;
+            do {
+                /* the words of this run that are of one kind: a counted loop each */
+                u32 n = s_klen[mi];
+                if (n > count - i) n = count - i;
+                const u32 k = s_bkind[mi];
+                if (k == 1) {
+                    for (u32 j = 0; j < n; j++) {
+                        seen[mi + j]++;
+                        regs[mi + j] = rsx_run_word(d, i + j);
+                    }
+                } else if (k == 2) {
+                    const u32 base_slot = regs[M_VP_UPLOAD_CONST_ID >> 2];
+                    const u32 word0 = mi - (M_VP_UPLOAD_CONST >> 2);
+                    for (u32 j = 0; j < n; j++) {
+                        const u32 arg = rsx_run_word(d, i + j);
+                        seen[mi + j]++;
+                        regs[mi + j] = arg;
+                        const u32 word = word0 + j;
+                        const u32 slot = base_slot + (word >> 2);
+                        if (slot < RSX_DSP_NUM_CONSTANTS)
+                            rsx->constants[slot][word & 3u] = arg;
+                    }
+                    n_const += n;
+                } else {
+                    u32 load = regs[M_VP_UPLOAD_FROM_ID >> 2];       /* no word of the window stores it */
+                    const u32 lane0 = mi - (M_VP_UPLOAD_INST >> 2);
+                    for (u32 j = 0; j < n; j++) {
+                        const u32 arg = rsx_run_word(d, i + j);
+                        seen[mi + j]++;
+                        regs[mi + j] = arg;
+                        const u32 lane = (lane0 + j) & 3u;
+                        const u32 pos = load * 4u + lane;
+                        if (pos < RSX_DSP_VP_WORDS && vp[pos] != arg) { vp[pos] = arg; vp_changed = 1; }
+                        if (lane == 3u) load++;
+                    }
+                    regs[M_VP_UPLOAD_FROM_ID >> 2] = load;
+                    n_vp += n;
+                }
+                i += n; mi += n;
+            } while (i < count);
+        } else if (top == 0x40000000u) {                     /* not incrementing: the same register `count` times */
+            if (s_bkind[m >> 2] != 1) break;
+            const u32 idx = m >> 2;
+            seen[idx] += count;
+            regs[idx] = rsx_run_word(d, count - 1u);
+        } else
+            break;
+        if (nh && tr_off) {                                  /* the caller has noted the first header itself */
+            const u32 t = tr_i & tr_mask;
+            tr_off[t] = io + off;
+            tr_w[t] = w;
+            tr_i++;
+        }
+        last = off;
+        off += 4u + count * 4u;
+        nh++;
+    }
+    b->headers = nh;
+    b->last = last;
+    if (tr_off) *b->trace_i = tr_i;
+    if (n_vp) {
+        if (!g_rsx_vp_gen_on_change) g_rsx_vp_upload_gen += n_vp;
+        else if (vp_changed) g_rsx_vp_upload_gen++;
+    }
+    /* every word taken that is neither a constant nor a program word was a plain store */
+    g_rsx_run_stat[0] += off / 4u - nh - n_const - n_vp; g_rsx_run_stat[1] += n_const; g_rsx_run_stat[2] += n_vp;
+    return off;
+}
