+/* A post-effect can read a subrect of its current render target through a
+ * different guest offset. A separate surface at that offset can be leftover
+ * from an older pass. Use the current target when it wrote newer, fully
+ * covers the texture, and has the same guest layout. */
+static int ld_feedback_subrect(u32 target, const rsx_dsp_texture* t, int sampled, u32* x, u32* y)
+{
+    const surface_t* s = &g.surfaces[target];
+    if (!ld_seq_feedback_on() || t->cubemap || t->dimension != 2u ||
+        !(t->format & TEX_FMT_LINEAR) || !s->tex || !s->pitch || t->pitch != s->pitch ||
+        t->location != s->location || t->offset <= s->offset)
+        return 0;
+    const u32 texel = ld_tex_texel_bytes(t->format);
+    const u32 surface_texel = s->fmt == DXGI_FORMAT_R16G16B16A16_FLOAT ? 8u : 4u;
+    if (texel != surface_texel) return 0;
+    const u32 offset = t->offset - s->offset;
+    const u32 row = offset / s->pitch;
+    const u32 column = offset % s->pitch;
+    if (row >= s->gh || column % texel) return 0;
+    const u32 col = column / texel;
+    if (sampled >= 0) {
+#if !defined(YZ_PERF_CLEAN)
+        const surface_t* old = &g.surfaces[sampled];
+        if (s->guard_frame != g_ld_frames + 1u || s->guard_dead ||
+            !ld_surface_has_colour(s) || col >= s->gw ||
+            t->width > s->gw - col || t->height > s->gh - row ||
+            t->width > (s->pitch - column) / texel ||
+            g_ld_surface_generation - s->last_write_generation >=
+                g_ld_surface_generation - old->last_write_generation)
+            return 0;
+#else
+        return 0;
+#endif
+    }
+    *x = col;
+    *y = row;
+    return 1;
+}
