diff --git a/libs/video/tests/test_live_draw_replay_clear.c b/libs/video/tests/test_live_draw_replay_clear.c
new file mode 100644
--- /dev/null
+++ b/libs/video/tests/test_live_draw_replay_clear.c
@@ -0,0 +1,100 @@
+/* D3D12 live-draw regression for a split colour/depth/stencil atlas.
+ * Clearing the right half (or an empty scissor) must preserve the other
+ * half and any stencil mask used by later draws.
+ * Build and run: see live_draw_test_harness.h.
+ */
+#include "live_draw_test_harness.h"
+
+#define T "test_live_draw_replay_clear"
+#define SURF 0x00010000u
+
+static void check_pixels(const char* file)
+{
+    uint8_t rgb[8 * 8 * 3];
+    u32 w = 0, h = 0;
+    const int read = ldh_read_rgb(SURF, file, rgb, 8, 8, &w, &h) == 0 && w == 8 && h == 8;
+    ldh_check("8x8 color target read", read);
+    if (!read) return;
+    u32 left_red = 0, right_green = 0;
+    for (u32 y = 0; y < h; ++y) {
+        for (u32 x = 0; x < w; ++x) {
+            const uint8_t* pixel = rgb + (y * w + x) * 3;
+            if (x < 4 && pixel[0] > 200 && pixel[1] < 10 && pixel[2] < 10) ++left_red;
+            if (x >= 4 && pixel[1] > 200 && pixel[0] < 10 && pixel[2] < 10) ++right_green;
+        }
+    }
+    printf("red left=%u/32, green right=%u/32\n", left_red, right_green);
+    ldh_check("the other atlas half is preserved", left_red == 32 && right_green == 32);
+}
+
+static void red_clear(void)
+{
+    ldh_m(NV4097_SET_SCISSOR_HORIZONTAL, 8u << 16);
+    ldh_m(NV4097_SET_COLOR_CLEAR_VALUE, 0xFFFF0000u);
+    ldh_m(NV4097_CLEAR_SURFACE, 0xF0u);
+}
+
+static void check_depth_stencil(const char* file, int white_on_left)
+{
+    uint8_t rgb[8 * 8 * 3];
+    u32 w = 0, h = 0, kept = 0;
+    if (ldh_read_rgb(SURF, file, rgb, 8, 8, &w, &h) == 0 && w == 8 && h == 8)
+        for (u32 y = 0; y < h; ++y)
+            for (u32 x = 0; x < w; ++x) {
+                const u32 i = (y * w + x) * 3u;
+                const int white = (x < 4) == white_on_left;
+                kept += rgb[i] > 200 && (white ? rgb[i + 1] > 200 && rgb[i + 2] > 200 :
+                                                rgb[i + 1] < 10 && rgb[i + 2] < 10);
+            }
+    printf("%s preserved=%u/64\n", file, kept);
+    ldh_check("scissored clear keeps the adjacent depth/stencil", kept == 64);
+}
+
+static void verify_zeta(void)
+{
+    ldh_surface(0x8u | (0x1u << 8) | (2u << 5), SURF, 32, 0x200000u, 32, 8, 8);
+    ldh_m(NV4097_SET_COLOR_MASK, 0x01010101u);
+    ldh_setup_quad(0, 1, 1, 0, 0);
+    rsx_test_fp_mov_r0_col0(ldh_main + 0x1000, RSX_TEST_FP_SWZ_IDENT);
+    red_clear();
+    ldh_m(NV4097_SET_ZSTENCIL_CLEAR_VALUE, 1u);
+    ldh_m(NV4097_CLEAR_SURFACE, 1u);
+    ldh_m(NV4097_SET_SCISSOR_HORIZONTAL, (4u << 16) | 4u);
+    ldh_m(NV4097_SET_ZSTENCIL_CLEAR_VALUE, 0xFFFFFF00u);
+    ldh_m(NV4097_CLEAR_SURFACE, 1u);
+    ldh_m(NV4097_SET_SCISSOR_HORIZONTAL, 8u << 16);
+    ldh_draw(0x1000, 0x40, 1, 0, 0x201);
+    check_depth_stencil("depth_replay_clear.ppm", 0);
+
+    red_clear();
+    ldh_m(NV4097_SET_ZSTENCIL_CLEAR_VALUE, 0xFFFFFF01u);
+    ldh_m(NV4097_CLEAR_SURFACE, 2u);
+    ldh_m(NV4097_SET_SCISSOR_HORIZONTAL, (4u << 16) | 4u);
+    ldh_m(NV4097_SET_ZSTENCIL_CLEAR_VALUE, 0xFFFFFF00u);
+    ldh_m(NV4097_CLEAR_SURFACE, 2u);
+    ldh_m(NV4097_SET_SCISSOR_HORIZONTAL, 8u << 16);
+    ldh_m(NV4097_SET_STENCIL_TEST_ENABLE, 1u);
+    ldh_m(NV4097_SET_STENCIL_FUNC, 0x202u);
+    ldh_m(NV4097_SET_STENCIL_FUNC_REF, 1u);
+    ldh_m(NV4097_SET_STENCIL_FUNC_MASK, 0xFFu);
+    ldh_draw(0x1000, 0x40, 1, 0, 0x207);
+    check_depth_stencil("stencil_replay_clear.ppm", 1);
+}
+
+int main(void)
+{
+    if (ldh_init(T) != 0) return 2;
+    ldh_surface(0x8u | (0x1u << 8), SURF, 32, 0x200000u, 32, 8, 8);
+    ldh_m(NV4097_SET_COLOR_CLEAR_VALUE, 0xFFFF0000u);
+    ldh_m(NV4097_CLEAR_SURFACE, 0xF0u);
+    ldh_m(NV4097_SET_SCISSOR_HORIZONTAL, (4u << 16) | 4u);
+    ldh_m(NV4097_SET_COLOR_CLEAR_VALUE, 0xFF00FF00u);
+    ldh_m(NV4097_CLEAR_SURFACE, 0xF0u);
+    check_pixels("partial_replay_clear.ppm");
+    ldh_m(NV4097_SET_SCISSOR_HORIZONTAL, 0);
+    ldh_m(NV4097_SET_COLOR_CLEAR_VALUE, 0xFF0000FFu);
+    ldh_m(NV4097_CLEAR_SURFACE, 0xF0u);
+    check_pixels("empty_replay_clear.ppm");
+    verify_zeta();
+    return ldh_done(T);
+}
