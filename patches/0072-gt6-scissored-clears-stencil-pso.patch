+/* NV4097's window origin moves the scissor together with the viewport.
+ * Keep clears and draws on the same sample grid, then scale their edges
+ * to host pixels. The game can clear just one view of a shared atlas. */
+static D3D12_RECT ld_surface_scissor(const rsx_dsp_surface* sf, const surface_t* target,
+                                      LONG* win_x, LONG* win_y)
+{
+    static int wo = -1;
+    if (wo < 0) {
+        const char* e = getenv("LD_WINDOW_OFFSET");
+        wo = !(e && *e == '0');
+    }
+    const u32 window = wo ? rsx_dsp_reg(&g.rsx, 0x02B8) : 0u;
+    *win_x = (LONG)ld_hx(target, (window & 0xFFFFu) * sf->aa_sx);
+    *win_y = (LONG)ld_hy(target, (window >> 16) * sf->aa_sy);
+    D3D12_RECT rect = {0, 0, (LONG)(target->w ? target->w : g.width),
+                            (LONG)(target->h ? target->h : g.height)};
+    if (g.rsx.seen[M_SCISSOR_HORIZONTAL >> 2] || g.rsx.seen[M_SCISSOR_VERTICAL >> 2]) {
+        /* A never-written scissor covers the target. An explicit zero size
+         * is empty and may not clear or draw anything. */
+        const u32 sh = rsx_dsp_reg(&g.rsx, M_SCISSOR_HORIZONTAL);
+        const u32 sv = rsx_dsp_reg(&g.rsx, M_SCISSOR_VERTICAL);
+        const u32 x = sh & 0xFFFFu, y = sv & 0xFFFFu;
+        const LONG left = (LONG)ld_hx(target, x * sf->aa_sx) + *win_x;
+        const LONG top = (LONG)ld_hy(target, y * sf->aa_sy) + *win_y;
+        const LONG right = (LONG)ld_hx(target, (x + (sh >> 16)) * sf->aa_sx) + *win_x;
+        const LONG bottom = (LONG)ld_hy(target, (y + (sv >> 16)) * sf->aa_sy) + *win_y;
+        if (left > rect.left) rect.left = left;
+        if (top > rect.top) rect.top = top;
+        if (right < rect.right) rect.right = right;
+        if (bottom < rect.bottom) rect.bottom = bottom;
+        if (rect.right < rect.left) rect.right = rect.left;
+        if (rect.bottom < rect.top) rect.bottom = rect.top;
+    }
+    return rect;
+}
