+/* ---- cellFsUnlink / cellFsRmdir / cellFsUtime ([GT6 0089]) ----------------------------------------------------------
+ * These three answered CELL_OK and did nothing. Gran Turismo 6's own installation, which every new installation runs
+ * on its first start (it merges the update packages' TPPS-01.xx folders into PDIPFS, applies the .bsdiff patches and
+ * then removes what it has used), depends on them: with Unlink / Rmdir doing nothing, ~11 GB of merged-away data
+ * stayed on the disk (and the next start found the update folders again), and the game's file times (it sets
+ * the times of the files it copies to 0) were lost. A copy of the game started once under RPCS3 has all of that done
+ * already, which is why it never showed there.
+ * Only the game's own partitions (/dev_hdd0, /dev_hdd1, whose host folders PS3_HDD0_ROOT / PS3_HDD1_ROOT name) are
+ * changed; the disc (/dev_bdvd), the firmware and any other path keep the old answer, as the disc is read-only on a
+ * console. The host file is the real one, never the mod overlay's stand-in. PS3_FS_LEGACY=1: all three as before. */
+static bool fs_legacy_mode()
+{
+    static int legacy = -1;
+    if (legacy < 0) { const char* e = getenv("PS3_FS_LEGACY"); legacy = (e && *e && *e != '0') ? 1 : 0; }
+    return legacy == 1;
+}
+static bool fs_change_allowed(const char* g)
+{
+    const char* root = nullptr;
+    if (strncmp(g, "/dev_hdd0/", 10) == 0) root = getenv("PS3_HDD0_ROOT");
+    else if (strncmp(g, "/dev_hdd1/", 10) == 0) root = getenv("PS3_HDD1_ROOT");
+    return root && *root;
+}
+#define CELL_FS_EBUSY      ((int)0x8001000A)
+#define CELL_FS_ENOTDIR    ((int)0x8001002E)
+#define CELL_FS_ENOTEMPTY  ((int)0x80010036)
+
+static void host_backslashes(char* p) { for (; *p; p++) if (*p == '/') *p = '\\'; }
+
+static void cellFsUnlink(ppu_context* ctx)
+{
+    char gpath[1024], hpath[1100];
+    guest_strcpy(gpath, (uint32_t)ctx->gpr[3], sizeof gpath);
+    if (fs_legacy_mode() || !fs_change_allowed(gpath)) { ctx->gpr[3] = CELL_OK; return; }
+    host_path_real(hpath, sizeof hpath, gpath);
+    int err = 0;
+#ifdef _WIN32
+    host_backslashes(hpath);
+    const DWORD attr = GetFileAttributesA(hpath);
+    if (attr == INVALID_FILE_ATTRIBUTES) err = CELL_FS_ENOENT;
+    else if (attr & FILE_ATTRIBUTE_DIRECTORY) err = CELL_FS_EISDIR;
+    else {
+        if (attr & FILE_ATTRIBUTE_READONLY) SetFileAttributesA(hpath, attr & ~FILE_ATTRIBUTE_READONLY);
+        if (!DeleteFileA(hpath)) {
+            const DWORD e = GetLastError();
+            err = (e == ERROR_FILE_NOT_FOUND || e == ERROR_PATH_NOT_FOUND) ? CELL_FS_ENOENT
+                : (e == ERROR_SHARING_VIOLATION || e == ERROR_ACCESS_DENIED) ? CELL_FS_EBUSY : CELL_FS_EIO;
+        }
+    }
+#else
+    if (unlink(hpath) != 0) err = errno == ENOENT ? CELL_FS_ENOENT : errno == EISDIR ? CELL_FS_EISDIR : CELL_FS_EIO;
+#endif
+    if (getenv("PS3_FSLOG") || (err && err != CELL_FS_ENOENT))
+        fprintf(stderr, "[fs] unlink '%s' -> 0x%08X\n", gpath, (unsigned)err);
+    ctx->gpr[3] = (uint64_t)(int64_t)err;
+}
+
+static void cellFsRmdir(ppu_context* ctx)
+{
+    char gpath[1024], hpath[1100];
+    guest_strcpy(gpath, (uint32_t)ctx->gpr[3], sizeof gpath);
+    if (fs_legacy_mode() || !fs_change_allowed(gpath)) { ctx->gpr[3] = CELL_OK; return; }
+    host_path_real(hpath, sizeof hpath, gpath);
+    int err = 0;
+#ifdef _WIN32
+    host_backslashes(hpath);
+    for (size_t n = strlen(hpath); n > 3 && hpath[n - 1] == '\\'; ) hpath[--n] = 0;
+    if (!RemoveDirectoryA(hpath)) {
+        const DWORD e = GetLastError();
+        err = (e == ERROR_FILE_NOT_FOUND || e == ERROR_PATH_NOT_FOUND) ? CELL_FS_ENOENT
+            : e == ERROR_DIR_NOT_EMPTY ? CELL_FS_ENOTEMPTY : e == ERROR_DIRECTORY ? CELL_FS_ENOTDIR
+            : (e == ERROR_SHARING_VIOLATION || e == ERROR_ACCESS_DENIED) ? CELL_FS_EBUSY : CELL_FS_EIO;
+    }
+#else
+    if (rmdir(hpath) != 0) err = errno == ENOENT ? CELL_FS_ENOENT : errno == ENOTEMPTY ? CELL_FS_ENOTEMPTY : errno == ENOTDIR ? CELL_FS_ENOTDIR : CELL_FS_EIO;
+#endif
+    if (getenv("PS3_FSLOG") || (err && err != CELL_FS_ENOENT))
+        fprintf(stderr, "[fs] rmdir '%s' -> 0x%08X\n", gpath, (unsigned)err);
+    ctx->gpr[3] = (uint64_t)(int64_t)err;
+}
+
+/* cellFsUtime(path, const CellFsUtimbuf* {time_t actime; time_t modtime;} (big-endian, seconds since 1970; NULL = now)). */
+static void cellFsUtime(ppu_context* ctx)
+{
+    char gpath[1024], hpath[1100];
+    guest_strcpy(gpath, (uint32_t)ctx->gpr[3], sizeof gpath);
+    if (fs_legacy_mode() || !fs_change_allowed(gpath)) { ctx->gpr[3] = CELL_OK; return; }
+    const uint32_t buf = (uint32_t)ctx->gpr[4];
+    host_path_real(hpath, sizeof hpath, gpath);
+    int err = 0;
+#ifdef _WIN32
+    host_backslashes(hpath);
+    const DWORD attr = GetFileAttributesA(hpath);
+    if (attr == INVALID_FILE_ATTRIBUTES) err = CELL_FS_ENOENT;
+    else {
+        HANDLE h = CreateFileA(hpath, FILE_WRITE_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                               OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL);
+        if (h == INVALID_HANDLE_VALUE) err = CELL_FS_EBUSY;
+        else {
+            FILETIME a, m, now;
+            GetSystemTimeAsFileTime(&now);
+            a = m = now;
+            if (buf) {
+                const uint64_t at = guest_be64(buf), mt = guest_be64(buf + 8);
+                const uint64_t epoch = 116444736000000000ULL;   /* 1970-01-01 in FILETIME ticks (100 ns since 1601) */
+                const uint64_t ta = epoch + at * 10000000ULL, tm = epoch + mt * 10000000ULL;
+                a.dwLowDateTime = (DWORD)ta; a.dwHighDateTime = (DWORD)(ta >> 32);
+                m.dwLowDateTime = (DWORD)tm; m.dwHighDateTime = (DWORD)(tm >> 32);
+            }
+            if (!SetFileTime(h, NULL, &a, &m)) err = CELL_FS_EIO;
+            CloseHandle(h);
+        }
+    }
+#else
+    (void)buf; (void)hpath;   /* the host's own file times stay: only Windows has needed this so far */
+#endif
+    if (getenv("PS3_FSLOG") || err)
+        fprintf(stderr, "[fs] utime '%s' -> 0x%08X\n", gpath, (unsigned)err);
+    ctx->gpr[3] = (uint64_t)(int64_t)err;
+}
+
+/* cellFsAllocateFileAreaWithoutZeroFill(path, u64 size) ([GT6 0089]): the file gets that size (on the console and in
+ * RPCS3 it is a truncate to `size`; the area is not filled). It used to answer OK and do nothing, on the grounds that
+ * a host file grows when it is written. But a title can depend on the SIZE: Gran Turismo 6's installation of its
+ * updates (the first start of every new installation) gives the file a patch will produce its final size this way,
+ * opens it as a stream - whose length is the file's size at that moment (0x00AC9A38: fstat, kept at +0x10) - writes
+ * the patch's difference bytes and then reads them back window by window (4 MB) to add the old file to them. With a
+ * length of 0 the window read back is empty (0x00AC9B88) and the adding loop (0x00AB386C) never ends: every file
+ * over 4 MB stopped the installation, one thread at 100 %, "Installing... Approx. 30 mins. left" for ever. Smaller
+ * files never left the first window, which is why 84 files went through before the first large one.
+ * Only the game's own partitions, as the three calls above; PS3_FS_LEGACY=1 = as before. */
+static void cellFsAllocateFileAreaWithoutZeroFill(ppu_context* ctx)
+{
+    char gpath[1024], hpath[1100];
+    guest_strcpy(gpath, (uint32_t)ctx->gpr[3], sizeof gpath);
+    const uint64_t size = ctx->gpr[4];
+    if (fs_legacy_mode() || !fs_change_allowed(gpath)) { ctx->gpr[3] = CELL_OK; return; }
+    host_path_real(hpath, sizeof hpath, gpath);
+    int err = 0;
+#ifdef _WIN32
+    host_backslashes(hpath);
+    HANDLE h = CreateFileA(hpath, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                           OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (h == INVALID_HANDLE_VALUE) {
+        const DWORD e = GetLastError();
+        err = (e == ERROR_FILE_NOT_FOUND || e == ERROR_PATH_NOT_FOUND) ? CELL_FS_ENOENT : CELL_FS_EBUSY;
+    } else {
+        LARGE_INTEGER to; to.QuadPart = (LONGLONG)size;
+        if (!SetFilePointerEx(h, to, NULL, FILE_BEGIN) || !SetEndOfFile(h)) err = CELL_FS_EIO;
+        CloseHandle(h);
+    }
+#else
+    if (truncate(hpath, (off_t)size) != 0) err = errno == ENOENT ? CELL_FS_ENOENT : CELL_FS_EIO;
+#endif
+    if (getenv("PS3_FSLOG") || err)
+        fprintf(stderr, "[fs] allocate '%s' size=%llu -> 0x%08X\n", gpath, (unsigned long long)size, (unsigned)err);
+    ctx->gpr[3] = (uint64_t)(int64_t)err;
+}
