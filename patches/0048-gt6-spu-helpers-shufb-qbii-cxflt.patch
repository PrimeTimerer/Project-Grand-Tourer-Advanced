 /* pshufb version: one of the hottest SPU ops (~11% of GH3's FMOD mixer task
  * as the byte loop). SPU byte P lives at host byte SPU_W(P), i.e. the bytes
  * of each 32-bit word reversed, so swap into SPU order, select, swap back. */
+#if !defined(SPU_SHUFB_SWAPPED)
+/* [GT6 0052] Without the four byte swaps (SPU_SHUFB_SWAPPED = the form below, as before). All three operands and the
+ * result keep SPU byte P in host lane P^3, so the result's host lane h is chosen by the control's host lane h, and
+ * byte q of the a:b concatenation is host lane (q & 15) ^ 3 of a (q < 16) or of b. pshufb reads the low four bits of
+ * an index and gives 0 where its top bit is set - the lanes a special selector then fills, picked from a table by
+ * the selector's three top bits (100, 101 -> 0x00, 110 -> 0xFF, 111 -> 0x80). Nine vector operations for twenty: in
+ * Gran Turismo 6's heaviest job (jobmod_9039b3cc346b, the car vertex loops) every fifth instruction is a shufb, and
+ * it was close to half of that code's host work. With a == b the two table reads fold into one. */
+static inline u128 spu_shufb(u128 a, u128 b, u128 c) {
+    __m128i A, B, C; memcpy(&A, &a, 16); memcpy(&B, &b, 16); memcpy(&C, &c, 16);
+    const __m128i idx = _mm_xor_si128(C, _mm_set1_epi8(3));
+    __m128i r = _mm_blendv_epi8(_mm_shuffle_epi8(A, idx), _mm_shuffle_epi8(B, idx), _mm_slli_epi16(C, 3));
+    const __m128i lut = _mm_setr_epi8(0, 0, 0, 0, 0, 0, (char)0xFF, (char)0x80, 0, 0, 0, 0, 0, 0, 0, 0);
+    const __m128i special = _mm_shuffle_epi8(lut, _mm_and_si128(_mm_srli_epi16(C, 5), _mm_set1_epi8(7)));
+    r = _mm_blendv_epi8(r, special, C);
+    u128 out; memcpy(&out, &r, 16); return out;
+}
+#else
 static inline u128 spu_shufb(u128 a, u128 b, u128 c) {
     const __m128i sw = _mm_setr_epi8(3,2,1,0, 7,6,5,4, 11,10,9,8, 15,14,13,12);
     __m128i A, B, C; memcpy(&A, &a, 16); memcpy(&B, &b, 16); memcpy(&C, &c, 16);
@@ -481,6 +499,7 @@ static inline u128 spu_shufb(u128 a, u128 b, u128 c) {
     r = _mm_shuffle_epi8(_mm_blendv_epi8(r, special, m80), sw);
     u128 out; memcpy(&out, &r, 16); return out;
 }
