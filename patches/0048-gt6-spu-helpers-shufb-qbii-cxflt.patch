+/* [GT6 0052] csflt / cuflt on a thread in the SPU float mode (MXCSR round toward zero, see spu__x8_rz): the host's
+ * own conversion truncates as the SPU's does, and the scale is a multiplication by a power of two, which is exact.
+ * Only for scales with which neither the smallest integer (1) falls below 2^-126 nor the largest reaches 2^128 -
+ * 29 <= i8 <= 250, every scale a program normally uses - so that no result is flushed, saturated or a negative
+ * zero; other scales and other threads take the exact forms below. An unsigned value goes in two exact halves,
+ * joined by one fused multiply-add (one truncation of the exact sum). SPU_CXFLT_EXACT_ONLY turns this off. */
+#if defined(__FMA__) && !defined(SPU_CXFLT_EXACT_ONLY)
+#define SPU__XE_CXFLT_FAST(i8) (__builtin_constant_p(i8) && ((i8) & 0xFF) >= 29 && ((i8) & 0xFF) <= 250 && spu__x8_rz())
+SPU__XE_INLINE __m128 spu__xe_pow2(int e) { return _mm_castsi128_ps(_mm_set1_epi32((e + 127) << 23)); }   /* 2^e, -126..127 */
+#else
+#define SPU__XE_CXFLT_FAST(i8) 0
+SPU__XE_INLINE __m128 spu__xe_pow2(int e) { (void)e; return _mm_setzero_ps(); }
+#endif
 SPU__XE_INLINE u128 spu_csflt(u128 a, int i8) {
     const __m128i v = spu__xe_ld(a);
+    if (SPU__XE_CXFLT_FAST(i8))
+        return spu__xe_st(_mm_castps_si128(_mm_mul_ps(_mm_cvtepi32_ps(v), spu__xe_pow2((i8 & 0xFF) - 155))));
     const __m256d d = _mm256_andnot_pd(_mm256_set1_pd(-0.0), _mm256_cvtepi32_pd(v));          /* |v|, exact */
     const __m128i sign = _mm_and_si128(v, _mm_set1_epi32((int)0x80000000u));
     const __m128i nz = _mm_xor_si128(_mm_cmpeq_epi32(v, _mm_setzero_si128()), _mm_set1_epi32(-1));
@@ -1777,6 +1828,12 @@ SPU__XE_INLINE u128 spu_csflt(u128 a, int i8) {
 }
 SPU__XE_INLINE u128 spu_cuflt(u128 a, int i8) {
     const __m128i v = spu__xe_ld(a);
+#if defined(__FMA__) && !defined(SPU_CXFLT_EXACT_ONLY)
+    if (SPU__XE_CXFLT_FAST(i8)) {
+        const __m128 hi = _mm_cvtepi32_ps(_mm_srli_epi32(v, 16)), lo = _mm_cvtepi32_ps(_mm_and_si128(v, _mm_set1_epi32(0xFFFF)));
+        return spu__xe_st(_mm_castps_si128(_mm_mul_ps(_mm_fmadd_ps(hi, _mm_set1_ps(65536.0f), lo), spu__xe_pow2((i8 & 0xFF) - 155))));
+    }
+#endif
     /* unsigned -> double: flip the top bit, convert as signed, add 2^31 back (all exact) */
     const __m256d d = _mm256_add_pd(_mm256_cvtepi32_pd(_mm_xor_si128(v, _mm_set1_epi32((int)0x80000000u))),
                                     _mm256_set1_pd(2147483648.0));
