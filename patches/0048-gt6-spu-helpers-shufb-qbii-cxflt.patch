@@ -1768,8 +1804,23 @@ SPU__XE_INLINE __m128i spu__xe_cxflt(__m256d d, __m128i sign, __m128i nz, int i8
     const __m128i flush = _mm_cmpgt_epi32(_mm_set1_epi32(1), biased);
     return _mm_and_si128(_mm_andnot_si128(flush, r), nz);
