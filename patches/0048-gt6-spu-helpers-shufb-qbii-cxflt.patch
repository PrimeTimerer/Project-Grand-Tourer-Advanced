@@ -588,14 +607,31 @@ static inline u128 spu_rotqbyi(u128 a, int sh) { return spu_rotqbyi_ref(a, sh);
  * word1<<32, but SPU's MS half is word0<<32 | word1), so native shifts on them
  * corrupt any bits crossing a 32-bit boundary. Assemble the logical hi/lo halves
  * with _u32[0] as most-significant, shift, then disassemble. */
-static inline u128 spu_shlqbii(u128 a, int sh) { sh&=7; if(!sh) return a;
+static inline u128 spu_shlqbii_ref(u128 a, int sh) { sh&=7; if(!sh) return a;
     uint64_t hi=((uint64_t)a._u32[0]<<32)|a._u32[1], lo=((uint64_t)a._u32[2]<<32)|a._u32[3];
     uint64_t nhi=(hi<<sh)|(lo>>(64-sh)), nlo=(lo<<sh);
     u128 r; r._u32[0]=(uint32_t)(nhi>>32); r._u32[1]=(uint32_t)nhi; r._u32[2]=(uint32_t)(nlo>>32); r._u32[3]=(uint32_t)nlo; return r; }
-static inline u128 spu_rotqbii(u128 a, int sh) { sh&=7; if(!sh) return a;
+static inline u128 spu_rotqbii_ref(u128 a, int sh) { sh&=7; if(!sh) return a;
     uint64_t hi=((uint64_t)a._u32[0]<<32)|a._u32[1], lo=((uint64_t)a._u32[2]<<32)|a._u32[3];
     uint64_t nhi=(hi<<sh)|(lo>>(64-sh)), nlo=(lo<<sh)|(hi>>(64-sh));
     u128 r; r._u32[0]=(uint32_t)(nhi>>32); r._u32[1]=(uint32_t)nhi; r._u32[2]=(uint32_t)(nlo>>32); r._u32[3]=(uint32_t)nlo; return r; }
+#if SPU_X86 && !defined(SPU_QBI_SCALAR)
+/* [GT6 0052] The quadword bit shifts in the vector register (SPU_QBI_SCALAR = the scalar forms above, as before).
+ * Word lane i is the i-th most significant word, so a shift left by 1..7 bits is each word shifted left with the
+ * top bits of the next lane coming in below: lanes moved down by one (a rotate of the four for rotqbii, zero into
+ * the last for shlqbii), shifted right by 32 - n, or-ed. The scalar forms built the result from four 32-bit
+ * stores, which the 128-bit load of the next instruction could not take from the store buffer: a stall at every
+ * use (thirteen rotqbii in one pass of jobmod_9039b3cc346b's func_0000C8C8). */
+static inline u128 spu_shlqbii(u128 a, int sh) { sh &= 7; if (!sh) return a;
+    const __m128i x = spu__xl(a);
+    return spu__xs(_mm_or_si128(_mm_slli_epi32(x, sh), _mm_srli_epi32(_mm_srli_si128(x, 4), 32 - sh))); }
+static inline u128 spu_rotqbii(u128 a, int sh) { sh &= 7; if (!sh) return a;
+    const __m128i x = spu__xl(a);
+    return spu__xs(_mm_or_si128(_mm_slli_epi32(x, sh), _mm_srli_epi32(_mm_shuffle_epi32(x, 0x39), 32 - sh))); }
+#else
+static inline u128 spu_shlqbii(u128 a, int sh) { return spu_shlqbii_ref(a, sh); }
+static inline u128 spu_rotqbii(u128 a, int sh) { return spu_rotqbii_ref(a, sh); }
+#endif
 
