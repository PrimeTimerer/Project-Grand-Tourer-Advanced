diff --git a/include/ps3emu/ps3_ab.h b/include/ps3emu/ps3_ab.h
new file mode 100644
index 0000000..55c3791
--- /dev/null
+++ b/include/ps3emu/ps3_ab.h
@@ -0,0 +1,37 @@
+/* ps3_ab.h - [GT6 0164, 2026-11-27] the in-run A/B.
+ *
+ * A set of switches alternates between OFF (phase A) and ON (phase B) every few seconds inside ONE run, so two ways are
+ * measured over the same race: GT6's 16-car reference scene varies from run to run more than the few per cent being
+ * measured (pack_run pb1on / pb1off, 2026-11-27: +15 .. +45 s 40.9 vs 57.7 fps with the same exe).
+ *
+ * The host sets the mask and flips the phase (GT6: main.cpp, GT6_AB=<names or hex mask>, GT6_AB_PERIOD=<s>); a switch
+ * site asks ps3_ab_on(bit, its own value from the environment): a bit in the mask follows the phase, any other switch
+ * keeps its own value. A cache that must not carry state from one phase into the other compares g_ps3_ab_gen, which
+ * every flip bumps. The frame trace (GT6_FRAME_TRACE) writes the phase on every row (column "ab": 0 A, 1 B, -1 none).
+ * tools\abprof.py splits a run's frames by phase. */
+#ifndef PS3_AB_H
+#define PS3_AB_H
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+extern volatile unsigned g_ps3_ab_mask;    /* the switches in the A/B (bits below); 0 = no A/B */
+extern volatile int      g_ps3_ab_phase;   /* 0 = A (the switches in the mask OFF), 1 = B (ON) */
+extern volatile unsigned g_ps3_ab_gen;     /* bumped at every flip */
+
+#define PS3_AB_RA_CACHE   0x0001u   /* PPU_RA_CACHE        ([GT6 0160], ppu_loader.cpp) */
+#define PS3_AB_HLE_SLOT   0x0002u   /* PPU_HLE_SLOT        ([GT6 0162], ppu_hle.cpp) */
+#define PS3_AB_PUMP_PEEK  0x0004u   /* GCM_PUMP_PEEK       ([GT6 0162], cellGcmSys.c) */
+#define PS3_AB_LOCKLINE   0x0008u   /* SPU_LOCKLINE_SLEEP  ([GT6 0163], spu_coherency.c) */
+#define PS3_AB_SPU_LS_VEC 0x0010u   /* g_spu_ls_vec ([GT6 0161]) - only in a GT6_SPU_LS_VEC=AB build ([GT6 0165]) */
+#define PS3_AB_SPU_CG     0x0020u   /* g_spu_cg_on  ([GT6 0159]) - only in a GT6_SPU_CG_HELPERS=AB build ([GT6 0165]) */
+
+static inline int ps3_ab_on(unsigned bit, int env_on)
+{
+    return (g_ps3_ab_mask & bit) ? (g_ps3_ab_phase != 0) : env_on;
+}
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* PS3_AB_H */
