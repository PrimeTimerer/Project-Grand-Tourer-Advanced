 #define SAVEDATA_FILESET_SIZE   0x30u
 
+/* The kernel copies for fread/fwrite and cannot fault a guest page in, so each page of a transfer is touched here
+ * first, in user mode (read-then-write: nothing in the buffer changes). A page that is not there is then brought in
+ * the way the title expects -- demand-committed, or, in a region the title pages itself (sys_mmapper page-fault
+ * notification), mapped by the title's own pager. Committing the buffer directly (vm_commit) put memory there that
+ * the title's pager knew nothing of: Gran Turismo 6 loads its save into a buffer in such a region, frees it, and
+ * later maps its car database (SPECDB) over the same addresses; the pages never faulted, the database read the save
+ * data left there instead of the file, every query came back empty and the menu script failed at load. */
+static void savedata_touch(void* buf, size_t len)
+{
+    volatile uint8_t* p = (volatile uint8_t*)buf;
+    if (!p || !len) return;
+    for (size_t o = 0; o < len; o += 0x1000) p[o] = p[o];
+    p[len - 1] = p[len - 1];
+}
+
 /* Preserve callback-updated userdata and read the requested operation back
  * before scratch is reused. FileGet reports the previous operation's byte count. */
 static s32 dispatch_func_file(uint32_t func_opd, uint32_t* userdata_ea,
@@ -270,9 +285,8 @@ static s32 dispatch_func_file(uint32_t func_opd, uint32_t* userdata_ea,
     out->fileSize = vm_read32(set_ea + 36);
     out->fileBufSize = vm_read32(set_ea + 40);
     out->fileBuf = buffer ? vm_base + buffer : NULL;
-    /* fread/fwrite on fileBuf go through the kernel, which cannot fault in a
-     * demand-committed guest page (see sys_fs_read). Commit it first. */
-    if (buffer && out->fileBufSize) vm_commit(buffer, out->fileBufSize);
+    /* fread/fwrite on fileBuf go through the kernel, which cannot fault in a guest page that is not there:
+     * savedata_touch() brings the pages of each transfer in, where the transfer is made. */
     return marshal_cbresult_read_result(cb_ea);
 }
 
@@ -702,6 +716,7 @@ static s32 process_file_op(const char* save_path, CellSaveDataFileSet* set)
         }
         size_t read_size = (size_t)set->fileSize;
         if (read_size > set->fileBufSize) read_size = set->fileBufSize;
+        savedata_touch(set->fileBuf, read_size);
