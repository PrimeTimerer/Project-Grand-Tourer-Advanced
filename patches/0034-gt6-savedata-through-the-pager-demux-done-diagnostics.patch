+/* Diagnostic (a port's thread report calls it): one line per SPU thread -- where it is, which events it has and
+ * waits for, and the SPURS kernel's own words in its local store (LS 0x1C0: the SPURS instance, 0x1C8: this SPU's
+ * number, 0x1DC: the workload it runs) -- then the first 0x80 bytes of each SPURS instance seen there (ready
+ * counts, contention, signals, idle flags). Reads only; a context may change while it is read. */
+void ps3_spu_threads_report(void)
+{
+    extern uint8_t* vm_base;
+    uint32_t spurs_seen[4]; int n_seen = 0;
+    for (int i = 0; i < MAX_SPU_THREADS; i++) {
+        const spu_thread_t* t = &s_spu_threads[i];
+        if (!t->in_use) continue;
+        const spu_context* c = (const spu_context*)t->live_ctx;
+        if (!c) c = t->sctx;
+        if (!c) {
+            fprintf(stderr, "[spu-threads] tid=0x%X group=0x%X running=%d (no context)\n", t->tid, t->group_id, t->running);
+            continue;
+        }
+        const uint8_t* ls = c->ls;
+        char k[160] = "";
+        if (ls) {
+            int p = 0;
+            for (int o = 0x1C0; o < 0x1E0; o += 4)
+                p += snprintf(k + p, sizeof k - p, " %02X%02X%02X%02X", ls[o], ls[o + 1], ls[o + 2], ls[o + 3]);
+        }
+        fprintf(stderr, "[spu-threads] tid=0x%X group=0x%X running=%d live=%d img=%d pc=0x%05X status=0x%X events=0x%X mask=0x%X int=%u LS[1C0]:%s\n",
+                t->tid, t->group_id, t->running, t->live_ctx ? 1 : 0, c->image_id, (unsigned)(c->pc & SPU_LS_MASK), c->status,
+                c->event_status, c->event_mask, c->int_enable, k);
+        if (ls) {
+            const uint32_t spurs = ((uint32_t)ls[0x1C4] << 24) | ((uint32_t)ls[0x1C5] << 16) | ((uint32_t)ls[0x1C6] << 8) | ls[0x1C7];
+            int dup = 0;
+            for (int j = 0; j < n_seen; j++) if (spurs_seen[j] == spurs) dup = 1;
+            if (!dup && spurs >= 0x10000u && n_seen < 4) spurs_seen[n_seen++] = spurs;
+        }
+    }
+    for (int j = 0; j < n_seen && vm_base; j++) {
+        const uint8_t* s = vm_base + spurs_seen[j];
+#ifdef _WIN32
+        MEMORY_BASIC_INFORMATION mbi;
+        if (!VirtualQuery(s, &mbi, sizeof mbi) || mbi.State != MEM_COMMIT || (mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD))) continue;
+#endif
+        /* +0x00..0xFF: counts, signals, workload states and status; +0xB00: the first eight workload descriptors
+         * (policy module address, argument, size, id, per-SPU priority), 0x20 bytes each. */
+        for (int row = 0; row < 0x100; row += 0x10) {
+            char b[80]; int p = 0;
+            for (int o = 0; o < 0x10; o++) p += snprintf(b + p, sizeof b - p, "%02X%s", s[row + o], (o & 3) == 3 ? " " : "");
+            fprintf(stderr, "[spu-threads] spurs 0x%08X +%02X: %s\n", spurs_seen[j], row, b);
+        }
+        for (int w = 0; w < 8; w++) {
+            const uint8_t* d = s + 0xB00 + w * 0x20;
+            char b[120]; int p = 0;
+            for (int o = 0; o < 0x20; o++) p += snprintf(b + p, sizeof b - p, "%02X%s", d[o], (o & 3) == 3 ? " " : "");
+            fprintf(stderr, "[spu-threads] spurs 0x%08X workload %d: %s\n", spurs_seen[j], w, b);
+        }
+    }
+}
