+/* FS_GUEST_BT=<substr> (diagnostic): for the opens, and the first 24 reads per descriptor, of a file whose path contains
+ * it: the callers, read from the ABI back chain ([frame] = caller's frame, [caller's frame + 0x10] = return address). */
+static unsigned g_fs_bt_reads[FS_MAX];
+static const char* fs_bt_want(void)
+{
+    static const char* want = (const char*)-1;
+    if (want == (const char*)-1) want = getenv("FS_GUEST_BT");
+    return (want && *want) ? want : NULL;
+}
+static void fs_guest_chain(ppu_context* ctx, const char* head)
+{
+    const uint32_t sp = (uint32_t)ctx->gpr[1];
+    char b[1500]; int p = snprintf(b, sizeof b, "[fs-bt] %s tid=%llu sp=0x%08X:", head, (unsigned long long)ctx->thread_id, sp);
+    uint32_t frame = sp;
+    for (int depth = 0; depth < 110 && p < 1480; depth++) {
+        const uint32_t up = vm_read32(frame + 4);
+        if (up <= frame || up - frame > 0x100000u) break;
+        const uint32_t lr = vm_read32(up + 0x14);
+        if (lr >= 0x00010200u && lr < 0x010C2000u) p += snprintf(b + p, sizeof(b) - p, " %08X", lr);
+        frame = up;
+    }
+    fprintf(stderr, "%s\n", b);
+}
+static void fs_guest_chain_read(ppu_context* ctx, int fd, long long pos, uint64_t want_bytes, size_t got, uint32_t buf)
+{
+    const char* want = fs_bt_want();
+    if (!want || fd < 0 || fd >= FS_MAX || !g_fd_path[fd][0] || !strstr(g_fd_path[fd], want) || g_fs_bt_reads[fd]++ >= 24) return;
+    char head[360];
+    snprintf(head, sizeof head, "read '%s' fd=%d pos=0x%llX want=0x%llX got=0x%zX buf=0x%08X", g_fd_path[fd], fd,
+             (unsigned long long)pos, (unsigned long long)want_bytes, got, buf);
+    fs_guest_chain(ctx, head);
