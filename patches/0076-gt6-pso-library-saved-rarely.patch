+/* [GT6 0147] How often the library file is written while the game runs. A save writes the WHOLE library, and
+ * Gran Turismo 6's had grown from the 50-60 MB above to 390-408 MB: at "every 10 s while new pipeline states arrive"
+ * one 29-minute session with 348 new states wrote it 28 times - 10.6 GB - and every short session twice (the first
+ * new state at once, the next ten seconds later). Each pipeline state is also kept as a file of its own
+ * (pipelines_v1), which the start's prewarm builds from, so the library only makes the next start faster: it is now
+ * written at shutdown, and while running at most every LD_PSO_LIBRARY_SAVE_S seconds (600 by default; counted from
+ * the first new state, not written at it; 0 = at shutdown only, 10 = as it was). */
+static LONGLONG ld_pso_library_save_every(LONGLONG qpc_frequency)
+{
+    static int secs = -1;
+    if (secs < 0) {
+        const char* e = getenv("LD_PSO_LIBRARY_SAVE_S");
+        secs = (e && *e) ? atoi(e) : 600;
+        if (secs < 0) secs = 0;
+        if (secs != 600)
+            fprintf(stderr, "[pso-library] LD_PSO_LIBRARY_SAVE_S=%d: %s\n", secs,
+                    secs ? "the file is written at most that often while running, and at shutdown"
+                         : "the file is written at shutdown only");
+    }
+    return (LONGLONG)secs * qpc_frequency;
+}
+
 static void ld_pso_library_save(int force)
 {
     if (g_pso_lib_state != 1) return;
@@ -9031,7 +9064,10 @@ static void ld_pso_library_save(int force)
     }
     if (g_pso_lib_gen == g_pso_lib_saved_gen) return;
     LARGE_INTEGER now, f; QueryPerformanceCounter(&now); QueryPerformanceFrequency(&f);
-    if (g_pso_lib_saved_qpc && now.QuadPart - g_pso_lib_saved_qpc < 10 * f.QuadPart) return;
+    const LONGLONG every = ld_pso_library_save_every(f.QuadPart);
+    if (!every) return;                                                        /* at shutdown only */
+    if (!g_pso_lib_saved_qpc) { g_pso_lib_saved_qpc = now.QuadPart; return; }  /* the first new state starts the clock */
+    if (now.QuadPart - g_pso_lib_saved_qpc < every) return;
     if (InterlockedCompareExchange(&g_pso_lib_saving, 1, 0) != 0) return;      /* the last one is still running */
     g_pso_lib_saved_qpc = now.QuadPart;
     HANDLE t = sync ? NULL : CreateThread(NULL, 0, ld_pso_library_save_thread, NULL, 0, NULL);
