+/* [GT6 0147] The save at the process's end. rsx_live_draw_shutdown has no caller in this port, so "at shutdown" never
+ * happened: the periodic save was the only one. A normal end - the window closed or the game's own exit - goes
+ * through the C library's exit() (cellSysutil.c host_quit_thread, sys_process_exit), which runs this. A killed
+ * process does not; the periodic save bounds what the library misses then, and the single pipeline files hold it. */
+static void ld_pso_library_atexit(void)
+{
+    ld_pso_library_save(1);
+}
