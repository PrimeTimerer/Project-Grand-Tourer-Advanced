+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        const surface_t* s = &g.surfaces[i];
+        if (s->gx1 <= s->gx0 || s->gy1 <= s->gy0 || s->location > 1u) continue;
+        const u32 a = s->offset + s->gy0 * s->pitch + s->gx0 * 4u, b = s->offset + (s->gy1 - 1u) * s->pitch + s->gx1 * 4u;
+        if (a < g_ld_mirror_lo[s->location]) g_ld_mirror_lo[s->location] = a;
