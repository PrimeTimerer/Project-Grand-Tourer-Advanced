+ *                           memory (the SPU side reads them there).
+ *   rsx_live_draw_note_guest_write   the title wrote into a display buffer's guest memory; before the next draw
+ *                           into that buffer (or its present) the written picture is copied into the GPU surface.
+ * Both are off unless a title asks (the port sets the variable and installs the hook). */
+static volatile LONG g_ld_guest_dirty[8];              /* per display buffer */
+static volatile LONG g_ld_guest_puts[8], g_ld_guest_bytes[8];   /* since the last upload (LD_PICTURE_LOG) */
