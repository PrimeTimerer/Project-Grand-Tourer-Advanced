+    const int64_t d = (int64_t)p->offset - (int64_t)q->offset;
+    int64_t dy = d / (int64_t)p->pitch, dxb = d % (int64_t)p->pitch;
+    if (dxb < 0) { dxb += p->pitch; dy -= 1; }
