+            g_vss.draws, g_vss.asked, g_vss.asked ? 100.0 * (double)g_vss.draws / (double)g_vss.asked : 0.0,
+            (double)g_vss.indices / nf, g_vss.direct, (double)g_vss.direct_verts / nf, g_vss.counted, g_vss.memo_hit,
+            g_vss.f_new, g_vss.f_wait, g_vss.f_volatile, g_vss.f_span, g_vss.f_restart, g_vss.f_shape, g_vss.f_full,
+            (double)g_vss.conv_verts / nf, g_vss.checks, g_vss.rehash, (double)g_vss.rehash_bytes / 1024.0 / nf,
+            g_vss.made, g_vss.grown, g_vss.dead, g_vss.idle, g_vss.sub_changed, g_vss.sub_again, g_vs_slabs,
+            (double)g_vs_live_bytes / 1048576.0, (double)g_vs_free_bytes / 1048576.0, g_vss.reused,
+            g_vs_chunks * 64u);
+    memset(&g_vss, 0, sizeof g_vss);
+    t0 = now.QuadPart; f0 = g_ld_frames;
+}
+
+static u32 ld_vs_level(u32 size)
+{
+    u32 k = 0;
+    while ((LD_VS_SUB << k) < size) k++;
+    return k;
+}
+
+/* A place in the arena is free from the moment the GPU has passed `fence`. */
+static void ld_vs_place_free(u32 size, u32 stride, u32 chunk, u32 offset, u64 fence)
+{
+    const u32 lv = ld_vs_level(size), sc = stride / 16u;
+    ld_vs_free* f = (ld_vs_free*)malloc(sizeof *f);
+    if (!f) return;                                 /* then the place is simply not used again */
+    f->next = NULL; f->fence = fence; f->chunk = chunk; f->offset = offset;
+    if (g_vs_freeq[lv][sc].tail) g_vs_freeq[lv][sc].tail->next = f; else g_vs_freeq[lv][sc].head = f;
+    g_vs_freeq[lv][sc].tail = f;
+    g_vs_free_bytes += (u64)size * stride;
+}
+
+/* A place for a block of `size` elements of `stride` bytes: one that was given back and that the GPU is done
+ * with, else new room in the arena; 0 when there is neither. */
+static int ld_vs_alloc(u32 size, u32 stride, u32* chunk, u32* offset)
+{
+    const u32 bytes = size * stride;
+    const u32 lv = ld_vs_level(size), sc = stride / 16u;
+    if (!bytes || bytes > LD_VS_CHUNK_BYTES || lv >= LD_VS_LEVELS || !sc || sc > 16u || (stride & 15u)) return 0;
+    ld_vs_free* f = g_vs_freeq[lv][sc].head;
+    if (f && g.fence->lpVtbl->GetCompletedValue(g.fence) >= f->fence) {
+        g_vs_freeq[lv][sc].head = f->next;
+        if (!f->next) g_vs_freeq[lv][sc].tail = NULL;
+        *chunk = f->chunk; *offset = f->offset;
+        free(f);
+        g_vs_free_bytes -= bytes;
+        g_vss.reused++;
+        return 1;
+    }
+    for (;;) {
+        if (g_vs_cur < g_vs_chunks && g_vs_chunk[g_vs_cur].used + bytes <= LD_VS_CHUNK_BYTES) {
+            *chunk = g_vs_cur;
+            *offset = g_vs_chunk[g_vs_cur].used;
+            g_vs_chunk[g_vs_cur].used += bytes;
+            return 1;
+        }
+        if (g_vs_cur + 1u < g_vs_chunks) { g_vs_cur++; continue; }
+        if (g_vs_chunks >= g_vs_chunk_cap || g_vs_chunks >= LD_VS_MAX_CHUNKS) break;
+        D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_UPLOAD;
+        D3D12_RESOURCE_DESC bd = {0};
+        bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = LD_VS_CHUNK_BYTES;
+        bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+        bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+        bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        ID3D12Resource* res = NULL;
+        void* cpu = NULL;
+        D3D12_RANGE rr = {0, 0};
+        if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+                D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void**)&res)) || !res ||
+            FAILED(res->lpVtbl->Map(res, 0, &rr, &cpu)) || !cpu) {
+            if (res) res->lpVtbl->Release(res);
+            fprintf(stderr, "[vslab] no memory for arena buffer %u: the arena stays at %u MB\n", g_vs_chunks, g_vs_chunks * 64u);
+            g_vs_chunk_cap = g_vs_chunks;
+            break;
+        }
+        res->lpVtbl->SetName(res, L"rsx-live-vertex-slabs");
+        g_vs_chunk[g_vs_chunks].res = res;
+        g_vs_chunk[g_vs_chunks].cpu = (u8*)cpu;
+        g_vs_chunk[g_vs_chunks].va = res->lpVtbl->GetGPUVirtualAddress(res);
+        g_vs_chunk[g_vs_chunks].used = 0;
+        g_vs_cur = g_vs_chunks++;
+    }
+    g_vs_full_seen = 1;                             /* see ld_vs_sweep */
+    g_vs_full_frame = g_ld_frames;
+    return 0;
+}
+
+/* The block leaves the hash now; its place is free once the GPU has run what was recorded so far (the open
+ * command list included: g.fence_value + 1 is what ld_flush signals it with). */
+static void ld_vs_retire(ld_vs_slab* s)
+{
+    ld_vs_slab** pp = &g_vs_bucket[(u32)(s->sig ^ (s->sig >> 32)) & (LD_VS_BUCKETS - 1u)];
+    while (*pp && *pp != s) pp = &(*pp)->next;
+    if (*pp) *pp = s->next;
+    ld_vs_place_free(s->size, s->stride, s->chunk, s->offset, g.fence_value + 1u);
+    g_vs_live_bytes -= (u64)s->size * s->stride;
+    g_vs_slabs--;
+    free(s);
+}
+
+/* A few hash chains a call: blocks no group has drawn from for 4 x LD_VS_IDLE_FRAMES frames give their place back -
+ * for LD_VS_IDLE_FRAMES when memory is short (more than half of the arena in use, or a new block went without a
+ * place in the last 1,800 frames). */
+static void ld_vs_sweep(u32 frame)
+{
+    if (g_ld_vslab_mb > 0) {                        /* a host's limit during a run: it can only take away */
+        u32 cap = (u32)g_ld_vslab_mb / 64u;
+        if (!cap) cap = 1;
+        if (cap < g_vs_chunk_cap) {
+            g_vs_chunk_cap = cap;
+            fprintf(stderr, "[vslab] the arena's limit is %u MB from here (%u MB are in it)\n", cap * 64u, g_vs_chunks * 64u);
+        }
+    }
+    /* Run255: with the sweep held back until three quarters of the arena were in use, a twelve-car race took 768 MB
+     * in 75 s, nearly all of it blocks of arrays that had changed and were never drawn from again; from the moment
+     * the limit was lowered to 64 MB the same race ran on 150-290 MB at the same frame rate. */
+    const u32 idle = (g_vs_live_bytes > (u64)g_vs_chunk_cap * (LD_VS_CHUNK_BYTES / 2u) ||
+                      (g_vs_full_seen && frame - g_vs_full_frame < 1800u)) ? LD_VS_IDLE_FRAMES : LD_VS_IDLE_FRAMES * 4u;
+    for (u32 n = 0; n < 16u; n++) {
+        g_vs_sweep_at = (g_vs_sweep_at + 1u) & (LD_VS_BUCKETS - 1u);
+        for (ld_vs_slab* s = g_vs_bucket[g_vs_sweep_at]; s;) {
+            ld_vs_slab* next = s->next;
+            if (frame - s->frame_used > idle) { ld_vs_retire(s); g_vss.idle++; }
+            s = next;
+        }
+    }
+}
+
+/* What is known about a signature that has no block (or whose block could not be read: its waiting time). With
+ * `make`, a place for it when it has none - NULL when its set holds four signatures that are kept. */
+static ld_vs_sigstate* ld_vs_sig_get(u64 sig, u32 frame, int make)
+{
+    ld_vs_sigstate* set = &g_vs_sig[((u32)(sig ^ (sig >> 32)) & (LD_VS_SIG_SETS - 1u)) * LD_VS_SIG_WAYS];
+    ld_vs_sigstate* empty = NULL; ld_vs_sigstate* once = NULL; ld_vs_sigstate* old = NULL;
+    for (u32 w = 0; w < LD_VS_SIG_WAYS; w++) {
+        ld_vs_sigstate* st = &set[w];
+        if (st->sig == sig) return st;
+        if (!st->sig) { if (!empty) empty = st; continue; }
+        if (st->until > frame) continue;                            /* waiting: kept */
+        if (st->misses && frame - st->frame <= 7200u) continue;     /* it changed not long ago: kept */
+        if (st->state == 1 && frame - st->frame > 1u) { if (!once) once = st; continue; }
+        if (!old || frame - st->frame > frame - old->frame) old = st;
+    }
+    if (!make) return NULL;
+    ld_vs_sigstate* st = empty ? empty : once ? once : old;
+    if (!st) return NULL;
+    memset(st, 0, sizeof *st);
+    st->sig = sig;
+    return st;
+}
+
+/* The host bytes elements [e0, e1) of the signature's arrays are read from, as their exact union, by address.
+ * UINT32_MAX when they cannot be named. */
+static u32 ld_vs_ranges(ld_vc_range* r, const rsx_vertex_fetch_plan* pl, const rsx_vertex_layout_plan* layout,
+                        u32 e0, u32 e1)
+{
+    ld_vc_range t[RSX_DSP_NUM_VERTEX_ATTR];
+    u32 n = 0;
+    for (u32 s = 0; s < layout->count; s++) {
+        const rsx_vertex_fetch_attr* f = &pl->attr[layout->attrs[s]];
+        if (!f->desc.type || !f->desc.size) continue;
+        const u64 prefix = rsx_dsp_resolve_vertex_offset(pl->base_offset, f->desc.offset);
+        const u64 start = prefix + (u64)e0 * f->stride;
+        const u64 end = prefix + (u64)(e1 - 1u) * f->stride + f->elem_size;
+        if (end > 0x100000000ull || end <= start) return UINT32_MAX;
+        const u8* p = guest_ptr(f->desc.location, (u32)start, (u32)(end - start));
+        if (!p) return UINT32_MAX;
+        /* The last byte too has to be memory the RSX sees, in one piece with the first: local memory below its
+         * 256 MB, main memory in a mapped IO page that follows on from the first byte's. So a block never reads
+         * (and never is the first to touch) guest memory outside what a title has given the RSX. */
+        if (f->desc.location == 0u ? end > 0x10000000ull
+                                   : guest_ptr(f->desc.location, (u32)(end - 1u), 1u) != p + (size_t)(end - start - 1u))
+            return UINT32_MAX;
+        t[n].p = p; t[n].n = (u32)(end - start); n++;
+    }
+    for (u32 i = 1; i < n; i++) {
+        const ld_vc_range x = t[i];
+        u32 j = i;
+        while (j && t[j - 1].p > x.p) { t[j] = t[j - 1]; j--; }
+        t[j] = x;
+    }
+    u32 m = 0;
+    for (u32 i = 0; i < n; i++) {
+        if (m && t[i].p <= r[m - 1].p + r[m - 1].n) {
+            const u8* end = t[i].p + t[i].n;
+            if (end > r[m - 1].p + r[m - 1].n) r[m - 1].n = (u32)(end - r[m - 1].p);
+        } else {
+            if (m >= LD_VS_RANGES) return UINT32_MAX;
+            r[m++] = t[i];
+        }
+    }
+    return m;
+}
+
+static u32 ld_vs_hash_ranges(const ld_vc_range* r, u32 n)
+{
+    u64 h = 0x9AE16A3B2F90404Full;
+    for (u32 i = 0; i < n; i++) {
+        h = ld_vr_bytes(h, r[i].p, r[i].n);
+        g_vss.rehash_bytes += r[i].n;
+    }
+    return (u32)(h ^ (h >> 32));
+}
+
+/* The signature's block that holds [vmin, vmax], or NULL; then *grow is its block that starts nearest below vmin
+ * (the one to make larger). *any says whether the signature has a block at all. */
+static ld_vs_slab* ld_vs_find(u64 sig, u32 vmin, u32 vmax, ld_vs_slab** grow, int* any)
+{
+    *grow = NULL;
+    for (ld_vs_slab* s = g_vs_bucket[(u32)(sig ^ (sig >> 32)) & (LD_VS_BUCKETS - 1u)]; s; s = s->next) {
+        if (s->sig != sig) continue;
+        *any = 1;
+        if (s->lo > vmin) continue;
+        if (vmax - s->lo < s->size) return s;
+        if (!*grow || s->lo > (*grow)->lo) *grow = s;
+    }
+    return NULL;
+}
+
+/* A new, empty block. The signature's blocks that lie wholly inside it hand over what they know of their
+ * sub-blocks (which wait, which never will) and give their place up. NULL (and nothing changed) when the arena
+ * has no place. */
+static ld_vs_slab* ld_vs_new(u64 sig, u32 lo, u32 size, u32 stride)
+{
+    u32 chunk = 0, offset = 0;
+    if (!ld_vs_alloc(size, stride, &chunk, &offset)) return NULL;
+    const u32 n_sub = size / LD_VS_SUB;
+    ld_vs_slab* s = (ld_vs_slab*)calloc(1, sizeof *s + (size_t)n_sub * 9u);
+    if (!s) { ld_vs_place_free(size, stride, chunk, offset, 0); return NULL; }
+    s->sig = sig; s->lo = lo; s->size = size; s->stride = stride;
+    s->chunk = chunk; s->offset = offset;
+    s->frame_used = g_ld_frames;
+    ld_vs_slab** head = &g_vs_bucket[(u32)(sig ^ (sig >> 32)) & (LD_VS_BUCKETS - 1u)];
+    for (ld_vs_slab* o = *head; o;) {
+        ld_vs_slab* next = o->next;
+        if (o->sig == sig && o->lo >= lo && o->lo - lo < size && o->lo - lo + o->size <= size) {
+            const u32 d = (o->lo - lo) / LD_VS_SUB, on = LD_VS_NSUB(o);
+            for (u32 c = 0; c < on; c++) {
+                const u32 t = c + d;
+                if ((o->refuse[c >> 6] >> (c & 63u)) & 1ull) s->refuse[t >> 6] |= 1ull << (t & 63u);
+                if ((o->wait[c >> 6] >> (c & 63u)) & 1ull) s->wait[t >> 6] |= 1ull << (t & 63u);
+                LD_VS_WHEN(s)[t] = LD_VS_WHEN(o)[c];
+                LD_VS_MISS(s)[t] = LD_VS_MISS(o)[c];
+            }
+            ld_vs_retire(o);
+        }
+        o = next;
+    }
+    s->next = *head;
+    *head = s;
+    g_vs_slabs++;
+    g_vs_live_bytes += (u64)size * stride;
+    g_vss.made++;
+    return s;
+}
+
+/* Elements [e0, e0 + n) of the arrays converted in their own order (n <= LD_VS_SUB). */
+static int ld_vs_fetch(rsx_vertex_fetch_plan* pl, u32 e0, u32 n, u8* out)
+{
+    static rsx_vertex_ref refs[LD_VS_SUB];
+    if (g_ld_vrun_ab) return rsx_vertex_fetch_run(pl, e0, n, out);
+    for (u32 i = 0; i < n; i++) { refs[i].vertex_id = e0 + i; refs[i].base_index = 0; }
+    rsx_vertex_fetch_plan_prepare(pl, refs, n);
+    return rsx_vertex_fetch_many(pl, refs, n, out);
+}
+
+/* Sub-block c of the block gets its vertices: its sources are harvested, hashed, read and converted, in that
+ * order. 1 done, 0 they cannot be read, -1 the sub-block reaches outside the RSX's memory (it is not asked for
+ * again: the groups that need it are drawn another way). */
+static int ld_vs_convert(ld_vs_slab* s, rsx_vertex_fetch_plan* pl, const rsx_vertex_layout_plan* layout, u32 c)
+{
+    static u8 scratch[LD_VS_SUB * RSX_DSP_NUM_VERTEX_ATTR * 16u];
+    const u32 e0 = s->lo + c * LD_VS_SUB;
+    ld_vc_range r[LD_VS_RANGES];
+    const u32 n = ld_vs_ranges(r, pl, layout, e0, e0 + LD_VS_SUB);
+    if ((size_t)LD_VS_SUB * s->stride > sizeof scratch) return 0;
+    if (n == UINT32_MAX) {
+        s->refuse[c >> 6] |= 1ull << (c & 63u);
+        return -1;
+    }
+    for (u32 i = 0; i < n; i++)
+        if (!ld_ww_harvest(r[i].p, r[i].n)) return 0;
+    const u32 h = ld_vs_hash_ranges(r, n);
+    if (!ld_vs_fetch(pl, e0, LD_VS_SUB, scratch)) return 0;
+    memcpy(g_vs_chunk[s->chunk].cpu + s->offset + (size_t)c * LD_VS_SUB * s->stride, scratch,
+           (size_t)LD_VS_SUB * s->stride);
+    s->conv[c >> 6] |= 1ull << (c & 63u);
+    s->hash[c] = h;
+    LD_VS_WHEN(s)[c] = g_ld_frames;
+    if (!s->n_conv || c < s->conv_first) s->conv_first = c;
+    if (!s->n_conv || c > s->conv_last) s->conv_last = c;
+    s->n_conv++;
+    g_vss.conv_verts += LD_VS_SUB;
+    return 1;
+}
+
+/* The block cannot be read (any more): it goes, and its signature gets no new block for a while that doubles
+ * each time. */
+static void ld_vs_give_up(ld_vs_slab* s, u32 frame)
+{
+    ld_vs_sigstate* st = ld_vs_sig_get(s->sig, frame, 1);
+    if (st) {
+        if (st->misses < 8u) st->misses++;
+        st->until = frame + (60u << st->misses);
+        st->state = 0;
+        st->frame = frame;
+    }
+    ld_vs_retire(s);
+    g_vss.dead++;
+}
+
+/* The block's first use in this epoch. 1: what its converted sub-blocks hold is what their sources say (those
+ * that it was not true of hold vertices no more and wait). 0: its sources cannot be read. */
+static int ld_vs_validate(ld_vs_slab* s, const rsx_vertex_fetch_plan* pl, const rsx_vertex_layout_plan* layout,
+                          u32 ep, u32 frame)
+{
+    g_vss.checks++;
+    if (s->n_conv) {
+        ld_vc_range r[LD_VS_RANGES];
+        const u32 n = ld_vs_ranges(r, pl, layout, s->lo + s->conv_first * LD_VS_SUB,
+                                   s->lo + (s->conv_last + 1u) * LD_VS_SUB);
+        if (n == UINT32_MAX) return 0;
+        u32 gen = g_ww_gen;
+        for (u32 i = 0; i < n; i++) {
+            const u32 g2 = ld_ww_harvest(r[i].p, r[i].n);
+            if (!g2) return 0;
+            gen = g2;
+        }
+        int clean = 1;
+        for (u32 i = 0; i < n && clean; i++) clean = ld_ww_clean_since(r[i].p, r[i].n, s->ww_gen);
+        if (!clean) {
+            g_vss.rehash++;
+            for (u32 c = s->conv_first; c <= s->conv_last; c++) {
+                const u64 bit = 1ull << (c & 63u);
+                if (!(s->conv[c >> 6] & bit)) continue;
+                ld_vc_range q[LD_VS_RANGES];
+                const u32 e0 = s->lo + c * LD_VS_SUB;
+                const u32 m = ld_vs_ranges(q, pl, layout, e0, e0 + LD_VS_SUB);
+                if (m == UINT32_MAX) return 0;
+                int sub_clean = 1;
+                for (u32 i = 0; i < m && sub_clean; i++) sub_clean = ld_ww_clean_since(q[i].p, q[i].n, s->ww_gen);
+                if (sub_clean || ld_vs_hash_ranges(q, m) == s->hash[c]) continue;
+                /* Its sources changed: it holds vertices no more. Nothing is written over now - draws recorded
+                 * before this may still read it. */
+                u32* const when = LD_VS_WHEN(s);
+                u8* const miss = LD_VS_MISS(s);
+                if (frame - when[c] > 3600u) miss[c] = 1;       /* it had stood for a minute */
+                else if (miss[c] < 8u) miss[c]++;
+                when[c] = frame + (60u << miss[c]);
+                s->conv[c >> 6] &= ~bit;
+                s->wait[c >> 6] |= bit;
+                s->n_conv--;
+                s->wait_fence = g.fence_value + 1u;
+                g_vss.sub_changed++;
+            }
+        }
+        s->ww_gen = gen;        /* of the harvest above, taken before the hashes */
+    } else
+        s->ww_gen = g_ww_gen;
+    s->epoch_ok = ep;
+    return 1;
+}
+
+/* 2 when the group's `total` indices (g_vs_raw, the lowest of them rmin) name nearly every element of their span -
+ * at most a quarter more elements in the span than are named - so that converting the span as a plain run costs
+ * little more than converting the named vertices alone; else 0 (the old way, which compacts). (The first form
+ * asked only that the span be no longer than the index list and converted 110-300,000 vertices a frame in a
+ * twelve-car race where the old way converted 60-75,000, run251.)
+ * The answer for one list of indices - `where` it lies, how many, their lowest and their span - is kept: counting
+ * the named elements was 0.4 ms of a heavy frame (run252). It is a choice between two ways that both draw the
+ * group right, so an answer that has gone stale (indices rewritten in place with the same lowest and span) can
+ * cost time and nothing else. */
+static int ld_vs_direct_ok(u32 total, u32 rmin, u32 span, u64 where)
+{
+    static u64 bits[LD_VS_MAX_BLOCK / 64u];
+    static u64 memo[LD_VS_MEMO];
+    if (span > LD_VS_MAX_BLOCK || span > total + total / 4u + 16u) return 0;
+    if (g_ld_vdir_ab) return 2;                     /* GT6_AB "vdir": the span against the index list alone */
+    const u64 key = ld_vr_mix(where, ((u64)total << 40) ^ ((u64)rmin << 20) ^ span) | 1ull;
+    u64* const m = &memo[(u32)(key >> 24) & (LD_VS_MEMO - 1u)];
+    if (((*m ^ key) & ~2ull) == 0ull) { g_vss.memo_hit++; return (int)(*m & 2ull); }
+    g_vss.counted++;
+    const u32 words = (span + 63u) >> 6;
+    memset(bits, 0, (size_t)words * sizeof(u64));
+    const u32* const raw = g_vs_raw;
+    for (u32 i = 0; i < total; i++) {
+        const u32 v = raw[i] - rmin;
+        bits[v >> 6] |= 1ull << (v & 63u);
+    }
+    u32 named = 0;
+    for (u32 w = 0; w < words; w++) named += (u32)__builtin_popcountll(bits[w]);
+    const int yes = span <= named + named / 4u + 16u;
+    *m = (key & ~2ull) | (yes ? 2ull : 0ull);
+    return yes ? 2 : 0;
+}
+
+static int ld_vs_prepare_inner(const rsx_vertex_layout_plan* layout, u32 prim, ld_vs_draw* out, int* plan_made)
+{
+    if (!dc.n_idx || dc.n_arr || !layout->stride || !layout->count) return 0;
+    if (prim != PRIM_TRIANGLES && prim != PRIM_TRIANGLE_STRIP && prim != PRIM_TRIANGLE_FAN && prim != PRIM_QUADS)
+        return 0;
+    const u32 frame = g_ld_frames;
+    g_vss.asked++;
+    if ((g_vss.asked & 63u) == 0u) { ld_vs_stats(); ld_vs_sweep(frame); }
+    rsx_vertex_fetch_plan* pl = &dc.fetch_plan;
