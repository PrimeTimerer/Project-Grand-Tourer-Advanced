+    b[0].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b[0].Transition.pResource = p->tex;
+    b[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b[1] = b[0];
+    b[1].Transition.pResource = q->tex;
+    b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+    g.list->lpVtbl->ResourceBarrier(g.list, 2, b);
+    D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+    dst.pResource = q->tex; dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.pResource = p->tex; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    const D3D12_BOX box = { sx, sy, 0, sx + w, sy + h, 1 };
+    g.list->lpVtbl->CopyTextureRegion(g.list, &dst, qx, qy, 0, &src, &box);
+    b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b[1].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    g.list->lpVtbl->ResourceBarrier(g.list, 2, b);
+    g_ld_mirror_gpu_copies++;
+}
+static int ld_mirror_peer(const surface_t* s, const surface_t* o, u32 maxpx)
+{
+    return o != s && o->tex && o->location == s->location && o->pitch &&
+           o->fmt == DXGI_FORMAT_R8G8B8A8_UNORM && (u64)o->w * o->h <= maxpx;
+}
+/* The stream leaves surface pi with [mx0,mx1) x [my0,my1) drawn. 1 = done on the GPU (see above); 0 = one of the
+ * surfaces over the same bytes lays them out differently, and the caller copies into guest memory as before. */
+static int ld_mirror_leave(u32 pi, u32 maxpx)
+{
+    surface_t* s = &g.surfaces[pi];
+    const u32 x0 = s->mx0, y0 = s->my0, x1 = s->mx1, y1 = s->my1;
+    const u32 lo = s->offset + y0 * s->pitch, hi = s->offset + (y1 - 1u) * s->pitch + x1 * 4u;
+    u32 sx, sy, qx, qy, w, h;
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        const surface_t* o = &g.surfaces[i];
+        if (!ld_mirror_peer(s, o, maxpx) || !(lo < o->offset + o->pitch * o->h && hi > o->offset)) continue;
+        if (ld_mirror_map(s, o, x0, y0, x1, y1, &sx, &sy, &qx, &qy, &w, &h) < 0) return 0;
+    }
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        surface_t* o = &g.surfaces[i];
+        if (!ld_mirror_peer(s, o, maxpx) || !(lo < o->offset + o->pitch * o->h && hi > o->offset)) continue;
+        if (ld_mirror_map(s, o, x0, y0, x1, y1, &sx, &sy, &qx, &qy, &w, &h) != 1) continue;
+        ld_mirror_gpu_copy(s, o, sx, sy, qx, qy, w, h);
+        ld_surface_note_write(i, LD_SURFACE_WRITE_COPY);
+    }
+    if (s->gx1 <= s->gx0 || s->gy1 <= s->gy0) { s->gx0 = x0; s->gy0 = y0; s->gx1 = x1; s->gy1 = y1; }
+    else {
+        if (x0 < s->gx0) s->gx0 = x0;
+        if (y0 < s->gy0) s->gy0 = y0;
+        if (x1 > s->gx1) s->gx1 = x1;
+        if (y1 > s->gy1) s->gy1 = y1;
+    }
+    ld_mirror_bounds();
+    return 1;
+}
+static int ld_surface_download(const surface_t* s, u32 sx, u32 sy, u32 w, u32 h, u8* dst, u32 dst_pitch);
+/* The remembered rectangle of one surface into guest memory (one synchronous flush). */
+static void ld_mirror_sync_one(surface_t* s)
+{
+    const u32 gx0 = s->gx0, gy0 = s->gy0, w = s->gx1 - s->gx0, h = s->gy1 - s->gy0;
+    s->gx0 = s->gy0 = s->gx1 = s->gy1 = 0;
+    u8* dst = (s->tex && s->pitch) ? (u8*)guest_ptr(s->location, s->offset + gy0 * s->pitch + gx0 * 4u, s->pitch * (h - 1u) + w * 4u) : NULL;
+    if (dst) ld_surface_download(s, gx0, gy0, w, h, dst, s->pitch);
+    g_ld_mirror_syncs++;
+}
+/* Guest bytes [lo, hi) of a location are about to be read as they are. */
+static void ld_mirror_sync_range(u32 location, u32 lo, u32 hi)
+{
+    if (!g_ld_mirror_pending) return;
+    int any = 0;
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        surface_t* s = &g.surfaces[i];
+        if (s->gx1 <= s->gx0 || s->gy1 <= s->gy0 || s->location != location || !s->pitch) continue;
+        const u32 a = s->offset + s->gy0 * s->pitch + s->gx0 * 4u, b = s->offset + (s->gy1 - 1u) * s->pitch + s->gx1 * 4u;
+        if (a >= hi || b <= lo) continue;
+        static u32 said;
+        if (said < 24u) {
+            said++;
+            fprintf(stderr, "[mirror] lazy: surface %u:0x%X %ux%u, %ux%u at %u,%u copied into guest memory for a reader of "
+                            "0x%X-0x%X, frame %u\n", s->location, s->offset, s->w, s->h, s->gx1 - s->gx0, s->gy1 - s->gy0,
+                    s->gx0, s->gy0, lo, hi, g_ld_frames);
+        }
+        ld_mirror_sync_one(s);
+        any = 1;
+    }
+    if (any) ld_mirror_bounds();
+}
+/* A surface is about to get another resource (or go): what only its old one holds goes into guest memory. */
+static void ld_mirror_drop_surface(surface_t* s)
+{
+    if (s->gx1 > s->gx0 && s->gy1 > s->gy0) { ld_mirror_sync_one(s); ld_mirror_bounds(); }
+    s->gx0 = s->gy0 = s->gx1 = s->gy1 = 0;
+    s->mseed = 0;
+}
+/* A surface the stream draws into for the first time since it was made: what other surfaces hold of its guest
+ * bytes, and guest memory does not have yet, comes over by GPU copy. */
+static void ld_mirror_seed(u32 ti, u32 maxpx)
+{
+    surface_t* t = &g.surfaces[ti];
+    t->mseed = 1;
+    if (!t->tex || !t->pitch || t->fmt != DXGI_FORMAT_R8G8B8A8_UNORM || (u64)t->w * t->h > maxpx || !g_ld_mirror_pending) return;
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        surface_t* p = &g.surfaces[i];
+        u32 sx, sy, qx, qy, w, h;
+        if (i == ti || !p->tex || p->gx1 <= p->gx0 || p->gy1 <= p->gy0 || p->fmt != DXGI_FORMAT_R8G8B8A8_UNORM) continue;
+        if (ld_mirror_map(p, t, p->gx0, p->gy0, p->gx1, p->gy1, &sx, &sy, &qx, &qy, &w, &h) != 1) continue;
+        ld_mirror_gpu_copy(p, t, sx, sy, qx, qy, w, h);
+        ld_surface_note_write(ti, LD_SURFACE_WRITE_COPY);
+    }
+}
+
+/* The cube window (see above). Face f, level m of a pitch-linear bordered cube starts at row
+ * f * face_rows + (the rows of the levels before it, each level + 2) of the texture's memory, with the picture
+ * one texel in and one row down (ld_cube_border_texels) - so in the surface that IS that memory it is the
+ * rectangle (1, that row + 1) of the level's size. */
+static void surface_cube_window_copy(surface_t* s, u32 k)
+{
+    const u32 w = s->swin[k].w, n = s->swin[k].cube;
+    u32 face_rows = 0;
+    for (u32 m = 0; m < n; m++) face_rows += ((w >> m) ? (w >> m) : 1u) + 2u;
+    D3D12_RESOURCE_BARRIER b[2] = {0};
+    b[0].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b[0].Transition.pResource = s->tex;
+    b[0].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b[1] = b[0];
+    b[1].Transition.pResource = s->swin[k].tex;
+    b[1].Transition.StateBefore = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+    g.list->lpVtbl->ResourceBarrier(g.list, 2, b);
+    D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+    dst.pResource = s->swin[k].tex; dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    src.pResource = s->tex;         src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+    for (u32 f = 0; f < 6u; f++) {
+        u32 row = f * face_rows;
+        for (u32 m = 0; m < n; m++) {
+            const u32 mw = (w >> m) ? (w >> m) : 1u;
+            const D3D12_BOX box = { 1u, row + 1u, 0, 1u + mw, row + 1u + mw, 1 };
+            dst.SubresourceIndex = m + f * n;
+            g.list->lpVtbl->CopyTextureRegion(g.list, &dst, 0, 0, 0, &src, &box);
+            row += mw + 2u;
+        }
+    }
+    b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b[1].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    g.list->lpVtbl->ResourceBarrier(g.list, 2, b);
+    s->swin[k].wgen = s->swin_wgen;
+    g_ld_cube_copies++;
+}
+/* The SRV slot of the cube window for texture t, or -1 when t is not such a texture or no surface is its memory. */
+static int surface_cube_window(const rsx_dsp_texture* t)
+{
+    if (!t->cubemap || !(t->format & TEX_FMT_LINEAR) || !t->pitch || t->dimension != 2u) return -1;
+    if ((t->format & TEX_FMT_BASE_MASK & ~(u32)TEX_FMT_UNNORM) != TEX_FMT_A8R8G8B8) return -1;
+    if ((t->remap & 0xFFFFu) != 0xAAE4u || t->width != t->height || !t->width || t->width > 1024u) return -1;
+    if (!ld_cube_border_texels(t)) return -1;
+    u32 n = t->mipmaps ? t->mipmaps : 1u, avail = 1u;
+    for (u32 m = t->width; m > 1u; m >>= 1) avail++;
+    if (n > 14u) n = 14u;
+    if (n > avail) n = avail;
+    u32 face_rows = 0;
+    for (u32 m = 0; m < n; m++) face_rows += ((t->width >> m) ? (t->width >> m) : 1u) + 2u;
+    int si = -1;
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        const surface_t* c = &g.surfaces[i];
+        if (!c->tex || c->location != t->location || c->offset != t->offset || c->pitch != t->pitch ||
+            c->fmt != DXGI_FORMAT_R8G8B8A8_UNORM || c->w < t->width + 2u || c->h < face_rows * 6u) continue;
+        si = (int)i;
+        break;
+    }
+    if (si < 0) return -1;
+    surface_t* s = &g.surfaces[si];
+    static u32 use_clock = 0x40000000u;       /* above the 2D windows' clock: a cube window is not the first to go */
+    u32 k = LD_SWIN_PER;
+    for (u32 j = 0; j < LD_SWIN_PER; j++)
+        if (s->swin[j].tex && s->swin[j].src == s->tex && s->swin[j].cube == n && s->swin[j].w == t->width) { k = j; break; }
+    if (k == LD_SWIN_PER) {
+        k = 0;
+        for (u32 j = 1; j < LD_SWIN_PER; j++)
+            if (!s->swin[j].tex || (s->swin[k].tex && s->swin[j].used < s->swin[k].used)) k = j;
+        if (s->swin[k].tex) retire_texture(s->swin[k].tex);
+        s->swin[k].tex = NULL; s->swin[k].cube = 0;
+        D3D12_RESOURCE_DESC rd = {0};
+        rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        rd.Width = t->width; rd.Height = t->width; rd.DepthOrArraySize = 6; rd.MipLevels = (UINT16)n;
+        rd.Format = DXGI_FORMAT_R8G8B8A8_UNORM; rd.SampleDesc.Count = 1;
+        D3D12_HEAP_PROPERTIES hp = {0};
+        hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+        ID3D12Resource* wt = NULL;
+        if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+                D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, NULL, &IID_ID3D12Resource, (void**)&wt))) {
+            static u32 n_fail;
+            if (n_fail++ < 4) fprintf(stderr, "[cube-window] create failed %u:0x%X %ux%u, %u levels\n", t->location, t->offset, t->width, t->width, n);
+            return -1;
+        }
+        s->swin[k].tex = wt; s->swin[k].src = s->tex; s->swin[k].w = t->width; s->swin[k].h = t->width;
+        s->swin[k].ox = 0; s->swin[k].oy = 0; s->swin[k].cube = n;
+        s->swin[k].wgen = s->swin_wgen - 1u;
+        D3D12_SHADER_RESOURCE_VIEW_DESC desc = {0};
+        desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURECUBE;
+        desc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        desc.TextureCube.MipLevels = (UINT)-1;
+        g.dev->lpVtbl->CreateShaderResourceView(g.dev, wt, &desc, srv_cpu(SRV_SURF_WIN_BASE + (u32)si * LD_SWIN_PER + k));
+        fprintf(stderr, "[cube-window] texture %u:0x%X %ux%u, %u levels, is surface %ux%u (slot %d.%u): filled by GPU copies, frame %u\n",
+                t->location, t->offset, t->width, t->width, n, s->w, s->h, si, k, g_ld_frames);
+    }
+    s->swin[k].used = ++use_clock;
+    if (s->swin[k].wgen != s->swin_wgen)
+        surface_cube_window_copy(s, k);
+    return (int)(SRV_SURF_WIN_BASE + (u32)si * LD_SWIN_PER + k);
+}
+
+/* LD_SURFACE_MIRROR=<max pixels>: small render targets are kept current in guest memory.
+ *
+ * GT6 renders the six faces of the car's reflection cube map into six small targets, builds the mip levels with
+ * draws into ONE target that spans all six, and then samples the same memory as a cube texture. Each (address,
+ * size) is a GPU surface of its own here, and a cube texture is decoded from guest memory, where nothing had
+ * been drawn: the reflection read as zero, the shader divided by its alpha, and the whole car came out black.
+ * With the mirror on, a target of at most <max pixels> is copied into guest memory when the stream moves to
+ * another target (only the part its draws reached), a target whose memory was rewritten that way is loaded from
+ * guest memory before it is drawn into again, and a cube texture is taken from guest memory even when a surface
+ * sits at its address. Off unless a title asks. */
+static u32 ld_surface_mirror_max(void)
+{
+    static long v = -1;
+    if (v < 0) { const char* e = getenv("LD_SURFACE_MIRROR"); v = (e && *e) ? atol(e) : 0; if (v < 0) v = 0; }
+    return (u32)v;
+}
+static void ld_surface_mirror_step(u32 target, u32 color_mask, u32 vx, u32 vy, u32 vw, u32 vh)
+{
+    const u32 maxpx = ld_surface_mirror_max();
+    if (!maxpx || target >= g.n_surfaces) return;
+    static u32 prev = LD_INVALID_SURFACE;
+    if (prev != target) {
+        if (prev < g.n_surfaces) {
+            surface_t* s = &g.surfaces[prev];
+            if (s->tex && s->fmt == DXGI_FORMAT_R8G8B8A8_UNORM && s->pitch && s->mx1 > s->mx0 && s->my1 > s->my0 &&
+                ld_mirror_lazy_on() && ld_mirror_leave(prev, maxpx)) {
+                /* lazy mirror: the pixels went to the surfaces over the same bytes on the GPU; nothing is copied
+                 * into guest memory until a reader of those bytes turns up */
+            } else
+            if (s->tex && s->fmt == DXGI_FORMAT_R8G8B8A8_UNORM && s->pitch && s->mx1 > s->mx0 && s->my1 > s->my0) {
+                const u32 w = s->mx1 - s->mx0, h = s->my1 - s->my0;
+                if (ld_mirror_lazy_on()) {          /* a surface over the same bytes that a GPU copy cannot serve */
+                    static u32 said;
+                    if (!g_ld_mirror_eager++ || said < 8u) {
+                        said++;
+                        fprintf(stderr, "[mirror] lazy: surface %u:0x%X %ux%u pitch %u is copied into guest memory after all "
+                                        "(another surface lays the same bytes out differently), frame %u\n",
+                                s->location, s->offset, s->w, s->h, s->pitch, g_ld_frames);
+                    }
+                }
+                /* older pixels that only surfaces hold go down first, this target's on top of them */
+                if (g_ld_mirror_pending) ld_mirror_sync_range(s->location, s->offset, s->offset + s->pitch * s->h);
+                u8* dst = (u8*)guest_ptr(s->location, s->offset + s->my0 * s->pitch + s->mx0 * 4u,
+                                         s->pitch * (h - 1u) + w * 4u);
+                if (dst && ld_surface_download(s, s->mx0, s->my0, w, h, dst, s->pitch)) {
+                    const u32 lo = s->offset + s->my0 * s->pitch, hi = s->offset + (s->my1 - 1u) * s->pitch + s->mx1 * 4u;
+                    for (u32 i = 0; i < g.n_surfaces; i++) {
+                        surface_t* o = &g.surfaces[i];
+                        if (i == prev || !o->tex || o->location != s->location || !o->pitch ||
+                            o->fmt != DXGI_FORMAT_R8G8B8A8_UNORM || (u64)o->w * o->h > maxpx) continue;
+                        if (lo < o->offset + o->pitch * o->h && hi > o->offset) o->mirror_stale = 1;
+                    }
+                    static u32 said_off[16]; static u32 n_said;      /* the first copy of each surface */
+                    u32 q = 0;
+                    for (; q < n_said; q++) if (said_off[q] == (s->offset ^ (s->h << 20))) break;
+                    if (q == n_said && n_said < 16 && (said_off[n_said++] = (s->offset ^ (s->h << 20)), 1))
+                        fprintf(stderr, "[mirror] surface %u:0x%X %ux%u: %ux%u at %u,%u copied into guest memory, frame %u\n",
+                                s->location, s->offset, s->w, s->h, w, h, s->mx0, s->my0, g_ld_frames);
+                }
+            }
+            s->mx0 = s->my0 = s->mx1 = s->my1 = 0;
+        }
+        prev = target;
+        surface_t* t = &g.surfaces[target];
+        if (!t->mseed && ld_mirror_lazy_on()) ld_mirror_seed(target, maxpx);
+        { static u32 said_frame;                 /* what the lazy mirror did, every 600 frames */
+          if (g_ld_frames - said_frame >= 600u && (g_ld_mirror_gpu_copies || g_ld_mirror_syncs || g_ld_cube_copies)) {
+              said_frame = g_ld_frames;
+              fprintf(stderr, "[mirror] lazy, up to frame %u: %llu GPU copies between surfaces, %llu cube fills, %llu copies into guest memory; "
+                              "%u surface(s) hold pixels guest memory does not | all synchronous downloads %llu (%llu px), uploads %llu (%llu px), "
+                              "left to the eager copy %llu, small blits read back later %llu/%llu\n", g_ld_frames, g_ld_mirror_gpu_copies,
+                      g_ld_cube_copies, g_ld_mirror_syncs, g_ld_mirror_pending, g_ld_dl_calls, g_ld_dl_px, g_ld_ul_calls, g_ld_ul_px,
+                      g_ld_mirror_eager, g_arb_delivered, g_arb_queued);
+          } }
+        if (t->mirror_stale) {
+            t->mirror_stale = 0;
+            if (g_ld_mirror_pending && t->pitch) ld_mirror_sync_range(t->location, t->offset, t->offset + t->pitch * t->h);
+            const u8* srcp = (t->pitch && t->fmt == DXGI_FORMAT_R8G8B8A8_UNORM)
+                ? guest_ptr(t->location, t->offset, t->pitch * (t->h - 1u) + t->w * 4u) : NULL;
+            if (srcp && ld_surface_upload(t, srcp, t->pitch, t->w, t->h)) {
+                ld_flush(LD_FLUSH_READBACK);        /* the upload buffer is free again for the next one */
+                static u32 said = 0;
+                if (PS3_LOG_FIRST(said, 12))
+                    fprintf(stderr, "[mirror] surface %u:0x%X %ux%u loaded from guest memory, frame %u\n",
+                            t->location, t->offset, t->w, t->h, g_ld_frames);
+            }
+        }
+    }
+    surface_t* s = &g.surfaces[target];
+    if (!color_mask || s->fmt != DXGI_FORMAT_R8G8B8A8_UNORM || (u64)s->w * s->h > maxpx) return;
+    u32 x0 = vx < s->w ? vx : s->w, y0 = vy < s->h ? vy : s->h;
+    u32 x1 = vx + vw < s->w ? vx + vw : s->w, y1 = vy + vh < s->h ? vy + vh : s->h;
+    if (x1 <= x0 || y1 <= y0) return;
+    if (s->mx1 <= s->mx0 || s->my1 <= s->my0) { s->mx0 = x0; s->my0 = y0; s->mx1 = x1; s->my1 = y1; }
+    else {
+        if (x0 < s->mx0) s->mx0 = x0;
+        if (y0 < s->my0) s->my0 = y0;
+        if (x1 > s->mx1) s->mx1 = x1;
+        if (y1 > s->my1) s->my1 = y1;
+    }
+}
+
+/* ---- A small picture copied out of a live surface into main memory, without waiting for the GPU [GT6 0036] ----
+ * Gran Turismo 6 copies 16x2 pixels of its brightness measurement into main memory twice a frame (NV3089, the source
+ * in a render target) and reads them with the CPU. Writing them into guest memory was a synchronous readback - the
+ * one flush left in a frame once the mirror was lazy, and it waits for everything the frame has drawn so far: 10%
+ * of the drawing thread (run234). Now the copy is recorded into a readback buffer and written to guest memory when
+ * the GPU has done it, a frame or two later. The console's own copy is asynchronous as well, and an exposure
+ * control works on a brightness that is a frame old. The first picture for a destination is still taken at once.
+ * LD_BLIT_ASYNC_PX=<pixels> (default 4096, 0 = always at once) is the largest picture handled this way; larger
+ * ones (the 1280x720 scene the SPU post-process reads) stay synchronous. Waits for LD_NEW_AT_SEC. */
+#define LD_ARB_N 8
