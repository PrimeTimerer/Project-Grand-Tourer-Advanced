+ * 1 = *sx,*sy (in p) and *qx,*qy (in q) and the size; 0 = no part of it is in q; -1 = the two surfaces do not lay
+ * the bytes out alike (another pitch, or q starts in the middle of a texel), so a GPU copy cannot stand for it. */
+static int ld_mirror_map(const surface_t* p, const surface_t* q, u32 x0, u32 y0, u32 x1, u32 y1,
+                         u32* sx, u32* sy, u32* qx, u32* qy, u32* cw, u32* ch)
