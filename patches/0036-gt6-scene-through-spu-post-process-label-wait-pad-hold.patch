+    if (from == -2) { const char* e = getenv("LD_PICTURE_LOG"); from = (e && *e) ? atol(e) : -1; }
+    if (from < 0 || (long)g_ld_frames < from || lines >= 1500) return;
+    LARGE_INTEGER now; QueryPerformanceCounter(&now);
+    if (!qf) { LARGE_INTEGER q; QueryPerformanceFrequency(&q); t0 = now.QuadPart; qf = q.QuadPart; }
+    InterlockedIncrement(&lines);
+    char buf[300]; va_list ap; va_start(ap, fmt); vsnprintf(buf, sizeof buf, fmt, ap); va_end(ap);
+    fprintf(stderr, "[pic] %9.3f f%u %s\n", (double)(now.QuadPart - t0) * 1000.0 / (double)qf, g_ld_frames, buf);
