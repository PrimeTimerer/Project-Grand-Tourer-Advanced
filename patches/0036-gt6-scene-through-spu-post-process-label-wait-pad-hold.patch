+static long s_bad;
+static void cmp(const char* what, u128 a, u128 b, int i8, u128 got_rn, u128 got_rz, u128 ref)
+{
+    if (!memcmp(&got_rn, &ref, 16) && !memcmp(&got_rz, &ref, 16)) return;
+    if (s_bad++ < 20)
+        printf("MISMATCH %s i8=%d a=%08X %08X %08X %08X b=%08X.. default=%08X.. rz=%08X.. ref=%08X..\n", what, i8,
+               a._u32[0], a._u32[1], a._u32[2], a._u32[3], b._u32[0], got_rn._u32[0], got_rz._u32[0], ref._u32[0]);
+}
+#define BOTH(expr, rn, rz) do { _mm_setcsr(0x1F80u); rn = (expr); _mm_setcsr(SPU_MXCSR_RZFZ); rz = (expr); _mm_setcsr(0x1F80u); } while (0)
+
+int main(int argc, char** argv)
+{
+    const long n = (argc > 1 ? atol(argv[1]) : 1) * 8L * 1000 * 1000;
+    for (long it = 0; it < n; it++) {
+        u128 a, b, rn, rz;
+        for (int k = 0; k < 4; k++) { a._u32[k] = word(); b._u32[k] = word(); }
+        if ((it & 7) == 0) for (int k = 0; k < 4; k++) a._u32[k] = rnd32();          /* plain integers for csflt/cuflt */
+        const int i8 = (int)(rnd32() & 0xFF);
+        BOTH(spu_cflts(a, i8), rn, rz);   cmp("cflts", a, b, i8, rn, rz, spu_cflts_ref(a, i8));
+        BOTH(spu_cfltu(a, i8), rn, rz);   cmp("cfltu", a, b, i8, rn, rz, spu_cfltu_ref(a, i8));
+        BOTH(spu_csflt(a, i8), rn, rz);   cmp("csflt", a, b, i8, rn, rz, spu_csflt_ref(a, i8));
+        BOTH(spu_cuflt(a, i8), rn, rz);   cmp("cuflt", a, b, i8, rn, rz, spu_cuflt_ref(a, i8));
+        BOTH(spu_frest(a), rn, rz);       cmp("frest", a, b, 0, rn, rz, spu_frest_ref(a));
+        BOTH(spu_frsqest(a), rn, rz);     cmp("frsqest", a, b, 0, rn, rz, spu_frsqest_ref(a));
+        BOTH(spu_fi(a, b), rn, rz);       cmp("fi", a, b, 0, rn, rz, spu_fi_ref(a, b));
+        BOTH(spu_fceq(a, b), rn, rz);     cmp("fceq", a, b, 0, rn, rz, spu_fceq_ref(a, b));
+        BOTH(spu_fcgt(a, b), rn, rz);     cmp("fcgt", a, b, 0, rn, rz, spu_fcgt_ref(a, b));
+        BOTH(spu_fcmeq(a, b), rn, rz);    cmp("fcmeq", a, b, 0, rn, rz, spu_fcmeq_ref(a, b));
+        BOTH(spu_fcmgt(a, b), rn, rz);    cmp("fcmgt", a, b, 0, rn, rz, spu_fcmgt_ref(a, b));
+        BOTH(spu_fesd(a), rn, rz);        cmp("fesd", a, b, 0, rn, rz, rn);
+    }
+    if (s_bad) { printf("test_spu_float_rz_x86: FAILED, %ld mismatches in %ld vectors\n", s_bad, n); return 1; }
+    printf("test_spu_float_rz_x86: ok, %ld vectors x 12 helpers identical under both MXCSR modes and to the references\n", n);
+    return 0;
+}
+#else
+int main(void) { printf("test_spu_float_rz_x86: skipped (not x86)\n"); return 0; }
+#endif
