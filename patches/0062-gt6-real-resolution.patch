index 5c96f31..e0c8fc0 100644
--- a/libs/video/rsx_fp_decompiler.c
+++ b/libs/video/rsx_fp_decompiler.c
@@ -1853,6 +1853,41 @@ int rsx_fp_apply_wpos_grid(char* hlsl, u32 capacity, u32 sx, u32 sy)
     return 1;
 }
 
+/*
+ * WPOS on an upscaled target [GT6 0102]: a backend that keeps a title's full-screen target sx x sy as large on the host
+ * (a higher real resolution) rasterises at host pixels, so SV_POSITION runs sx times as far. Unlike the sample grid
+ * above the mapping is continuous - each host pixel is its own place in the guest's picture, so a program that builds
+ * texture coordinates from WPOS samples them at the host's resolution: the position is divided by the scale before
+ * any read. Same entry, same form and same once-only check as rsx_fp_apply_wpos_grid; a program without WPOS is left
+ * byte-identical. Returns 1 when inserted, 0 when nothing to do, -1 on a text it cannot place the line in.
+ */
+int rsx_fp_apply_wpos_scale(char* hlsl, u32 capacity, float sx, float sy)
+{
+    static const char wpos_read[] = "_rsx_wpos(input.position)";
+    static const char* const entries[] = { "main(PSInput input) : SV_TARGET {\n",
+                                           "main(PSInput input) {\n" };
+    if (!hlsl || !capacity || !(sx > 0.0f) || !(sy > 0.0f)) return -1;
+    if (sx == 1.0f && sy == 1.0f) return 0;
+    size_t len = 0;
+    while (len < capacity && hlsl[len]) ++len;
+    if (len == capacity) return -1;
+    if (!strstr(hlsl, wpos_read)) return 0;
+    if (strstr(hlsl, "input.position.xy = input.position.xy *")) return -1;
+    char* body = NULL;
+    for (size_t i = 0; i < sizeof entries / sizeof entries[0] && !body; ++i) {
+        char* at = strstr(hlsl, entries[i]);
+        if (at) body = at + strlen(entries[i]);
+    }
+    if (!body) return -1;
+    char line[160];
+    const int n = snprintf(line, sizeof line,
+        "    input.position.xy = input.position.xy * float2(%.9g, %.9g);\n", 1.0 / sx, 1.0 / sy);
+    if (n < 0 || (size_t)n >= sizeof line || len + (size_t)n + 1 > capacity) return -1;
+    memmove(body + n, body, len - (size_t)(body - hlsl) + 1);
+    memcpy(body, line, (size_t)n);
+    return 1;
+}
