+/* Host scheduling observation only: no guest export or callback. The renderer
+ * must not acquire the decoder lock while it is doing GPU work, since a decode
+ * can hold that lock across a device call. Keep the successful Open/Close
+ * lifetime in a separate atomic mask, including EndSeq's queued pictures. */
+static atomic_uint s_vdec_host_open_mask;
+int ps3_vdec_has_open_decoder(void)
+{
+    return atomic_load_explicit(&s_vdec_host_open_mask, memory_order_acquire) != 0;
+}
+
 /* The handle the guest sees is the slot index plus one, never 0: some
  * titles treat a 0 handle as "no decoder open".
  * Killzone 2's movie player keeps the handle as its "decoder open" flag and
@@ -297,6 +308,7 @@ s32 cellVdecOpen(const CellVdecType* type, const CellVdecResource* res,
             if (!s_vdec[i].cbGeneration) {
                 s_vdec[i].in_use = 0; VDEC_UNLOCK(); return (s32)CELL_VDEC_ERROR_FATAL;
             }
+            atomic_fetch_or_explicit(&s_vdec_host_open_mask, 1u << i, memory_order_release);
             s_vdec[i].ff = vdec_ff_open(codec_type);
             VDEC_UNLOCK();
             vm_write32((u32)(uintptr_t)handle, (u32)VDEC_HANDLE_OF(i));
@@ -343,6 +355,7 @@ s32 cellVdecClose(CellVdecHandle handle)
         s_vdec[handle].ff = NULL;
     }
     s_vdec[handle].in_use = 0;
+    atomic_fetch_and_explicit(&s_vdec_host_open_mask, ~(1u << handle), memory_order_release);
     VDEC_UNLOCK();
     return CELL_OK;
 }
