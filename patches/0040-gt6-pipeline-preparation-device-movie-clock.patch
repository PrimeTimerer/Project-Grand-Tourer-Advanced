+/* Shared worker admission gate. The renderer owner changes this using actual
+ * playback state; no guessed startup delay or guest-clock change is involved.
+ * A pause waits only for the tiny admission lock, never for driver/FXC work. */
+#ifndef RSX_PREPARE_CONTROL_H
+#define RSX_PREPARE_CONTROL_H
+#include <windows.h>
+static SRWLOCK g_ld_prepare_control_lock;
+static volatile LONG g_ld_prepare_paused;
+static volatile LONG g_ld_prepare_in_flight;
+
+static int ld_prepare_set_paused(int paused)
+{
+    AcquireSRWLockExclusive(&g_ld_prepare_control_lock);
+    const LONG old = InterlockedExchange(&g_ld_prepare_paused, paused != 0);
+    ReleaseSRWLockExclusive(&g_ld_prepare_control_lock);
+    WakeByAddressAll((PVOID)&g_ld_prepare_paused);
+    return old != (paused != 0);
+}
+static void ld_prepare_wake(void)
+{
+    WakeByAddressAll((PVOID)&g_ld_prepare_paused);
+}
+static int ld_prepare_enter(volatile LONG* stop)
+{
+    for (;;) {
+        AcquireSRWLockShared(&g_ld_prepare_control_lock);
+        const int stopped = InterlockedCompareExchange(stop, 0, 0) != 0;
+        const LONG paused = InterlockedCompareExchange(&g_ld_prepare_paused, 0, 0);
+        if (!stopped && !paused) InterlockedIncrement(&g_ld_prepare_in_flight);
+        ReleaseSRWLockShared(&g_ld_prepare_control_lock);
+        if (stopped) return 0;
+        if (!paused) return 1;
+        WaitOnAddress(&g_ld_prepare_paused, (PVOID)&paused, sizeof(paused), 1000);
+    }
+}
+static void ld_prepare_leave(void)
+{
+    InterlockedDecrement(&g_ld_prepare_in_flight);
+}
+#endif
