diff --git a/libs/video/rsx_sampler_key_index.h b/libs/video/rsx_sampler_key_index.h
new file mode 100644
index 0000000..b52ddce
--- /dev/null
+++ b/libs/video/rsx_sampler_key_index.h
@@ -0,0 +1,55 @@
+#ifndef RSX_SAMPLER_KEY_INDEX_H
+#define RSX_SAMPLER_KEY_INDEX_H
+
+#include <stdint.h>
+#include <string.h>
+
+/* The live sampler key array is append-only until its device state is reset.
+ * Buckets contain array index + 1, not truncated keys: collisions still compare
+ * all 64 bits and duplicate keys retain the first slot, as the linear walk did.
+ */
+#define RSX_SAMPLER_KEY_CAPACITY 128u
+#define RSX_SAMPLER_KEY_BUCKETS 256u
+#define RSX_SAMPLER_KEY_NOT_FOUND UINT32_MAX
+
+typedef struct rsx_sampler_key_index {
+    uint16_t buckets[RSX_SAMPLER_KEY_BUCKETS];
+    uint32_t indexed;
+} rsx_sampler_key_index;
+
+static inline uint32_t rsx_sampler_key_hash(uint64_t key)
+{
+    key ^= key >> 33;
+    key *= UINT64_C(0xff51afd7ed558ccd);
+    key ^= key >> 33;
+    return (uint32_t)key & (RSX_SAMPLER_KEY_BUCKETS - 1u);
+}
+
+static inline uint32_t rsx_sampler_key_find(
+    rsx_sampler_key_index* index, const uint64_t* keys,
+    uint32_t count, uint64_t key)
+{
+    if (count > RSX_SAMPLER_KEY_CAPACITY)
+        return RSX_SAMPLER_KEY_NOT_FOUND;
+    if (index->indexed > count) {
+        memset(index, 0, sizeof(*index));
+    }
+    for (; index->indexed < count; index->indexed++) {
+        const uint32_t at = index->indexed;
+        uint32_t bucket = rsx_sampler_key_hash(keys[at]);
+        while (index->buckets[bucket] &&
+               keys[index->buckets[bucket] - 1u] != keys[at])
+            bucket = (bucket + 1u) & (RSX_SAMPLER_KEY_BUCKETS - 1u);
+        if (!index->buckets[bucket])
+            index->buckets[bucket] = (uint16_t)(at + 1u);
+    }
+    uint32_t bucket = rsx_sampler_key_hash(key);
+    while (index->buckets[bucket]) {
+        const uint32_t at = index->buckets[bucket] - 1u;
+        if (keys[at] == key) return at;
+        bucket = (bucket + 1u) & (RSX_SAMPLER_KEY_BUCKETS - 1u);
+    }
+    return RSX_SAMPLER_KEY_NOT_FOUND;
+}
+
+#endif
diff --git a/libs/video/rsx_shader_prepare.h b/libs/video/rsx_shader_prepare.h
new file mode 100644
index 0000000..d8e4000
--- /dev/null
+++ b/libs/video/rsx_shader_prepare.h
@@ -0,0 +1,382 @@
+/* Prepare known compact-IA vertex shaders for the exact GPU-pull emitter.
+ * Only owned source/DXBC and independent cache files cross worker threads.
+ * Guest state, renderer caches and command lists are never accessed here.
+ */
+#ifndef RSX_SHADER_PREPARE_H
+#define RSX_SHADER_PREPARE_H
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <windows.h>
+#include <d3dcompiler.h>
+#include "rsx_vp_pull_prepare.h"
+#include "rsx_prepare_control.h"
+
+#define LD_SP_LIMIT 4096u
+#define LD_SP_HASH 8192u
+#define LD_SP_MAX_SOURCE (256u * 1024u)
+#define LD_SP_MAX_BLOB (4u * 1024u * 1024u)
+#define LD_SP_MAX_SOURCE_MEMORY (32u * 1024u * 1024u)
+#define LD_SP_MAX_BLOB_MEMORY (128u * 1024u * 1024u)
+
+typedef struct ld_sp_header {
+    uint32_t magic, version, stage, source_length, blob_length, reserved;
+    uint64_t source_hash;
+} ld_sp_header;
+typedef char ld_sp_header_size_is_32[(sizeof(ld_sp_header) == 32) ? 1 : -1];
+/* Older v2 records used zero here. Preserve their established compatibility;
+ * new records explicitly distinguish compiler options without changing HLSL
+ * identity or discarding the user's existing shader cache. */
+static uint32_t ld_sp_cache_flags(UINT flags) { return 0x80000000u | (uint32_t)flags; }
+typedef struct ld_sp_entry {
+    uint64_t hash;
+    char* source;
+    uint32_t length;
+    uint64_t source_stamp;
+    int cached;
+    volatile LONG state; /* 0 queued, 1 worker owns, 2 ready, 3 failed/cancelled, 4 draw owns */
+    ID3DBlob* blob;
+} ld_sp_entry;
+typedef struct ld_sp_manifest {
+    unsigned count;
+    size_t source_bytes;
+    uint16_t index[LD_SP_HASH];
+    ld_sp_entry entries[LD_SP_LIMIT];
+} ld_sp_manifest;
+static struct {
+    int active;
+    volatile LONG stop, next;
+    /* Discovery owns its manifest exclusively until one release publication.
+     * After publication count/source/index are immutable; only entry states
+     * and blob ownership change. The renderer owner joins before freeing it. */
+    ld_sp_manifest* volatile manifest;
+    HANDLE discovery;
+    unsigned threads_count;
+    HANDLE threads[2];
+    char dir[MAX_PATH];
+    char* pull_helper;
+    UINT flags;
+    uint32_t magic, version;
+    ULONGLONG start_tick;
+    volatile LONG scanned, discovery_done;
+    volatile LONG64 blob_bytes;
+    volatile LONG compiled, disk_hits, failed, rejected, written, ready, foreground;
+    uint64_t hits, waits, wait_us;
+} g_ld_sp;
+
+static ld_sp_manifest* ld_sp_published(void)
+{
+    return (ld_sp_manifest*)InterlockedCompareExchangePointer(
+        (PVOID volatile*)&g_ld_sp.manifest, NULL, NULL);
+}
+
+static void ld_sp_free_manifest(ld_sp_manifest* m)
+{
+    if (!m) return;
+    for (unsigned i = 0; i < m->count; ++i) {
+        if (m->entries[i].blob) m->entries[i].blob->lpVtbl->Release(m->entries[i].blob);
+        free(m->entries[i].source);
+    }
+    free(m);
+}
+
+static int ld_sp_order(const void* aa, const void* bb)
+{
+    const ld_sp_entry *a = (const ld_sp_entry*)aa, *b = (const ld_sp_entry*)bb;
+    if (a->cached != b->cached) return a->cached ? -1 : 1;
+    if (a->source_stamp != b->source_stamp) return a->source_stamp > b->source_stamp ? -1 : 1;
+    return a->hash < b->hash ? -1 : a->hash > b->hash ? 1 : 0;
+}
+
+static uint64_t ld_sp_hash(const void* data, size_t length)
+{
+    uint64_t h = 1469598103934665603ull;
+    const unsigned char* p = (const unsigned char*)data;
+    for (size_t i = 0; i < length; ++i) { h ^= p[i]; h *= 1099511628211ull; }
+    return h;
+}
+static ld_sp_entry* ld_sp_find(ld_sp_manifest* m, const char* source, uint32_t length, uint64_t hash)
+{
+    for (unsigned slot = (unsigned)(hash ^ (hash >> 32)) & (LD_SP_HASH - 1u);
+         m->index[slot]; slot = (slot + 1u) & (LD_SP_HASH - 1u)) {
+        ld_sp_entry* e = &m->entries[m->index[slot] - 1u];
+        if (e->hash == hash && e->length == length && !memcmp(e->source, source, length)) return e;
+    }
+    return NULL;
+}
+static int ld_sp_path(char out[MAX_PATH], const ld_sp_entry* e)
+{
+    const int n = snprintf(out, MAX_PATH, "%s\\V_%016llX_%08X.bin", g_ld_sp.dir,
+                           (unsigned long long)e->hash, e->length);
+    return n > 0 && n < MAX_PATH;
+}
+static ID3DBlob* ld_sp_disk_load(const ld_sp_entry* e)
+{
+    char path[MAX_PATH]; if (!ld_sp_path(path, e)) return NULL;
+    FILE* f = fopen(path, "rb"); if (!f) return NULL;
+    ld_sp_header h; ID3DBlob* blob = NULL; char* source = NULL;
+    int valid = fread(&h, sizeof(h), 1, f) == 1 && h.magic == g_ld_sp.magic &&
+        h.version == g_ld_sp.version && h.stage == 'V' &&
+        (!h.reserved || h.reserved == ld_sp_cache_flags(g_ld_sp.flags)) &&
+        h.source_hash == e->hash && h.source_length == e->length &&
+        h.blob_length >= 32 && h.blob_length <= LD_SP_MAX_BLOB;
+    if (valid) {
+        source = (char*)malloc(e->length);
+        valid = source && fread(source, 1, e->length, f) == e->length &&
+                !memcmp(source, e->source, e->length);
+    }
+    if (valid) valid = SUCCEEDED(D3DCreateBlob(h.blob_length, &blob)) && blob &&
+        fread(blob->lpVtbl->GetBufferPointer(blob), 1, h.blob_length, f) == h.blob_length &&
+        !memcmp(blob->lpVtbl->GetBufferPointer(blob), "DXBC", 4) && fgetc(f) == EOF;
+    fclose(f); free(source);
+    if (!valid) { if (blob) blob->lpVtbl->Release(blob); InterlockedIncrement(&g_ld_sp.rejected); return NULL; }
+    return blob;
+}
+static void ld_sp_disk_store(const ld_sp_entry* e, ID3DBlob* blob)
+{
+    char path[MAX_PATH], temporary[MAX_PATH + 64];
+    if (!ld_sp_path(path, e)) return;
+    const size_t bytes = blob->lpVtbl->GetBufferSize(blob);
+    if (!bytes || bytes > LD_SP_MAX_BLOB) return;
+    snprintf(temporary, sizeof(temporary), "%s.prepare.%lu.%lu.tmp", path,
+             (unsigned long)GetCurrentProcessId(), (unsigned long)GetCurrentThreadId());
+    ld_sp_header h = {g_ld_sp.magic, g_ld_sp.version, 'V', e->length, (uint32_t)bytes,
+                      ld_sp_cache_flags(g_ld_sp.flags), e->hash};
+    FILE* f = fopen(temporary, "wb"); if (!f) return;
+    int ok = fwrite(&h, sizeof(h), 1, f) == 1 &&
+        fwrite(e->source, 1, e->length, f) == e->length &&
+        fwrite(blob->lpVtbl->GetBufferPointer(blob), 1, bytes, f) == bytes;
+    if (fclose(f)) ok = 0;
+    if (ok && !InterlockedCompareExchange(&g_ld_sp.stop, 0, 0))
+        ok = MoveFileExA(temporary, path, MOVEFILE_REPLACE_EXISTING) != 0;
+    else ok = 0;
+    if (ok) InterlockedIncrement(&g_ld_sp.written);
+    else DeleteFileA(temporary); /* this worker's exact temporary file only */
+}
+static DWORD WINAPI ld_sp_worker(LPVOID unused)
+{
+    (void)unused;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    ld_sp_manifest* m = ld_sp_published();
+    if (!m) return 0;
+    while (!InterlockedCompareExchange(&g_ld_sp.stop, 0, 0)) {
+        if (!ld_prepare_enter(&g_ld_sp.stop)) break;
+        const LONG index = InterlockedIncrement(&g_ld_sp.next) - 1;
+        if ((unsigned)index >= m->count) { ld_prepare_leave(); break; }
+        ld_sp_entry* e = &m->entries[index];
+        if (InterlockedCompareExchange(&e->state, 1, 0)) { ld_prepare_leave(); continue; }
+        ID3DBlob *blob = ld_sp_disk_load(e), *error = NULL;
+        if (blob) InterlockedIncrement(&g_ld_sp.disk_hits);
+        else if (!InterlockedCompareExchange(&g_ld_sp.stop, 0, 0)) {
+            const HRESULT hr = D3DCompile(e->source, e->length, "xvs", NULL, NULL,
+                "main", "vs_5_0", g_ld_sp.flags, 0, &blob, &error);
+            if (SUCCEEDED(hr) && blob) {
+                InterlockedIncrement(&g_ld_sp.compiled);
+                ld_sp_disk_store(e, blob);
+            } else { if (blob) blob->lpVtbl->Release(blob); blob = NULL; InterlockedIncrement(&g_ld_sp.failed); }
+        }
+        if (error) error->lpVtbl->Release(error);
+        int retain = blob && !InterlockedCompareExchange(&g_ld_sp.stop, 0, 0);
+        if (retain) {
+            const LONG64 bytes = (LONG64)blob->lpVtbl->GetBufferSize(blob);
+            if (InterlockedAdd64(&g_ld_sp.blob_bytes, bytes) > LD_SP_MAX_BLOB_MEMORY) {
+                InterlockedAdd64(&g_ld_sp.blob_bytes, -bytes); retain = 0;
+            }
+        }
+        if (retain) {
+            e->blob = blob; InterlockedIncrement(&g_ld_sp.ready); InterlockedExchange(&e->state, 2);
+        } else { if (blob) blob->lpVtbl->Release(blob); InterlockedExchange(&e->state, 3); }
+        WakeByAddressAll((PVOID)&e->state);
+        ld_prepare_leave();
+    }
+    return 0;
+}
+
+static void ld_sp_discover_file(ld_sp_manifest* m, const WIN32_FIND_DATAA* data)
+{
+    if (data->dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) return;
+    char path[MAX_PATH]; const int pn = snprintf(path, sizeof(path), "%s\\%s", g_ld_sp.dir, data->cFileName);
+    if (pn < 0 || pn >= MAX_PATH) return;
+    FILE* f = fopen(path, "rb"); if (!f) return;
+    ld_sp_header h;
+    int valid = fread(&h, sizeof(h), 1, f) == 1 && h.magic == g_ld_sp.magic && h.version == g_ld_sp.version &&
+        h.stage == 'V' && (!h.reserved || (h.reserved & 0x80000000u)) &&
+        h.source_length && h.source_length <= LD_SP_MAX_SOURCE &&
+        h.blob_length && h.blob_length <= LD_SP_MAX_BLOB;
+    char* source = valid ? (char*)malloc((size_t)h.source_length + 1u) : NULL;
+    valid = source && fread(source, 1, h.source_length, f) == h.source_length;
+    if (valid) valid = fseek(f, 0, SEEK_END) == 0 &&
+        ftell(f) == (long)(sizeof(h) + h.source_length + h.blob_length);
+    fclose(f);
+    if (!valid) { free(source); return; }
+    source[h.source_length] = 0;
+    if (ld_sp_hash(source, h.source_length) != h.source_hash) { free(source); return; }
+    char* derived = (char*)malloc(LD_SP_MAX_SOURCE + 1u); size_t length = 0;
+    if (!derived || !rsx_vp_pull_prepare(source, h.source_length, g_ld_sp.pull_helper,
+            derived, LD_SP_MAX_SOURCE + 1u, &length)) { free(derived); free(source); return; }
+    free(source);
+    const uint64_t hash = ld_sp_hash(derived, length);
+    if (m->source_bytes + length + 1u > LD_SP_MAX_SOURCE_MEMORY ||
+        ld_sp_find(m, derived, (uint32_t)length, hash)) { free(derived); return; }
+    char* compact = (char*)realloc(derived, length + 1u);
+    if (!compact) { free(derived); return; }
+    derived = compact;
+    ld_sp_entry* e = &m->entries[m->count];
+    e->source = derived; e->length = (uint32_t)length; e->hash = hash;
+    e->source_stamp = ((uint64_t)data->ftLastWriteTime.dwHighDateTime << 32) | data->ftLastWriteTime.dwLowDateTime;
+    char target[MAX_PATH];
+    if (ld_sp_path(target, e)) {
+        const DWORD attributes = GetFileAttributesA(target);
+        e->cached = attributes != INVALID_FILE_ATTRIBUTES && !(attributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT));
+    }
+    unsigned slot = (unsigned)(hash ^ (hash >> 32)) & (LD_SP_HASH - 1u);
+    while (m->index[slot]) slot = (slot + 1u) & (LD_SP_HASH - 1u);
+    m->index[slot] = (uint16_t)(++m->count);
+    m->source_bytes += length + 1u;
+}
+
+static DWORD WINAPI ld_sp_discover(LPVOID unused)
+{
+    (void)unused;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    ld_sp_manifest* m = (ld_sp_manifest*)calloc(1, sizeof(*m));
+    HANDLE find = INVALID_HANDLE_VALUE;
+    if (!m) goto done;
+    char search[MAX_PATH]; snprintf(search, sizeof(search), "%s\\V_*.bin", g_ld_sp.dir);
+    WIN32_FIND_DATAA data;
+    while (m->count < LD_SP_LIMIT && ld_prepare_enter(&g_ld_sp.stop)) {
+        /* Admission is per file, including the directory query. A movie can
+         * pause discovery without discarding its private partial manifest. */
+        int found;
+        if (find == INVALID_HANDLE_VALUE) {
+            find = FindFirstFileA(search, &data); found = find != INVALID_HANDLE_VALUE;
+        } else found = FindNextFileA(find, &data) != 0;
+        if (found) { ld_sp_discover_file(m, &data); InterlockedIncrement(&g_ld_sp.scanned); }
+        ld_prepare_leave();
+        if (!found) break;
+#ifdef LD_SP_DISCOVERY_TEST_HOOK
+        LD_SP_DISCOVERY_TEST_HOOK(1);
+#endif
+    }
+    if (find != INVALID_HANDLE_VALUE) { FindClose(find); find = INVALID_HANDLE_VALUE; }
+    if (!ld_prepare_enter(&g_ld_sp.stop)) goto done;
+    /* This private index becomes immutable before any draw or worker sees it.
+     * Existing variants remain first, followed by recent original sources. */
+    qsort(m->entries, m->count, sizeof(m->entries[0]), ld_sp_order);
+    memset(m->index, 0, sizeof(m->index));
+    for (unsigned i = 0; i < m->count; ++i) {
+        const uint64_t hash = m->entries[i].hash;
+        unsigned slot = (unsigned)(hash ^ (hash >> 32)) & (LD_SP_HASH - 1u);
+        while (m->index[slot]) slot = (slot + 1u) & (LD_SP_HASH - 1u);
+        m->index[slot] = (uint16_t)(i + 1u);
+    }
+    ld_prepare_leave();
+#ifdef LD_SP_DISCOVERY_TEST_HOOK
+    LD_SP_DISCOVERY_TEST_HOOK(2);
+#endif
+    if (InterlockedCompareExchange(&g_ld_sp.stop, 0, 0)) goto done;
+    InterlockedExchangePointer((PVOID volatile*)&g_ld_sp.manifest, m);
+    m = NULL; /* shared ownership; only owner stop may free after all joins */
+    for (unsigned i = 0; i < 2 && ld_sp_published()->count &&
+            !InterlockedCompareExchange(&g_ld_sp.stop, 0, 0); ++i) {
+        HANDLE t = CreateThread(NULL, 0, ld_sp_worker, NULL, 0, NULL);
+        if (t) g_ld_sp.threads[g_ld_sp.threads_count++] = t;
+    }
+done:
+    if (find != INVALID_HANDLE_VALUE) FindClose(find);
+    ld_sp_free_manifest(m);
+    m = ld_sp_published();
+    fprintf(stderr, "[shader-prepare] discovery complete elapsed_ms=%llu scanned=%ld queued=%u workers=%u flags=0x%X source_bytes=%zu cancelled=%d\n",
+        (unsigned long long)(GetTickCount64() - g_ld_sp.start_tick), g_ld_sp.scanned,
+        m ? m->count : 0, g_ld_sp.threads_count, g_ld_sp.flags, m ? m->source_bytes : 0,
+        InterlockedCompareExchange(&g_ld_sp.stop, 0, 0) != 0);
+    InterlockedExchange(&g_ld_sp.discovery_done, 1);
+    WakeByAddressAll((PVOID)&g_ld_sp.discovery_done);
+    return 0;
+}
+
+/* Owner-only start performs no file enumeration, source load or translation.
+ * Copy caller-owned inputs before returning; discovery publishes a complete
+ * immutable index once. Until then take immediately uses the normal path. */
+static void ld_sp_start(const char* directory, const char* pull_helper,
+    uint32_t magic, uint32_t version, UINT flags)
+{
+    const char* setting = getenv("LD_SHADER_PREPARE");
+    /* Opt in until movie playback and cold-track scheduling pass the same
+     * cache-seed A/B. The source/DXBC gate alone does not prove CPU contention. */
+    if (g_ld_sp.active || !setting || *setting != '1' || !directory || !*directory ||
+        strlen(directory) >= sizeof(g_ld_sp.dir) - sizeof("\\V_*.bin") || !pull_helper) return;
+    LARGE_INTEGER first, last, frequency;
+    QueryPerformanceCounter(&first); QueryPerformanceFrequency(&frequency);
+    const size_t helper_length = strlen(pull_helper);
+    if (!helper_length || helper_length > LD_SP_MAX_SOURCE) return;
+    char* owned_helper = (char*)malloc(helper_length + 1u);
+    if (!owned_helper) return;
+    memcpy(owned_helper, pull_helper, helper_length + 1u);
+    memset(&g_ld_sp, 0, sizeof(g_ld_sp));
+    strcpy(g_ld_sp.dir, directory); g_ld_sp.pull_helper = owned_helper;
+    g_ld_sp.magic = magic; g_ld_sp.version = version; g_ld_sp.flags = flags;
+    g_ld_sp.start_tick = GetTickCount64(); g_ld_sp.active = 1;
+    g_ld_sp.discovery = CreateThread(NULL, 0, ld_sp_discover, NULL, 0, NULL);
+    if (!g_ld_sp.discovery) {
+        free(owned_helper); memset(&g_ld_sp, 0, sizeof(g_ld_sp)); return;
+    }
+    QueryPerformanceCounter(&last);
+    fprintf(stderr, "[shader-prepare] discovery queued asynchronously; flags=0x%X owner_us=%llu\n", flags,
+        (unsigned long long)((last.QuadPart - first.QuadPart) * 1000000 / frequency.QuadPart));
+}
+
+static ID3DBlob* ld_sp_take(const char* source, uint32_t length, uint64_t hash)
+{
+    if (!g_ld_sp.active) return NULL;
+    ld_sp_manifest* m = ld_sp_published();
+    if (!m) return NULL;
+    ld_sp_entry* e = ld_sp_find(m, source, length, hash); if (!e) return NULL;
+    /* A not-yet-started variant belongs to the normal draw compile now; this
+     * prevents a worker duplicating that exact first-use compilation. */
+    if (InterlockedCompareExchange(&e->state, 4, 0) == 0) {
+        InterlockedIncrement(&g_ld_sp.foreground); return NULL;
+    }
+    LONG state = InterlockedCompareExchange(&e->state, 0, 0);
+    if (state == 1) {
+        LARGE_INTEGER first, last, frequency;
+        QueryPerformanceCounter(&first); QueryPerformanceFrequency(&frequency); g_ld_sp.waits++;
+        while ((state = InterlockedCompareExchange(&e->state, 0, 0)) == 1)
+            WaitOnAddress(&e->state, &state, sizeof(state), 1000);
+        QueryPerformanceCounter(&last);
+        g_ld_sp.wait_us += (uint64_t)((last.QuadPart - first.QuadPart) * 1000000 / frequency.QuadPart);
+    }
+    if (state != 2 || !e->blob) return NULL;
+    e->blob->lpVtbl->AddRef(e->blob); ++g_ld_sp.hits;
+    if (g_ld_sp.hits <= 4 || (g_ld_sp.hits & 127u) == 0)
+        fprintf(stderr, "[shader-prepare] hits=%llu ready=%ld/%u compiled=%ld disk=%ld waits=%llu wait_us=%llu foreground=%ld\n",
+            (unsigned long long)g_ld_sp.hits, g_ld_sp.ready, m->count, g_ld_sp.compiled, g_ld_sp.disk_hits,
+            (unsigned long long)g_ld_sp.waits, (unsigned long long)g_ld_sp.wait_us, g_ld_sp.foreground);
+    return e->blob;
+}
+static void ld_sp_stop(void)
+{
+    if (!g_ld_sp.active) return;
+    InterlockedExchange(&g_ld_sp.stop, 1);
+    ld_prepare_wake();
+    /* The discovery join also fixes the final worker handle set. No discovery
+     * publication or worker creation can race destruction after this point. */
+    WaitForSingleObject(g_ld_sp.discovery, INFINITE);
+    CloseHandle(g_ld_sp.discovery);
+    /* FXC has no per-call cancellation. Finish only the at-most-two in-flight
+     * calls, skip all queued work, then release source and bytecode ownership. */
+    if (g_ld_sp.threads_count)
+        WaitForMultipleObjects(g_ld_sp.threads_count, g_ld_sp.threads, TRUE, INFINITE);
+    for (unsigned i = 0; i < g_ld_sp.threads_count; ++i) CloseHandle(g_ld_sp.threads[i]);
+    ld_sp_manifest* m = ld_sp_published();
+    fprintf(stderr, "[shader-prepare] stop ready=%ld/%u compiled=%ld disk=%ld failed=%ld rejected=%ld written=%ld hits=%llu waits=%llu wait_us=%llu foreground=%ld\n",
+        g_ld_sp.ready, m ? m->count : 0, g_ld_sp.compiled, g_ld_sp.disk_hits, g_ld_sp.failed, g_ld_sp.rejected, g_ld_sp.written,
+        (unsigned long long)g_ld_sp.hits, (unsigned long long)g_ld_sp.waits,
+        (unsigned long long)g_ld_sp.wait_us, g_ld_sp.foreground);
+    InterlockedExchangePointer((PVOID volatile*)&g_ld_sp.manifest, NULL);
+    ld_sp_free_manifest(m);
+    free(g_ld_sp.pull_helper);
+    memset(&g_ld_sp, 0, sizeof(g_ld_sp));
+}
+#endif
diff --git a/libs/video/rsx_surface_key_index.h b/libs/video/rsx_surface_key_index.h
new file mode 100644
index 0000000..542eae9
--- /dev/null
+++ b/libs/video/rsx_surface_key_index.h
@@ -0,0 +1,98 @@
+#ifndef RSX_SURFACE_KEY_INDEX_H
+#define RSX_SURFACE_KEY_INDEX_H
+
+#include <stdint.h>
+#include <string.h>
+
+/* Only address membership is indexed. Size, format, feedback and write
+ * generations remain live selection inputs. Bucket chains are kept in slot
+ * order so collisions and same-address variants preserve the linear walk's
+ * first-match/tie behavior. Zero initialization is an empty index. */
+#define RSX_SURFACE_KEY_CAPACITY 512u
+#define RSX_SURFACE_KEY_BUCKETS 1024u
+#define RSX_SURFACE_KEY_NONE UINT32_MAX
+
+typedef struct rsx_surface_key_index {
+    uint64_t keys[RSX_SURFACE_KEY_CAPACITY];
+    uint16_t heads[RSX_SURFACE_KEY_BUCKETS]; /* slot + 1 */
+    uint16_t next[RSX_SURFACE_KEY_CAPACITY]; /* slot + 1 */
+    uint16_t bucket[RSX_SURFACE_KEY_CAPACITY]; /* bucket + 1, 0 = absent */
+} rsx_surface_key_index;
+
+static inline uint64_t rsx_surface_key(uint32_t location, uint32_t offset)
+{
+    return ((uint64_t)location << 32) | offset;
+}
+
+static inline uint32_t rsx_surface_key_bucket(uint64_t key)
+{
+    key ^= key >> 33;
+    key *= UINT64_C(0xff51afd7ed558ccd);
+    key ^= key >> 33;
+    return (uint32_t)key & (RSX_SURFACE_KEY_BUCKETS - 1u);
+}
+
+static inline void rsx_surface_key_reset(rsx_surface_key_index* index)
+{
+    memset(index, 0, sizeof(*index));
+}
+
+static inline void rsx_surface_key_remove(rsx_surface_key_index* index,
+                                          uint32_t slot)
+{
+    if (slot >= RSX_SURFACE_KEY_CAPACITY || !index->bucket[slot]) return;
+    uint16_t* link = &index->heads[index->bucket[slot] - 1u];
+    while (*link && *link != slot + 1u)
+        link = &index->next[*link - 1u];
+    if (*link) *link = index->next[slot];
+    index->bucket[slot] = 0;
+    index->next[slot] = 0;
+    index->keys[slot] = 0;
+}
+
+static inline int rsx_surface_key_set(rsx_surface_key_index* index,
+                                      uint32_t slot, uint32_t location,
+                                      uint32_t offset)
+{
+    if (slot >= RSX_SURFACE_KEY_CAPACITY) return 0;
+    const uint64_t key = rsx_surface_key(location, offset);
+    if (index->bucket[slot] && index->keys[slot] == key) return 1;
+    rsx_surface_key_remove(index, slot);
+    const uint32_t bucket = rsx_surface_key_bucket(key);
+    uint16_t* link = &index->heads[bucket];
+    while (*link && *link < slot + 1u)
+        link = &index->next[*link - 1u];
+    index->keys[slot] = key;
+    index->bucket[slot] = (uint16_t)(bucket + 1u);
+    index->next[slot] = *link;
+    *link = (uint16_t)(slot + 1u);
+    return 1;
+}
+
+static inline uint32_t rsx_surface_key_match(
+    const rsx_surface_key_index* index, uint16_t link, uint64_t key)
+{
+    while (link) {
+        const uint32_t slot = link - 1u;
+        if (index->keys[slot] == key) return slot;
+        link = index->next[slot];
+    }
+    return RSX_SURFACE_KEY_NONE;
+}
+
+static inline uint32_t rsx_surface_key_first(
+    const rsx_surface_key_index* index, uint32_t location, uint32_t offset)
+{
+    const uint64_t key = rsx_surface_key(location, offset);
+    return rsx_surface_key_match(index, index->heads[rsx_surface_key_bucket(key)], key);
+}
+
+static inline uint32_t rsx_surface_key_next(
+    const rsx_surface_key_index* index, uint32_t slot)
+{
+    if (slot >= RSX_SURFACE_KEY_CAPACITY || !index->bucket[slot])
+        return RSX_SURFACE_KEY_NONE;
+    return rsx_surface_key_match(index, index->next[slot], index->keys[slot]);
+}
+
+#endif
diff --git a/libs/video/rsx_texture_watch_policy.h b/libs/video/rsx_texture_watch_policy.h
new file mode 100644
index 0000000..b3e7485
--- /dev/null
+++ b/libs/video/rsx_texture_watch_policy.h
@@ -0,0 +1,54 @@
+#ifndef PS3RECOMP_RSX_TEXTURE_WATCH_POLICY_H
+#define PS3RECOMP_RSX_TEXTURE_WATCH_POLICY_H
+
+#include <stdint.h>
+
+/* Admission only: direct_hash still validates every source byte and performs
+ * the ordinary refresh. No policy result authorizes reusing unread pixels. */
+typedef struct {
+    uint8_t direct_hash;
+    uint8_t dirty_run;
+    uint8_t unchanged_run;
+} rsx_texture_watch_policy;
+
+typedef enum {
+    RSX_TEX_WATCH_CLEAN,
+    RSX_TEX_WATCH_UNCHANGED,
+    RSX_TEX_WATCH_UPDATED,
+    RSX_TEX_WATCH_FAILED
+} rsx_texture_watch_result;
+
+static inline void rsx_texture_watch_reset(rsx_texture_watch_policy* policy)
+{
+    policy->direct_hash = policy->dirty_run = policy->unchanged_run = 0;
+}
+
+/* Observations occur once per entry's first bind in a different frame, not
+ * once per global frame. UPDATED means the replacement upload succeeded.
+ * A clean watch, unchanged hash or failed operation breaks dirty admission.
+ * Return +1 on entering direct hashing, -1 on returning to the watch. */
+static inline int rsx_texture_watch_observe(
+    rsx_texture_watch_policy* policy, rsx_texture_watch_result result,
+    int successfully_watched_dirty)
+{
+    const int before = policy->direct_hash != 0;
+    if (result == RSX_TEX_WATCH_UPDATED) {
+        policy->unchanged_run = 0;
+        if (!policy->direct_hash) {
+            if (!successfully_watched_dirty) policy->dirty_run = 0;
+            else if (++policy->dirty_run >= 4u) {
+                policy->direct_hash = 1;
+                policy->dirty_run = 0;
+            }
+        }
+    } else if (result == RSX_TEX_WATCH_UNCHANGED) {
+        policy->dirty_run = 0;
+        if (policy->direct_hash && ++policy->unchanged_run >= 2u)
+            rsx_texture_watch_reset(policy);
+    } else {
+        rsx_texture_watch_reset(policy);
+    }
+    return (policy->direct_hash != 0) - before;
+}
+
+#endif
diff --git a/libs/video/rsx_vertex_cache_admission.h b/libs/video/rsx_vertex_cache_admission.h
new file mode 100644
index 0000000..efde737
--- /dev/null
+++ b/libs/video/rsx_vertex_cache_admission.h
@@ -0,0 +1,24 @@
+#ifndef PS3RECOMP_RSX_VERTEX_CACHE_ADMISSION_H
+#define PS3RECOMP_RSX_VERTEX_CACHE_ADMISSION_H
+
+#include "rsx_draw_batches.h"
+
+/* A small nonindexed group is cheaper to fetch freshly than to validate and
+ * retain. Count source references, not DRAW packets; overlaps only reduce the
+ * number of unique vertices. Returning zero leaves the old cache path intact.
+ * No guest bytes are read, and limit - total cannot underflow or overflow.
+ */
+static inline u32 rsx_vertex_cache_small_array_refs(
+    const rsx_draw_batch* arrays, u32 n_arrays, u32 n_indexed,
+    int inline_source, u32 limit)
+{
+    if (!limit || !arrays || !n_arrays || n_indexed || inline_source) return 0;
+    u32 total = 0;
+    for (u32 i = 0; i < n_arrays; i++) {
+        if (arrays[i].count > limit - total) return 0;
+        total += arrays[i].count;
+    }
+    return total;
+}
+
+#endif
diff --git a/libs/video/rsx_vp_pull_prepare.h b/libs/video/rsx_vp_pull_prepare.h
new file mode 100644
index 0000000..fc37d49
--- /dev/null
+++ b/libs/video/rsx_vp_pull_prepare.h
@@ -0,0 +1,62 @@
+/* Reconstruct only the exact compact-input -> pull-input emitter variant.
+ * No vertex formats, strides, guest addresses, or shader operations are
+ * inferred. The caller supplies the same helper text used by the emitter.
+ * A prepared variant is useful only when a real draw requests identical HLSL.
+ */
+#ifndef RSX_VP_PULL_PREPARE_H
+#define RSX_VP_PULL_PREPARE_H
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+static int rsx_vp_pull_prepare(const char* source, size_t length,
+    const char* helper, char* out, size_t capacity, size_t* out_length)
+{
+    static const char begin[] = "struct VSInput {\n";
+    static const char pull[] = "struct VSInput { uint vertex_id:SV_VertexID; };\n";
+    static const char main_begin[] = "VSOutput main(VSInput input) {\n    float4 v[16];\n"
+        "    [unroll] for (int _k=0;_k<16;_k++) v[_k]=float4(0,0,0,1);\n";
+    if (!source || !helper || !out || !out_length || length > 256u * 1024u ||
+        strlen(source) != length || strncmp(source, begin, sizeof(begin) - 1u) ||
+        strstr(source, "register(t19)") || strstr(source, "vp_pull")) return 0;
+    const char* p = source + sizeof(begin) - 1u;
+    unsigned mask = 0, last = 0; int first = 1;
+    while (strncmp(p, "};\n", 3)) {
+        unsigned a; int n = 0;
+        for (a = first ? 0 : last + 1u; a < 16; ++a) {
+            char expected[64]; n = snprintf(expected, sizeof(expected), "    float4 a%u:ATTR%u;\n", a, a);
+            if (!strncmp(p, expected, (size_t)n)) break;
+        }
+        if (a == 16) return 0;
+        p += n; mask |= 1u << a; last = a; first = 0;
+    }
+    if (!mask) return 0;
+    p += 3;
+    if (strncmp(p, "struct VSOutput {\n", sizeof("struct VSOutput {\n") - 1u)) return 0;
+    const char* main = strstr(p, main_begin);
+    if (!main) return 0;
+    const char* assignments = main + sizeof(main_begin) - 1u;
+    /* All input reads must be the emitter's initial assignment block. */
+    const char* tail = assignments;
+    for (unsigned a = 0; a < 16; ++a) if (mask & (1u << a)) {
+        char expected[64]; const int n = snprintf(expected, sizeof(expected), "    v[%u]=input.a%u;\n", a, a);
+        if (strncmp(tail, expected, (size_t)n)) return 0;
+        tail += n;
+    }
+    const char* read = strstr(p, "input.");
+    if (strstr(tail, "input.") || !read || read < assignments || read >= tail) return 0;
+    const size_t helper_length = strlen(helper), prefix_length = (size_t)(assignments - p);
+    size_t need = sizeof(pull) - 1u + helper_length + prefix_length + strlen(tail) + 1u;
+    for (unsigned a = 0; a < 16; ++a) if (mask & (1u << a)) need += 64u;
+    if (need > capacity) return 0;
+    char* write = out;
+#define VP_PREP_COPY(data, count) do { size_t n_ = (count); memcpy(write, (data), n_); write += n_; } while (0)
+    VP_PREP_COPY(pull, sizeof(pull) - 1u); VP_PREP_COPY(helper, helper_length); VP_PREP_COPY(p, prefix_length);
+    for (unsigned a = 0; a < 16; ++a) if (mask & (1u << a))
+        write += sprintf(write, "    v[%u]=vp_pull(%u,input.vertex_id);\n", a, a);
+    VP_PREP_COPY(tail, strlen(tail) + 1u);
+#undef VP_PREP_COPY
+    *out_length = (size_t)(write - out - 1u);
+    return 1;
+}
+#endif
diff --git a/libs/video/tests/test_prepare_control.c b/libs/video/tests/test_prepare_control.c
new file mode 100644
index 0000000..710752a
--- /dev/null
+++ b/libs/video/tests/test_prepare_control.c
@@ -0,0 +1,54 @@
+/* CPU-only worker admission/pause/lifetime fixture, no D3D device. */
+#define _WIN32_WINNT 0x0A00
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include "../rsx_prepare_control.h"
+static volatile LONG stop, started, finished;
+static HANDLE admitted[4], finish;
+static unsigned checks;
+static void check(int good, const char* text)
+{
+    if (!good) { fprintf(stderr, "FAIL: %s\n", text); exit(1); } ++checks;
+}
+static DWORD WINAPI worker(LPVOID opaque)
+{
+    const unsigned index = (unsigned)(uintptr_t)opaque;
+    while (ld_prepare_enter(&stop)) {
+        InterlockedIncrement(&started); SetEvent(admitted[index]);
+        WaitForSingleObject(finish, INFINITE);
+        InterlockedIncrement(&finished); ld_prepare_leave();
+    }
+    return 0;
+}
+int main(void)
+{
+    check(ld_prepare_set_paused(1), "pause before any worker exists");
+    check(!ld_prepare_set_paused(1), "same state is idempotent");
+    HANDLE threads[4]; finish = CreateEventA(NULL, TRUE, FALSE, NULL);
+    for (unsigned i = 0; i < 4; ++i) {
+        admitted[i] = CreateEventA(NULL, TRUE, FALSE, NULL);
+        threads[i] = CreateThread(NULL, 0, worker, (void*)(uintptr_t)i, 0, NULL);
+        check(admitted[i] && threads[i], "fixture worker started");
+    }
+    Sleep(30);
+    check(started == 0 && g_ld_prepare_in_flight == 0, "no background admission while initially paused");
+    check(ld_prepare_set_paused(0), "resume pending work");
+    check(WaitForMultipleObjects(4, admitted, TRUE, 1000) == WAIT_OBJECT_0, "all original pending jobs admitted after resume");
+    check(started == 4 && g_ld_prepare_in_flight == 4, "four independent worker jobs in flight");
+    check(ld_prepare_set_paused(1), "pause returns without waiting for in-flight completion");
+    check(finished == 0, "pause did not finish or discard existing work");
+    SetEvent(finish);
+    for (unsigned i = 0; i < 1000 && g_ld_prepare_in_flight; ++i) Sleep(1);
+    check(finished == 4 && !g_ld_prepare_in_flight, "in-flight work finishes normally while paused");
+    Sleep(30); check(started == 4, "no next job slips past pause admission barrier");
+    InterlockedExchange(&stop, 1); ld_prepare_wake();
+    check(WaitForMultipleObjects(4, threads, TRUE, 1000) == WAIT_OBJECT_0, "stop wakes and joins paused workers");
+    for (unsigned i = 0; i < 4; ++i) { CloseHandle(threads[i]); CloseHandle(admitted[i]); }
+    CloseHandle(finish);
+    check(!g_ld_prepare_in_flight, "worker lifetime counter balances");
+    ld_prepare_set_paused(0);
+    check(!ld_prepare_enter(&stop), "stopped worker cannot be admitted on resume");
+    printf("Prepare control: %u checks PASS (CPU only)\n", checks);
+    return 0;
+}
diff --git a/libs/video/tests/test_pso_payload.c b/libs/video/tests/test_pso_payload.c
new file mode 100644
index 0000000..9102c48
--- /dev/null
+++ b/libs/video/tests/test_pso_payload.c
@@ -0,0 +1,108 @@
+/* CPU-only exact-payload/lifetime fixture. Optional argument audits existing
+ * .gpso files read-only; it never creates a D3D device or changes the cache. */
+#define _WIN32_WINNT 0x0A00
+#define _CRT_SECURE_NO_WARNINGS
+#include <windows.h>
+#include <initguid.h>
+#include <d3d12.h>
+#include "../rsx_pso_warmup.h"
+
+static unsigned checks;
+static void check(int good, const char* text)
+{
+    if (!good) { fprintf(stderr, "FAIL: %s\n", text); exit(1); }
+    ++checks;
+}
+static unsigned char vertex[65536], pixel[8192];
+static ld_pw_record record;
+static D3D12_GRAPHICS_PIPELINE_STATE_DESC desc;
+
+static DWORD WINAPI concurrent(LPVOID unused)
+{
+    (void)unused;
+    for (unsigned i = 0; i < 128; ++i) {
+        ld_pw_entry e = {0}; D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = desc;
+        if (!ld_pw_retain_payload(&e, &record, &pd) ||
+            memcmp(pd.VS.pShaderBytecode, vertex, sizeof(vertex)) ||
+            memcmp(pd.PS.pShaderBytecode, pixel, sizeof(pixel))) return 1;
+        ld_pw_release_payload(&e);
+    }
+    return 0;
+}
+
+static void audit(const char* directory)
+{
+    g_ld_pw.payload_bytes = g_ld_pw.deduplicated_bytes = 0;
+    char search[MAX_PATH]; snprintf(search, sizeof(search), "%s\\*.gpso", directory);
+    WIN32_FIND_DATAA data; HANDLE find = FindFirstFileA(search, &data);
+    check(find != INVALID_HANDLE_VALUE, "audit recipe directory exists");
+    g_ld_pw.roots[0] = g_ld_pw.roots[1] = (ID3D12RootSignature*)(uintptr_t)1;
+    unsigned count = 0, rejected = 0; uint64_t input_bytes = 0;
+    do {
+        if (data.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) continue;
+        check(count < LD_PW_LIMIT, "all audit recipes fit index");
+        char path[MAX_PATH]; snprintf(path, sizeof(path), "%s\\%s", directory, data.cFileName);
+        FILE* f = fopen(path, "rb"); check(f != NULL, "audit open read-only");
+        fseek(f, 0, SEEK_END); long size = ftell(f); rewind(f);
+        check(size > 0 && size < (long)(sizeof(ld_pw_record) + 3u * LD_PW_MAX_SHADER), "bounded recipe file");
+        ld_pw_record* r = (ld_pw_record*)malloc((size_t)size); check(r != NULL, "audit buffer");
+        check(fread(r, 1, (size_t)size, f) == (size_t)size, "audit full read"); fclose(f);
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC pd; D3D12_INPUT_ELEMENT_DESC il[16];
+        if (!ld_pw_unpack(r, (size_t)size, &pd, il)) { rejected++; free(r); continue; }
+        ld_pw_entry* e = &g_ld_pw.entries[count]; e->key = r->key;
+        check(ld_pw_retain_payload(e, r, &pd), "all valid known recipes retained within budget");
+        check(ld_pw_key(&e->record->identity, &pd) == r->key, "interned DXBC preserves complete identity");
+        input_bytes += (uint64_t)size; count++; free(r);
+    } while (FindNextFileA(find, &data));
+    FindClose(find);
+    printf("AUDIT recipes=%u rejected=%u unique_dxbc=%u original_bytes=%llu retained_bytes=%llu saved_payload=%llu\n",
+        count, rejected, g_ld_pw.unique_blobs, (unsigned long long)input_bytes,
+        (unsigned long long)g_ld_pw.retained, (unsigned long long)g_ld_pw.deduplicated_bytes);
+    for (unsigned i = 0; i < count; ++i) ld_pw_release_payload(&g_ld_pw.entries[i]);
+    check(!g_ld_pw.retained && !g_ld_pw.unique_blobs, "audit releases all owned bytes");
+}
+
+int main(int argc, char** argv)
+{
+    InitializeSRWLock(&g_ld_pw.lock);
+    for (unsigned i = 0; i < sizeof(vertex); ++i) vertex[i] = (unsigned char)(i * 17u);
+    for (unsigned i = 0; i < sizeof(pixel); ++i) pixel[i] = (unsigned char)(i * 31u);
+    desc.VS.pShaderBytecode = vertex; desc.VS.BytecodeLength = sizeof(vertex);
+    desc.PS.pShaderBytecode = pixel; desc.PS.BytecodeLength = sizeof(pixel);
+    record.payload_size = sizeof(vertex) + sizeof(pixel);
+    ld_pw_entry entries[256] = {0};
+    for (unsigned i = 0; i < 256; ++i) {
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = desc;
+        check(ld_pw_retain_payload(&entries[i], &record, &pd), "repeated exact payload retained");
+        check(entries[i].shaders[0] == entries[0].shaders[0] &&
+              entries[i].shaders[1] == entries[0].shaders[1], "exact DXBC shares stable allocation");
+    }
+    check(g_ld_pw.unique_blobs == 2, "256 states use two DXBC allocations");
+    check(g_ld_pw.retained < 600000, "shared retention bounded independently of duplicate payload");
+    ld_pw_entry extra = {0}; D3D12_GRAPHICS_PIPELINE_STATE_DESC changed = desc;
+    unsigned char changed_vertex[sizeof(vertex)]; memcpy(changed_vertex, vertex, sizeof(vertex)); changed_vertex[23] ^= 1;
+    changed.VS.pShaderBytecode = changed_vertex;
+    check(ld_pw_retain_payload(&extra, &record, &changed), "changed DXBC retained separately");
+    check(extra.shaders[0] != entries[0].shaders[0] && extra.shaders[1] == entries[0].shaders[1], "one byte cannot alias exact program");
+    ld_pw_release_payload(&extra);
+    const uint64_t retained = g_ld_pw.retained;
+    g_ld_pw.retained = LD_PW_MAX_RETAINED - sizeof(record) + 1;
+    check(!ld_pw_retain_payload(&extra, &record, &changed) && !extra.record && !extra.shaders[0], "budget rejection leaves no partial ownership");
+    g_ld_pw.retained = retained;
+    /* Force failure after the header/first shared stage were acquired. */
+    g_ld_pw.retained = LD_PW_MAX_RETAINED - sizeof(record) - 1;
+    changed = desc; changed.PS.pShaderBytecode = changed_vertex; changed.PS.BytecodeLength = sizeof(pixel);
+    check(!ld_pw_retain_payload(&extra, &record, &changed) && !extra.record && !extra.shaders[0], "late budget failure rolls back acquired references");
+    check(g_ld_pw.retained == LD_PW_MAX_RETAINED - sizeof(record) - 1, "late failure restores accounting");
+    g_ld_pw.retained = retained;
+    HANDLE threads[8];
+    for (unsigned i = 0; i < 8; ++i) { threads[i] = CreateThread(NULL, 0, concurrent, NULL, 0, NULL); check(threads[i] != NULL, "concurrent fixture thread"); }
+    check(WaitForMultipleObjects(8, threads, TRUE, 10000) == WAIT_OBJECT_0, "concurrent references complete");
+    for (unsigned i = 0; i < 8; ++i) { DWORD rc; GetExitCodeThread(threads[i], &rc); check(rc == 0, "concurrent references exact"); CloseHandle(threads[i]); }
+    check(g_ld_pw.retained == retained && g_ld_pw.unique_blobs == 2, "concurrent reference ownership balances");
+    for (unsigned i = 0; i < 256; ++i) ld_pw_release_payload(&entries[i]);
+    check(g_ld_pw.retained == 0 && g_ld_pw.unique_blobs == 0, "last release frees every byte");
+    if (argc == 2) audit(argv[1]);
+    printf("PSO payload: %u checks PASS (CPU only)\n", checks);
+    return 0;
+}
