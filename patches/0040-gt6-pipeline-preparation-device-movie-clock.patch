diff --git a/libs/video/tests/test_shader_prepare.c b/libs/video/tests/test_shader_prepare.c
new file mode 100644
index 0000000..c61c008
--- /dev/null
+++ b/libs/video/tests/test_shader_prepare.c
@@ -0,0 +1,209 @@
+/* CPU/FXC-only fixture. Uses a NEW disposable directory and generated shader
+ * sources. No game execution, player files, D3D device or GPU submission. */
+#define _WIN32_WINNT 0x0A00
+#define _CRT_SECURE_NO_WARNINGS
+#include <windows.h>
+static void discovery_checkpoint(unsigned phase);
+#define LD_SP_DISCOVERY_TEST_HOOK(phase) discovery_checkpoint(phase)
+#include "../rsx_vertex_pull.h"
+#include "../rsx_vp_decompiler.h"
+#include "../rsx_shader_prepare.h"
+
+static unsigned checks;
+static HANDLE checkpoint_entered, checkpoint_release;
+static volatile LONG checkpoint_phase;
+static void discovery_checkpoint(unsigned phase)
+{
+    if ((LONG)phase != InterlockedCompareExchange(&checkpoint_phase, 0, 0)) return;
+    SetEvent(checkpoint_entered);
+    while (WaitForSingleObject(checkpoint_release, 10) != WAIT_OBJECT_0 &&
+           !InterlockedCompareExchange(&g_ld_sp.stop, 0, 0)) { }
+}
+static void check(int good, const char* text)
+{
+    if (!good) { fprintf(stderr, "FAIL: %s\n", text); exit(1); }
+    ++checks;
+}
+__declspec(dllexport) int gt6_prepare_pull(const char* input, size_t length,
+    char* output, size_t capacity, size_t* output_length)
+{
+    return rsx_vp_pull_prepare(input, length, rsx_vertex_pull_hlsl, output, capacity, output_length);
+}
+static ID3DBlob* compile_flags(const char* source, UINT flags)
+{
+    ID3DBlob *blob = NULL, *error = NULL;
+    HRESULT hr = D3DCompile(source, strlen(source), "xvs", NULL, NULL, "main", "vs_5_0",
+                           flags, 0, &blob, &error);
+    if (error) { if (FAILED(hr)) fprintf(stderr, "%s\n", (char*)error->lpVtbl->GetBufferPointer(error)); error->lpVtbl->Release(error); }
+    check(SUCCEEDED(hr) && blob, "fixture compiles with unchanged production VS flags");
+    return blob;
+}
+static ID3DBlob* compile(const char* source) { return compile_flags(source, D3DCOMPILE_SKIP_OPTIMIZATION); }
+static void write_source(const char* directory, const char* source, ID3DBlob* blob)
+{
+    const uint32_t length = (uint32_t)strlen(source); const uint64_t hash = ld_sp_hash(source, length);
+    char path[MAX_PATH]; snprintf(path, sizeof(path), "%s\\V_%016llX_%08X.bin", directory, (unsigned long long)hash, length);
+    ld_sp_header h = {0x43535A59u, 2, 'V', length, (uint32_t)blob->lpVtbl->GetBufferSize(blob), 0, hash};
+    FILE* f = fopen(path, "wb"); check(f != NULL, "owned fixture cache open");
+    check(fwrite(&h, sizeof(h), 1, f) == 1 && fwrite(source, 1, length, f) == length &&
+          fwrite(blob->lpVtbl->GetBufferPointer(blob), 1, h.blob_length, f) == h.blob_length,
+          "owned fixture cache write"); fclose(f);
+}
+static ld_sp_manifest* discovered(void)
+{
+    check(WaitForSingleObject(g_ld_sp.discovery, 10000) == WAIT_OBJECT_0,
+          "asynchronous discovery finishes within fixture deadline");
+    ld_sp_manifest* m = ld_sp_published();
+    check(m != NULL, "completed immutable manifest published");
+    return m;
+}
+static void ready_entry(ld_sp_entry* e)
+{
+    for (unsigned i = 0; i < 10000 && InterlockedCompareExchange(&e->state, 0, 0) < 2; ++i) Sleep(1);
+    check(InterlockedCompareExchange(&e->state, 0, 0) == 2,
+          "known shader ready before the first draw request");
+}
+static void ready(void)
+{
+    ld_sp_manifest* m = discovered();
+    check(m->count != 0, "known source remains in discovered manifest");
+    ready_entry(&m->entries[0]);
+}
+static void same(ID3DBlob* a, ID3DBlob* b)
+{
+    check(a && b && a->lpVtbl->GetBufferSize(a) == b->lpVtbl->GetBufferSize(b) &&
+        !memcmp(a->lpVtbl->GetBufferPointer(a), b->lpVtbl->GetBufferPointer(b), a->lpVtbl->GetBufferSize(a)),
+        "entire prepared DXBC byte-identical to direct compiler output");
+}
+static void mov(u32* words, u32 dest, u32 attr, int constant, int end)
+{
+    const u32 src = 0x1B00u | (constant ? 3u : 2u);
+    words[0] = (1u << 30) | (63u << 15); words[1] = (1u << 22) | (attr << 8) | (src >> 9);
+    words[2] = (src & 511u) << 23; words[3] = (15u << 13) | (dest << 2) | (end ? 1u : 0u);
+}
+int main(int argc, char** argv)
+{
+    _putenv_s("LD_SHADER_PREPARE", "1");
+    check(argc == 2 && CreateDirectoryA(argv[1], NULL), "provide NEW disposable fixture directory");
+    checkpoint_entered = CreateEventA(NULL, TRUE, FALSE, NULL);
+    checkpoint_release = CreateEventA(NULL, TRUE, FALSE, NULL);
+    check(checkpoint_entered && checkpoint_release, "owned discovery checkpoint events");
+    static char ia[262144], pull[262144], converted[262144], bad[262144]; size_t length;
+    u32 words[68];
+    for (unsigned i = 0; i < 512; ++i) {
+        const u32 mask = ((i * 1297u) & 0xFFFFu) | 6u;
+        unsigned count = 1; mov(words, 0, 0, 1, 0);
+        for (unsigned attr = 0; attr < 16; ++attr) if (mask & (1u << attr)) mov(words + 4u * count++, 1, attr, 0, 0);
+        words[count * 4u - 1u] |= 1u;
+        check(rsx_vp_decompile_compact_ex((u8*)words, count * 16u, 0, mask, ia, sizeof(ia)) == (int)count, "original emitter source");
+        check(rsx_vp_decompile_pull_ex((u8*)words, count * 16u, 0, mask, pull, sizeof(pull)) == (int)count, "actual pull emitter source");
+        check(gt6_prepare_pull(ia, strlen(ia), converted, sizeof(converted), &length), "strict source variant recognized");
+        check(length == strlen(pull) && !memcmp(converted, pull, length + 1), "entire source matches production emitter");
+    }
+    check(!gt6_prepare_pull(pull, strlen(pull), converted, sizeof(converted), &length), "already-pull source not transformed twice");
+    check(!gt6_prepare_pull(ia, strlen(ia), converted, 32, &length), "bounded output");
+    strcpy(bad, ia); char* at = strstr(bad, "input.a1;"); check(at != NULL, "fixture input exists"); at[7] = '2';
+    check(!gt6_prepare_pull(bad, strlen(bad), converted, sizeof(converted), &length), "changed input mapping rejected");
+    snprintf(bad, sizeof(bad), "%s\nTexture2D conflict : register(t19);\n", ia);
+    check(!gt6_prepare_pull(bad, strlen(bad), converted, sizeof(converted), &length), "t19 conflict rejected");
+    ID3DBlob *ordinary = compile(ia), *expected = compile(pull);
+    write_source(argv[1], ia, ordinary);
+    ld_sp_start(argv[1], rsx_vertex_pull_hlsl, 0x43535A59u, 2, D3DCOMPILE_SKIP_OPTIMIZATION);
+    check(g_ld_sp.active && g_ld_sp.discovery, "discovery worker owns asynchronous start"); ready();
+    check(ld_sp_published()->count == 1, "owned source published before draw");
+    ID3DBlob* prepared = ld_sp_take(pull, (uint32_t)strlen(pull), ld_sp_hash(pull, strlen(pull))); same(expected, prepared);
+    check(g_ld_sp.compiled == 1 && g_ld_sp.written == 1 && g_ld_sp.foreground == 0, "cold compile completed entirely in worker");
+    strcpy(bad, pull); bad[strlen(bad) - 2] ^= 1;
+    check(ld_sp_take(bad, (uint32_t)strlen(bad), ld_sp_hash(pull, strlen(pull))) == NULL, "hash collision does not replace source comparison");
+    char prepared_path[MAX_PATH]; check(ld_sp_path(prepared_path, &ld_sp_published()->entries[0]), "prepared exact path");
+    ld_sp_stop(); same(expected, prepared); prepared->lpVtbl->Release(prepared);
+    ld_sp_start(argv[1], rsx_vertex_pull_hlsl, 0x43535A59u, 2, D3DCOMPILE_SKIP_OPTIMIZATION); ready();
+    check(g_ld_sp.compiled == 0 && g_ld_sp.disk_hits == 1, "restart uses exact persisted bytecode"); ld_sp_stop();
+    FILE* f = fopen(prepared_path, "r+b"); check(f != NULL, "owned corrupt-cache fixture open");
+    fseek(f, 4, SEEK_SET); const uint32_t wrong_version = 999; fwrite(&wrong_version, 4, 1, f); fclose(f);
+    ld_sp_start(argv[1], rsx_vertex_pull_hlsl, 0x43535A59u, 2, D3DCOMPILE_SKIP_OPTIMIZATION); ready();
+    check(g_ld_sp.rejected == 1 && g_ld_sp.compiled == 1, "schema change rejects cache and rebuilds exact program"); ld_sp_stop();
+    ld_sp_start(argv[1], rsx_vertex_pull_hlsl, 0x43535A59u, 2, 0); ready();
+    check(g_ld_sp.rejected == 1 && g_ld_sp.compiled == 1, "changed compiler flags reject tagged cache");
+    ID3DBlob* optimized = compile_flags(pull, 0);
+    prepared = ld_sp_take(pull, (uint32_t)strlen(pull), ld_sp_hash(pull, strlen(pull))); same(optimized, prepared);
+    prepared->lpVtbl->Release(prepared); optimized->lpVtbl->Release(optimized); ld_sp_stop();
+    char updated_helper[sizeof(rsx_vertex_pull_hlsl) + 32];
+    snprintf(updated_helper, sizeof(updated_helper), "%s// helper revision\n", rsx_vertex_pull_hlsl);
+    ld_sp_start(argv[1], updated_helper, 0x43535A59u, 2, D3DCOMPILE_SKIP_OPTIMIZATION); ready();
+    check(g_ld_sp.compiled == 1 && !g_ld_sp.disk_hits &&
+          !ld_sp_take(pull, (uint32_t)strlen(pull), ld_sp_hash(pull, strlen(pull))),
+          "helper revision changes exact source key and cannot replace another draw"); ld_sp_stop();
+    ld_prepare_set_paused(1);
+    ld_sp_start(argv[1], rsx_vertex_pull_hlsl, 0x43535A59u, 2, D3DCOMPILE_SKIP_OPTIMIZATION);
+    Sleep(30);
+    check(!ld_sp_published() && !g_ld_sp.scanned && !g_ld_sp.ready && !g_ld_sp.next && !g_ld_prepare_in_flight,
+          "initial pause starts asynchronously without any enumeration or partial publication");
+    check(!ld_sp_take(pull, (uint32_t)strlen(pull), ld_sp_hash(pull, strlen(pull))),
+          "foreground uses normal compile/cache immediately before discovery publication");
+    ld_sp_stop(); check(!g_ld_sp.active && !g_ld_prepare_in_flight, "paused shader stop joins safely");
+    strcpy(updated_helper, rsx_vertex_pull_hlsl);
+    ld_sp_start(argv[1], updated_helper, 0x43535A59u, 2, D3DCOMPILE_SKIP_OPTIMIZATION);
+    memset(updated_helper, 'x', sizeof(updated_helper));
+    ld_prepare_set_paused(0); ready();
+    prepared = ld_sp_take(pull, (uint32_t)strlen(pull), ld_sp_hash(pull, strlen(pull))); same(expected, prepared);
+    check(g_ld_sp.hits == 1, "start copied caller helper before return and background access");
+    prepared->lpVtbl->Release(prepared); ld_sp_stop();
+    for (unsigned i = 0; i < 32; ++i) { snprintf(bad, sizeof(bad), "%s\n// cancellation variant %u\n", ia, i); write_source(argv[1], bad, ordinary); }
+    InterlockedExchange(&checkpoint_phase, 1);
+    ld_sp_start(argv[1], rsx_vertex_pull_hlsl, 0x43535A59u, 2, D3DCOMPILE_SKIP_OPTIMIZATION);
+    check(WaitForSingleObject(checkpoint_entered, 10000) == WAIT_OBJECT_0, "discovery paused after first private file");
+    check(g_ld_sp.scanned == 1 && !ld_sp_published(), "partial manifest is invisible to foreground");
+    check(!ld_sp_take(pull, (uint32_t)strlen(pull), ld_sp_hash(pull, strlen(pull))),
+          "partial discovery never waits or replaces a foreground shader");
+    ld_prepare_set_paused(1); SetEvent(checkpoint_release); Sleep(30);
+    check(g_ld_sp.scanned == 1 && !ld_sp_published() && !g_ld_prepare_in_flight,
+          "pause retains private partial discovery without reading another file");
+    ld_sp_stop();
+    check(!g_ld_sp.active && !ld_sp_published() && !g_ld_sp.discovery && !g_ld_prepare_in_flight,
+          "cancel joins partial discovery and destroys unpublished ownership");
+    ResetEvent(checkpoint_entered); ResetEvent(checkpoint_release);
+    InterlockedExchange(&checkpoint_phase, 2); ld_prepare_set_paused(0);
+    ld_sp_start(argv[1], rsx_vertex_pull_hlsl, 0x43535A59u, 2, D3DCOMPILE_SKIP_OPTIMIZATION);
+    check(WaitForSingleObject(checkpoint_entered, 10000) == WAIT_OBJECT_0, "complete private index checkpoint reached");
+    check(!ld_sp_published(), "complete index still invisible before atomic publication");
+    ld_prepare_set_paused(1); SetEvent(checkpoint_release);
+    ld_sp_manifest* m = discovered();
+    check(m->count == 33 && !g_ld_sp.next && !g_ld_prepare_in_flight, "publication preserves every paused queued source");
+    for (unsigned i = 0; i < m->count; ++i)
+        check(ld_sp_find(m, m->entries[i].source, m->entries[i].length, m->entries[i].hash) == &m->entries[i],
+              "all published index entries resolve their complete source exactly");
+    ld_sp_entry* requested = ld_sp_find(m, pull, (uint32_t)strlen(pull), ld_sp_hash(pull, strlen(pull)));
+    check(requested && !ld_sp_take(pull, (uint32_t)strlen(pull), ld_sp_hash(pull, strlen(pull))) && requested->state == 4,
+          "published queued shader takes normal foreground path while paused");
+    ld_sp_entry* pending = requested == &m->entries[0] ? &m->entries[1] : &m->entries[0];
+    InterlockedExchange(&checkpoint_phase, 0); ld_prepare_set_paused(0); ready_entry(pending);
+    check(ld_sp_published() == m && m->count == 33, "resume prepares the same immutable manifest");
+    ld_prepare_set_paused(1); ld_sp_stop();
+    check(!g_ld_sp.active && !g_ld_sp.threads_count && !ld_sp_published(), "stop joins workers before freeing owned sources");
+    for (unsigned i = 0; i < 16; ++i) {
+        ld_sp_start(argv[1], rsx_vertex_pull_hlsl, 0x43535A59u, 2, D3DCOMPILE_SKIP_OPTIMIZATION);
+        ld_sp_stop();
+        check(!g_ld_sp.active && !g_ld_sp.discovery && !ld_sp_published() && !g_ld_prepare_in_flight,
+              "immediate stop/restart cannot publish a previous generation");
+    }
+    char search[MAX_PATH]; snprintf(search, sizeof(search), "%s\\*.prepare.*.tmp", argv[1]);
+    WIN32_FIND_DATAA data; HANDLE find = FindFirstFileA(search, &data);
+    check(find == INVALID_HANDLE_VALUE, "cancellation leaves no partial cache files");
+    char empty[MAX_PATH]; snprintf(empty, sizeof(empty), "%s\\empty", argv[1]);
+    check(CreateDirectoryA(empty, NULL), "empty cache fixture created");
+    ld_prepare_set_paused(0);
+    ld_sp_start(empty, rsx_vertex_pull_hlsl, 0x43535A59u, 2, D3DCOMPILE_SKIP_OPTIMIZATION);
+    m = discovered();
+    check(!m->count && !g_ld_sp.threads_count &&
+          !ld_sp_take(pull, (uint32_t)strlen(pull), ld_sp_hash(pull, strlen(pull))),
+          "empty cache completes asynchronously and retains normal path without workers");
+    ld_sp_stop();
+    _putenv_s("LD_SHADER_PREPARE", "0"); ld_sp_start(argv[1], rsx_vertex_pull_hlsl, 0x43535A59u, 2, D3DCOMPILE_SKIP_OPTIMIZATION);
+    check(!g_ld_sp.active && ld_sp_take(pull, (uint32_t)strlen(pull), ld_sp_hash(pull, strlen(pull))) == NULL, "rollback retains normal compile path");
+    ld_prepare_set_paused(0);
+    CloseHandle(checkpoint_release); CloseHandle(checkpoint_entered);
+    expected->lpVtbl->Release(expected); ordinary->lpVtbl->Release(ordinary);
+    printf("Shader prepare: %u checks PASS (CPU FXC, exact emitter/DXBC, asynchronous publication, cancellation, cache invalidation, ownership)\n", checks);
+    return 0;
+}
