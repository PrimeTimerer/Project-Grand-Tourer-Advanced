+/* Host-only observation, not a guest SDK export. The generation changes at
+ * Open/Start/Stop/Close. presentation_us is the device time of read_index
+ * (the end of the last consumed block), in the guest system-time epoch.
+ * The persistent snapshot lock remains valid after cellAudioQuit. */
+typedef struct CellAudioClockSnapshot {
+    u64 generation, generation_start_us, read_index, presentation_us, sampled_guest_us;
+    u64 query_guest_us, query_qpc_100ns;
+    u64 device_position, device_frequency, device_qpc_100ns;
+    u32 running, ready, channels, blocks;
+    u32 port_addr, read_index_addr, padding_frames, device_valid, device_capacity_frames;
+} CellAudioClockSnapshot;
+s32 ps3_audio_get_clock_snapshot(u32 portNum, CellAudioClockSnapshot* snapshot);
+
 /* NID: 0x56DFE179; the HLE context adapter reads level from PPU f1. */
 s32 cellAudioSetPortLevel(u32 portNum, float level);
 
diff --git a/libs/audio/tests/test_audio_clock_snapshot.c b/libs/audio/tests/test_audio_clock_snapshot.c
new file mode 100644
index 0000000..dcab7bb
--- /dev/null
+++ b/libs/audio/tests/test_audio_clock_snapshot.c
@@ -0,0 +1,62 @@
+/* Permanent snapshot lifetime and per-port generation, with the real mixer.
+ * Only synthetic guest VM is used. No backend, device, game or HDD is opened. */
+#define main unused_audio_ring_main
+#include "test_audio_ring.c"
+#undef main
+
+int main(void)
+{
+    vm_base = VirtualAlloc(NULL, VM_TOTAL_SIZE, MEM_RESERVE, PAGE_NOACCESS);
+    assert(vm_base && vm_commit(0, 0x10000) == CELL_OK);
+    mutex_init(&s_audio_mutex);
+    s_audio_initialized = 1;
+    vm_write64(0x100, 2); vm_write64(0x108, 8);
+    vm_write64(0x110, 0);
+    CellAudioClockSnapshot first, active, stopped, restarted, closed, reused;
+    assert(cellAudioPortOpen((void*)0x100, (void*)0x200) == CELL_OK);
+    assert(ps3_audio_get_clock_snapshot(0, &first) == CELL_OK);
+    assert(first.generation && !first.running && !first.ready && first.read_index == 0);
+    assert(first.channels == 2 && first.blocks == 8);
+    assert(cellAudioPortStart(0) == CELL_OK);
+    assert(ps3_audio_get_clock_snapshot(0, &active) == CELL_OK);
+    assert(active.generation != first.generation && active.running && !active.ready);
+    audio_clock_observe_device(1, 96000, 48000, 20000000, 1920, 2560);
+    s_mix_present_us = test_clock_us + 40000;
+    audio_mix_one_block();
+    assert(ps3_audio_get_clock_snapshot(0, &active) == CELL_OK);
+    assert(active.ready && active.read_index == 1);
+    assert(active.presentation_us == test_clock_us + 40000 + 256000000 / 48000);
+    assert(active.device_valid && active.device_position == 96000);
+    assert(active.device_frequency == 48000 && active.device_qpc_100ns == 20000000);
+    assert(active.query_guest_us == test_clock_us && active.padding_frames == 1920);
+    assert(active.device_capacity_frames == 2560 && active.generation_start_us == test_clock_us);
+    assert(cellAudioPortStop(0) == CELL_OK);
+    assert(ps3_audio_get_clock_snapshot(0, &stopped) == CELL_OK);
+    assert(!stopped.running && !stopped.ready && stopped.generation != active.generation);
+    test_clock_us += 10000000;
+    assert(cellAudioPortStart(0) == CELL_OK);
+    assert(ps3_audio_get_clock_snapshot(0, &restarted) == CELL_OK);
+    assert(restarted.generation != stopped.generation && !restarted.ready);
+    assert(restarted.generation_start_us == test_clock_us);
+    assert(restarted.read_index == 1); /* count is not reset by a restart */
+    s_mix_present_us = test_clock_us + 21333;
+    audio_mix_one_block();
+    assert(ps3_audio_get_clock_snapshot(0, &restarted) == CELL_OK);
+    assert(restarted.ready && restarted.read_index == 2);
+    assert(restarted.presentation_us == s_mix_present_us + 256000000 / 48000);
+    assert(cellAudioPortClose(0) == CELL_OK);
+    assert(ps3_audio_get_clock_snapshot(0, &closed) == CELL_OK);
+    assert(!closed.running && !closed.ready && closed.generation != restarted.generation);
+    assert(cellAudioPortOpen((void*)0x100, (void*)0x200) == CELL_OK);
+    assert(ps3_audio_get_clock_snapshot(0, &reused) == CELL_OK);
+    assert(reused.generation != closed.generation && reused.read_index == 0 && !reused.ready);
+    assert(reused.port_addr == first.port_addr); /* same EA does not mean same lifetime */
+    assert(cellAudioQuit() == CELL_OK);
+    assert(ps3_audio_get_clock_snapshot(0, &closed) == CELL_OK);
+    assert(!closed.running && !closed.ready && closed.generation != reused.generation);
+    assert(ps3_audio_get_clock_snapshot(CELL_AUDIO_PORT_MAX, &closed) == CELL_AUDIO_ERROR_PARAM);
+    assert(ps3_audio_get_clock_snapshot(0, NULL) == CELL_AUDIO_ERROR_PARAM);
+    VirtualFree(vm_base, 0, MEM_RELEASE);
+    puts("movie clock snapshot: actual consume, device fields, Stop/Start, reused EA, and post-Quit lifetime passed");
+    return 0;
+}
diff --git a/libs/audio/tests/test_audio_flow_window.c b/libs/audio/tests/test_audio_flow_window.c
new file mode 100644
index 0000000..665a39e
--- /dev/null
+++ b/libs/audio/tests/test_audio_flow_window.c
@@ -0,0 +1,84 @@
+/* Real cellAudio diagnostic lifecycle on synthetic guest VM. No audio backend,
+ * mix thread, game or HDD is opened. Only the diagnostic file writer is used. */
+#define main unused_audio_ring_main
+#include "test_audio_ring.c"
+#undef main
+
+static void reset_flow_fixture(void)
+{
+    assert(!s_flow_state && !s_flow_records && !s_flow_file && !s_flow_writer);
+    s_flow_initialized = 0; s_flow_count = s_flow_dropped = 0;
+    s_flow_mix_frame = s_flow_next_frame = 0;
+    s_flow_wav_qpc = s_flow_wav_mix_frame = s_flow_wav_frames = 0;
+    s_flow_wav_short_writes = 0;
+    memset(s_flow_previous_valid, 0, sizeof s_flow_previous_valid);
+}
+static void check_saved(const char* path, const char* reason, unsigned expected)
+{
+    FILE* file = fopen(path, "rb"); assert(file);
+    char line[2048], expected_end[128]; unsigned records = 0, footer = 0;
+    snprintf(expected_end, sizeof expected_end, "# end reason=%s records=%u dropped=0", reason, expected);
+    while (fgets(line, sizeof line, file)) {
+        if (line[0] == 'P' || line[0] == 'C') ++records;
+        if (strstr(line, expected_end)) ++footer;
+    }
+    assert(!ferror(file) && !fclose(file));
+    assert(records == expected && footer == 1);
+}
+int main(int argc, char** argv)
+{
+    assert(argc == 2); // caller-selected disposable output directory
+    vm_base = VirtualAlloc(NULL, VM_TOTAL_SIZE, MEM_RESERVE, PAGE_NOACCESS);
+    assert(vm_base && vm_commit(0, 0x10000) == CELL_OK);
+    mutex_init(&s_audio_mutex); s_audio_initialized = 1;
+    vm_write64(0x100, 2); vm_write64(0x108, 8); vm_write64(0x110, 0);
+    assert(cellAudioPortOpen((void*)0x100, (void*)0x200) == CELL_OK);
+    assert(cellAudioPortStart(0) == CELL_OK);
+    char deadline_path[1024], quit_path[1024];
+    snprintf(deadline_path, sizeof deadline_path, "%s/flow_%lu_%llu_deadline.txt", argv[1], (unsigned long)GetCurrentProcessId(), (unsigned long long)GetTickCount64());
+    snprintf(quit_path, sizeof quit_path, "%s/flow_%lu_%llu_quit.txt", argv[1], (unsigned long)GetCurrentProcessId(), (unsigned long long)GetTickCount64());
+    assert(!_putenv_s("AUDIO_FLOW_TRACE", deadline_path));
+    assert(!_putenv_s("AUDIO_FLOW_TRACE_AFTER_MS", "0"));
+    assert(!_putenv_s("AUDIO_FLOW_TRACE_PORT", "0"));
+    assert(!_putenv_s("AUDIO_FLOW_TRACE_DURATION_MS", "60001"));
+    audio_flow_init();
+    assert(!s_flow_state && !s_flow_file && !s_flow_records);
+    assert(GetFileAttributesA(deadline_path) == INVALID_FILE_ATTRIBUTES);
+
+    reset_flow_fixture();
+    assert(!_putenv_s("AUDIO_FLOW_TRACE_DURATION_MS", "40000"));
+    audio_flow_init();
+    assert(s_flow_state && s_flow_file && s_flow_records);
+    assert(s_flow_end - s_flow_start == s_flow_freq * 40);
+    assert(AUDIO_FLOW_CAP == 32768);
+    // Sixty seconds at 48k/256 produces 11,250 producer+consumer pairs.
+    // Drive the actual record/mixer paths quickly; this is not a cadence test.
+    for (unsigned i = 0; i < 11250; ++i) {
+        audio_flow_begin_block();
+        const u32 slot = (u32)(s_ports[0].read_index % 8);
+        cellAudio_trace_producer((u32)s_ports[0].port_addr + slot * 2048, slot, i, 1);
+        s_mix_present_us = test_clock_us;
+        audio_mix_one_block();
+        audio_flow_note_wav(256);
+    }
+    assert(s_flow_count == 22500 && !s_flow_dropped);
+    s_flow_end = audio_flow_qpc() - 1; // deterministic expiry, no 40-second sleep
+    audio_flow_begin_block(); audio_flow_quit();
+    assert(!g_cell_audio_flow_trace_on && !s_flow_state && !s_flow_records && !s_flow_file && !s_flow_writer);
+    check_saved(deadline_path, "deadline", 22500);
+
+    reset_flow_fixture();
+    assert(!_putenv_s("AUDIO_FLOW_TRACE", quit_path));
+    assert(!_putenv_s("AUDIO_FLOW_TRACE_DURATION_MS", "60000"));
+    audio_flow_init(); assert(s_flow_end - s_flow_start == s_flow_freq * 60);
+    audio_flow_begin_block(); audio_mix_one_block(); audio_flow_note_wav(256);
+    assert(s_flow_count == 1 && !s_flow_dropped);
+    assert(cellAudioQuit() == CELL_OK);
+    assert(!g_cell_audio_flow_trace_on && !s_flow_state && !s_flow_records && !s_flow_file && !s_flow_writer);
+    // Disabled late probes must not touch the now-destroyed audio mutex.
+    cellAudio_trace_producer(0, 0, 0, 0); audio_flow_begin_block(); audio_flow_quit();
+    check_saved(quit_path, "audio_quit_before_deadline", 1);
+    VirtualFree(vm_base, 0, MEM_RELEASE);
+    puts("audio FLOW: 40000/60000 admitted, 60001 rejected; 22500 records fit, no drops; deadline/quit flush and late-probe lifetime passed");
+    return 0;
+}
