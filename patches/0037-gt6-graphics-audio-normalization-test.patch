new file mode 100644
index 0000000..3d7ef6a
--- /dev/null
+++ b/libs/video/rsx_point_sprite.h
@@ -0,0 +1,60 @@
+#ifndef RSX_POINT_SPRITE_H
+#define RSX_POINT_SPRITE_H
+
+/* NV4097 points, expanded after the vertex program has run. The VSOutput
+ * signature matches rsx_vp_decompiler.c. Point size is a pixel diameter;
+ * each corner moves by diameter / target_extent in clip space, multiplied
+ * by W. Extents are guest pixels, so MSAA's sample grid scales both axes.
+ *
+ * Register facts: envytools rnndb/graph/nv30-40_3d.xml and nv_3ddefs.xml;
+ * RSX extends the coordinate replacement mask to TEX8/9. Coordinate rules:
+ * https://registry.khronos.org/OpenGL/extensions/NV/NV_point_sprite.txt
+ * (top-down S/T, R mode ZERO/R/S, Q=1). This is an authored shader, not a
+ * translation of another renderer's implementation.
+ *
+ * Six 32-bit root constants at b2: 1/width, 1/height, fixed size,
+ * program-size enable, coordinate replacement mask, R mode. Keep sizes and
+ * masks dynamic: particles need no PSO per size, viewport, or texture unit.
+ */
+static const char rsx_point_sprite_hlsl[] =
+    "struct VSOutput {\n"
+    "  float4 pos:SV_Position; float4 col0:COLOR0; float4 col1:COLOR1;\n"
+    "  float4 fog:FOG;\n"
+    "  float4 t0:TEXCOORD0; float4 t1:TEXCOORD1; float4 t2:TEXCOORD2; float4 t3:TEXCOORD3;\n"
+    "  float4 t4:TEXCOORD4; float4 t5:TEXCOORD5; float4 t6:TEXCOORD6; float4 t7:TEXCOORD7;\n"
+    "  float4 t8:TEXCOORD8; float4 t9:TEXCOORD9;\n"
+    "};\n"
+    "cbuffer PointState:register(b2) {\n"
+    "  float2 point_inv_extent; float point_fixed_size; uint point_program_size;\n"
+    "  uint point_replace_mask; uint point_r_mode;\n"
+    "};\n"
+    "float4 point_coord(float4 original, float2 uv, uint unit) {\n"
+    "  if (!(point_replace_mask & (1u << unit))) return original;\n"
+    "  float r = point_r_mode == 1u ? original.z : (point_r_mode == 2u ? original.x : 0.0);\n"
+    "  return float4(uv, r, 1.0);\n"
+    "}\n"
+    "[maxvertexcount(4)]\n"
+    "void main(point VSOutput input[1], inout TriangleStream<VSOutput> stream) {\n"
+    "  float4 p = input[0].pos;\n"
+    "  float size = point_program_size != 0u ? input[0].t9.x : point_fixed_size;\n"
+    /* Preserve subpixel and large finite sizes; the RSX sprite-size upper
+     * range is not established here. Nonpositive/program-NaN sizes are
+     * undefined guest input and must not poison the generated positions. */
+    "  if (!all(isfinite(p)) || !isfinite(size) || size <= 0.0 || p.w <= 0.0) return;\n"
+    "  float2 delta = size * point_inv_extent * p.w;\n"
+    "  if (!all(isfinite(delta))) return;\n"
+    "  [unroll] for (uint corner = 0u; corner < 4u; corner++) {\n"
+    "    float2 uv = float2(corner & 1u, corner >> 1u);\n"
+    "    VSOutput o = input[0];\n"
+    "    o.pos.xy = p.xy + float2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0) * delta;\n"
+    "    o.t0=point_coord(o.t0,uv,0u); o.t1=point_coord(o.t1,uv,1u);\n"
+    "    o.t2=point_coord(o.t2,uv,2u); o.t3=point_coord(o.t3,uv,3u);\n"
+    "    o.t4=point_coord(o.t4,uv,4u); o.t5=point_coord(o.t5,uv,5u);\n"
+    "    o.t6=point_coord(o.t6,uv,6u); o.t7=point_coord(o.t7,uv,7u);\n"
+    "    o.t8=point_coord(o.t8,uv,8u); o.t9=point_coord(o.t9,uv,9u);\n"
+    "    stream.Append(o);\n"
+    "  }\n"
+    "  stream.RestartStrip();\n"
+    "}\n";
+
+#endif
