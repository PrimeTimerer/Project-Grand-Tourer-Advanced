+/* Device-free test of the actual WASAPI cadence/clock helpers. The simulator
+ * supplies a finite 2880-frame device queue with 480-frame engine periods.
+ * It never opens a device, starts the mixer thread or executes game code. */
+#define main audio_ring_fixture_main
+#include "test_audio_ring.c"
+#undef main
+
+#if defined(_WIN32) && AUDIO_BACKEND_WASAPI
+typedef struct {
+    int legacy, ppm, collect, capacity;
+    u64 duration, overshoot, stall_at, stall_duration, jump_at;
+} SimConfig;
+typedef struct {
+    u64 count, min_gap, max_gap, short_gaps, final_debt, rebases;
+    u64 min_padding, max_padding, underrun_frames;
+    u64* times;
+    int final_padding;
+} SimResult;
+
+static u64 sim_frames(u64 time, int ppm)
+{
+    return (u64)((double)time * 48000.0 * (1.0 + ppm/1000000.0) / 10000000.0);
+}
+static SimResult simulate(SimConfig cfg)
+{
+    const u64 epoch = 1234567890000ULL, device_frequency = 192000;
+    AudioDeviceClock c = {0}; AudioCadence p = {0};
+    SimResult out = {0}; out.min_gap = out.min_padding = UINT64_MAX;
+    if (cfg.collect) { out.times = malloc((size_t)(cfg.duration/30000+100)*sizeof(u64)); assert(out.times); }
+    const int capacity=cfg.capacity?cfg.capacity:2880;
+    u64 now=0, consumed=0, previous=0, wait_overshoot=0; int padding=capacity, stalled=0;
+    while (now < cfg.duration) {
+        if (!stalled && cfg.stall_duration && now >= cfg.stall_at) { now+=cfg.stall_duration; stalled=1; }
+        if (now>=cfg.duration) break;
+        const u64 device_consumed=sim_frames(now,cfg.ppm)/480*480;
+        const u64 delta=device_consumed-consumed; consumed=device_consumed;
+        if (delta>(u64)padding) { out.underrun_frames+=delta-padding; padding=0; }
+        else padding-=(int)delta;
+        const int room=capacity-padding;
+        if (room<256) {
+            u64 next=(u64)ceil((double)(device_consumed+480)*10000000.0 /
+                              (48000.0*(1.0+cfg.ppm/1000000.0)));
+            now=next>now?next:now+1;
+            continue;
+        }
+        if (!cfg.legacy) {
+            /* Coarse position readings, including a fresh sample QPC while
+             * the position repeats. The helper must retain a changing anchor. */
+            const u64 sample=now/100000*100000;
+            u64 position=sim_frames(sample,cfg.ppm)*device_frequency/48000;
+            if (cfg.jump_at && now>=cfg.jump_at) position+=device_frequency;
+            const u64 clock=audio_device_clock_update(&c,epoch+now,1,position,epoch+sample,device_frequency);
+            const u64 wait=audio_cadence_delay(&p,clock,epoch+now,room);
+            if (wait) {
+                const u64 request=audio_cadence_wait_request(wait,wait_overshoot);
+                const u64 elapsed=request+cfg.overshoot;
+                now+=elapsed;audio_cadence_wait_feedback(&wait_overshoot,request,elapsed);continue;
+            }
+        }
+        assert(padding+256<=capacity); /* no overrun/dropped submitted samples */
+        if (out.count) {
+            const u64 gap=now-previous;
+            if (gap<out.min_gap) out.min_gap=gap;
+            if (gap>out.max_gap) out.max_gap=gap;
+            if (gap<40000) ++out.short_gaps;
+        }
+        if ((u64)padding<out.min_padding) out.min_padding=padding;
+        if ((u64)padding>out.max_padding) out.max_padding=padding;
+        if (out.times) out.times[out.count]=now;
+        previous=now; ++out.count; padding+=256;
+        now+=100; /* 10 us of real mixing/submission work */
+        if (!cfg.legacy) audio_cadence_commit(&p,epoch+now);
+    }
+    out.final_padding=padding; out.rebases=p.phase_rebases;
+    out.final_debt=c.last_time>p.due?c.last_time-p.due:0;
+    return out;
+}
+
+/* SGX-shaped toy producer: each completed notification advances one job and
+ * its sequential destination. Jobs write actual tagged slots and a consumer
+ * clears each read. Nothing is silently filled or considered ready by time. */
+static u64 toy_zero_reads(const SimResult* run, u64 compute_time)
+{
+    s64 ring[16]; for (int i=0;i<16;++i) ring[i]=-1;
+    ring[0]=0; ring[1]=1;
+    u64 consumed=0, ack=0, target=2, end=UINT64_MAX, zero=0;
+    for (u64 i=0;i<run->count;++i) {
+        const u64 now=run->times[i];
+        while (end<=now) {
+            ring[target%16]=(s64)target; ++target; ++ack;
+            end=ack<consumed?end+compute_time:UINT64_MAX;
+        }
+        if (ring[consumed%16]<0) ++zero;
+        ring[consumed%16]=-1; ++consumed;
+        if (end==UINT64_MAX && ack<consumed) end=now+compute_time;
+    }
+    return zero;
+}
+static void clock_contract(void)
+{
+    assert(audio_clock_scale(1234567890123ULL,3579545)==3448952004020ULL);
+    assert(audio_clock_scale(987654321ULL,192000)==51440329218ULL);
+    const u64 e=1000000000;
+    AudioDeviceClock c={0};
+    assert(audio_device_clock_update(&c,e,1,19200,e,192000)==e);
+    /* Repeating quantized device position with a freshly sampled QPC must
+     * not freeze the interpolated clock until the next 10-ms engine event. */
+    assert(audio_device_clock_update(&c,e+50000,1,19200,e+50000,192000)==e+50000);
+    assert(audio_device_clock_update(&c,e+100000,1,21120,e+100000,192000)==e+100000);
+    /* Device failure, recovery, reset/backwards position and frequency change
+     * continue from the same timeline rather than jumping to another epoch. */
+    assert(audio_device_clock_update(&c,e+200000,0,0,0,0)==e+200000);
+    assert(audio_device_clock_update(&c,e+300000,1,24960,e+300000,192000)==e+300000);
+    assert(audio_device_clock_update(&c,e+400000,1,0,e+400000,192000)==e+400000);
+    assert(audio_device_clock_update(&c,e+500000,1,480,e+500000,48000)==e+500000);
+    AudioCadence p={0};
+    assert(audio_cadence_delay(&p,e,e,480)==53333);
+    assert(!audio_cadence_delay(&p,e+53333,e+53333,480));
+    audio_cadence_commit(&p,e+53333);
+    assert(audio_cadence_delay(&p,e+60000,e+60000,480)>0);
+    /* A stopped/restarted mixer constructs new local state. */
+    memset(&p,0,sizeof p);memset(&c,0,sizeof c);
+    assert(audio_device_clock_update(&c,e+10000000,1,0,e+10000000,48000)==e+10000000);
+    assert(audio_cadence_delay(&p,e+10000000,e+10000000,480)==53333);
+    /* Rational accumulation is exact over a whole second / an hour. */
+    memset(&p,0,sizeof p);
+    for (u32 i=0;i<675000;++i) audio_cadence_advance(&p);
+    assert(p.due==36000000000ULL && p.remainder==0);
+}
+int main(void)
+{
+    setvbuf(stdout,NULL,_IONBF,0);
+    clock_contract();
+    SimConfig cfg={0};cfg.duration=120000000;cfg.collect=1;
+    SimResult paced=simulate(cfg);cfg.legacy=1;SimResult legacy=simulate(cfg);
+    const u64 oldzero=toy_zero_reads(&legacy,51000),newzero=toy_zero_reads(&paced,51000);
+    printf("12s finite queue: legacy blocks=%llu min_gap=%.4fms zero=%llu; paced blocks=%llu min_gap=%.4fms zero=%llu\n",
+           legacy.count,legacy.min_gap/10000.0,oldzero,paced.count,paced.min_gap/10000.0,newzero);
+    assert(legacy.short_gaps>500 && oldzero>50);
+    assert(!paced.short_gaps && newzero<oldzero/10 && paced.count+3>=legacy.count);
+    assert(toy_zero_reads(&paced,60000)>0); /* slower production stays observable */
+    free(legacy.times);free(paced.times);
+    cfg=(SimConfig){0};cfg.duration=36000000000ULL;cfg.overshoot=2500;
+    SimResult hour=simulate(cfg);
+    printf("1h +0.25ms waits: blocks=%llu expected~675000 queue=%d min_gap=%.4fms phase_resets=%llu\n",hour.count,hour.final_padding,hour.min_gap/10000.0,hour.rebases);
+    assert(hour.count>=674995 && hour.count<=675001 && !hour.short_gaps && !hour.rebases && !hour.underrun_frames);
+    for(int sign=-1;sign<=1;sign+=2) {
+        cfg.duration=6000000000ULL;cfg.ppm=sign*1000;SimResult drift=simulate(cfg);
+        const double expected=600.0*187.5*(1.0+cfg.ppm/1000000.0);
+        printf("600s device drift %+dppm: blocks=%llu expected=%.3f queue=%d\n",cfg.ppm,drift.count,expected,drift.final_padding);
+        assert(fabs((double)drift.count-expected)<5 && !drift.short_gaps && !drift.underrun_frames);
+    }
+    cfg=(SimConfig){0};cfg.duration=50000000;cfg.stall_at=5000000;cfg.stall_duration=10000000;
+    SimResult stall=simulate(cfg);
+    printf("1s suspension: phase_resets=%llu final_debt=%.4fms queue=%d min_gap=%.4fms\n",stall.rebases,stall.final_debt/10000.0,stall.final_padding,stall.min_gap/10000.0);
+    assert(stall.rebases==1 && stall.final_debt<10000 && stall.final_padding>=2000 && !stall.short_gaps);
+    cfg.stall_duration=0;cfg.jump_at=5000000;SimResult jump=simulate(cfg);
+    printf("+1s device-position jump: phase_resets=%llu final_debt=%.4fms queue=%d\n",jump.rebases,jump.final_debt/10000.0,jump.final_padding);
+    assert(jump.rebases==1 && jump.final_debt<10000 && !jump.short_gaps && !jump.underrun_frames);
