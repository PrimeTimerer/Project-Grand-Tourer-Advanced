+SPU_NOINLINE_COLD void spu_native_capture_probe(spu_context* ctx, spu_fn fn, const char* site)
+{
+    if (__atomic_load_n(&g_spu_native_capture_state, __ATOMIC_ACQUIRE) < 0) spu_native_capture_init();
+    if (__atomic_load_n(&g_spu_native_capture_state, __ATOMIC_ACQUIRE) != 1 ||
+        fn == spu_indirect_branch ||
+        (s_nc_tid && ctx->spu_id != s_nc_tid)) return;
+    for (unsigned i = 0; i < s_nc_count; ++i) {
+        if (ctx->pc != s_nc_entry[i].pc || __atomic_load_n(&s_nc_entry[i].claimed, __ATOMIC_RELAXED)) continue;
+        const uint64_t elapsed = GetTickCount64() - s_nc_start_ms;
+        if (elapsed < s_nc_after_ms) return;
+        int expected_hit = 0;
+        const int first_hit = __atomic_compare_exchange_n(&s_nc_entry[i].observed, &expected_hit, 1, 0,
+                                                          __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+        /* A raw SPU_DIRECT trampoline has not necessarily resolved/verified
+         * this owner yet. Verify through the normal resolver before the exact
+         * source/byte proof below; never label an unrelated raw fn as native
+         * code belonging to the requested image. */
+        const spu_fn resolved = spu_lifted_lookup(ctx, ctx->pc);
+        if (first_hit)
+            fprintf(stderr, "[spu-native-capture] first-hit tid=0x%X image=%d pc=0x%05X site=%s "
+                            "resolver=%s resident_count=%u elapsed_ms=%llu\n",
+                    ctx->spu_id, s_nc_entry[i].image, ctx->pc, site,
+                    resolved == fn ? "same-fn" : "REJECTED-different-fn",
+                    ctx->resident_code_count, (unsigned long long)elapsed);
+        if (resolved != fn) continue;
+        /* Confirm exact source identity and all code bytes, not just an image
+         * ID, a first instruction, or a cached function with a matching PC. */
+        for (unsigned slot = 0; slot < ctx->resident_code_count; ++slot) {
+            const int source = ctx->resident_code[slot].source_index;
+            if (ctx->resident_code[slot].image_id != s_nc_entry[i].image ||
+                ctx->resident_code[slot].verify_state != SPU_OVERLAY_VERIFIED ||
+                source < 0 || source >= s_ovl_src_count) continue;
+            const spu_ovl_src* o = &s_ovl_src[source];
+            if (!o->code || !o->code_count || o->image_id != s_nc_entry[i].image ||
+                ctx->resident_code[slot].lsa != o->load_lsa + o->sub_off ||
+                ctx->resident_code[slot].size != o->span ||
+                ctx->resident_code[slot].source_ea != o->src_ea + o->sub_off ||
+                ctx->pc < ctx->resident_code[slot].lsa ||
+                ctx->pc - ctx->resident_code[slot].lsa >= o->span) continue;
