+#define audio_sgx_lock() AcquireSRWLockExclusive(&s_sgx_fifo_lock)
+#define audio_sgx_unlock() ReleaseSRWLockExclusive(&s_sgx_fifo_lock)
+#else
+static pthread_mutex_t s_sgx_fifo_lock = PTHREAD_MUTEX_INITIALIZER;
+#define audio_sgx_lock() pthread_mutex_lock(&s_sgx_fifo_lock)
+#define audio_sgx_unlock() pthread_mutex_unlock(&s_sgx_fifo_lock)
+#endif
+
+/* Caller holds s_audio_mutex (or has stopped the mixer during init/quit). */
+static void audio_sgx_port_changed(u32 port, int detach)
+{
+    if (port) return;
+    audio_sgx_lock();
+    AudioSgxFifo* f = &s_sgx_fifo;
+    const AudioPortSlot* p = &s_ports[0];
+    ++f->generation; if (!f->generation) ++f->generation;
+    f->lifecycle_discard += f->count;
+    f->head = f->count = 0; f->inflight_cookie = 0;
+    f->have_sequence = f->have_consumed = 0;
+    if (detach) f->attached = 0;
+    f->buffer = p->buffer; f->base = p->port_addr; f->size = p->buf_size;
+    f->nch = (u32)p->param.nChannel; f->nblock = (u32)p->param.nBlock;
+    f->in_use = p->in_use; f->running = p->running;
+    __atomic_store_n(&s_sgx_fifo_selected, f->attached, __ATOMIC_RELEASE);
+    audio_sgx_unlock();
+}
+static int audio_sgx_contract(const AudioSgxFifo* f, u32 base, u32 destination, u32 slot)
+{
+    return f->in_use && f->running && f->buffer && f->base == base &&
+        f->nch == 8 && f->nblock == 16 && f->size == 16*AUDIO_SGX_PCM_BYTES &&
+        slot < 16 && f->base + (u64)slot*AUDIO_SGX_PCM_BYTES == destination;
+}
+u64 cellAudio_sgx_fifo_begin(u32 base, u32 destination, u32 slot)
+{
+    audio_sgx_lock();
+    AudioSgxFifo* f = &s_sgx_fifo;
+    if (!audio_sgx_contract(f, base, destination, slot)) {
+        ++f->reject_contract; audio_sgx_unlock(); return 0;
+    }
+    if (f->inflight_cookie) { ++f->reject_busy; audio_sgx_unlock(); return 0; }
+    if (!f->attached) {
+        f->attached = f->ever_attached = 1;
+        __atomic_store_n(&s_sgx_fifo_selected, 1, __ATOMIC_RELEASE);
+    }
+    ++f->cookie_serial; if (!f->cookie_serial) ++f->cookie_serial;
+    f->inflight_cookie = f->cookie_serial; f->inflight_generation = f->generation;
+    f->inflight_slot = slot; f->inflight_ea = destination;
+    const u64 cookie = f->inflight_cookie;
+    audio_sgx_unlock(); return cookie;
+}
+void cellAudio_sgx_fifo_complete(u64 cookie, u32 base, u32 destination, u32 slot, u64 sequence)
+{
+    if (!cookie) return;
+    const u64 completed_us = ppu_system_time_us();
+    u64 completed_qpc = 0;
+#ifdef _WIN32
+    LARGE_INTEGER now; QueryPerformanceCounter(&now); completed_qpc = (u64)now.QuadPart;
+#endif
+    audio_sgx_lock();
+    AudioSgxFifo* f = &s_sgx_fifo;
+    if (cookie != f->inflight_cookie || f->generation != f->inflight_generation) {
+        ++f->reject_oldgen; audio_sgx_unlock(); return;
+    }
+    f->inflight_cookie = 0;
+    if (!audio_sgx_contract(f, base, destination, slot) ||
+        slot != f->inflight_slot || destination != f->inflight_ea) {
+        ++f->reject_contract; audio_sgx_unlock(); return;
+    }
+    /* Guest sequence can repeat: CB59E8 also has a valid memset-zero path
+     * without a mix-counter increment. The unique before-hook ticket orders
+     * packets; guest sequence is observational metadata only. */
+    if (cookie <= f->last_ticket) {
+        ++f->reject_order; audio_sgx_unlock(); return;
+    }
+    if (sequence != UINT64_MAX && f->have_sequence && sequence > f->last_sequence &&
+        sequence-f->last_sequence > 1)
+        f->sequence_gaps += sequence-f->last_sequence-1;
+    if (f->count == AUDIO_SGX_FIFO_CAP) {
+        f->head = (f->head+1)%AUDIO_SGX_FIFO_CAP; --f->count; ++f->overflow_oldest;
+    }
+    AudioSgxBlock* b = &f->blocks[(f->head+f->count)%AUDIO_SGX_FIFO_CAP];
+    memcpy(b->pcm, (const u8*)f->buffer + (size_t)slot*AUDIO_SGX_PCM_BYTES, sizeof b->pcm);
+    b->sequence = sequence; b->ticket = cookie; b->generation = f->generation;
+    b->source_slot = slot; b->source_ea = destination;
+    b->completed_qpc = completed_qpc; b->completed_us = completed_us;
+    ++f->count; ++f->accepted; f->last_ticket = cookie;
+    f->last_sequence = sequence; f->have_sequence = sequence != UINT64_MAX;
+    if (f->count > f->high_water) f->high_water = f->count;
+    audio_sgx_unlock();
+}
+/* Caller holds the permanent SGX lock. No ring fallback on an empty queue. */
+static int audio_sgx_pop(AudioSgxBlock* block, u32* remaining)
+{
+    AudioSgxFifo* f = &s_sgx_fifo;
+    if (!f->count) { ++f->underflows; *remaining = 0; return 0; }
+    *block = f->blocks[f->head];
+    f->head = (f->head+1)%AUDIO_SGX_FIFO_CAP; --f->count; ++f->consumed;
+    f->last_consumed_sequence = block->sequence; f->last_consumed_ticket = block->ticket; f->have_consumed = 1;
+    const u64 now = ppu_system_time_us();
+    const u64 age = now >= block->completed_us ? now-block->completed_us : 0;
+    if (age > f->max_age_us) f->max_age_us = age;
+    *remaining = f->count; return 1;
+}
+static void audio_sgx_report(void)
+{
+    audio_sgx_lock();
+    const AudioSgxFifo* f = &s_sgx_fifo;
+    const int report = f->ever_attached, active = f->attached && f->running;
+    const u32 count = f->count;
+    const u64 generation = f->generation, accepted = f->accepted, consumed = f->consumed,
+        underflows = f->underflows, overflow = f->overflow_oldest, discarded = f->lifecycle_discard,
+        oldgen = f->reject_oldgen, contract = f->reject_contract, order = f->reject_order,
+        busy = f->reject_busy, gaps = f->sequence_gaps, high = f->high_water, age = f->max_age_us;
+    audio_sgx_unlock();
+    if (report)
+        fprintf(stderr, "[audio-sgx-fifo] gen=%llu active=%d queued=%u accepted=%llu consumed=%llu underflow=%llu overflow_oldest=%llu lifecycle_discard=%llu reject{oldgen=%llu contract=%llu order=%llu busy=%llu} gaps=%llu high=%llu max_age_us=%llu\n",
+            generation, active, count, accepted, consumed, underflows, overflow,
+            discarded, oldgen, contract, order, busy, gaps, high, age);
+}
