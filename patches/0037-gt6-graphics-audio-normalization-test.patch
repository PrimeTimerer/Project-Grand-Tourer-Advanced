diff --git a/libs/audio/tests/test_audio_sgx_fifo.c b/libs/audio/tests/test_audio_sgx_fifo.c
new file mode 100644
index 0000000..7954ee0
--- /dev/null
+++ b/libs/audio/tests/test_audio_sgx_fifo.c
@@ -0,0 +1,156 @@
+/* Actual cellAudio mixer + GT6 adapter, using disposable VM memory and no
+ * audio device. Before/after hooks are simulated at the real API boundary. */
+#define main audio_ring_fixture_main
+#include "test_audio_ring.c"
+#undef main
+
+static u32 open_port(u32 channels, u32 blocks, u32 expected)
+{
+    vm_write64(0x100,channels);vm_write64(0x108,blocks);vm_write64(0x110,0);
+    assert(cellAudioPortOpen((void*)0x100,(void*)0x200)==CELL_OK);
+    assert(vm_read32(0x200)==expected);assert(cellAudioPortStart(expected)==CELL_OK);
+    return (u32)s_ports[expected].port_addr;
+}
+static void fill(u32 port,u32 slot,float value)
+{
+    float* data=s_ports[port].buffer+slot*256*s_ports[port].param.nChannel;
+    memset(data,0,(size_t)256*s_ports[port].param.nChannel*4);
+    if (value==0) return; /* the guest's memset-zero path, not negative float zero */
+    for(u32 i=0;i<256;++i) {store_sample(data+i*s_ports[port].param.nChannel,value);store_sample(data+i*s_ports[port].param.nChannel+1,-value);}
+}
+static void mix(void)
+{
+    audio_flow_begin_block();s_mix_present_us=test_clock_us;audio_mix_one_block();test_clock_us+=5333;
+}
+static u64 submit(u32 slot,u64 guestseq,float value)
+{
+    const u32 base=(u32)s_ports[0].port_addr,ea=base+slot*AUDIO_SGX_PCM_BYTES;
+    u64 cookie=cellAudio_sgx_fifo_begin(base,ea,slot);assert(cookie);
+    fill(0,slot,value);
+    cellAudio_trace_producer(ea,slot,guestseq,17);
+    cellAudio_sgx_fifo_complete(cookie,base,ea,slot,guestseq);
+    return cookie;
+}
+#ifdef _WIN32
+typedef struct { HANDLE ready; u32 base; u64 cookie; } RaceBegin;
+static DWORD WINAPI race_begin(void* opaque)
+{
+    RaceBegin* r=opaque;SetEvent(r->ready);
+    r->cookie=cellAudio_sgx_fifo_begin(r->base,r->base,0);assert(r->cookie);
+    fill(0,0,.625f);return 0;
+}
+static DWORD WINAPI race_mix(void* ready)
+{
+    SetEvent((HANDLE)ready);audio_mix_one_block();return 0;
+}
+#endif
+int main(void)
+{
+    setvbuf(stdout,NULL,_IONBF,0);
+    assert(!cellAudio_sgx_fifo_begin(0x58000000,0x58000000,0));
+#ifdef _WIN32
+    vm_base=VirtualAlloc(NULL,VM_TOTAL_SIZE,MEM_RESERVE,PAGE_NOACCESS);assert(vm_base);
+    assert(vm_commit(0,0x10000)==CELL_OK);
+#else
+    vm_base=mmap(NULL,VM_TOTAL_SIZE,PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANON,-1,0);assert(vm_base!=MAP_FAILED);
+#endif
+    mutex_init(&s_audio_mutex);s_audio_initialized=1;audio_sgx_port_changed(0,1);audio_flow_init();
+    u32 base=open_port(8,16,0);fill(0,0,.125f);mix();
+    assert(s_mix_buffer[0]==.125f && ld_be_f32(s_ports[0].buffer)==0 && !s_sgx_fifo.attached);
+    assert(!cellAudio_sgx_fifo_begin(base+1,base,0));
+    assert(!cellAudio_sgx_fifo_begin(base,base+8192,0));
+    assert(!cellAudio_sgx_fifo_begin(base,base,16));
+    assert(!s_sgx_fifo.attached);
+    assert(cellAudioPortClose(0)==CELL_OK);
+    base=open_port(2,16,0);assert(!cellAudio_sgx_fifo_begin(base,base,0));assert(cellAudioPortClose(0)==CELL_OK);
+    base=open_port(8,8,0);assert(!cellAudio_sgx_fifo_begin(base,base,0));assert(cellAudioPortClose(0)==CELL_OK);
+    base=open_port(8,32,0);assert(!cellAudio_sgx_fifo_begin(base,base,0));assert(cellAudioPortClose(0)==CELL_OK);
+    base=open_port(8,16,0);
+    puts("strict address/slot/channel/block validation and default ring PASS");
+
+    u64 cookie=cellAudio_sgx_fifo_begin(base,base,0);assert(cookie);fill(0,0,.25f);
+    assert(!cellAudio_sgx_fifo_begin(base,base+8192,1));
+    u64 u=s_sgx_fifo.underflows;mix();
+    assert(s_sgx_fifo.underflows==u+1 && s_ports[0].read_index==1 && s_mix_buffer[0]==0);
+    assert(ld_be_f32(s_ports[0].buffer)==.25f); /* in-flight destination survives */
+    cellAudio_trace_producer(base,0,10,17);cellAudio_sgx_fifo_complete(cookie,base,base,0,10);
+    fill(0,0,.75f);mix();assert(s_mix_buffer[0]==.25f && s_ports[0].read_index==2);
+    assert(s_sgx_fifo.last_consumed_ticket==cookie && !s_sgx_fifo.count);
+    assert(vm_read64((u32)s_ports[0].read_idx_addr)==2);
+    assert(s_ports[0].timestamp_us==s_mix_present_us+256000000ULL/48000);
+    assert(ld_be_f32(s_ports[0].buffer)==.75f); /* FIFO never clears the source ring */
+    u64 old=s_sgx_fifo.reject_oldgen;cellAudio_sgx_fifo_complete(cookie,base,base,0,10);
+    assert(s_sgx_fifo.reject_oldgen==old+1);
+    puts("in-flight protection/copy ownership/read-index/timestamp/duplicate completion PASS");
+
+    u64 of=s_sgx_fifo.overflow_oldest;
+    const u32 slots[]={15,1,14,2,13,3};u64 tickets[6];
+    for(u32 i=0;i<6;++i) tickets[i]=submit(slots[i],11+i,(float)(i+1)/16);
+    assert(s_sgx_fifo.count==4 && s_sgx_fifo.overflow_oldest==of+2);
+    for(u32 i=2;i<6;++i) {mix();assert(s_mix_buffer[0]==(float)(i+1)/16 && s_sgx_fifo.last_consumed_ticket==tickets[i]);}
+    assert(!s_sgx_fifo.count && s_sgx_fifo.max_age_us<=4*5334);
+    u=s_sgx_fifo.underflows;u64 zero_ticket=submit(12,16,0);mix();
+    assert(!s_mix_buffer[0] && s_sgx_fifo.underflows==u && s_sgx_fifo.last_consumed_ticket==zero_ticket);
+#ifdef _WIN32
+    if(s_flow_count) {
+        const AudioFlowRecord* c=&s_flow_records[s_flow_count-1];
+        assert(c->kind==2 && c->sequence==16 && c->ticket==zero_ticket && c->slot==12 && c->ea==base+12*8192);
+        assert((c->flags&(AUDIO_FLOW_ZERO|AUDIO_FLOW_SGX_FIFO))==33 && !(c->flags&AUDIO_FLOW_FIFO_UNDERFLOW));
+        assert(c->producer_qpc && c->generation==s_sgx_fifo.generation);
+    }
+#endif
+    u64 same_seq=submit(4,16,.125f);mix();assert(s_sgx_fifo.last_consumed_ticket==same_seq && s_mix_buffer[0]==.125f);
+    submit(5,UINT64_MAX,.25f);mix();assert(s_mix_buffer[0]==.25f);
+    mix();assert(s_sgx_fifo.underflows==u+1 && !s_mix_buffer[0]);
+    puts("FIFO order/cap4/explicit oldest discard/legitimate zero/repeated guest sequence/underflow PASS");
+
+    cookie=cellAudio_sgx_fifo_begin(base,base+6*8192,6);assert(cookie);fill(0,6,.5f);
+    u64 generation=s_sgx_fifo.generation;assert(cellAudioPortStop(0)==CELL_OK);
+    assert(cellAudioPortStart(0)==CELL_OK && s_sgx_fifo.generation>generation && s_sgx_fifo.attached);
+    old=s_sgx_fifo.reject_oldgen;cellAudio_sgx_fifo_complete(cookie,base,base+6*8192,6,17);
+    assert(s_sgx_fifo.reject_oldgen==old+1 && !s_sgx_fifo.count);mix();assert(!s_mix_buffer[0]);
+    submit(7,1,.375f);mix();assert(s_mix_buffer[0]==.375f);
+    cookie=cellAudio_sgx_fifo_begin(base,base+8*8192,8);assert(cookie);
+    assert(cellAudioPortClose(0)==CELL_OK);base=open_port(2,16,0);
+    old=s_sgx_fifo.reject_oldgen;cellAudio_sgx_fifo_complete(cookie,base,base+8*8192,8,2);
+    assert(s_sgx_fifo.reject_oldgen==old+1 && !s_sgx_fifo.attached);
+    fill(0,0,.5f);mix();assert(s_mix_buffer[0]==.5f && !ld_be_f32(s_ports[0].buffer));
+    assert(cellAudioPortClose(0)==CELL_OK);base=open_port(8,16,0);
+    puts("stop/start old-generation rejection and close/reuse default ring PASS");
+
+#ifdef _WIN32
+    /* Force both the real mixer and before hook to contend on the permanent
+     * lock. Either order must finish the old clear before begin returns. */
+    RaceBegin race={CreateEventW(NULL,TRUE,FALSE,NULL),base,0};
+    HANDLE mr=CreateEventW(NULL,TRUE,FALSE,NULL);assert(race.ready && mr);
+    audio_sgx_lock();
+    HANDLE mt=CreateThread(NULL,0,race_mix,mr,0,NULL);
+    HANDLE bt=CreateThread(NULL,0,race_begin,&race,0,NULL);assert(mt && bt);
+    assert(WaitForSingleObject(mr,1000)==WAIT_OBJECT_0 && WaitForSingleObject(race.ready,1000)==WAIT_OBJECT_0);
+    audio_sgx_unlock();
+    assert(WaitForSingleObject(mt,1000)==WAIT_OBJECT_0 && WaitForSingleObject(bt,1000)==WAIT_OBJECT_0);
+    CloseHandle(mt);CloseHandle(bt);CloseHandle(mr);CloseHandle(race.ready);
+    assert(ld_be_f32(s_ports[0].buffer)==.625f);
+    cellAudio_sgx_fifo_complete(race.cookie,base,base,0,5);mix();assert(s_mix_buffer[0]==.625f);
+#endif
+    u32 second=open_port(2,16,1);assert(!cellAudio_sgx_fifo_begin(second,second,0));
+    fill(1,0,.125f);submit(11,6,.25f);mix();assert(s_mix_buffer[0]==.375f);
+    assert(!ld_be_f32(s_ports[1].buffer) && s_ports[1].read_index==1);
+    puts("first-claim concurrency and unrelated port preservation PASS");
+
+    cookie=cellAudio_sgx_fifo_begin(base,base+9*8192,9);assert(cookie);
+    u64 bad=s_sgx_fifo.reject_contract;cellAudio_sgx_fifo_complete(cookie,base,base+10*8192,10,7);
+    assert(s_sgx_fifo.reject_contract==bad+1 && !s_sgx_fifo.count);
+    cookie=cellAudio_sgx_fifo_begin(base,base+9*8192,9);assert(cookie);
+    assert(cellAudioQuit()==CELL_OK);
+#ifdef _WIN32
+    VirtualFree(vm_base,0,MEM_RELEASE);
+#else
+    munmap(vm_base,VM_TOTAL_SIZE);
+#endif
+    vm_base=NULL;old=s_sgx_fifo.reject_oldgen;
+    cellAudio_sgx_fifo_complete(cookie,base,base+9*8192,9,7);
+    assert(s_sgx_fifo.reject_oldgen==old+1 && !cellAudio_sgx_fifo_begin(base,base,0));
+    puts("bad completion and late completion after Quit/VM release PASS");
+    return 0;
+}
diff --git a/libs/video/rsx_gpu_aa.h b/libs/video/rsx_gpu_aa.h
new file mode 100644
index 0000000..0872592
--- /dev/null
+++ b/libs/video/rsx_gpu_aa.h
@@ -0,0 +1,31 @@
+/* Spatial, edge-directed AA for the completed display image. No temporal
+ * history or extra frame queue. Low-contrast pixels are preserved exactly. */
+#ifndef RSX_GPU_AA_H
+#define RSX_GPU_AA_H
+static const char rsx_gpu_aa_hlsl[] =
+    "cbuffer C : register(b0) { float4 r; };\n"
+    "Texture2D t0 : register(t0); SamplerState s0 : register(s0);\n"
+    "struct V { float4 p : SV_Position; float2 uv : TEXCOORD0; };\n"
+    "V vs(uint id : SV_VertexID) { V o; float2 q=float2((id<<1)&2,id&2);\n"
+    " o.p=float4(q*float2(2,-2)+float2(-1,1),0,1);\n"
+    " o.uv=r.xy+(r.zw-r.xy)*q; return o; }\n"
+    "float luma(float3 c) { return dot(c,float3(0.299,0.587,0.114)); }\n"
+    "float4 tap(float2 uv,float2 px) { return t0.SampleLevel(s0,\n"
+    " clamp(uv,r.xy+px*0.5,r.zw-px*0.5),0); }\n"
+    "float4 ps(V i) : SV_Target {\n"
+    " uint w,h; t0.GetDimensions(w,h); float2 px=1.0/float2(w,h);\n"
+    " float4 c=tap(i.uv,px); float m=luma(c.rgb);\n"
+    " float nw=luma(tap(i.uv+px*float2(-1,-1),px).rgb);\n"
+    " float ne=luma(tap(i.uv+px*float2(1,-1),px).rgb);\n"
+    " float sw=luma(tap(i.uv+px*float2(-1,1),px).rgb);\n"
+    " float se=luma(tap(i.uv+px*float2(1,1),px).rgb);\n"
+    " float lo=min(m,min(min(nw,ne),min(sw,se)));\n"
+    " float hi=max(m,max(max(nw,ne),max(sw,se)));\n"
+    " if(hi-lo<max(0.03125,hi*0.125)) return c;\n"
+    " float2 d=float2(sw+se-nw-ne,nw+sw-ne-se);\n"
+    " float reduce=max((nw+ne+sw+se)*0.03125,0.0078125);\n"
+    " d=clamp(d/(min(abs(d.x),abs(d.y))+reduce),-8.0,8.0)*px;\n"
+    " float3 a=0.5*(tap(i.uv-d/6.0,px).rgb+tap(i.uv+d/6.0,px).rgb);\n"
+    " float3 b=a*0.5+0.25*(tap(i.uv-d*0.5,px).rgb+tap(i.uv+d*0.5,px).rgb);\n"
+    " float lb=luma(b); return float4((lb<lo||lb>hi)?a:b,c.a); }\n";
+#endif
