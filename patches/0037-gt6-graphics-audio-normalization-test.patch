+
+/* Optional bounded exit captures. AFTER_MS is measured from the first selected
+ * LV2/run event, not process launch. Existing files are never replaced. */
+static void spu_lifted_trace_dump(const spu_context* ctx, unsigned run, uint64_t now)
+{
+    const char* dir = getenv("SPU_TRACE_DUMP");
+    if (!dir || !*dir) return;
+    const char* after_s = getenv("SPU_TRACE_DUMP_AFTER_MS");
+    if (after_s && now < strtoull(after_s, NULL, 0)) return;
+    const char* limit_s = getenv("SPU_TRACE_DUMP_LIMIT");
+    unsigned limit = limit_s ? (unsigned)strtoul(limit_s, NULL, 0) : 4u;
+    if (limit > 16u) limit = 16u;
+    static unsigned captures;
+    const unsigned n = __atomic_add_fetch(&captures, 1, __ATOMIC_RELAXED);
+    if (n > limit) return;
+    char path[1024];
+    for (unsigned part = 0; part < 3; ++part) {
+        const char* suffix = part == 0 ? "ls.bin" : part == 1 ? "gpr_be.bin" : "meta.txt";
+        const int len = snprintf(path, sizeof path, "%s/trace_%08X_%06u_%s",
+                                  dir, ctx->spu_id, run, suffix);
+        if (len < 0 || (size_t)len >= sizeof path) return;
+        FILE* f = fopen(path, part == 2 ? "wx" : "wbx");
+        if (!f) {
+            fprintf(stderr, "[SPU-TRACE] cannot create exit dump: %s\n", path);
+            continue;
+        }
+        size_t written = 0;
+        const size_t expected = part == 0 ? SPU_LS_SIZE : 128u * 16u;
+        if (part == 0) written = fwrite(ctx->ls, 1, SPU_LS_SIZE, f);
+        else if (part == 1) {
+            for (unsigned reg = 0; reg < 128; ++reg)
+                for (unsigned lane = 0; lane < 4; ++lane) {
+                    const uint32_t w = ctx->gpr[reg]._u32[lane];
+                    const uint8_t be[4] = { (uint8_t)(w >> 24), (uint8_t)(w >> 16),
+                                            (uint8_t)(w >> 8), (uint8_t)w };
+                    written += fwrite(be, 1, sizeof be, f);
+                }
+        } else {
+            fprintf(f, "run=%u ms=%llu tid=0x%X group=0x%X status=0x%X code=0x%X "
+                    "pc=0x%05X image=%d lr=0x%05X sp=0x%05X depth=%u drain=0x%05X\n",
+                    run, (unsigned long long)now, ctx->spu_id, ctx->spu_group_id,
+                    ctx->status, ctx->stop_code, ctx->pc, ctx->image_id,
+                    ctx->gpr[0]._u32[0], ctx->gpr[1]._u32[0], ctx->host_depth,
+                    ctx->drain_ret_pc);
+            for (unsigned slot = 0; slot < SPU_RESIDENT_CODE_SLOTS; ++slot)
+                if (ctx->resident_code[slot].image_id)
