+static u64 audio_flow_hash(const void* memory, u32 size, u32* flags)
+{
+    const u8* p = (const u8*)memory;
+    u64 h = 14695981039346656037ull;
+    u32 nonzero = 0;
+    for (u32 i = 0; i < size; ++i) { h = (h ^ p[i]) * 1099511628211ull; nonzero |= p[i]; }
+    if (!nonzero) { *flags |= AUDIO_FLOW_ZERO; return 0; }
+    return h;
