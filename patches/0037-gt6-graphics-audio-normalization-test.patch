+/* Diagnostic for local-store writes that bypass DMA residency invalidation.
+ * SPU_RESIDENT_RECHECK=1 compares verified bytes before even a cached rejoin;
+ * optional SPU_RESIDENT_RECHECK_TID selects a guest SPU id. Once rejected,
+ * leave the span interpreted until a later code write or GET marks it pending. */
+static int spu_overlay_recheck_lookup(spu_context* ctx, uint32_t lsa, spu_lifted_fn* out)
+{
+    static SRWLOCK lock = SRWLOCK_INIT;
+    static uint32_t tid;
+    if (__atomic_load_n(&s_overlay_recheck, __ATOMIC_ACQUIRE) < 0) {
+        AcquireSRWLockExclusive(&lock);
+        if (__atomic_load_n(&s_overlay_recheck, __ATOMIC_RELAXED) < 0) {
+            const char* e = getenv("SPU_RESIDENT_RECHECK");
+            const char* t = getenv("SPU_RESIDENT_RECHECK_TID");
+            if (t) tid = (uint32_t)strtoul(t, NULL, 0);
+            __atomic_store_n(&s_overlay_recheck, e && !strcmp(e, "1") ? 1 : 0, __ATOMIC_RELEASE);
+        }
+        ReleaseSRWLockExclusive(&lock);
+    }
+    if (!__atomic_load_n(&s_overlay_recheck, __ATOMIC_ACQUIRE) || (tid && tid != ctx->spu_id)) return 0;
+    for (unsigned s = 0; s < ctx->resident_code_count; ++s) {
+        if (!ctx->resident_code[s].image_id || !ctx->resident_code[s].verify_state ||
+            lsa < ctx->resident_code[s].lsa || lsa - ctx->resident_code[s].lsa >= ctx->resident_code[s].size)
+            continue;
+        const int was_verified = ctx->resident_code[s].verify_state == SPU_OVERLAY_VERIFIED;
+        if (was_verified) ctx->resident_code[s].verify_state = SPU_OVERLAY_PENDING;
+        if (!spu_overlay_resident_verified(ctx, s)) {
+            if (was_verified) {
+                spu_dcache_residency_changed(ctx);
+                static unsigned reports;
+                if (__atomic_add_fetch(&reports, 1, __ATOMIC_RELAXED) <= 16)
+                    fprintf(stderr, "[spu-resident-recheck] spu=0x%X pc=0x%05X slot=%u image=%d "
+                                    "ls=0x%05X size=0x%X changed after verification; interpreting\n",
+                            ctx->spu_id, lsa, s, ctx->resident_code[s].image_id,
+                            ctx->resident_code[s].lsa, ctx->resident_code[s].size);
+            }
+            *out = NULL;
+        } else *out = spu_lookup_memoized(lsa, ctx->resident_code[s].image_id);
+        return 1;
+    }
+    return 0;
+}
+
+/* Reuse an existing owner before a lower-index hole, otherwise repeated loads
+ * of one span could create duplicate owners. Keep a high-water count so the
+ * larger capacity costs nothing in the common one/two-span resolver scans. */
+static unsigned spu_overlay_resident_slot(spu_context* ctx, uint32_t lsa, int image_id)
+{
+    unsigned free_slot = SPU_RESIDENT_CODE_SLOTS;
+    for (unsigned slot = 0; slot < ctx->resident_code_count; ++slot) {
+        if (ctx->resident_code[slot].image_id) {
+            if (ctx->resident_code[slot].lsa == lsa) return slot;
+        } else if (free_slot == SPU_RESIDENT_CODE_SLOTS) free_slot = slot;
+    }
+    if (free_slot < SPU_RESIDENT_CODE_SLOTS) return free_slot;
+    if (ctx->resident_code_count < SPU_RESIDENT_CODE_SLOTS) return ctx->resident_code_count++;
+    if (!ctx->resident_code_overflow) {
+        ctx->resident_code_overflow = 1;
+        spu_dcache_residency_changed(ctx);
+        fprintf(stderr, "[spu-ovl] no free resident code span for image %d at LS 0x%05X; "
+                        "unowned PCs will stay interpreted until context reset\n", image_id, lsa);
+    }
+    return SPU_RESIDENT_CODE_SLOTS;
+}
