+{ (void)c; (void)a; (void)b; (void)d; abort(); }
+uint32_t g_spu_image_src_ea, g_spu_image_ls_start, g_spu_image_span;
diff --git a/runtime/spu/tests/test_spu_resident_store.c b/runtime/spu/tests/test_spu_resident_store.c
new file mode 100644
index 0000000..c6b6fe3
--- /dev/null
+++ b/runtime/spu/tests/test_spu_resident_store.c
@@ -0,0 +1,160 @@
+/* Real runtime regression: synthetic LS writes, no game files or services.
+ * Run with SPU_RESIDENT_RECHECK unset so dispatch cannot hide a missing store
+ * invalidation. The registered primary entry deliberately represents stale
+ * code at the same address. */
+#include "../spu_helpers.h"
+#include "../spu_interp.h"
+#include "../spu_overlay_residency.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+extern void spu_begin_image(int);
+extern void spu_register_function(uint32_t, void (*)(spu_context*));
+extern int spu_run_with_halt(void (*)(spu_context*), spu_context*);
+extern void spu_halt(spu_context*);
+extern void spu_wrch(spu_context*, uint32_t, u128);
+extern void spu_overlay_note_get(spu_context*, uint32_t, const uint8_t*, uint32_t);
+extern void spu_overlay_register_region(uint32_t, uint32_t, int);
+static spu_context ctx;
+static const uint8_t code[32] = {
+    0x04,0x00,0x2F,0x83, 0x04,0x00,0x2F,0x84, 0x04,0x00,0x2F,0x85, 0x04,0x00,0x2F,0x86,
+    0x04,0x00,0x2F,0x87, 0x04,0x00,0x2F,0x88, 0x04,0x00,0x2F,0x89, 0x04,0x00,0x2F,0x8A
+};
+static void native(spu_context* c) { c->gpr[3]._u32[0] = 1; }
+static void stale(spu_context* c) { (void)c; abort(); }
+static void finish(spu_context* c) { c->status = SPU_STATUS_STOPPED_BY_STOP; spu_halt(c); }
+static int watched(uint32_t lsa)
+{
+    unsigned page = lsa >> SPU_CODE_PAGE_SHIFT;
+    return !!(ctx.resident_code_pages[page >> 6] & (UINT64_C(1) << (page & 63)));
+}
+static u128 quad(const uint8_t* p)
+{
+    u128 q;
+    for (unsigned i = 0; i < 4; ++i)
+        q._u32[i] = ((uint32_t)p[i*4] << 24) | ((uint32_t)p[i*4+1] << 16) |
+                    ((uint32_t)p[i*4+2] << 8) | p[i*4+3];
+    return q;
+}
+static void load(unsigned index, uint32_t base, uint32_t body, uint32_t span, uint32_t bytes)
+{
+    memcpy(ctx.ls + body, code, bytes);
+    spu_overlay_note_get(&ctx, 0x100000 + index * 0x1000, ctx.ls + base, span);
+    assert(spu_lifted_lookup(&ctx, body) == native);
+}
+static void register_code(unsigned index, uint32_t base, uint32_t body, uint32_t span, uint32_t bytes)
+{
+    spu_begin_image(700 + (int)index); spu_register_function(body, native);
+    spu_begin_image(900); spu_register_function(body, stale);
+    const spu_overlay_code_segment seg = {body, bytes, code};
+    assert(spu_overlay_register_verified_region(0x100000 + index * 0x1000,
+        base, span, 700 + (int)index, &seg, 1));
+}
+int main(void)
+{
+    assert(!getenv("SPU_RESIDENT_RECHECK"));
+    register_code(0, 0xC800, 0xC810, 0x100, 32);
+    register_code(1, 0xC900, 0xC910, 0x100, 16); /* shares the first owner's page */
+    register_code(2, 0x10000, 0x10010, 0x100, 16);
+    register_code(3, 0x103F0, 0x103F8, 0x20, 16); /* crosses a page boundary */
+    spu_begin_image(710); spu_register_function(0x20000, native);
+    spu_begin_image(900); spu_register_function(0x20000, stale); spu_register_function(0x240, finish);
+    spu_begin_image(0);
+    spu_overlay_register_region(0x200000, 0x100, 710);
+    spu_context_init(&ctx, 0x2005); ctx.image_id = 900;
+    load(0, 0xC800, 0xC810, 0x100, 32);
+    load(1, 0xC900, 0xC910, 0x100, 16);
+    assert(watched(0xC800));
+    u128 zero = {{0}};
+    uint32_t gen = ctx.dcache_residency;
+    spu_ls_write128(&ctx, 0xC880, zero); /* data in a code page is not code */
+    spu_ls_write32(&ctx, 0x30000, 0);
+    assert(ctx.dcache_residency == gen);
+    spu_ls_write128(&ctx, 0xC810, zero);
+    assert(ctx.dcache_residency == gen + 1 && ctx.resident_code[0].verify_state == 1);
+    assert(watched(0xC800)); /* the second owner must still be protected */
+    spu_ls_write128(&ctx, 0xC820, zero);
+    assert(ctx.dcache_residency == gen + 1); /* pending copies do not invalidate again */
+    assert(spu_lifted_lookup(&ctx, 0xC810) == NULL); /* warmed positive cache cannot win */
+    assert(ctx.resident_code[0].verify_state == 3 && watched(0xC800));
+    assert(spu_lifted_lookup(&ctx, 0xC910) == native);
+    spu_ls_write128(&ctx, 0xC810, quad(code));
+    assert(ctx.resident_code[0].verify_state == 1);
+    assert(spu_lifted_lookup(&ctx, 0xC810) == NULL); /* incomplete restore */
+    spu_ls_write128(&ctx, 0xC820, quad(code + 16));
+    assert(spu_lifted_lookup(&ctx, 0xC810) == native); /* no DMA required */
+
+    load(2, 0x10000, 0x10010, 0x100, 16);
+    gen = ctx.dcache_residency;
+    spu_ls_write32(&ctx, 0x10010, 0);
+    assert(!watched(0x10010) && ctx.dcache_residency == gen + 1);
+    spu_ls_write32(&ctx, 0x10010, 0);
+    assert(ctx.dcache_residency == gen + 1);
+    assert(spu_lifted_lookup(&ctx, 0x10010) == NULL && watched(0x10010));
+    spu_ls_write32(&ctx, 0x10010, 0x04002F83);
+    assert(spu_lifted_lookup(&ctx, 0x10010) == native);
+
+    load(3, 0x103F0, 0x103F8, 0x20, 16);
+    assert(watched(0x103F8) && watched(0x10400));
+    spu_ls_write32(&ctx, 0x103FF, 0);
+    assert(spu_lifted_lookup(&ctx, 0x103F8) == NULL);
+    spu_ls_write32(&ctx, 0x103FF, 0x8404002F);
+    assert(spu_lifted_lookup(&ctx, 0x103F8) == native);
+
+    spu_overlay_note_get(&ctx, 0x200000, ctx.ls + 0x20000, 0x100);
+    assert(spu_lifted_lookup(&ctx, 0x20000) == native && watched(0x20000));
+    spu_ls_write32(&ctx, 0x20000, 0);
+    assert(spu_lifted_lookup(&ctx, 0x20000) == NULL && !watched(0x20000));
+    spu_overlay_note_get(&ctx, 0x200000, ctx.ls + 0x20000, 0x100);
+    assert(spu_lifted_lookup(&ctx, 0x20000) == native);
+
+    /* Real interpreter STQD and the dispatcher's raw-memcpy microstep path. */
+    for (int micro = 0; micro < 2; ++micro) {
+        load(0, 0xC800, 0xC810, 0x100, 32);
+        ctx.gpr[1]._u32[0] = 0xC810; ctx.gpr[5] = zero;
+        spu_ls_write32(&ctx, 0x4000, 0x24000085); /* stqd r5,0(r1) */
+        spu_ls_write32(&ctx, 0x4004, micro ? 0x30004800 : 0x00000123);
+        ctx.pc = 0x4000; ctx.status = SPU_STATUS_RUNNING; ctx.policy_mode = 1;
+        if (micro) {
+            g_spu_ls_watch_n = g_spu_ls_probe = g_spu_smc_watch = g_spu_ls_wdiag = 0;
+            assert(spu_run_with_halt(spu_indirect_branch, &ctx));
+        } else spu_interp_run_until(&ctx, 0x4000, 0);
+        assert(spu_ls_read32(&ctx, 0xC810) == 0);
+        assert(ctx.resident_code[0].verify_state == 1);
+        assert(spu_lifted_lookup(&ctx, 0xC810) == NULL);
+    }
+    /* An invalid-source GETLLAR writes zeros without the normal DMA hook. */
+    load(0, 0xC800, 0xC810, 0x100, 32);
+    ctx.mfc_lsa = 0xC800; ctx.mfc_eal = 0;
+    u128 cmd = {{0}}; cmd._u32[0] = MFC_GETLLAR_CMD;
+    spu_wrch(&ctx, MFC_Cmd, cmd);
+    assert(spu_lifted_lookup(&ctx, 0xC810) == NULL);
+
+    /* Foreign DMA and reused holes must drop the old page bits. */
+    spu_overlay_note_get(&ctx, 0xDEAD000, ctx.ls + 0x20000, 0x100);
+    assert(!watched(0x20000));
+    spu_context_init(&ctx, 0x2005);
+    for (unsigned i = 0; i < SPU_CODE_PAGE_WORDS; ++i) assert(!ctx.resident_code_pages[i]);
+    puts("PASS: cached stale code rejected; LS restoration, pending disarm, shared pages, data false positives, cross-page words, legacy, interpreter/microstep/GETLLAR stores, DMA/reset");
+    return 0;
+}
+
+/* Fail if the disposable fixture leaves the local SPU runtime boundary. */
+void spu_thread_publish_ctx(uint32_t tid, void* c) { (void)tid; (void)c; abort(); }
+void ppu_resv_break_store(uint64_t ea) { (void)ea; abort(); }
+int ps3_mmapper_page_fault(uint32_t a, int w) { (void)a; (void)w; abort(); }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; abort(); }
+unsigned long long ps3_ms_now(void) { abort(); }
+uint32_t g_ww_lo = 0xFFFFFFFFu, g_ww_hi;
+int g_resv_store_active;
+uint32_t g_barrier_sync_watch;
+uint32_t g_ydkj_real_spurs_ea, g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
+void spurs_ef_set_from_spu(uint32_t ea, uint16_t bits) { (void)ea; (void)bits; abort(); }
+void ydkj_wake_all_event_flags(void) { abort(); }
+void spurs_pm_build_context(spu_context* c, uint32_t a, uint32_t b, uint32_t d)
+{ (void)c; (void)a; (void)b; (void)d; abort(); }
+uint32_t g_spu_image_src_ea, g_spu_image_ls_start, g_spu_image_span;
diff --git a/runtime/spu/tests/test_spu_restart_dispatch.c b/runtime/spu/tests/test_spu_restart_dispatch.c
new file mode 100644
index 0000000..41d272e
--- /dev/null
+++ b/runtime/spu/tests/test_spu_restart_dispatch.c
@@ -0,0 +1,119 @@
+/* Regression for a non-local SPU return that abandons nested host drains.
+ * Real dispatcher, interpreter, registry, and drain code run on synthetic LS
+ * bytes. No game, GPU, DMA, external process, or saved-data access is needed.
+ * The 0x52C8 continuation matches the GT6 failure's unlifted return boundary.
+ */
+#include "../spu_helpers.h"
+#include "../spu_interp.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+extern void spu_begin_image(int);
+extern void spu_register_function(uint32_t, void (*)(spu_context*));
+extern int spu_run_with_halt(void (*)(spu_context*), spu_context*);
+extern void spu_restart_dispatch(spu_context*);
+extern void spu_halt(spu_context*);
+static spu_context ctx;
+static int direct_restart;
+
+static void word(uint32_t pc, uint32_t w)
+{
+    ctx.ls[pc] = w >> 24; ctx.ls[pc + 1] = w >> 16;
+    ctx.ls[pc + 2] = w >> 8; ctx.ls[pc + 3] = w;
+}
+static void finish(spu_context* c)
+{
+    ++c->gpr[11]._u32[0];
+    c->status = SPU_STATUS_STOPPED_BY_STOP;
+    spu_halt(c);
+}
+static void nonlocal_return(spu_context* c)
+{
+    c->pc = 0x7000;
+    c->gpr[0] = spu_link(0x52C8);
+    /* A lifted callee returns to an unlifted point different from its
+     * caller's return PC. The real inner drain restarts from that guest PC. */
+}
+static void inner_call(spu_context* c)
+{
+    c->gpr[0] = spu_link(0x6104);
+    ++c->host_depth;
+    c->pc = 0x6500;
+    g_spu_trampoline_fn = nonlocal_return;
+    spu_drain_call(c, 0x6104);
+    --c->host_depth;
+    ++c->gpr[21]._u32[0]; /* abandoned host continuation must never run */
+}
+static void entry(spu_context* c)
+{
+    if (direct_restart) {
+        unsigned abandoned_irq_frame;
+        c->host_depth = 2;
+        c->drain_ret_pc = 0x52C8;
+        c->irq_frame = &abandoned_irq_frame;
+        c->pc = 0x7000;
+        spu_restart_dispatch(c);
+    } else {
+        c->gpr[0] = spu_link(0x52C8);
+        ++c->host_depth;
+        c->pc = 0x6000;
+        g_spu_trampoline_fn = inner_call;
+        spu_drain_call(c, 0x52C8);
+        --c->host_depth;
+    }
+    ++c->gpr[21]._u32[0];
+}
+int main(int argc, char** argv)
+{
+    assert(argc >= 2);
+    direct_restart = !strcmp(argv[1], "direct");
+    assert(direct_restart || !strcmp(argv[1], "nested"));
+    spu_context_init(&ctx, 0x2001);
+    ctx.image_id = 77;
+    ctx.status = SPU_STATUS_RUNNING;
+    ctx.gpr[95]._u32[0] = 0x12345678;
+    ctx.ls[0x33000] = 0xA5;
+    spu_begin_image(77);
+    spu_register_function(0x240, finish);
+    word(0x7000, 0x04000082); /* ori $2,$1,0: use the full interpreter */
+    word(0x7004, 0x300A5900); /* bra 0x52C8 */
+    word(0x52C8, 0x04002F83); /* ori $3,$95,0: actual GT6 continuation word */
+    word(0x52CC, 0x30004800); /* bra 0x240: lifted completion */
+    int halted = spu_run_with_halt(entry, &ctx);
+    printf("%s: halted=%d status=%X pc=%X depth=%u return_pc=%X finished=%u abandoned=%u irq=%s\n",
+           argv[1], halted, ctx.status, ctx.pc, ctx.host_depth, ctx.drain_ret_pc,
+           ctx.gpr[11]._u32[0], ctx.gpr[21]._u32[0], ctx.irq_frame ? "stale" : "clear");
+    fflush(stdout);
+    assert(ctx.gpr[21]._u32[0] == 0 && ctx.ls[0x33000] == 0xA5);
+    if (argc == 3 && !strcmp(argv[2], "expect-bug")) {
+        assert(!halted && ctx.status == SPU_STATUS_RUNNING && ctx.pc == 0x52C8);
+        assert(!ctx.host_depth && ctx.drain_ret_pc == 0x52C8 && !ctx.gpr[11]._u32[0]);
+        puts("REPRODUCED: stale return boundary silently ended the running SPU");
+    } else {
+        assert(halted && ctx.status == SPU_STATUS_STOPPED_BY_STOP);
+        assert(ctx.gpr[11]._u32[0] == 1 && ctx.gpr[3]._u32[0] == 0x12345678);
+        assert(!ctx.host_depth && !ctx.drain_ret_pc && !ctx.irq_frame);
+        puts("PASS: guest continuation completed; abandoned host state cleared");
+    }
+    return 0;
+}
+
+/* Link-only boundaries outside this CPU-only fixture: fail if reached. */
+void spu_thread_publish_ctx(uint32_t tid, void* c) { (void)tid; (void)c; abort(); }
+void ppu_resv_break_store(uint64_t ea) { (void)ea; abort(); }
+int ps3_mmapper_page_fault(uint32_t a, int writing) { (void)a; (void)writing; abort(); }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; abort(); }
+unsigned long long ps3_ms_now(void) { abort(); }
+uint32_t g_ww_lo = 0xFFFFFFFFu, g_ww_hi;
+int g_resv_store_active;
+uint32_t g_barrier_sync_watch;
+uint32_t g_ydkj_real_spurs_ea, g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
+void spurs_ef_set_from_spu(uint32_t ea, uint16_t bits) { (void)ea; (void)bits; abort(); }
+void ydkj_wake_all_event_flags(void) { abort(); }
+void spurs_pm_build_context(spu_context* c, uint32_t a, uint32_t b, uint32_t d)
+{ (void)c; (void)a; (void)b; (void)d; abort(); }
+uint32_t g_spu_image_src_ea, g_spu_image_ls_start, g_spu_image_span;
diff --git a/runtime/spu/tests/test_spu_unlifted_owner.c b/runtime/spu/tests/test_spu_unlifted_owner.c
new file mode 100644
index 0000000..e2728bc
--- /dev/null
+++ b/runtime/spu/tests/test_spu_unlifted_owner.c
@@ -0,0 +1,183 @@
+/* Synthetic SPU instructions + real residency, interpreter, and drain code.
+ * A verified opt-in manager may call an unknown high-LS module. No game bytes,
+ * DMA engine, host threads, external process, or guest memory are involved. */
+#include "../spu_helpers.h"
+#include "../spu_interp.h"
+#include "../spu_overlay_residency.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+extern void spu_begin_image(int);
+extern void spu_register_function(uint32_t, void (*)(spu_context*));
+extern void spu_overlay_register_region(uint32_t, uint32_t, int);
+extern void spu_overlay_note_get(spu_context*, uint32_t, const uint8_t*, uint32_t);
+extern int spu_run_with_halt(void (*)(spu_context*), spu_context*);
+extern void spu_halt(spu_context*);
+enum { MANAGER = 701, OTHER = 702, ENTRY = 0xA00, CALLBACK = 0xA40,
+       RETURN_PC = 0xA80, CHILD = 0x17400, SOURCE = 0x100000, SPAN = 0x100 };
+static spu_context ctx;
+static uint8_t reference[SPAN];
+static unsigned post_calls, host_continuations, callback_calls;
+static int invalidate_in_callback;
+
+static void word(uint32_t pc, uint32_t value)
+{
+    ctx.ls[pc] = value >> 24; ctx.ls[pc+1] = value >> 16;
+    ctx.ls[pc+2] = value >> 8; ctx.ls[pc+3] = value;
+}
+static uint32_t reference_word(unsigned offset)
+{
+    return (uint32_t)reference[offset] << 24 | (uint32_t)reference[offset+1] << 16 |
+           (uint32_t)reference[offset+2] << 8 | reference[offset+3];
+}
+static void post_job(spu_context* c)
+{
+    ++post_calls;
+    c->gpr[0] = spu_ls_read128(c, 0x400);
+    c->gpr[1] = spu_ls_read128(c, 0x410);
+    c->gpr[126] = spu_ls_read128(c, 0x420);
+    c->status = SPU_STATUS_STOPPED_BY_STOP;
+    c->stop_code = 0x102;
+    spu_halt(c);
+}
+static void native_callback(spu_context* c)
+{
+    ++callback_calls;
+    c->gpr[10] = spu_ai(c->gpr[10], 1);
+    if (invalidate_in_callback == 1)
+        spu_ls_write32(c, ENTRY + SPAN - 4, reference_word(SPAN - 4) ^ 1u);
+    else if (invalidate_in_callback == 2)
+        spu_overlay_note_get(c, SOURCE + 0x20000, c->ls + ENTRY, SPAN);
+    SPU_RET(c);
+}
+static void prepare_call(spu_context* c)
+{
+    spu_ls_write128(c, 0x400, c->gpr[0]);
+    spu_ls_write128(c, 0x410, c->gpr[1]);
+    spu_ls_write128(c, 0x420, c->gpr[126]);
+    c->gpr[1] = spu_ila(0x3C000);
+    c->gpr[126] = spu_ila(CHILD);
+    c->gpr[0] = spu_link(RETURN_PC);
+    c->pc = CHILD;
+}
+static void manager_call(spu_context* c)
+{
+    prepare_call(c);
+    ++c->host_depth;
+    /* Same order as generated PM2530: immediate dispatch precedes drain. */
+    spu_indirect_branch(c);
+    spu_drain_call(c, RETURN_PC);
+    --c->host_depth;
+    ++host_continuations;
+    post_job(c);
+}
+static void top_call(spu_context* c)
+{
+    prepare_call(c);
+    g_spu_trampoline_fn = spu_indirect_branch;
+}
+
+int main(int argc, char** argv)
+{
+    assert(argc == 2 && !getenv("SPU_INTERP_UNLIFTED") && !getenv("SPU_RESIDENT_RECHECK"));
+    const char* mode = argv[1];
+    const int callback = !strcmp(mode, "callback") || !strcmp(mode, "callback-store") ||
+                         !strcmp(mode, "callback-dma");
+    const int top = !strcmp(mode, "top");
+    const int accepted = !strcmp(mode, "direct") || !strcmp(mode, "restore") ||
+                         !strcmp(mode, "callback") || top;
+    for (unsigned i = 0; i < SPAN; ++i) reference[i] = (uint8_t)(i ^ 0x5A);
+    const spu_overlay_code_segment code[2] = {
+        { ENTRY, SPAN/2, reference }, { ENTRY + SPAN/2, SPAN/2, reference + SPAN/2 }
+    };
+    assert(spu_overlay_register_verified_region(SOURCE, ENTRY, SPAN, MANAGER, code, 2));
+    assert(spu_overlay_register_verified_region(SOURCE+0x10000, ENTRY, SPAN, OTHER, code, 2));
+    spu_overlay_register_region(SOURCE+0x30000, SPAN, MANAGER); /* same ID, no code proof */
+    spu_overlay_register_region(SOURCE+0x40000, SPAN, 703); /* legacy-only image */
+    assert(!spu_overlay_allow_unlifted_calls(0));
+    assert(!spu_overlay_allow_unlifted_calls(999));
+    assert(!spu_overlay_allow_unlifted_calls(703));
+    if (!strcmp(mode, "flag-off")) assert(spu_overlay_allow_unlifted_calls(OTHER));
+    else if (strcmp(mode, "default-off")) assert(spu_overlay_allow_unlifted_calls(MANAGER));
+    spu_begin_image(MANAGER);
+    spu_register_function(CALLBACK, native_callback);
+    spu_register_function(RETURN_PC, post_job);
+    spu_begin_image(0);
+
+    spu_context_init(&ctx, 0x2005);
+    ctx.image_id = 900;
+    ctx.status = SPU_STATUS_RUNNING;
+    ctx.gpr[0] = spu_ila(0x2220);
+    ctx.gpr[1] = spu_ila(0x3E000);
+    ctx.gpr[126] = spu_ila(0x12340);
+    memcpy(ctx.ls + ENTRY, reference, SPAN);
+    if (strcmp(mode, "id-only")) {
+        const uint32_t source = !strcmp(mode, "other-owner") ? SOURCE+0x10000 :
+                                !strcmp(mode, "legacy-owner") ? SOURCE+0x30000 : SOURCE;
+        spu_overlay_note_get(&ctx, source, ctx.ls + ENTRY, SPAN);
+    } else ctx.image_id = MANAGER;
+    if (!strcmp(mode, "mismatch")) ctx.ls[ENTRY + SPAN - 1] ^= 1;
+    if (!strcmp(mode, "stale-store") || !strcmp(mode, "restore")) {
+        assert(spu_lifted_lookup(&ctx, CALLBACK) == native_callback);
+        spu_ls_write32(&ctx, ENTRY+SPAN-4, reference_word(SPAN-4)^1u);
+        assert(spu_lifted_lookup(&ctx, CALLBACK) == NULL);
+        if (!strcmp(mode, "restore"))
+            spu_ls_write32(&ctx, ENTRY+SPAN-4, reference_word(SPAN-4));
+    }
+    if (!strcmp(mode, "foreign-dma")) {
+        assert(spu_lifted_lookup(&ctx, CALLBACK) == native_callback);
+        spu_overlay_note_get(&ctx, SOURCE+0x20000, ctx.ls+ENTRY, SPAN);
+    }
+    if (!strcmp(mode, "source-mismatch")) ++ctx.resident_code[0].source_ea;
+    if (!strcmp(mode, "callback-store")) invalidate_in_callback = 1;
+    if (!strcmp(mode, "callback-dma")) invalidate_in_callback = 2;
+
+    if (callback) {
+        word(CHILD,   0x04000004); /* ori $4,$0,0: save the manager return */
+        word(CHILD+4, 0x31000000u | ((CALLBACK >> 2) << 7)); /* brasl $0,callback */
+        word(CHILD+8, 0x04000200); /* ori $0,$4,0: restore manager return */
+        word(CHILD+12,0x1C00450A); /* ai $10,$10,1 */
+        word(CHILD+16,0x35000000); /* bi $0 */
+    } else {
+        word(CHILD,   0x04000082); /* ori $2,$1,0 */
+        word(CHILD+4, 0x1C00450A); /* ai $10,$10,1 */
+        word(CHILD+8, 0x35000000); /* bi $0 */
+    }
+    const int halted = spu_run_with_halt(top ? top_call : manager_call, &ctx);
+    assert(halted == 1);
+    if (accepted) {
+        assert(post_calls == 1 && ctx.status == SPU_STATUS_STOPPED_BY_STOP && ctx.stop_code == 0x102);
+        assert(ctx.gpr[0]._u32[0] == 0x2220 && ctx.gpr[1]._u32[0] == 0x3E000 &&
+               ctx.gpr[126]._u32[0] == 0x12340 && ctx.host_depth == 0);
+        assert(ctx.gpr[10]._u32[0] == (callback ? 2u : 1u));
+        assert(callback_calls == (callback ? 1u : 0u));
+        assert(host_continuations == (callback || top ? 0u : 1u));
+    } else {
+        assert(post_calls == 0 && host_continuations == 0);
+        assert(ctx.status == SPU_STATUS_RUNNING && ctx.stop_code == 0);
+        assert(ctx.gpr[10]._u32[0] == (callback ? 1u : 0u));
+        assert(ctx.pc == CHILD + (callback ? 8u : 0u));
+    }
+    printf("PASS %s: interpreted=%u native_callback=%u post=%u host_cont=%u depth=%u\n",
+           mode, ctx.gpr[10]._u32[0], callback_calls, post_calls, host_continuations, ctx.host_depth);
+    return 0;
+}
