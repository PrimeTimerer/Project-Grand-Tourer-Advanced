+{
+    const char* dir = getenv("SPU_FAULT_DUMP");
+    if (!dir || !*dir) return;
+    static unsigned captures;
+    const unsigned n = __atomic_add_fetch(&captures, 1, __ATOMIC_RELAXED);
+    if (n > 16) return;
+    char path[1024];
+    for (int part = 0; part < 2; ++part) {
+        int len = snprintf(path, sizeof path, "%s/spu_%08X_%02u_%s.bin",
+                           dir, ctx->spu_id, n, part ? "gpr_be" : "ls");
+        if (len < 0 || (size_t)len >= sizeof path) {
+            fprintf(stderr, "[SPU] fault dump path is too long\n");
+            return;
+        }
+        FILE* f = fopen(path, "wbx");
+        if (!f) {
+            fprintf(stderr, "[SPU] cannot create fault dump (existing file or unavailable directory): %s\n", path);
+            continue;
+        }
+        size_t written = 0;
+        const size_t expected = part ? 128u * 16u : SPU_LS_SIZE;
+        if (!part) written = fwrite(ctx->ls, 1, SPU_LS_SIZE, f);
+        else for (unsigned reg = 0; reg < 128; ++reg)
