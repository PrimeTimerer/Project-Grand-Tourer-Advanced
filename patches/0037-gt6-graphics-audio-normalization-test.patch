+    SimResult overshoot=simulate(cfg);
+    printf("20s +1.5ms waits: blocks=%llu queue=%d min_gap=%.4fms\n",overshoot.count,overshoot.final_padding,overshoot.min_gap/10000.0);
+    assert(overshoot.count>=3745 && overshoot.count<=3751 && !overshoot.short_gaps && !overshoot.rebases);
