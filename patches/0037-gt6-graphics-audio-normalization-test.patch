+     * not filter the same completed image twice. A new write generation gets
+     * a fresh feedback snapshot below, including after a disabled interval. */
+    static u64 last_generation[MAX_SURFACES], last_serial[MAX_SURFACES];
+    if (!ld_gpu_aa_on()) return;
+    surface_t* s = &g.surfaces[slot];
+    if (!s->tex || !s->w || !s->h) return;
+    if (last_serial[slot] == s->resource_serial && last_generation[slot] == s->last_write_generation) return;
+    u32 w = s->w, h = s->h;
+    if (buffer_id < 8 && g.display_buffers[buffer_id].valid) {
+        const display_buffer_t* d = &g.display_buffers[buffer_id];
+        if (d->width < w) w = d->width;
