+/* Real residency/dispatch regression on synthetic local stores. No guest,
+ * DMA, files, or external services are reached. Link with the SPU runtime. */
+#include "../spu_helpers.h"
+#include "../spu_interp.h"
+#include "../spu_overlay_residency.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+extern void spu_begin_image(int);
+extern void spu_register_function(uint32_t, void (*)(spu_context*));
+extern int spu_run_with_halt(void (*)(spu_context*), spu_context*);
+extern void spu_halt(spu_context*);
+extern void spu_overlay_note_get(spu_context*, uint32_t, const uint8_t*, uint32_t);
+extern int spu_overlay_register_verified_subregion(uint32_t, uint32_t, uint32_t,
+    uint32_t, int, const spu_overlay_code_segment*, unsigned);
+static spu_context ctx;
+static void current_code(spu_context* c)
+{
+    c->gpr[3]._u32[0] = 1;
+    c->status = SPU_STATUS_STOPPED_BY_STOP;
+    spu_halt(c);
+}
+static void stale_code(spu_context* c) { c->gpr[3]._u32[0] = 2; }
+static const uint8_t code[] = {0x04, 0x00, 0x2F, 0x83};
+static uint32_t base(unsigned i) { return 0x10000u + i * 0x400u; }
+static uint32_t source(unsigned i) { return 0x200000u + i * 0x400u; }
+static void load(unsigned i)
+{
+    memcpy(ctx.ls + base(i), code, sizeof code);
+    spu_overlay_note_get(&ctx, source(i), ctx.ls + base(i), 0x100);
+}
+int main(void)
+{
+    assert(SPU_RESIDENT_CODE_SLOTS >= 5);
+    const unsigned extra = SPU_RESIDENT_CODE_SLOTS;
+    spu_context_init(&ctx, 0x2005);
+    ctx.image_id = 900;
+    for (unsigned i = 0; i <= extra; ++i) {
+        spu_begin_image(700 + (int)i); spu_register_function(base(i), current_code);
+        spu_begin_image(900); spu_register_function(base(i), stale_code);
+        const spu_overlay_code_segment seg = {base(i), sizeof code, code};
+        assert(spu_overlay_register_verified_region(source(i), base(i), 0x100,
+                                                     700 + (int)i, &seg, 1));
+    }
+    spu_begin_image(0);
+    for (unsigned i = 0; i < extra; ++i) {
+        load(i);
+        assert(ctx.resident_code_count == i + 1);
+        for (unsigned j = 0; j <= i; ++j)
+            assert(spu_lifted_lookup(&ctx, base(j)) == current_code);
+    }
+    assert(!ctx.resident_code_overflow);
+    /* Prime the stale primary cache entry before capacity is exhausted. */
+    assert(spu_lifted_lookup(&ctx, base(extra)) == stale_code);
+    load(extra);
+    assert(ctx.resident_code_overflow && ctx.resident_code_count == extra);
+    assert(spu_lifted_lookup(&ctx, base(extra)) == NULL);
+    assert(spu_lifted_lookup(&ctx, base(extra - 1)) == current_code);
+    /* Exercise the dispatcher too: legacy image-2 fallback must not bypass
+     * the refused lookup. Then verify an interpreted branch rejoins a known
+     * resident function through the top-level trampoline. */
+    spu_begin_image(1); spu_register_function(base(extra), stale_code); spu_begin_image(0);
+    ctx.image_id = 2; ctx.policy_mode = 1;
+    ctx.gpr[95]._u32[0] = 0x12345678;
+    spu_ls_write32(&ctx, base(extra) + 4, 0x00000123);
+    ctx.pc = base(extra); ctx.status = SPU_STATUS_RUNNING;
+    spu_run_with_halt(spu_indirect_branch, &ctx);
+    assert(ctx.gpr[3]._u32[0] == 0x12345678 && ctx.stop_code == 0x123);
+    ctx.image_id = 900; ctx.policy_mode = 0;
+    memcpy(ctx.ls + 0x20000, code, sizeof code);
+    spu_ls_write32(&ctx, 0x20004, 0x00000124);
+    ctx.pc = 0x20000; ctx.status = SPU_STATUS_RUNNING;
+    spu_run_with_halt(spu_indirect_branch, &ctx);
+    assert(ctx.gpr[3]._u32[0] == 0x12345678 && ctx.stop_code == 0x124);
+    spu_ls_write32(&ctx, base(extra) + 4, 0x30000000u | ((base(0) >> 2) << 7));
+    ctx.pc = base(extra); ctx.status = SPU_STATUS_RUNNING;
+    assert(spu_run_with_halt(spu_indirect_branch, &ctx));
+    assert(ctx.gpr[3]._u32[0] == 1 && ctx.status == SPU_STATUS_STOPPED_BY_STOP);
+
+    /* Verification is still authoritative in slots beyond the old four. */
+    ctx.ls[base(extra - 1)] ^= 0xFF;
+    spu_overlay_note_get(&ctx, source(extra - 1) + 0x80,
+                         ctx.ls + base(extra - 1) + 0x80, 16);
+    assert(spu_lifted_lookup(&ctx, base(extra - 1)) == NULL);
+    load(extra - 1);
+    assert(spu_lifted_lookup(&ctx, base(extra - 1)) == current_code);
+
+    /* A hole before an existing owner must not duplicate that owner's span. */
+    spu_overlay_note_get(&ctx, 0x900000, ctx.ls + base(0), 16);
+    assert(!ctx.resident_code[0].image_id);
+    assert(spu_lifted_lookup(&ctx, base(0)) == NULL);
+    load(extra - 1);
+    assert(!ctx.resident_code[0].image_id);
+    assert(ctx.resident_code[extra - 1].image_id == 700 + (int)extra - 1);
+    load(extra);
+    assert(ctx.resident_code[0].image_id == 700 + (int)extra);
+    assert(ctx.resident_code_count == extra && ctx.resident_code_overflow);
+    assert(spu_lifted_lookup(&ctx, base(extra)) == current_code);
+    assert(spu_lifted_lookup(&ctx, base(0)) == NULL);
+
+    spu_context_init(&ctx, 0x2005);
+    ctx.image_id = 900;
+    assert(!ctx.resident_code_count && !ctx.resident_code_overflow);
+    assert(spu_lifted_lookup(&ctx, base(extra)) == stale_code);
+
+    /* The alternate subregion registration path uses the same slot allocator. */
+    const uint32_t load_ea = 0xA00000, load_lsa = 0x8000, sub_lsa = 0x8100;
+    const spu_overlay_code_segment sub = {sub_lsa, sizeof code, code};
+    spu_begin_image(950); spu_register_function(sub_lsa, current_code); spu_begin_image(0);
+    assert(spu_overlay_register_verified_subregion(load_ea, load_lsa, sub_lsa,
+                                                   0x100, 950, &sub, 1));
+    memcpy(ctx.ls + sub_lsa, code, sizeof code);
+    spu_overlay_note_get(&ctx, load_ea, ctx.ls + load_lsa, 0x400);
+    assert(ctx.resident_code_count == 1 && ctx.resident_code[0].image_id == 950);
+    assert(spu_lifted_lookup(&ctx, sub_lsa) == current_code);
+    printf("PASS: %u independent verified spans, overflow cache invalidation, "
+           "no stale fallback, hole reuse, reset, subregion\n", extra);
+    return 0;
+}
+
+/* Link-only boundaries outside this CPU-only fixture: fail if reached. */
+void spu_thread_publish_ctx(uint32_t tid, void* c) { (void)tid; (void)c; abort(); }
+void ppu_resv_break_store(uint64_t ea) { (void)ea; abort(); }
+int ps3_mmapper_page_fault(uint32_t a, int writing) { (void)a; (void)writing; abort(); }
+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; abort(); }
+unsigned long long ps3_ms_now(void) { abort(); }
+uint32_t g_ww_lo = 0xFFFFFFFFu, g_ww_hi;
+int g_resv_store_active;
+uint32_t g_barrier_sync_watch;
+uint32_t g_ydkj_real_spurs_ea, g_ydkj_real_taskset_ea, g_ydkj_real_taskid;
+void spurs_ef_set_from_spu(uint32_t ea, uint16_t bits) { (void)ea; (void)bits; abort(); }
+void ydkj_wake_all_event_flags(void) { abort(); }
