+/* Recover the owner after a genuine SPU copy/restore of a complete module.
+ * A header only chooses candidates; it never authorizes a native function.
+ * All code bytes must match, including code outside the queried basic block.
+ * This also records an authoritative owner for a PC with no compiled entry,
+ * so an unrelated primary image cannot fill that gap. */
+static int spu_overlay_copy_owner(spu_context* ctx, uint32_t lsa, spu_lifted_fn* out)
+{
+    *out = NULL;
+    if (!spu_overlay_copy_page(lsa)) return 0;
+    const unsigned page = lsa >> 10;
+    const int n = __atomic_load_n(&s_ovl_src_count, __ATOMIC_ACQUIRE);
+    for (unsigned w = 0; w < (SPU_OVL_SRC_MAX + 63u) / 64u; ++w) {
+        uint64_t bits = __atomic_load_n(&s_ovl_copy_pages[page][w], __ATOMIC_ACQUIRE);
+        while (bits) {
+            const unsigned i = w * 64u + (unsigned)__builtin_ctzll(bits);
+            bits &= bits - 1u;
+            if (i >= (unsigned)n) continue;
+            const spu_ovl_src* o = &s_ovl_src[i];
+            const uint32_t start = o->load_lsa + o->sub_off;
+            if (!o->copy_enabled || lsa < start || lsa - start >= o->span ||
+                memcmp(ctx->ls + o->load_lsa, o->copy_sig, 16)) continue;
+            int match = 1;
+            for (unsigned c = 0; match && c < o->code_count; ++c)
+                match = !memcmp(ctx->ls + o->code[c].lsa, o->code[c].bytes, o->code[c].size);
+            if (!match) continue;
+
+            /* A larger copied module can replace several smaller old owners.
+             * Remove all overlaps before installing its single verified span. */
+            for (unsigned s = 0; s < ctx->resident_code_count; ++s)
+                if (ctx->resident_code[s].image_id && start < ctx->resident_code[s].lsa + ctx->resident_code[s].size &&
+                    start + o->span > ctx->resident_code[s].lsa)
+                    ctx->resident_code[s].image_id = 0;
+            const unsigned slot = spu_overlay_resident_slot(ctx, start, o->image_id);
+            if (slot == SPU_RESIDENT_CODE_SLOTS) return 1;
+            ctx->resident_code[slot].lsa = start;
+            ctx->resident_code[slot].size = o->span;
+            ctx->resident_code[slot].source_ea = o->src_ea + o->sub_off;
+            ctx->resident_code[slot].image_id = o->image_id;
+            ctx->resident_code[slot].verify_state = SPU_OVERLAY_VERIFIED;
+            ctx->resident_code[slot].source_index = (int)i;
+            spu_dcache_residency_changed(ctx);
+            *out = (spu_lifted_fn)spu_lookup_memoized(lsa, o->image_id);
+            static unsigned reports;
+            if (__atomic_add_fetch(&reports, 1, __ATOMIC_RELAXED) <= 16)
+                fprintf(stderr, "[spu-copy-code] spu=0x%X pc=0x%05X image=%d LS=0x%05X+0x%X exact code verified\n",
+                        ctx->spu_id, lsa, o->image_id, start, o->span);
+            return 1;
+        }
+    }
+    return 0;
+}
