+                            slot, ctx->resident_code[slot].image_id,
+                            ctx->resident_code[slot].lsa, ctx->resident_code[slot].size,
+                            ctx->resident_code[slot].source_ea, ctx->resident_code[slot].verify_state);
+        }
+        const int failed = ferror(f);
+        const int closed = fclose(f);
+        fprintf(stderr, "[SPU-TRACE] exit dump %s: %s\n",
+                !failed && !closed && (part == 2 || written == expected) ? "saved" : "incomplete", path);
+    }
+}
+
+/* Explicit, bounded fault evidence. The directory must already exist. Each
+ * local store is raw guest bytes; the companion register file is 128 x 16
+ * bytes in guest big-endian lane order. Exclusive creation preserves earlier
+ * captures if a later process is given the same directory. */
