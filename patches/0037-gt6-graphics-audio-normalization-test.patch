+/* Explicit per-TID run-boundary diagnostics; shared clock with the SPU runner.
+ * No group lifecycle or guest-visible result is changed by these records. */
+extern int spu_lifted_trace_tid(uint32_t tid);
+extern uint64_t spu_lifted_trace_ms(void);
+static void spu_trace_thread(const char* event, const spu_thread_t* t,
+                              const ppu_context* ppu, uint32_t detail)
+{
+    if (!t || !spu_lifted_trace_tid(t->tid)) return;
+    const spu_group_t* g = spu_find_group(t->group_id);
+#ifdef _WIN32
+    /* finish_event is manual-reset, so a zero-time status query cannot consume
+     * completion. Distinguish running=0 before SetEvent from host termination. */
+    const DWORD event_wait = t->finish_event ? WaitForSingleObject(t->finish_event, 0) : (DWORD)-2;
+    const DWORD host_wait = t->host_thread ? WaitForSingleObject(t->host_thread, 0) : (DWORD)-2;
+#else
+    const uint32_t event_wait = 0xFFFFFFFEu, host_wait = 0xFFFFFFFEu;
+#endif
+    fprintf(stderr, "[SPU-TRACE] %s ms=%llu tid=0x%X group=0x%X "
+            "group_state=%d cause=%u group_status=%d running=%d exit=%d "
+            "host=0x%llX finish=0x%llX event_wait=0x%X host_wait=0x%X "
+            "detail=0x%X ppu_pc=0x%08X ppu_lr=0x%08X\n",
+            event, (unsigned long long)spu_lifted_trace_ms(), t->tid, t->group_id,
+            g ? g->state : -1, g ? g->cause : 0, g ? g->exit_status : 0,
+            t->running, t->exit_status, (unsigned long long)(uintptr_t)t->host_thread,
+#ifdef _WIN32
+            (unsigned long long)(uintptr_t)t->finish_event,
+#else
+            (unsigned long long)(uintptr_t)&t->finish_event,
+#endif
+            (unsigned)event_wait, (unsigned)host_wait, detail,
+            ppu ? (uint32_t)ppu->cia : 0, ppu ? (uint32_t)ppu->lr : 0);
+    fflush(stderr);
+}
+
+static void spu_trace_group(const char* event, const spu_group_t* g,
+                             const ppu_context* ppu, uint32_t detail)
+{
+    if (!g || !getenv("SPU_TRACE_TID")) return;
+    for (unsigned i = 0; i < g->num_threads && i < 8u; ++i) {
+        const unsigned idx = g->thread_indices[i];
+        if (idx < MAX_SPU_THREADS && s_spu_threads[idx].in_use)
+            spu_trace_thread(event, &s_spu_threads[idx], ppu, detail);
+    }
+}
