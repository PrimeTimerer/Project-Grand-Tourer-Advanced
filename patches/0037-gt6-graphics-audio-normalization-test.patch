diff --git a/runtime/spu/tests/test_spu_ls_copy.c b/runtime/spu/tests/test_spu_ls_copy.c
new file mode 100644
index 0000000..d327ab7
--- /dev/null
+++ b/runtime/spu/tests/test_spu_ls_copy.c
@@ -0,0 +1,118 @@
+/* Real resolver regression using synthetic bytes only. No game or host I/O.
+ * An SPU store can replace an overlay without a source-EA DMA notification.
+ * Run both with the default dispatch cache and SPU_DISPATCH_CACHE=0. */
+#include "../spu_helpers.h"
+#include "../spu_interp.h"
+#include "../spu_overlay_residency.h"
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+extern void spu_begin_image(int);
+extern void spu_register_function(uint32_t, void (*)(spu_context*));
+extern void spu_overlay_note_get(spu_context*, uint32_t, const uint8_t*, uint32_t);
+static spu_context ctx;
+static uint8_t old_code[32], new_code[96], no_copy_code[32];
+static const uint8_t old_sig[16] = {1,2,3,4};
+static const uint8_t new_sig[16] = {5,6,7,8};
+static const uint8_t no_copy_sig[16] = {9,10,11,12};
+static void old_fn(spu_context* c) { c->gpr[3]._u32[0] = 701; }
+static void new_fn(spu_context* c) { c->gpr[3]._u32[0] = 702; }
+static void stale_primary(spu_context* c) { (void)c; abort(); }
+
+static void copy_ls(uint32_t lsa, const uint8_t* bytes, uint32_t size)
+{
+    assert(!(size & 15));
+    for (uint32_t i = 0; i < size; i += 16) {
+        u128 q;
+        for (unsigned j = 0; j < 4; ++j) {
+            const uint8_t* p = bytes + i + j * 4;
+            q._u32[j] = (uint32_t)p[0]<<24 | (uint32_t)p[1]<<16 |
+                        (uint32_t)p[2]<<8 | p[3];
+        }
+        spu_ls_write128(&ctx, lsa + i, q);
+    }
+}
+
+static void copy_new(void)
+{
+    copy_ls(0x10000, new_sig, sizeof new_sig);
+    copy_ls(0x10010, new_code, sizeof new_code);
+}
+
+int main(void)
+{
+    assert(!getenv("SPU_RESIDENT_RECHECK"));
+    memset(old_code, 0x41, sizeof old_code);
+    memset(new_code, 0x52, sizeof new_code);
+    memset(no_copy_code, 0x63, sizeof no_copy_code);
+    spu_begin_image(701); spu_register_function(0x10024, old_fn);
+    spu_begin_image(702); spu_register_function(0x10020, new_fn);
+    spu_begin_image(703); spu_register_function(0x20010, new_fn);
+    spu_begin_image(900); spu_register_function(0x10024, stale_primary);
+    spu_begin_image(0);
+    const spu_overlay_code_segment old = {0x10010, sizeof old_code, old_code};
+    const spu_overlay_code_segment replacement = {0x10010, sizeof new_code, new_code};
+    const spu_overlay_code_segment opt_out = {0x20010, sizeof no_copy_code, no_copy_code};
+    assert(spu_overlay_register_verified_region(0x100000, 0x10000, 0x30, 701, &old, 1));
+    assert(spu_overlay_register_verified_region(0x110000, 0x10000, 0x70, 702, &replacement, 1));
+    assert(spu_overlay_register_verified_region(0x120000, 0x20000, 0x30, 703, &opt_out, 1));
+    assert(spu_overlay_allow_ls_copy(701, old_sig));
+    assert(spu_overlay_allow_ls_copy(702, new_sig));
+    assert(!spu_overlay_allow_ls_copy(999, new_sig));
+    assert(!spu_overlay_allow_ls_copy(702, NULL));
+
+    spu_context_init(&ctx, 0x2005); ctx.image_id = 900;
+    copy_ls(0x10000, old_sig, sizeof old_sig);
+    copy_ls(0x10010, old_code, sizeof old_code);
+    spu_overlay_note_get(&ctx, 0x100000, ctx.ls + 0x10000, 0x30);
+    assert(spu_lifted_lookup(&ctx, 0x10024) == old_fn); /* positive cache */
+    assert(spu_lifted_lookup(&ctx, 0x10020) == NULL);
+    copy_new();
+    assert(spu_lifted_lookup(&ctx, 0x10020) == new_fn);
+    assert(spu_lifted_lookup(&ctx, 0x10024) == NULL); /* authoritative gap */
+
+    /* Changing one byte beyond the queried block invalidates the whole code.
+     * A matching header alone cannot authorize a native function. */
+    spu_ls_write32(&ctx, 0x10060, 0x52525253);
+    assert(spu_lifted_lookup(&ctx, 0x10020) == NULL);
+    spu_ls_write32(&ctx, 0x10060, 0x52525252);
+    assert(spu_lifted_lookup(&ctx, 0x10020) == new_fn);
+
+    /* No old owner: neither a miss nor an unrelated primary hit can be
+     * cached on candidate pages before the first copy arrives. */
+    spu_context_init(&ctx, 0x2005); ctx.image_id = 900;
+    assert(spu_lifted_lookup(&ctx, 0x10020) == NULL);
+    assert(spu_lifted_lookup(&ctx, 0x10024) == stale_primary);
+    copy_new();
+    assert(spu_lifted_lookup(&ctx, 0x10024) == NULL);
+    assert(spu_lifted_lookup(&ctx, 0x10020) == new_fn);
+
+    /* SDK registrations that did not opt in still require their source EA. */
+    copy_ls(0x20000, no_copy_sig, sizeof no_copy_sig);
+    copy_ls(0x20010, no_copy_code, sizeof no_copy_code);
+    assert(spu_lifted_lookup(&ctx, 0x20010) == NULL);
+    spu_overlay_note_get(&ctx, 0x120000, ctx.ls + 0x20000, 0x30);
+    assert(spu_lifted_lookup(&ctx, 0x20010) == new_fn);
+    puts("PASS: LS-copy exact identity, stale positive/negative cache, authoritative gaps, restoration and source-EA opt-out");
+    return 0;
+}
+
+/* Any escape from this disposable local fixture is a failure. */
+void spu_thread_publish_ctx(uint32_t tid, void* c) { (void)tid; (void)c; abort(); }
