+static int audio_flow_env(const char* name, u32 fallback, u32 max, u32* value)
+{
+    const char* e = getenv(name);
+    if (!e) { *value = fallback; return 1; }
+    char* end;
+    const unsigned long n = strtoul(e, &end, 0);
+    if (end == e || *end || n > max) return 0;
