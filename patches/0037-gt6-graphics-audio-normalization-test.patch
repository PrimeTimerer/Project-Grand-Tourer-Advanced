+                uint32_t w = ctx->gpr[reg]._u32[lane];
+                const uint8_t be[4] = { (uint8_t)(w >> 24), (uint8_t)(w >> 16),
+                                        (uint8_t)(w >> 8), (uint8_t)w };
+                written += fwrite(be, 1, sizeof be, f);
+            }
+        const int closed = fclose(f);
+        fprintf(stderr, "[SPU] fault dump %s: %s (%zu/%zu bytes)\n",
+                written == expected && !closed ? "saved" : "incomplete", path, written, expected);
+    }
+}
