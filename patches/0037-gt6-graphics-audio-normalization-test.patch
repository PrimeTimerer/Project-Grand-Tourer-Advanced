+                __atomic_store_n(&g_spu_native_capture_state, 0, __ATOMIC_RELEASE);
+            return;
+        }
+        if (first_hit)
+            fprintf(stderr, "[spu-native-capture] rejected first-hit image=%d pc=0x%05X: "
+                            "resident source identity, entry coverage or full code proof did not match\n",
+                    s_nc_entry[i].image, ctx->pc);
+    }
+}
