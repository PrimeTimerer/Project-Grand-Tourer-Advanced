+int spu_overlay_allow_ls_copy(int image_id, const uint8_t content_sig[16])
+{
+    if (image_id <= 0 || !content_sig) return 0;
+    int enabled = 0;
+    const int n = __atomic_load_n(&s_ovl_src_count, __ATOMIC_ACQUIRE);
+    for (int i = 0; i < n; ++i) {
+        spu_ovl_src* o = &s_ovl_src[i];
+        if (o->image_id != image_id || !o->code || !o->code_count ||
+            o->load_lsa > SPU_LS_SIZE - 16u) continue;
+        memcpy(o->copy_sig, content_sig, 16);
+        o->copy_enabled = 1;
+        const uint32_t start = o->load_lsa + o->sub_off;
+        const unsigned first = start >> 10, last = (start + o->span - 1u) >> 10;
+        for (unsigned p = first; p <= last; ++p)
+            __atomic_fetch_or(&s_ovl_copy_pages[p][(unsigned)i >> 6],
+                              UINT64_C(1) << ((unsigned)i & 63u), __ATOMIC_RELEASE);
+        enabled = 1;
+    }
+    return enabled;
+}
