+                exact_code = !memcmp(ctx->ls + o->code[c].lsa, o->code[c].bytes, o->code[c].size);
+                if (o->code[c].size >= 4 && ctx->pc >= o->code[c].lsa &&
+                    ctx->pc - o->code[c].lsa <= o->code[c].size - 4) entry_covered = 1;
+            }
+            if (!exact_code || !entry_covered) continue;
+            int expected = 0;
+            if (!__atomic_compare_exchange_n(&s_nc_entry[i].claimed, &expected, 1, 0,
+                                             __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return;
