+    assert(smaller_queue.rebases==1 && smaller_queue.final_debt<10000 && smaller_queue.final_padding>=700 && !smaller_queue.short_gaps);
+    HANDLE timer=CreateWaitableTimerExW(NULL,NULL,2,TIMER_MODIFY_STATE|SYNCHRONIZE);
