+/* [GT6 0183] (on by default; LD_REC_THREAD=0 = off; A/B "rec"): the D3D12 calls of the drawing thread are made by a
+ * thread of their own.
+ *
+ * In the 16-car start (trace ft3, 2026-11-28) the frame's last wait ends 17.6 ms in and the drawing thread then
+ * works alone for 6 ms more; in half the heavy frames the game's render thread waits 8.5 ms for it as well. About
+ * 4.7 ms of its 15.4 ms of work there is in the driver (ph0 sample: the descriptor-table copies, the draw state, the
+ * present). With this switch the drawing thread makes no command-list call, no descriptor write and no submit: each
+ * becomes a record in a ring (rsx_live_rec.inc, generated by tools/gen_ld_rec.py), and the thread gt6-draw-rec makes
+ * the calls in the same order on the same list. Nothing else moves: what is drawn, every guest-memory read and every
+ * decision stay where they were. The drawing thread still waits for the GPU through the fence (ld_flush), which the
+ * recording thread signals only after it has made every earlier call, so every resource lives as long as before.
+ * A caller that must use the list itself (the menu overlay, a back-buffer resize) first waits until the ring is
+ * empty (ld_rec_sync). While a movie is shown the host's thread draws, so the records are off then. */
+static void ld_dump_dred(const char* where, HRESULT trigger_hr);
+#define LDR_RING_BYTES (64u << 20)
+typedef struct { u32 size, op; } ldr_hdr;     /* size: the record's bytes, header included, a multiple of 16 */
+static u8* g_ldr_ring;
+static volatile u64 g_ldr_wpos;               /* published by the drawing thread */
+static volatile u64 g_ldr_rpos;               /* done by the recording thread */
+static u64 g_ldr_wlocal, g_ldr_wpub;          /* the drawing thread's own */
+static u32 g_ldr_cur;                         /* size of the record being made */
+static volatile LONG g_ldr_sleeping;
+static HANDLE g_ldr_event, g_ldr_thread;
+static volatile int g_ld_rec_on;              /* records are made; changed only by the drawing thread, the ring empty */
+static volatile LONG g_ldr_failures;
+static u32 g_ldr_bbi;                         /* the back buffer the next present draws into, while records are on */
+static volatile LONG g_ldr_bbi_bad;           /* the recording thread found the swap chain elsewhere: look again */
+static int g_ldr_movie;                       /* a movie is shown (rsx_live_draw_set_video_active): records off */
+static u32 g_ldr_movie_end;                   /* ... and for 60 frames after it */
+static unsigned long long g_ldr_n_records, g_ldr_n_bytes, g_ldr_n_waits, g_ldr_n_syncs, g_ldr_n_presents;
+
+static void ldr_publish(void)
+{
+    if (g_ldr_wlocal == g_ldr_wpub) return;
+    g_ldr_wpub = g_ldr_wlocal;
+    __atomic_store_n(&g_ldr_wpos, g_ldr_wlocal, __ATOMIC_SEQ_CST);
+    if (__atomic_load_n(&g_ldr_sleeping, __ATOMIC_SEQ_CST)) SetEvent(g_ldr_event);
+}
+static void ldr_space(u32 need)
+{
+    if (g_ldr_wlocal + need - __atomic_load_n(&g_ldr_rpos, __ATOMIC_ACQUIRE) <= LDR_RING_BYTES) return;
+    ldr_publish();
+    g_ldr_n_waits++;
+    while (g_ldr_wlocal + need - __atomic_load_n(&g_ldr_rpos, __ATOMIC_ACQUIRE) > LDR_RING_BYTES) SwitchToThread();
+}
+static void* ldr_begin(u32 op, u32 bytes)
+{
+    const u32 size = (u32)((sizeof(ldr_hdr) + bytes + 15u) & ~15u);
+    u32 off = (u32)(g_ldr_wlocal % LDR_RING_BYTES);
+    if (off + size > LDR_RING_BYTES) {           /* the record goes to the ring's start: the end is padded */
+        const u32 pad = LDR_RING_BYTES - off;
+        ldr_space(pad + size);
+        ldr_hdr* ph = (ldr_hdr*)(g_ldr_ring + off);
+        ph->size = pad; ph->op = 0u;
+        g_ldr_wlocal += pad; off = 0;
+    } else
+        ldr_space(size);
+    ldr_hdr* h = (ldr_hdr*)(g_ldr_ring + off);
+    h->size = size; h->op = op;
+    g_ldr_cur = size;
+    return h + 1;
+}
+static void ldr_end(int publish_now)
+{
+    g_ldr_wlocal += g_ldr_cur;
+    g_ldr_n_records++; g_ldr_n_bytes += g_ldr_cur;
+    if (publish_now || g_ldr_wlocal - g_ldr_wpub >= 4096u) ldr_publish();
+}
+static void ldr_failed(const char* what, HRESULT hr)          /* the recording thread */
+{
+    if (InterlockedIncrement(&g_ldr_failures) <= 8)
+        fprintf(stderr, "[d3d-fail] %s hr=0x%08lX (made by the recording thread, LD_REC_THREAD)\n", what, (unsigned long)hr);
+    ld_dump_dred(what, hr);
+    g.ready = 0;
+}
+static void ldr_special(u32 op, const void* body);
+#include "rsx_live_rec.inc"
+typedef struct { UINT sync, flags; u32 expect; u32 pad_; } ldr_present_rec;
+typedef struct { ID3D12Resource* dst; ID3D12Resource* src; rsx_present_copy_plan plan; } ldr_present_copy_rec;
+static void ldr_special(u32 op, const void* body)
+{
+    if (op == LDR_PRESENT) {
+        const ldr_present_rec* a = (const ldr_present_rec*)body;
+        const HRESULT hr = g.swap->lpVtbl->Present(g.swap, a->sync, a->flags);
+        if (FAILED(hr)) ldr_failed("Present", hr);
+        else if (g.swap->lpVtbl->GetCurrentBackBufferIndex(g.swap) != a->expect) InterlockedExchange(&g_ldr_bbi_bad, 1);
+    } else if (op == LDR_PRESENT_COPY) {
+        const ldr_present_copy_rec* a = (const ldr_present_copy_rec*)body;
+        rsx_present_record_copy(g.list, a->dst, a->src, a->plan);
+    }
+}
+static DWORD WINAPI ldr_thread(LPVOID unused)
+{
+    (void)unused;
+    u64 r = 0;
+    for (;;) {
+        u64 w = __atomic_load_n(&g_ldr_wpos, __ATOMIC_ACQUIRE);
+        if (r == w) {
+            for (u32 k = 0; k < 4000u && r == w; k++) { YieldProcessor(); w = __atomic_load_n(&g_ldr_wpos, __ATOMIC_ACQUIRE); }
+            if (r == w) {
+                __atomic_store_n(&g_ldr_sleeping, 1, __ATOMIC_SEQ_CST);
+                w = __atomic_load_n(&g_ldr_wpos, __ATOMIC_SEQ_CST);
+                if (r == w) WaitForSingleObject(g_ldr_event, INFINITE);
+                __atomic_store_n(&g_ldr_sleeping, 0, __ATOMIC_SEQ_CST);
+                continue;
+            }
+        }
+        while (r != w) {
+            const ldr_hdr* h = (const ldr_hdr*)(g_ldr_ring + (u32)(r % LDR_RING_BYTES));
+            if (h->op) ldr_exec_call(h->op, h + 1);
+            r += h->size;
+        }
+        __atomic_store_n(&g_ldr_rpos, r, __ATOMIC_RELEASE);
+    }
+    return 0;
+}
+/* every record made so far has been made into a call (records off: nothing to wait for) */
+static void ld_rec_sync(void)
+{
+    if (!g_ld_rec_on) return;
+    ldr_publish();
+    g_ldr_n_syncs++;
+    while (__atomic_load_n(&g_ldr_rpos, __ATOMIC_ACQUIRE) != g_ldr_wlocal) SwitchToThread();
+}
+/* the back buffer the present draws into */
+static u32 ld_bbi(void) { return g_ld_rec_on ? g_ldr_bbi : g.swap->lpVtbl->GetCurrentBackBufferIndex(g.swap); }
+static HRESULT ld_present_call(UINT sync, UINT flags)
+{
+    if (!g_ld_rec_on) return g.swap->lpVtbl->Present(g.swap, sync, flags);
+    g_ldr_bbi = (g_ldr_bbi + 1u) % LD_SWAP_BUFFERS;
+    ldr_present_rec* a = (ldr_present_rec*)ldr_begin(LDR_PRESENT, (u32)sizeof(ldr_present_rec));
+    a->sync = sync; a->flags = flags; a->expect = g_ldr_bbi; a->pad_ = 0;
+    ldr_end(1);
+    g_ldr_n_presents++;
+    return S_OK;
+}
+static void ld_present_copy_call(ID3D12Resource* dst, ID3D12Resource* src, rsx_present_copy_plan plan)
+{
+    if (!g_ld_rec_on) { rsx_present_record_copy(g.list, dst, src, plan); return; }
+    ldr_present_copy_rec* a = (ldr_present_copy_rec*)ldr_begin(LDR_PRESENT_COPY, (u32)sizeof(ldr_present_copy_rec));
+    a->dst = dst; a->src = src; a->plan = plan;
+    ldr_end(0);
+}
+/* once a frame, on the drawing thread: records on or off as the switch says (a sync when they go off) */
+static void ldr_note(const char* what)
+{
+    static LONG n;
+    const LONG k = InterlockedIncrement(&n);
+    if (k <= 16) fprintf(stderr, "[ld-rec] %s, frame %u%s\n", what, g_ld_frames, k == 16 ? " (further changes not shown)" : "");
+}
+static void ld_rec_update(void)
+{
+    static int env = -1;   /* on by default since [GT6 0183]; LD_REC_THREAD=0 = the drawing thread makes its calls itself */
+    if (env < 0) { const char* e = getenv("LD_REC_THREAD"); env = (e && *e == '0') ? 0 : 1; }
+    if (g_ld_rec_on && g_ldr_bbi_bad) {
+        ld_rec_sync();
+        g_ldr_bbi = g.swap->lpVtbl->GetCurrentBackBufferIndex(g.swap);
+        InterlockedExchange(&g_ldr_bbi_bad, 0);
+    }
+    { static LONGLONG t0, f;
+      LARGE_INTEGER now; QueryPerformanceCounter(&now);
+      if (!f) { LARGE_INTEGER q; QueryPerformanceFrequency(&q); f = q.QuadPart; t0 = now.QuadPart; }
+      if (now.QuadPart - t0 >= 5 * f) {
+          if (g_ldr_n_records)
+              fprintf(stderr, "[ld-rec] last 5 s: %llu records (%.1f MB), %llu presents, %llu syncs, %llu waits for ring space, "
+                      "%ld failures\n", g_ldr_n_records, (double)g_ldr_n_bytes / 1048576.0, g_ldr_n_presents, g_ldr_n_syncs,
+                      g_ldr_n_waits, (long)g_ldr_failures);
+          g_ldr_n_records = g_ldr_n_bytes = g_ldr_n_presents = g_ldr_n_syncs = g_ldr_n_waits = 0;
+          t0 = now.QuadPart;
+      } }
+    static int broken;
+    const int may = !broken && ps3_ab_on(PS3_AB_LD_REC, env) && g.ready && !g_ldr_movie &&
+                    (u32)(g_ld_frames - g_ldr_movie_end) > 60u;
+    if (may == g_ld_rec_on) return;
+    if (g_ld_rec_on) { ld_rec_sync(); g_ld_rec_on = 0; ldr_note("records off"); return; }
+    if (!g_ldr_thread) {
+        g_ldr_ring = (u8*)VirtualAlloc(NULL, LDR_RING_BYTES, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
+        g_ldr_event = CreateEventW(NULL, FALSE, FALSE, NULL);
+        g_ldr_thread = g_ldr_ring && g_ldr_event ? CreateThread(NULL, 0, ldr_thread, NULL, 0, NULL) : NULL;
+        if (!g_ldr_thread) {
+            fprintf(stderr, "[ld-rec] the recording thread could not be made: records stay off\n");
+            broken = 1;
+            return;
+        }
+        SetThreadPriority(g_ldr_thread, THREAD_PRIORITY_ABOVE_NORMAL);
+        fprintf(stderr, "[ld-rec] the drawing thread's D3D12 calls go to a thread of their own (LD_REC_THREAD=0 = off)\n");
+    }
+    g_ldr_bbi = g.swap->lpVtbl->GetCurrentBackBufferIndex(g.swap);
+    g_ld_rec_on = 1;
+    ldr_note("records on");
+}
