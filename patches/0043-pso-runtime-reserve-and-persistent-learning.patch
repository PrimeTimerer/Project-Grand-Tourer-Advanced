diff --git a/libs/video/tests/test_pso_warmup.c b/libs/video/tests/test_pso_warmup.c
index 7760cbd..927be78 100644
--- a/libs/video/tests/test_pso_warmup.c
+++ b/libs/video/tests/test_pso_warmup.c
@@ -8,6 +8,12 @@
 #include <dxgi1_4.h>
 #include <d3dcompiler.h>
 #include <stddef.h>
+/* Exercise saturation with real PSOs without thousands of driver creations.
+ * Production defaults remain 16384 startup + 4096 demand slots. */
+#define LD_PW_STARTUP_LIMIT 4u
+#define LD_PW_RUNTIME_RESERVE 2u
+#define LD_PW_MAX_NEW_RECORDS 4u
+#define LD_PW_HASH 16u
 #include "../rsx_pso_warmup.h"
 
 static unsigned checks;
@@ -79,6 +85,92 @@ static void render(ID3D12Device* dev, ID3D12RootSignature* root, ID3D12PipelineS
     rb->lpVtbl->Release(rb); rt->lpVtbl->Release(rt); l->lpVtbl->Release(l); a->lpVtbl->Release(a); q->lpVtbl->Release(q);
 }
 
+static void check_capacity(ID3D12Device* dev, ID3D12RootSignature* root,
+    const D3D12_GRAPHICS_PIPELINE_STATE_DESC* base, const char* fixture_root,
+    const unsigned char expected[64])
+{
+    char directory[MAX_PATH];
+    snprintf(directory, sizeof(directory), "%s\\capacity", fixture_root);
+    check(CreateDirectoryA(directory, NULL), "new capacity fixture directory");
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC variants[8];
+    for (unsigned i = 0; i < 8; ++i) {
+        variants[i] = *base;
+        /* Valid distinct pipeline states; z is disabled, so these same draws
+         * still have the same expected pixels. Exact desc keys remain distinct. */
+        variants[i].RasterizerState.DepthBias = (INT)(i + 1);
+    }
+    ld_prepare_set_paused(1);
+    ld_pw_start(dev, NULL, root, root, directory);
+    for (unsigned i = 0; i < LD_PW_STARTUP_LIMIT; ++i)
+        ld_pw_remember(&variants[i], 0, 200u + i);
+    check(g_ld_pw.new_records == LD_PW_STARTUP_LIMIT, "seed recipes have independent bounded write quota");
+    ld_pw_stop();
+    ld_pw_start(dev, NULL, root, root, directory);
+    check(g_ld_pw.entry_count == LD_PW_STARTUP_LIMIT && !g_ld_pw.ready,
+          "full startup catalog does not consume runtime reserve or start paused driver jobs");
+    check(ld_pw_submit(&variants[4], 0, 204), "full startup table accepts first exact future PSO");
+    check(g_ld_pw.entry_count == LD_PW_STARTUP_LIMIT + 1 && g_ld_pw.runtime_submitted == 1,
+          "future pipeline occupies reserved runtime slot");
+    check(ld_pw_submit(&variants[4], 0, 204) && g_ld_pw.entry_count == LD_PW_STARTUP_LIMIT + 1,
+          "future duplicate does not consume reserve");
+    check(ld_pw_take_ex(&variants[4], 0, 0) == NULL, "reserved queued prediction stays nonblocking");
+    ID3D12PipelineState* pso = ld_pw_take(&variants[4], 0);
+    check(pso != NULL, "real use promotes exact reserved prediction while workers paused");
+    unsigned char got[64]; render(dev, root, pso, got);
+    check(!memcmp(got, expected, sizeof(got)), "reserved future PSO preserves rendered pixels");
+    pso->lpVtbl->Release(pso);
+    check(ld_pw_submit(&variants[5], 0, 205) && g_ld_pw.entry_count == LD_PW_LIMIT,
+          "last runtime slot is bounded and available");
+    check(!ld_pw_submit(&variants[6], 0, 206) && g_ld_pw.runtime_full == 1,
+          "resident overflow retains ordinary fallback");
+    check(ld_pw_take(&variants[6], 0) == NULL, "overflow does not publish a wrong pipeline");
+    ld_pw_remember(&variants[6], 0, 206);
+    check(g_ld_pw.new_records == 3, "full resident table still persists ordinary successful pipeline recipe");
+    ld_pw_remember(&variants[6], 0, 206);
+    check(g_ld_pw.new_records == 3, "repeated remember does not consume recipe quota");
+    ld_pw_remember(&variants[7], 0, 207);
+    check(g_ld_pw.new_records == LD_PW_MAX_NEW_RECORDS, "write quota is independent of resident occupancy");
+    ld_pw_remember(&variants[0], 0, 200);
+    check(g_ld_pw.new_records == LD_PW_MAX_NEW_RECORDS && g_ld_pw.record_quota_full == 1,
+          "independent write quota bounds more unique records");
+    ld_pw_stop();
+    check(!g_ld_pw.active && !g_ld_pw.queued_bytes && !g_ld_prepare_in_flight,
+          "saturated stop joins workers, drains writes and releases cancelled memory recipe");
+    ld_pw_start(dev, NULL, root, root, directory);
+    check(g_ld_pw.entry_count == LD_PW_STARTUP_LIMIT,
+          "restart retains unchanged startup work bound despite larger on-disk catalog");
+    ld_pw_stop();
+    /* Open the exact saved ordinary-fallback recipe in a new one-entry cache.
+     * Do not assume FindFirstFile order includes it in the bounded startup set. */
+    ld_pw_identity id; check(ld_pw_identity_make(&id, &variants[6], 0), "overflow recipe identity");
+    char saved[MAX_PATH], replay[MAX_PATH], replay_pipelines[MAX_PATH], copied[MAX_PATH];
+    snprintf(saved, sizeof(saved), "%s\\pipelines_v1\\%016llX.gpso", directory,
+             (unsigned long long)ld_pw_key(&id, &variants[6]));
+    snprintf(replay, sizeof(replay), "%s\\capacity_replay", fixture_root);
+    snprintf(replay_pipelines, sizeof(replay_pipelines), "%s\\pipelines_v1", replay);
+    check(CreateDirectoryA(replay, NULL) && CreateDirectoryA(replay_pipelines, NULL),
+          "new exact replay fixture directories");
+    snprintf(copied, sizeof(copied), "%s\\%016llX.gpso", replay_pipelines,
+             (unsigned long long)ld_pw_key(&id, &variants[6]));
+    check(CopyFileA(saved, copied, TRUE), "overflow recipe persisted atomically after saturated run");
+    ld_prepare_set_paused(0);
+    ld_pw_start(dev, NULL, root, root, replay);
+    check(g_ld_pw.entry_count == 1, "next run discovers the saved overflow recipe");
+    pso = ld_pw_take(&variants[6], 0);
+    check(pso != NULL, "saved overflow recipe loads with exact descriptor and DXBC");
+    render(dev, root, pso, got);
+    check(!memcmp(got, expected, sizeof(got)), "restarted overflow recipe preserves rendered pixels");
+    pso->lpVtbl->Release(pso);
+    /* Saturate only the fixture's write de-dup table. Its bounded probe must
+     * terminate without allocation or writing even if the quota has room. */
+    for (unsigned i = 0; i < LD_PW_HASH; ++i) g_ld_pw.recorded[i] = i + 1u;
+    const uint64_t skipped = g_ld_pw.skipped_records;
+    ld_pw_remember(&variants[7], 0, 207);
+    check(g_ld_pw.new_records == 0 && g_ld_pw.skipped_records == skipped + 1,
+          "full record hash remains bounded without overwriting an occupied slot");
+    ld_pw_stop();
+}
+
