+/* 2 = the job's blob is ready, 1 = queued or being compiled, 0 = failed or cancelled, -1 = no such job (or the
+ * queue does not run). Nothing waits and nothing is taken. */
+static int ld_scj_status(ld_scj_state* state, unsigned stage, const char* source, uint32_t length, uint64_t hash)
+{
+    if (!state || !source || !length) return -1;
+    int result = -1;
+    AcquireSRWLockShared(&state->lock);
+    if (state->state == LD_SCJ_RUNNING) {
+        const ld_scj_job* job = ld_scj_find_locked(state, stage, source, length, hash);
+        if (job) result = job->status == LD_SCJ_READY ? 2
+                        : (job->status == LD_SCJ_QUEUED || job->status == LD_SCJ_WORKING) ? 1 : 0;
+    }
+    ReleaseSRWLockShared(&state->lock);
+    return result;
+}
