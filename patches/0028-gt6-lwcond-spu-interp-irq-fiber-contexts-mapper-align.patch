+ * destroy, free_block and try_allocate_block. */
+#include <mutex>
+#include <condition_variable>
+namespace {
+struct MemPool { bool used; uint32_t chunk; uint64_t chunk_size, block_size; uint32_t* free_list; uint32_t nfree; };
+MemPool                 s_mp[256];
+std::mutex              s_mp_lock;
+std::condition_variable s_mp_cv;
+MemPool* mp_get(uint64_t id) { return (id >= 1 && id <= 256 && s_mp[id - 1].used) ? &s_mp[id - 1] : nullptr; }
