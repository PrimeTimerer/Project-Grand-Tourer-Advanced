+static void sys_mempool_create(ppu_context* ctx)
+{
+    const uint32_t  id_out     = (uint32_t)ctx->gpr[3];
+    const uint32_t  chunk      = (uint32_t)ctx->gpr[4];
+    const uint64_t  chunk_size = ctx->gpr[5], block_size = ctx->gpr[6];
+    uint64_t        alignment  = ctx->gpr[7];
+    if (alignment == 0 || alignment == 2) alignment = 4;
+    if (!block_size || block_size > chunk_size || (alignment & (alignment - 1)) || (chunk & 7)) {
+        ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)0x80010002u;   /* CELL_EINVAL */
+        return;
+    }
+    std::lock_guard<std::mutex> hold(s_mp_lock);
+    for (uint32_t i = 0; i < 256; i++) {
+        MemPool& p = s_mp[i];
+        if (p.used) continue;
+        const uint64_t n = chunk_size / block_size;
+        p.free_list = (uint32_t*)malloc((size_t)(n ? n : 1) * sizeof(uint32_t));
+        if (!p.free_list) break;
+        for (uint64_t k = 0; k < n; k++) p.free_list[k] = chunk + (uint32_t)(k * block_size);
+        p.nfree = (uint32_t)n; p.chunk = chunk; p.chunk_size = chunk_size; p.block_size = block_size; p.used = true;
+        if (id_out) vm_write32(id_out, i + 1);
+        fprintf(stderr, "[mempool] create id=%u chunk=0x%08X size=0x%llX block=0x%llX (%llu blocks)\n", i + 1, chunk,
+                (unsigned long long)chunk_size, (unsigned long long)block_size, (unsigned long long)n);
+        ctx->gpr[3] = 0;
+        return;
+    }
+    ctx->gpr[3] = (uint64_t)(int64_t)(int32_t)0x80010001u;       /* CELL_EAGAIN */
