+static void sys_mempool_destroy(ppu_context* ctx)
+{
+    std::lock_guard<std::mutex> hold(s_mp_lock);
+    if (MemPool* p = mp_get(ctx->gpr[3])) { free(p->free_list); p->free_list = nullptr; p->used = false; }
+    s_mp_cv.notify_all();
+    ctx->gpr[3] = 0;
+}
+static void sys_mempool_free_block(ppu_context* ctx)
+{
+    const uint32_t block = (uint32_t)ctx->gpr[4];
+    std::lock_guard<std::mutex> hold(s_mp_lock);
