+/* REAL waits (the default since the Gran Turismo 6 port; PS3_LWCOND_POLL=1 = the
+ * polling wait described above, where every wait returned CELL_OK within 1 ms).
+ *
+ * lv2 has no spurious wakeups: sys_lwcond_wait returns when THIS lwcond was
+ * signalled for THIS thread, or with ETIMEDOUT. Titles build on that. Gran
+ * Turismo 6's event object (0xAE27AC) is
+ *     if (signalled) { signalled = 0; return; }
+ *     waiting = 1; sys_lwcond_wait(cond, timeout); waiting = 0;
+ * with no predicate loop, and its signal side only calls sys_lwcond_signal when
+ * `waiting` is set. Under the polling wait every such wait "completed" at once:
+ * a file reader thread read through a stream pointer nobody had set yet, and a
+ * synchronous request on the caller's stack was torn down before the worker
+ * touched it (NULL vtable calls, endless recursion, stack overflow).
+ *
+ * One record per waiting thread (struct LwcWaiter, above), in arrival order,
+ * each with its own host condition variable. A waiter queues its record BEFORE
+ * it gives the guest lwmutex up, and a signaller takes that lwmutex first, so a
+ * signal cannot slip in between. A signalled waiter returns to the guest only
+ * once it has been handed the lwmutex (lwm_handoff). The vblank beat still
+ * nudges every waiter (ppu_lwcond_wake_all): a nudged waiter does not return to
+ * the guest, it runs the GCM pump -- guest vblank/flip handlers are delivered by
+ * whichever guest thread pumps, and a title whose threads all sit in real waits
+ * would otherwise never get them -- and goes back to waiting. */
+static struct LwcWaiter* s_lwc_head = nullptr;     /* guarded by s_lwc_lock */
+extern "C" void ppu_gcm_pump(void);                 /* cellGcmSys.c, or ppu_loader.cpp's absent stub */
+
+/* mode 0: the longest waiter, 1: every waiter, 2: the waiter that is thread `tid`.
+ * Returns how many records it selected. */
+static int lwc_signal(uint32_t lwcond, int mode, uint32_t tid)
+{
+    int n = 0;
+    AcquireSRWLockExclusive(&s_lwc_lock);
+    for (struct LwcWaiter* w = s_lwc_head; w; w = w->next) {
+        if (w->lwcond != lwcond || w->signalled) continue;
+        if (mode == 2 && w->tid != tid) continue;
+        w->signalled = 1; n++;
+        struct LwmSlot* sl = w->sl;
+        if (lwm_try(sl)) {                          /* the lwmutex is free: it is the waiter's */
+            w->granted = 1;
