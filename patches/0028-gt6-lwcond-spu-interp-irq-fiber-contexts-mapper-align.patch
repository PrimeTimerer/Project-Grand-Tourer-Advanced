diff --git a/libs/spurs/cellFiber.c b/libs/spurs/cellFiber.c
index 3673985..77fb063 100644
--- a/libs/spurs/cellFiber.c
+++ b/libs/spurs/cellFiber.c
@@ -547,3 +547,248 @@ s32 cellFiberPpuJoinFiber(CellFiberPpu* fiber, s32* status)
     UNLOCK();
     return rc;
 }
+
+/* ---------------------------------------------------------------------------
+ * Fiber contexts (cellFiberPpuContext*)
+ *
+ * The layer under the scheduler: a guest stack and a register set, switched by the title itself. Gran Turismo 6
+ * runs its menu event loop and its script threads this way (one Run per frame from the thread that owns them).
+ *
+ * As with the scheduler's fibers, a context has its own host stack and its own ppu_context. r13 and the thread id
+ * are not part of a context on the console (a context runs on whichever thread entered it), so every Run copies
+ * them from the entering thread. ppu_loader's per-thread indirect-call counts would only grow if they stayed with
+ * the host thread while guest frames are parked in a context, so each context keeps its own while switched out.
+ * -----------------------------------------------------------------------*/
+
+#define PCTX_HOST_STACK   (8u * 1024u * 1024u)
+
+#if defined(__GNUC__) || defined(__clang__)
+__attribute__((weak)) int* ps3_ppu_dispatch_depth_slot(void);   /* ppu_loader.cpp; absent in fixtures */
+__attribute__((weak)) int* ps3_ppu_vcall_sp_slot(void);
+#  define PCTX_COUNTS() (ps3_ppu_dispatch_depth_slot && ps3_ppu_vcall_sp_slot)
+#else
+static int* ps3_ppu_dispatch_depth_slot(void) { return NULL; }
+static int* ps3_ppu_vcall_sp_slot(void) { return NULL; }
+#  define PCTX_COUNTS() 0
+#endif
+
+enum { C_READY, C_RUNNING, C_ENDED };
+
+typedef struct PpuCtx PpuCtx;
+struct PpuCtx {
+    PpuCtx* next;
+    u32     ea;                  /* the guest CellFiberPpuContext */
+    int     state;
+    int     ended;               /* its entry returned */
+    s32     cause;               /* what it passed to ReturnToThread */
+    int     depth, vsp;          /* ppu_loader's counts for the frames parked in it */
+#ifdef _WIN32
+    void*   host_fiber;
+    void*   back;                /* the Run that entered it */
+#else
+    ucontext_t uc, back;
+    void*   host_stack;
+#endif
+    ppu_context ctx;
+};
+
+static PpuCtx* s_pctxs;
+/* The context running on this host thread, if any. */
+static PPU_THREAD_LOCAL PpuCtx* t_pctx;
+
+static PpuCtx* find_pctx(u32 ea)                 /* the lock is held */
+{
+    for (PpuCtx* c = s_pctxs; c; c = c->next)
+        if (c->ea == ea) return c;
+    return NULL;
+}
+
+static void pctx_body(PpuCtx* c);
+
+#ifdef _WIN32
+static VOID CALLBACK pctx_entry(void* p) { pctx_body((PpuCtx*)p); }
+static int pctx_host_create(PpuCtx* c)
+{
+    c->host_fiber = CreateFiberEx(0, PCTX_HOST_STACK, 0, pctx_entry, c);
+    return c->host_fiber != NULL;
+}
+static void pctx_host_destroy(PpuCtx* c) { if (c->host_fiber) DeleteFiber(c->host_fiber); c->host_fiber = NULL; }
+static void pctx_host_enter(PpuCtx* c)
+{
+    if (!IsThreadAFiber()) ConvertThreadToFiber(NULL);
+    c->back = GetCurrentFiber();
+    SwitchToFiber(c->host_fiber);
+}
+static void pctx_host_leave(PpuCtx* c) { SwitchToFiber(c->back); }
+#else
+static void pctx_entry(unsigned hi, unsigned lo) { pctx_body((PpuCtx*)(((uintptr_t)hi << 32) | lo)); }
+static int pctx_host_create(PpuCtx* c)
+{
+    c->host_stack = malloc(PCTX_HOST_STACK);
+    if (!c->host_stack) return 0;
+    getcontext(&c->uc);
+    c->uc.uc_stack.ss_sp   = c->host_stack;
+    c->uc.uc_stack.ss_size = PCTX_HOST_STACK;
+    c->uc.uc_link          = NULL;
+    uintptr_t p = (uintptr_t)c;
+    makecontext(&c->uc, (void (*)(void))pctx_entry, 2, (unsigned)(p >> 32), (unsigned)(p & 0xFFFFFFFFu));
+    return 1;
+}
+static void pctx_host_destroy(PpuCtx* c) { free(c->host_stack); c->host_stack = NULL; }
+static void pctx_host_enter(PpuCtx* c) { swapcontext(&c->back, &c->uc); }
+static void pctx_host_leave(PpuCtx* c) { swapcontext(&c->uc, &c->back); }
+#endif
+
+/* The context's first frame, on its own host stack. */
+static void pctx_body(PpuCtx* c)
+{
+    if (g_ppu_thread_entry_trampoline)
+        g_ppu_thread_entry_trampoline(&c->ctx);
+    /* The entry returned, which the SDK does not allow. Hand control back for good. */
+    c->ended = 1;
+    c->cause = 0;
+    for (;;) pctx_host_leave(c);
+}
+
+s32 _cellFiberPpuContextAttributeInitialize(CellFiberPpuContextAttribute* attr, u32 sdkVersion)
+{
+    (void)sdkVersion;
+    if (!attr) return (s32)CELL_FIBER_ERROR_NULL_POINTER;
+    vm_memset((u32)(uintptr_t)attr, 0, CELL_FIBER_PPU_CONTEXT_ATTRIBUTE_SIZE);
+    return CELL_OK;
+}
+
+s32 cellFiberPpuContextInitialize(CellFiberPpuContext* context, u32 entry, u64 arg,
+                                  void* eaStack, u32 sizeStack, const CellFiberPpuContextAttribute* attr)
+{
+    (void)attr;
+    const u32 ea       = (u32)(uintptr_t)context;
+    const u32 stack_ea = (u32)(uintptr_t)eaStack;
+    if (!ea || !entry || !stack_ea) return (s32)CELL_FIBER_ERROR_NULL_POINTER;
+    if (ea % CELL_FIBER_PPU_CONTEXT_ALIGN) return (s32)CELL_FIBER_ERROR_ALIGN;
+    if (sizeStack < FIBER_MIN_STACK) return (s32)CELL_FIBER_ERROR_INVAL;
+
+    PpuCtx* c = (PpuCtx*)calloc(1, sizeof *c);
+    if (!c) return (s32)CELL_FIBER_ERROR_NOMEM;
+    c->ea    = ea;
+    c->state = C_READY;
+    if (g_active_ctx) c->ctx = *g_active_ctx;    /* the creator's FP modes; the rest is set here or by Run */
+    c->ctx.gpr[1] = (stack_ea + sizeStack - FIBER_STACK_TOP_PAD) & ~0xFull;
+    c->ctx.gpr[3] = arg;
+    c->ctx.gpr[4] = 0;                           /* fiberFrom: entered from a thread */
+    c->ctx.cia    = entry;
+    c->ctx.lr     = 0;
+    c->ctx.reserve_valid = 0;
+    vm_write64((u32)c->ctx.gpr[1], 0);           /* end of the back chain */
+    if (!pctx_host_create(c)) { free(c); return (s32)CELL_FIBER_ERROR_NOMEM; }
+
+    /* The same memory initialised again without a Finalize replaces the old context. */
+    PpuCtx* old = NULL;
+    LOCK();
+    for (PpuCtx** pc = &s_pctxs; *pc; pc = &(*pc)->next)
+        if ((*pc)->ea == ea) { old = *pc; *pc = old->next; break; }
+    if (old && old->state == C_RUNNING) {        /* it is running: put it back and refuse */
+        old->next = s_pctxs; s_pctxs = old;
+        UNLOCK();
+        pctx_host_destroy(c); free(c);
+        return (s32)CELL_FIBER_ERROR_STAT;
+    }
+    c->next = s_pctxs;
+    s_pctxs = c;
+    UNLOCK();
+    if (old) { pctx_host_destroy(old); free(old); }
+    return CELL_OK;
+}
+
+s32 cellFiberPpuContextFinalize(CellFiberPpuContext* context)
+{
+    const u32 ea = (u32)(uintptr_t)context;
+    if (!ea) return (s32)CELL_FIBER_ERROR_NULL_POINTER;
+
+    PpuCtx* c = NULL;
+    LOCK();
+    for (PpuCtx** pc = &s_pctxs; *pc; pc = &(*pc)->next)
+        if ((*pc)->ea == ea) { c = *pc; if (c->state != C_RUNNING) *pc = c->next; break; }
+    const s32 rc = !c ? (s32)CELL_FIBER_ERROR_INVAL : c->state == C_RUNNING ? (s32)CELL_FIBER_ERROR_STAT : CELL_OK;
+    UNLOCK();
+    if (rc == CELL_OK) { pctx_host_destroy(c); free(c); }   /* the guest frames parked in it are dropped */
+    return rc;
+}
+
+s32 cellFiberPpuContextRun(CellFiberPpuContext* context, s32* cause, CellFiberPpuContext** fiberFrom,
+                           const void* option)
+{
+    (void)option;
+    const u32 ea = (u32)(uintptr_t)context;
+    if (!ea) return (s32)CELL_FIBER_ERROR_NULL_POINTER;
+    if (ea % CELL_FIBER_PPU_CONTEXT_ALIGN) return (s32)CELL_FIBER_ERROR_ALIGN;
+
+    LOCK();
+    PpuCtx* c = find_pctx(ea);
+    if (!c) { UNLOCK(); return (s32)CELL_FIBER_ERROR_INVAL; }
+    if (c->state != C_READY) { UNLOCK(); return (s32)CELL_FIBER_ERROR_STAT; }
+    c->state = C_RUNNING;
+    UNLOCK();
+
+    ppu_context* entering = g_active_ctx;
+    PpuCtx*      outer    = t_pctx;              /* a context may enter another; it comes back here */
+    if (entering) {
+        c->ctx.gpr[13]   = entering->gpr[13];
+        c->ctx.thread_id = entering->thread_id;
+    }
+    int depth = 0, vsp = 0;
+    if (PCTX_COUNTS()) {
+        depth = *ps3_ppu_dispatch_depth_slot(); *ps3_ppu_dispatch_depth_slot() = c->depth;
+        vsp   = *ps3_ppu_vcall_sp_slot();       *ps3_ppu_vcall_sp_slot()       = c->vsp;
+    }
+    t_pctx       = c;
+    g_active_ctx = &c->ctx;
+    pctx_host_enter(c);          /* back here when it returns to the thread */
+    g_active_ctx = entering;
+    t_pctx       = outer;
+    if (PCTX_COUNTS()) {
+        c->depth = *ps3_ppu_dispatch_depth_slot(); *ps3_ppu_dispatch_depth_slot() = depth;
+        c->vsp   = *ps3_ppu_vcall_sp_slot();       *ps3_ppu_vcall_sp_slot()       = vsp;
+    }
+
+    /* Only now may another Run enter it: it has left its host stack. */
+    LOCK();
+    c->state = c->ended ? C_ENDED : C_READY;
+    const s32 why = c->cause;
+    UNLOCK();
+    if (cause)     vm_write32((u32)(uintptr_t)cause, (u32)why);
+    if (fiberFrom) vm_write32((u32)(uintptr_t)fiberFrom, ea);
+    return CELL_OK;
+}
+
+s32 cellFiberPpuContextReturnToThread(s32 cause)
+{
+    PpuCtx* c = t_pctx;
+    if (!c) return (s32)CELL_FIBER_ERROR_PERM;
+    c->cause = cause;
+    pctx_host_leave(c);          /* resumed by the next Run of this context */
+    return CELL_OK;
+}
+/* Diagnostics: every fiber context with its state and where its guest code is (lr, r1 and the return addresses
+ * up the guest back chain), in the format of ppu_report_guest_lrs. A context that is running reads as the thread
+ * that entered it does: live, unsynchronised. */
+void ps3_fiber_contexts_report(void)
+{
+    static const char* const names[] = { "ready", "running", "ended" };
+    LOCK();
+    for (const PpuCtx* c = s_pctxs; c; c = c->next) {
+        char bt[160]; int n = 0; bt[0] = 0;
+        u32 sp = (u32)c->ctx.gpr[1];
+        for (int i = 0; i < 12 && sp >= 0x10000u && !(sp & 7u); i++) {
+            const u32 up = (u32)vm_read64(sp);
+            if (up <= sp || up - sp > 0x100000u) break;
+            n += snprintf(bt + n, sizeof bt - (size_t)n, " %08X", (u32)vm_read64(up + 16));
+            if (n >= (int)sizeof bt - 10) break;
+            sp = up;
+        }
+        fprintf(stderr, "[WATCHDOG]   fiber-ctx 0x%08X %-7s tid=%-3u lr=0x%08X  r3=0x%08X sp=0x%08X  bt:%s\n",
+                c->ea, names[c->state], (unsigned)c->ctx.thread_id, (u32)c->ctx.lr, (u32)c->ctx.gpr[3],
+                (u32)c->ctx.gpr[1], bt);
+    }
+    UNLOCK();
+}
\ No newline at end of file
