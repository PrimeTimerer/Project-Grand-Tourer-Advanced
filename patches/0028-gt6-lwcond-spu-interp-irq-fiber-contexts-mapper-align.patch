+/* ---------------------------------------------------------------------------
+ * Fiber contexts: the layer under the scheduler. A context is a guest stack and
+ * a register set and nothing else; the title schedules them itself. A thread
+ * enters one with cellFiberPpuContextRun and gets control back when the code
+ * running in it calls cellFiberPpuContextReturnToThread; the next Run of that
+ * context carries on after that call.
+ * -----------------------------------------------------------------------*/
+#define CELL_FIBER_PPU_CONTEXT_SIZE             640
+#define CELL_FIBER_PPU_CONTEXT_ALIGN            16
+#define CELL_FIBER_PPU_CONTEXT_ATTRIBUTE_SIZE   128
+
+typedef struct CellFiberPpuContext          CellFiberPpuContext;
+typedef struct CellFiberPpuContextAttribute CellFiberPpuContextAttribute;
+
+s32 _cellFiberPpuContextAttributeInitialize(CellFiberPpuContextAttribute* attr, u32 sdkVersion);
+/* `entry` is the OPD of void entry(u64 arg, CellFiberPpuContext* fiberFrom); it must not return. */
+s32 cellFiberPpuContextInitialize(CellFiberPpuContext* context, u32 entry, u64 arg,
+                                  void* eaStack, u32 sizeStack, const CellFiberPpuContextAttribute* attr);
+s32 cellFiberPpuContextFinalize(CellFiberPpuContext* context);
+/* Runs the context on the calling thread until it returns to the thread; *cause is the value it passed and
+ * *fiberFrom the context that returned. `option` is not modelled. */
+s32 cellFiberPpuContextRun(CellFiberPpuContext* context, s32* cause, CellFiberPpuContext** fiberFrom,
+                           const void* option);
+/* Called in a context: back to the thread that runs it. */
+s32 cellFiberPpuContextReturnToThread(s32 cause);
+
 #ifdef __cplusplus
 }
 #endif
