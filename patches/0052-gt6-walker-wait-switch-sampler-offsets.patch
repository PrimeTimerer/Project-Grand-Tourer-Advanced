+/* What the last walker pass ended on, and the wait that looks at it [GT6 0056].
+ *
+ * The walker's thread learns of new work only when it comes back from the wait below, and nothing signals the kick
+ * event when a title stores `put` or an SPU job overwrites the self-jump the walker stands at: the wait ran its
+ * whole timeout, which with a 1 ms timer is 1 to 2 ms (the sampler's Sleep(1) averages 1.7 ms on the same machine).
+ * In a Gran Turismo 6 race that is the time between the game publishing its last batch of commands for a frame and
+ * the walker starting on it, in the one stretch of the frame where the walker is what the game waits for
+ * (tools\ftrace_park.py) - and the same again before every finished frame is presented, because a flip the pass
+ * stopped at is shown after the wait.
+ *
+ * The wait now first asks whether a pass would get anywhere: a flip waiting to be shown; the word the walker is
+ * parked on no longer the self-jump; the label an acquire waits for at its value; `put` moved since the pass read
+ * it; or a pass that stopped at a flip with commands left. If so it does not wait. If not it looks again in a
+ * short spin - once per idle stretch and for GCM_WAIT_SPIN_US microseconds at most (0 = the timed wait alone, as
+ * before, and the DEFAULT; g_gcm_wait_spin_us for a host to turn during a run) - and then falls back to the timed
+ * wait.
+ *
+ * MEASURED 2026-11-18 (two races, 4000 against 0 in alternating 6 s stretches, the second race in reversed order):
+ * the walker's waits a heavy frame went from 6.2 to 5.8 ms and the frame did not change (20.06 against 20.11 ms,
+ * 49.8 against 49.7 fps). The reasoning above was wrong about what the waits are: the walker does come back in
+ * time; it stands because the SPU jobs have not written the cars' commands yet (tools\ftrace_chain.py). So this
+ * stays off, as a switch for a title whose waits ARE the timer. Left as it was in any case: a title with reference values queued (they are published one a pass, and the timed wait
+ * is what paces them), a pass that burned its whole word budget or did not move (the walker's stuck and circling
+ * rules count passes), and two early returns in a row with no pass between them. Walker thread only.
+ *
+ * The spin (not the look before it, which costs nothing) is kept for where it can matter: it runs only while
+ * frames come slower than a 60 Hz beat AND the walker is busy for much of them - a frame longer than 17.5 ms in
+ * which the passes took 8 ms or more arms it for the next 120 frames. A menu, a movie, a loading screen or a race
+ * that holds its 60 frames a second waits as it always did, on the timer. GCM_WAIT_SPIN_ALWAYS=1 = no such rule. */
+int g_gcm_wait_spin_us = -1;
+static u32 s_wait_kind, s_wait_ea, s_wait_word, s_wait_put;     /* kind: 0 caught up or stopped, 1 acquire, 2 park */
+static int s_wait_progress, s_wait_spun;
+static unsigned s_wait_seq, s_wait_seq_early;
+static LONGLONG s_wait_busy_ticks, s_wait_flip_qpc;             /* the passes since the last flip; when that flip was */
+static u32 s_wait_flip_seen;
+static int s_wait_spin_frames;                                  /* frames the spin stays armed for */
+static void gcm_wait_note_pass(LONGLONG q0, LONGLONG q1)
+{
+    static LARGE_INTEGER freq;
+    static int always = -1;
+    if (!freq.QuadPart) QueryPerformanceFrequency(&freq);
+    if (always < 0) { const char* e = getenv("GCM_WAIT_SPIN_ALWAYS"); always = (e && *e == '1') ? 1 : 0; }
+    s_wait_busy_ticks += q1 - q0;
+    if (s_flip_request_count == s_wait_flip_seen) return;
+    /* a frame ended in this pass */
+    const LONGLONG frame = q1 - s_wait_flip_qpc;
+    if (always || (s_wait_flip_qpc && frame * 1000 > freq.QuadPart * 35 / 2 && frame < freq.QuadPart &&
+                   s_wait_busy_ticks * 1000 >= freq.QuadPart * 8))
+        s_wait_spin_frames = 120;
+    else if (s_wait_spin_frames > 0)
+        s_wait_spin_frames--;
+    s_wait_flip_seen = s_flip_request_count; s_wait_flip_qpc = q1; s_wait_busy_ticks = 0;
+}
+static int gcm_walker_has_work(void)
+{
+    if (s_flip_pending) return 1;
+    if (s_wait_kind == 2u) return s_wait_ea && vm_read32(s_wait_ea) != s_wait_word;
+    if (s_wait_kind == 1u) return s_wait_ea && vm_read32(s_wait_ea) == s_wait_word;
+    const u32 put = vm_read32(GCM_CONTROL_GUEST_ADDR + 0);
+    if (put != s_wait_put) return 1;
+    return s_wait_progress && s_fifo_getoff != put;
+}
