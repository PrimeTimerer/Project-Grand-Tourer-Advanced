+static void chk(const char* op, int k, u128 a, u128 b) {
+    if (memcmp(&a, &b, 16) && bad++ < 20)
+        printf("%s (%d): %08X %08X %08X %08X vs %08X %08X %08X %08X\n", op, k, a._u32[0], a._u32[1], a._u32[2], a._u32[3],
+               b._u32[0], b._u32[1], b._u32[2], b._u32[3]);
+}
+int main(void) {
+#if !defined(SPU_CODEGEN_HELPERS) || !defined(__SSE4_1__)
+    printf("built without SPU_CODEGEN_HELPERS / SSE4.1 - nothing to compare\n"); return 2;
+#else
+    long n = 0;
+    for (int it = 0; it < 200000; it++) {
+        u128 a = rv(), b = rv();
+        chk("nand", it, (spu_nand)(a, b), spu_cg_nand(a, b)); chk("nor", it, (spu_nor)(a, b), spu_cg_nor(a, b));
+        chk("andc", it, (spu_andc)(a, b), spu_cg_andc(a, b)); chk("orc", it, (spu_orc)(a, b), spu_cg_orc(a, b));
+        chk("cbx", it, (spu_cbx)(a, b), spu_cg_cbx(a, b)); chk("chx", it, (spu_chx)(a, b), spu_cg_chx(a, b));
+        chk("cdx", it, (spu_cdx)(a, b), spu_cg_cdx(a, b));
+        n += 7;
+    }
+    for (int it = 0; it < 2000; it++) {
+        u128 a = rv();
+        for (int i = -128; i < 128; i++) {
+            chk("shli", i, (spu_shli)(a, i), spu_cg_shli(a, i)); chk("shlhi", i, (spu_shlhi)(a, i), spu_cg_shlhi(a, i));
+            chk("rotmi", i, (spu_rotmi)(a, i), spu_cg_rotmi(a, i)); chk("rotmhi", i, (spu_rotmhi)(a, i), spu_cg_rotmhi(a, i));
+            chk("rotqmbii", i, (spu_rotqmbii)(a, i), spu_cg_rotqmbii(a, i));
+            u128 p = a; p._u32[0] = (uint32_t)(it * 7 + i);
+            chk("cbd", i, (spu_cbd)(p, i), spu_cg_cbd(p, i)); chk("chd", i, (spu_chd)(p, i), spu_cg_chd(p, i));
+            chk("cdd", i, (spu_cdd)(p, i), spu_cg_cdd(p, i));
+            n += 8;
+        }
+    }
+    printf("%s: %ld comparisons, %d different\n", bad ? "FAIL" : "ok", n, bad);
+    return bad ? 1 : 0;
+#endif
+}
