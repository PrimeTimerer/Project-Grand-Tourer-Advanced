diff --git a/runtime/syscalls/sys_memory.c b/runtime/syscalls/sys_memory.c
index d0a730e..c43cd49 100644
--- a/runtime/syscalls/sys_memory.c
+++ b/runtime/syscalls/sys_memory.c
@@ -541,6 +541,277 @@ int64_t sys_mmapper_map_shared_memory(ppu_context* ctx)
     return CELL_OK;
 }
 
+/* ---------------------------------------------------------------------------
+ * Mapper blocks and page-fault notification
+ *
+ * liblv2's sys_mmapper_allocate_memory / map_memory / unmap_memory / free_memory
+ * (ppu_sysprx.cpp) come here. A block is memory with an identity: it keeps its
+ * contents while it is unmapped and shows them again wherever it is mapped
+ * next. The flat VM cannot alias pages, so the contents are copied out at the
+ * unmap and back in at the map; a block is mapped in one place at a time.
+ *
+ * sys_mmapper_enable_page_fault_notification(start, queue) turns a reservation
+ * into one the title pages itself: an access to a page of it that holds no
+ * block suspends the thread and posts {source 0xFFFE000000000000, address,
+ * thread id, cause 2} to that queue; the title's handler thread maps a block
+ * there and calls sys_ppu_thread_recover_page_fault(thread id), and the access
+ * is tried again. Pages of such a reservation without a block are kept
+ * decommitted so that the access faults (the host's access-violation handler
+ * calls ps3_mmapper_page_fault first).
+ *
+ * Gran Turismo 6 keeps a pageable heap this way and reads its SQLite databases
+ * through it: its pager is asked to map 8 MB of db/userdb0101.dat, and the
+ * first read of each 64 KB page faults; the pager fills a block from the file
+ * at a scratch address, unmaps it and maps it at the faulting page. With every
+ * page committed up front nothing faulted, SQLite read zeros and reported
+ * "file is encrypted or is not a database".
+ *
+ * A fault on a host thread that is no PPU thread (an SPU worker's DMA, the
+ * FIFO walker) is reported under a made-up PPU thread id; the handler passes
+ * the id it was given back to recover_page_fault, which is all it is used for.
+ * -----------------------------------------------------------------------*/
+#ifdef _WIN32
+#define MM_PAGE     0x10000u
+#define MM_ID_BASE  0x1000u
+#define MM_FAKE_TID 0x7F000000u
+
+typedef struct mm_block { uint32_t size, mapped_at; uint8_t* backing; int used; } mm_block;
+typedef struct mm_notify { uint32_t start, end, queue; } mm_notify;
+typedef struct mm_waiter { int used; uint64_t tid; HANDLE ev; } mm_waiter;
+
+static mm_block*  s_mm_blocks;
+static uint32_t   s_mm_cap, s_mm_hint;
+static uint32_t*  s_mm_page_id;            /* block id mapped at each 64 KB page of the 4 GB space; 0 = none */
+static mm_notify  s_mm_notify[8];
+static int        s_mm_n_notify;
+static mm_waiter  s_mm_wait[128];
+static SRWLOCK    s_mm_lock = SRWLOCK_INIT;
+static unsigned long long s_mm_faults;
+
+extern PPU_THREAD_LOCAL ppu_context* g_active_ctx;
+extern int sys_event_queue_push_by_id(uint32_t queue_id, uint64_t source, uint64_t data1, uint64_t data2, uint64_t data3);
+
+static int mm_log(void)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("PS3_MEMTRACE") ? 1 : 0;
+    return on;
+}
+
+static mm_block* mm_get(uint32_t id)                    /* the lock is held */
+{
+    const uint32_t i = id - MM_ID_BASE;
+    return (i < s_mm_cap && s_mm_blocks[i].used) ? &s_mm_blocks[i] : NULL;
+}
+
+static const mm_notify* mm_region(uint32_t addr)        /* the lock is held */
+{
+    for (int i = 0; i < s_mm_n_notify; i++)
+        if (addr >= s_mm_notify[i].start && addr < s_mm_notify[i].end) return &s_mm_notify[i];
+    return NULL;
+}
+
+static int mm_pages_ready(void)                         /* the lock is held */
+{
+    if (!s_mm_page_id) s_mm_page_id = (uint32_t*)calloc(0x10000u, sizeof(uint32_t));
+    return s_mm_page_id != NULL;
+}
+
+uint32_t ps3_mmapper_block_new(uint32_t size)
+{
+    AcquireSRWLockExclusive(&s_mm_lock);
+    uint32_t i = s_mm_hint;
+    while (i < s_mm_cap && s_mm_blocks[i].used) i++;
+    if (i >= s_mm_cap) {
+        const uint32_t cap = s_mm_cap ? s_mm_cap * 2u : 1024u;
+        mm_block* nb = (mm_block*)realloc(s_mm_blocks, (size_t)cap * sizeof(mm_block));
+        if (!nb) { ReleaseSRWLockExclusive(&s_mm_lock); return 0; }
+        memset(nb + s_mm_cap, 0, (size_t)(cap - s_mm_cap) * sizeof(mm_block));
+        i = s_mm_cap; s_mm_blocks = nb; s_mm_cap = cap;
+    }
+    memset(&s_mm_blocks[i], 0, sizeof(mm_block));
+    s_mm_blocks[i].used = 1;
+    s_mm_blocks[i].size = (size + MM_PAGE - 1u) & ~(MM_PAGE - 1u);
+    s_mm_hint = i + 1u;
+    ReleaseSRWLockExclusive(&s_mm_lock);
+    return MM_ID_BASE + i;
+}
+
+uint32_t ps3_mmapper_block_size(uint32_t id)
+{
+    AcquireSRWLockShared(&s_mm_lock);
+    const mm_block* b = mm_get(id);
+    const uint32_t size = b ? b->size : 0;
+    ReleaseSRWLockShared(&s_mm_lock);
+    return size;
+}
+
+int64_t ps3_mmapper_block_map(uint32_t addr, uint32_t id)
+{
+    int64_t rc = CELL_OK;
+    AcquireSRWLockExclusive(&s_mm_lock);
+    mm_block* b = mm_get(id);
+    if (!b)                              rc = (int64_t)(int32_t)CELL_ESRCH;
+    else if (addr & (MM_PAGE - 1u))      rc = (int64_t)(int32_t)CELL_EALIGN;
+    else if (b->mapped_at || (uint64_t)addr + b->size > 0x100000000ull || !mm_pages_ready())
+                                         rc = (int64_t)(int32_t)CELL_EBUSY;
+    else {
+        for (uint32_t o = 0; o < b->size; o += MM_PAGE)
+            if (s_mm_page_id[(addr + o) >> 16]) { rc = (int64_t)(int32_t)CELL_EBUSY; break; }
+    }
+    if (rc == CELL_OK) {
+        uint8_t* host = (uint8_t*)vm_to_host(addr);
+        if (!VirtualAlloc(host, b->size, MEM_COMMIT, PAGE_READWRITE)) {
+            rc = (int64_t)(int32_t)CELL_ENOMEM;
+        } else {
+            if (b->backing) { memcpy(host, b->backing, b->size); free(b->backing); b->backing = NULL; }
+            else if (!mm_region(addr)) memset(host, 0, b->size);   /* committed up front: may hold an earlier block's data */
+            for (uint32_t o = 0; o < b->size; o += MM_PAGE) s_mm_page_id[(addr + o) >> 16] = id;
+            b->mapped_at = addr;
+        }
+    }
+    ReleaseSRWLockExclusive(&s_mm_lock);
+    if (mm_log()) fprintf(stderr, "[mmapper] map(addr=0x%08X id=0x%X) -> 0x%X\n", addr, id, (unsigned)rc);
+    return rc;
+}
+
+int64_t ps3_mmapper_block_unmap(uint32_t addr, uint32_t* id_out)
+{
+    int64_t rc = CELL_OK;
+    uint32_t id = 0;
+    AcquireSRWLockExclusive(&s_mm_lock);
+    id = (s_mm_page_id && !(addr & (MM_PAGE - 1u))) ? s_mm_page_id[addr >> 16] : 0;
+    mm_block* b = mm_get(id);
+    if (!b || b->mapped_at != addr) {
+        rc = (int64_t)(int32_t)CELL_EINVAL;
+    } else {
+        uint8_t* host = (uint8_t*)vm_to_host(addr);
+        b->backing = (uint8_t*)malloc(b->size);
+        if (!b->backing) {
+            rc = (int64_t)(int32_t)CELL_ENOMEM;
+        } else {
+            memcpy(b->backing, host, b->size);
+            for (uint32_t o = 0; o < b->size; o += MM_PAGE) s_mm_page_id[(addr + o) >> 16] = 0;
+            b->mapped_at = 0;
+            if (mm_region(addr)) VirtualFree(host, b->size, MEM_DECOMMIT);   /* the next access faults */
+        }
+    }
+    ReleaseSRWLockExclusive(&s_mm_lock);
+    if (rc == CELL_OK && id_out) *id_out = id;
+    if (mm_log()) fprintf(stderr, "[mmapper] unmap(addr=0x%08X) -> id 0x%X rc 0x%X\n", addr, id, (unsigned)rc);
+    return rc;
+}
+
+int64_t ps3_mmapper_block_free(uint32_t id)
+{
+    int64_t rc = CELL_OK;
+    AcquireSRWLockExclusive(&s_mm_lock);
+    mm_block* b = mm_get(id);
+    if (!b)                 rc = (int64_t)(int32_t)CELL_ESRCH;
+    else if (b->mapped_at)  rc = (int64_t)(int32_t)CELL_EBUSY;
+    else {
+        free(b->backing);
+        memset(b, 0, sizeof *b);
+        if (id - MM_ID_BASE < s_mm_hint) s_mm_hint = id - MM_ID_BASE;
+    }
+    ReleaseSRWLockExclusive(&s_mm_lock);
+    return rc;
+}
+
+int64_t ps3_mmapper_enable_page_fault_notification(uint32_t start, uint32_t queue_id)
+{
+    uint32_t end = 0;
+    bump_lock();
+    for (int i = 0; i < SYS_MEMORY_ALLOC_MAX; i++)
+        if (s_mapper_reservations[i].start == start && start) { end = s_mapper_reservations[i].end; break; }
+    bump_unlock();
+    if (!end) return (int64_t)(int32_t)CELL_EINVAL;
+
+    int64_t rc = CELL_OK;
+    AcquireSRWLockExclusive(&s_mm_lock);
+    if (mm_region(start) || s_mm_n_notify >= (int)(sizeof s_mm_notify / sizeof s_mm_notify[0]) || !mm_pages_ready()) {
+        rc = (int64_t)(int32_t)CELL_EBUSY;
+    } else {
+        s_mm_notify[s_mm_n_notify].start = start;
+        s_mm_notify[s_mm_n_notify].end   = end;
+        s_mm_notify[s_mm_n_notify].queue = queue_id;
+        s_mm_n_notify++;
+        /* Every page without a block has to fault from now on. */
+        for (uint32_t a = start; a < end;) {
+            if (s_mm_page_id[a >> 16]) { a += MM_PAGE; continue; }
+            uint32_t run = a;
+            while (run < end && !s_mm_page_id[run >> 16]) run += MM_PAGE;
+            VirtualFree(vm_to_host(a), run - a, MEM_DECOMMIT);
+            a = run;
+        }
+    }
+    ReleaseSRWLockExclusive(&s_mm_lock);
+    fprintf(stderr, "[mmapper] page-fault notification for 0x%08X-0x%08X -> queue %u (rc 0x%X)\n",
+            start, end, queue_id, (unsigned)rc);
+    return rc;
+}
+
+/* From the host's access-violation handler, on the faulting thread. Returns 1
+ * when the access should be tried again, 0 when the address is not paged by
+ * the title (the caller then treats the fault as it always did). */
+int ps3_mmapper_page_fault(uint32_t addr, int writing)
+{
+    AcquireSRWLockExclusive(&s_mm_lock);
+    const mm_notify* r = mm_region(addr);
+    if (!r) { ReleaseSRWLockExclusive(&s_mm_lock); return 0; }
+    if (s_mm_page_id[addr >> 16]) { ReleaseSRWLockExclusive(&s_mm_lock); return 1; }   /* mapped meanwhile */
+    const uint32_t queue = r->queue;
+    mm_waiter* w = NULL;
+    for (int i = 0; i < (int)(sizeof s_mm_wait / sizeof s_mm_wait[0]); i++)
+        if (!s_mm_wait[i].used) { w = &s_mm_wait[i]; w->used = 1;
+                                  w->tid = (g_active_ctx && g_active_ctx->thread_id) ? g_active_ctx->thread_id
+                                                                                     : (uint64_t)(MM_FAKE_TID + (uint32_t)i);
+                                  break; }
+    if (w && !w->ev) w->ev = CreateEventA(NULL, FALSE, FALSE, NULL);
+    if (w && w->ev) ResetEvent(w->ev);
+    const unsigned long long n = ++s_mm_faults;
+    ReleaseSRWLockExclusive(&s_mm_lock);
+    if (!w || !w->ev) { Sleep(1); return 1; }           /* every slot is waiting: try again shortly */
+
+    if (mm_log() || n <= 8 || (n % 1000) == 0)
+        fprintf(stderr, "[mmapper] page fault #%llu %s 0x%08X tid=0x%llX -> queue %u\n", n,
+                writing ? "writing" : "reading", addr, (unsigned long long)w->tid, queue);
+    /* data2 = (thread type << 32) | id, type 0 = PPU thread; data3 = 2: the page is not mapped. */
+    while (sys_event_queue_push_by_id(queue, 0xFFFE000000000000ull, addr, w->tid, 2) != 0)
+        Sleep(1);                                       /* the queue is full: the handler is behind */
+    WaitForSingleObject(w->ev, INFINITE);
+    AcquireSRWLockExclusive(&s_mm_lock);
+    w->used = 0;
+    ReleaseSRWLockExclusive(&s_mm_lock);
+    return 1;
+}
+
+/* sys_ppu_thread_recover_page_fault / sys_spu_thread_recover_page_fault. */
+int64_t ps3_mmapper_recover_page_fault(uint64_t tid)
+{
+    int64_t rc = (int64_t)(int32_t)CELL_EINVAL;
+    AcquireSRWLockExclusive(&s_mm_lock);
+    for (int i = 0; i < (int)(sizeof s_mm_wait / sizeof s_mm_wait[0]); i++)
+        if (s_mm_wait[i].used && s_mm_wait[i].tid == tid && s_mm_wait[i].ev) {
+            SetEvent(s_mm_wait[i].ev);
+            rc = CELL_OK;
+            break;
+        }
+    ReleaseSRWLockExclusive(&s_mm_lock);
+    return rc;
+}
+#else   /* not implemented off Windows: blocks are ids over memory that is always there, as before */
+static uint32_t s_mm_sizes[4096], s_mm_next = 0x1000u;
+uint32_t ps3_mmapper_block_new(uint32_t size) { uint32_t id = s_mm_next++; if (id - 0x1000u < 4096u) s_mm_sizes[id - 0x1000u] = size; return id; }
+uint32_t ps3_mmapper_block_size(uint32_t id) { return id - 0x1000u < 4096u ? s_mm_sizes[id - 0x1000u] : 0; }
+int64_t  ps3_mmapper_block_map(uint32_t addr, uint32_t id) { (void)addr; (void)id; return CELL_OK; }
+int64_t  ps3_mmapper_block_unmap(uint32_t addr, uint32_t* id_out) { (void)addr; (void)id_out; return CELL_OK; }
+int64_t  ps3_mmapper_block_free(uint32_t id) { (void)id; return CELL_OK; }
+int64_t  ps3_mmapper_enable_page_fault_notification(uint32_t start, uint32_t queue_id) { (void)start; (void)queue_id; return CELL_OK; }
+int      ps3_mmapper_page_fault(uint32_t addr, int writing) { (void)addr; (void)writing; return 0; }
+int64_t  ps3_mmapper_recover_page_fault(uint64_t tid) { (void)tid; return CELL_OK; }
+#endif
