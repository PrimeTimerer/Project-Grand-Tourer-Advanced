diff --git a/libs/input/cellKb.c b/libs/input/cellKb.c
index 6b4cdbc..52cf64a 100644
--- a/libs/input/cellKb.c
+++ b/libs/input/cellKb.c
@@ -279,3 +279,29 @@ s32 cellKbClearBuf(u32 port_no)
     s_kb_ports[port_no].event_count = 0;
     return CELL_OK;
 }
+
+/* cellKbRead is the name the SDK exports for reading a keyboard; cellKbGetData above is that routine under a
+ * name no title imports. Unregistered, the dispatcher answered CELL_OK and left CellKbData untouched: Gran
+ * Turismo 6's input thread then walked `len` = whatever was on its stack while holding its input lock (a quarter
+ * of a second per poll), and the logic thread, which takes that lock every frame, ran at 4 Hz. */
+s32 cellKbRead(u32 port_no, CellKbData* data)
+{
+    return cellKbGetData(port_no, data);
+}
+
+/* Guest CellKbConfig (big-endian): +0x00 arrange, +0x04 read_mode, +0x08 code_type. */
+s32 cellKbGetConfiguration(u32 port_no, void* config)
+{
+    unsigned long long ea = (unsigned int)(uintptr_t)config;
+
+    if (!s_kb_initialized)
+        return CELL_KB_ERROR_UNINITIALIZED;
+
+    if (port_no >= CELL_KB_MAX_KEYBOARDS || !config)
+        return CELL_KB_ERROR_INVALID_PARAMETER;
+
+    vm_write32(ea + 0x00, 0);                              /* CELL_KB_MAPPING_101 */
+    vm_write32(ea + 0x04, s_kb_ports[port_no].rmode);
+    vm_write32(ea + 0x08, s_kb_ports[port_no].codetype);
+    return CELL_OK;
+}
