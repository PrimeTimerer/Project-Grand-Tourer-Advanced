+/* PS3_FS_STRICT_MOUNTS=1: a path that names no mount point fails as it does on
+ * the console -- CELL_FS_ENOTMOUNTED for an unknown first component, ENOENT for
+ * a relative path -- instead of resolving under the disc root. Returns that
+ * error, or 0 when the path may be resolved.
+ *
+ * Gran Turismo 6 looks for development copies of its databases this way:
+ * stat("specdb/GT6"), stat("/specdb"), and on anything but "not mounted" it
+ * mkdirs the path and uses it. host_path() put "/specdb" under the disc root,
+ * the mkdir succeeded, and from then on the game worked on an empty database
+ * directory and stopped at an "insufficient free space" dialog.
+ * Off by default: other titles may rely on the lenient mapping. */
+static int fs_strict_error(const char* g)
+{
+    static int strict = -1;
+    if (strict < 0) { const char* e = getenv("PS3_FS_STRICT_MOUNTS"); strict = (e && *e && *e != '0') ? 1 : 0; }
+    if (!strict) return 0;
+    if (g[0] != '/') return (int)CELL_FS_ENOENT;
+    const size_t n = strcspn(g + 1, "/");
+    if (n == 0) return 0;                                   /* the root itself */
+    static const char* const mounts[] = {
+        "dev_bdvd", "app_home", "dev_hdd0", "dev_hdd1", "dev_flash", "dev_flash2", "dev_flash3",
+        "host_root", "dev_usb", "dev_ms", "dev_cf", "dev_sd"
+    };
+    for (size_t i = 0; i < sizeof(mounts) / sizeof(mounts[0]); i++)
+        if (strlen(mounts[i]) == n && strncmp(g + 1, mounts[i], n) == 0) return 0;
+    if (n == 10 && strncmp(g + 1, "dev_usb00", 9) == 0) return 0;   /* dev_usb000..007 */
+    return (int)0x8001003A;                                 /* CELL_FS_ENOTMOUNTED */
+}
