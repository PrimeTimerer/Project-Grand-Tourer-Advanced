diff --git a/libs/codec/cellDmux.c b/libs/codec/cellDmux.c
index b055385..8f917c9 100644
--- a/libs/codec/cellDmux.c
+++ b/libs/codec/cellDmux.c
@@ -288,3 +288,40 @@ s32 cellDmuxFlushEs(CellDmuxEsHandle esHandle)
 
     return CELL_OK;
 }
+
+/* ---------------------------------------------------------------------------
+ * The variants a title on a SPURS-driven demuxer uses.
+ * cellDmuxQueryAttr(type, attr): CellDmuxAttr { memSize, demuxerVerUpper, demuxerVerLower }.
+ * cellDmuxOpenEx(type, resourceEx, cb, handle): the callback comes as a pointer to
+ * CellDmuxCb { cbMsgFunc, cbArg } instead of two arguments; the resource (SPURS
+ * instance, priorities) is not used here.
+ * -----------------------------------------------------------------------*/
+s32 cellDmuxQueryAttr(const CellDmuxType* type, void* attr)
+{
+    if (!type || !attr)
+        return (s32)CELL_DMUX_ERROR_ARG;
+    vm_write32(GUEST_EA(attr) + 0, 0x10000);       /* memSize */
+    vm_write32(GUEST_EA(attr) + 4, 0x00280000);    /* demuxer version, upper */
+    vm_write32(GUEST_EA(attr) + 8, 0x00000000);    /* ... lower */
+    return CELL_OK;
+}
+
+s32 cellDmuxQueryAttr2(const CellDmuxType* type, void* attr)
+{
+    return cellDmuxQueryAttr(type, attr);
+}
+
+s32 cellDmuxOpenEx(const CellDmuxType* type, const void* resourceEx, const void* cb, CellDmuxHandle* handle)
+{
+    (void)resourceEx;
+    if (!cb)
+        return (s32)CELL_DMUX_ERROR_ARG;
+    const u32 func = vm_read32(GUEST_EA(cb) + 0);
+    const u32 arg  = vm_read32(GUEST_EA(cb) + 4);
+    return cellDmuxOpen(type, NULL, (CellDmuxCbMsg)(uintptr_t)func, (void*)(uintptr_t)arg, handle);
+}
+
+s32 cellDmuxOpen2(const CellDmuxType* type, const void* resource2, const void* cb, CellDmuxHandle* handle)
+{
+    return cellDmuxOpenEx(type, resource2, cb, handle);
+}
diff --git a/libs/codec/cellPamf.c b/libs/codec/cellPamf.c
index 1b6275d..c0cd62e 100644
--- a/libs/codec/cellPamf.c
+++ b/libs/codec/cellPamf.c
@@ -504,3 +504,55 @@ s32 cellPamfReaderGetEp(CellPamfReader* reader, u32 epIndex, CellPamfEp* ep)
     vm_write32((u32)(uintptr_t)ep + 4, be32(epData + 4));
     return CELL_OK;
 }
+
+/* ---------------------------------------------------------------------------
+ * Whole-file helpers a title calls before it has a reader: header size, where the
+ * stream data lies, and a check that the buffer holds a PAMF header at all.
+ * In the header (big-endian) +0x08 is the offset of the stream data and +0x0C its
+ * size, both in 2048-byte sectors.
+ * Gran Turismo 6's movie player calls all three first; unregistered they answered
+ * CELL_OK with the outputs untouched, and it went on with whatever was on its stack.
+ * -----------------------------------------------------------------------*/
+static const u8* pamf_header(void* pAddr)
+{
+    if (!pAddr) return NULL;
+    const u8* base = (const u8*)GUEST_PTR(pAddr, void*);
+    return be32(base + PAMF_OFF_MAGIC) == CELL_PAMF_MAGIC ? base : NULL;
+}
+
+s32 cellPamfVerify(void* pAddr, u64 fileSize)
+{
+    (void)fileSize;
+    return pamf_header(pAddr) ? CELL_OK : (s32)CELL_PAMF_ERROR_INVALID_HEADER;
+}
+
+s32 cellPamfGetHeaderSize(void* pAddr, u64 fileSize, void* pSize)
+{
+    (void)fileSize;
+    const u8* base = pamf_header(pAddr);
+    if (!base || !pSize) return (s32)CELL_PAMF_ERROR_INVALID_HEADER;
+    vm_write64((u32)(uintptr_t)pSize, (u64)be32(base + PAMF_OFF_DATA_OFFSET) * 0x800u);
+    return CELL_OK;
+}
+
+s32 cellPamfGetHeaderSize2(void* pAddr, u64 fileSize, u32 attribute, void* pSize)
+{
+    (void)attribute;
+    return cellPamfGetHeaderSize(pAddr, fileSize, pSize);
+}
+
+s32 cellPamfGetStreamOffsetAndSize(void* pAddr, u64 fileSize, void* pOffset, void* pSize)
+{
+    (void)fileSize;
+    const u8* base = pamf_header(pAddr);
+    if (!base || !pOffset || !pSize) return (s32)CELL_PAMF_ERROR_INVALID_HEADER;
+    vm_write64((u32)(uintptr_t)pOffset, (u64)be32(base + PAMF_OFF_DATA_OFFSET) * 0x800u);
+    vm_write64((u32)(uintptr_t)pSize,   (u64)be32(base + PAMF_OFF_DATA_SIZE) * 0x800u);
+    return CELL_OK;
+}
+
+s32 cellPamfGetStreamOffsetAndSize2(void* pAddr, u64 fileSize, u32 attribute, void* pOffset, void* pSize)
+{
+    (void)attribute;
+    return cellPamfGetStreamOffsetAndSize(pAddr, fileSize, pOffset, pSize);
+}
diff --git a/libs/misc/cellMusic.c b/libs/misc/cellMusic.c
new file mode 100644
index 0000000..991e85d
--- /dev/null
+++ b/libs/misc/cellMusic.c
@@ -0,0 +1,121 @@
+/*
+ * ps3recomp - cellMusicUtility (Music Utility 2) HLE implementation
+ *
+ * Background music from the system's music player while the title runs. There is no such player on the host, so
+ * the answers are those of a console whose user has chosen no music: initialisation succeeds, nothing is selected,
+ * nothing plays. What matters is HOW the answers arrive: every request reports its result through the title's
+ * callback, called from cellSysutilCheckCallback like the system's own, and a title waits for it.
+ *
+ * Gran Turismo 6 calls cellMusicInitialize2 during boot and does not open its main menu before the
+ * INITIALIZE_RESULT event has come. With the functions unregistered the call "succeeded" and the event never
+ * came: the game sat on its loading screen for good.
+ */
+
+#include "ps3emu/ps3types.h"
+#include "ps3emu/error_codes.h"
+#include <stdint.h>
+#include <stdio.h>
+#include "../../runtime/ppu/ppu_memory.h"   /* vm_write*: guest EA -> host, byte-swapped */
+
+/* cellSysutil.c: call a guest function at the title's next cellSysutilCheckCallback. */
+s32 cellSysutilQueueGuestCallbackArgs(u32 opd, const u64 args[8]);
+
+/* Events handed to the callback: void cb(u32 event, void* param, void* userData), param = the result. */
+#define CELL_MUSIC2_EVENT_STATUS_NOTIFICATION            0
+#define CELL_MUSIC2_EVENT_INITIALIZE_RESULT              1
+#define CELL_MUSIC2_EVENT_FINALIZE_RESULT                2
+#define CELL_MUSIC2_EVENT_SELECT_CONTENTS_RESULT         3
+#define CELL_MUSIC2_EVENT_SET_PLAYBACK_COMMAND_RESULT    4
+#define CELL_MUSIC2_EVENT_SET_VOLUME_RESULT              5
+#define CELL_MUSIC2_EVENT_SET_SELECTION_CONTEXT_RESULT   6
+
+#define CELL_MUSIC2_CANCELED                 1
+#define CELL_MUSIC2_ERROR_PARAM              0x8002C101u
+#define CELL_MUSIC2_ERROR_NO_ACTIVE_CONTENT  0x8002C103u
+#define CELL_MUSIC2_ERROR_INVALID_CONTEXT    0x8002C105u
+#define CELL_MUSIC2_ERROR_GENERIC            0x8002C1FFu
+
+#define CELL_MUSIC2_PB_STATUS_STOP           0
+#define CELL_MUSIC2_PB_CMD_STOP              0
+#define CELL_MUSIC2_PB_CMD_PAUSE             2
+
+static u32 s_music_cb;          /* the title's callback (guest function descriptor) */
+static u32 s_music_userdata;
+
+static void music_event(u32 event, u32 result)
+{
+    const u64 args[8] = { event, result, s_music_userdata, 0, 0, 0, 0, 0 };
+    if (s_music_cb) cellSysutilQueueGuestCallbackArgs(s_music_cb, args);
+}
+
+s32 cellMusicInitialize2(s32 mode, s32 spuPriority, u32 func, u32 userData)
+{
+    printf("[cellMusic] Initialize2(mode=%d, spuPriority=%d, func=0x%08X)\n", mode, spuPriority, func);
+    if (!func)
+        return (s32)CELL_MUSIC2_ERROR_PARAM;
+    s_music_cb = func;
+    s_music_userdata = userData;
+    music_event(CELL_MUSIC2_EVENT_INITIALIZE_RESULT, CELL_OK);
+    return CELL_OK;
+}
+
+s32 cellMusicInitialize2SystemWorkload(s32 mode, u32 func, u32 userData, u32 spurs, u32 priority, u32 attr)
+{
+    (void)spurs; (void)priority; (void)attr;
+    return cellMusicInitialize2(mode, 0, func, userData);
+}
+
+s32 cellMusicFinalize2(void)
+{
+    printf("[cellMusic] Finalize2()\n");
+    music_event(CELL_MUSIC2_EVENT_FINALIZE_RESULT, CELL_OK);
+    s_music_cb = 0;
+    return CELL_OK;
+}
+
+/* Nothing has been selected in the music player. */
+s32 cellMusicGetSelectionContext2(u32 context)
+{
+    (void)context;
+    return (s32)CELL_MUSIC2_ERROR_NO_ACTIVE_CONTENT;
+}
+
+/* A context the title kept from an earlier session names music this machine does not have. */
+s32 cellMusicSetSelectionContext2(u32 context)
+{
+    if (!context)
+        return (s32)CELL_MUSIC2_ERROR_PARAM;
+    music_event(CELL_MUSIC2_EVENT_SET_SELECTION_CONTEXT_RESULT, CELL_MUSIC2_ERROR_INVALID_CONTEXT);
+    return CELL_OK;
+}
+
+/* (float level): nothing plays, so the level is not kept. */
+s32 cellMusicSetVolume2(void)
+{
+    music_event(CELL_MUSIC2_EVENT_SET_VOLUME_RESULT, CELL_OK);
+    return CELL_OK;
+}
+
+s32 cellMusicGetPlaybackStatus2(u32 status)
+{
+    if (!status)
+        return (s32)CELL_MUSIC2_ERROR_PARAM;
+    vm_write32(status, CELL_MUSIC2_PB_STATUS_STOP);
+    return CELL_OK;
+}
+
+s32 cellMusicSetPlaybackCommand2(s32 command, u32 param)
+{
+    (void)param;
+    music_event(CELL_MUSIC2_EVENT_SET_PLAYBACK_COMMAND_RESULT,
+                command == CELL_MUSIC2_PB_CMD_STOP || command == CELL_MUSIC2_PB_CMD_PAUSE
+                    ? (u32)CELL_OK : CELL_MUSIC2_ERROR_NO_ACTIVE_CONTENT);
+    return CELL_OK;
+}
+
+/* The system's selection screen: closed without a choice. */
+s32 cellMusicSelectContents2(void)
+{
+    music_event(CELL_MUSIC2_EVENT_SELECT_CONTENTS_RESULT, CELL_MUSIC2_CANCELED);
+    return CELL_OK;
+}
