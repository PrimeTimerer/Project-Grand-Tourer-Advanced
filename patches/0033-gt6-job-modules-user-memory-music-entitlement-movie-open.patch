diff --git a/runtime/syscalls/sys_memory.c b/runtime/syscalls/sys_memory.c
index c43cd49..9ce9e25 100644
--- a/runtime/syscalls/sys_memory.c
+++ b/runtime/syscalls/sys_memory.c
@@ -617,9 +617,70 @@ static int mm_pages_ready(void)                         /* the lock is held */
     return s_mm_page_id != NULL;
 }
 
+/* User memory. On the console the blocks of sys_mmapper_allocate_memory come out of the pool that
+ * sys_memory_get_user_memory_size reports, and allocating past it fails with ENOMEM. A title that pages itself
+ * lives by both: Gran Turismo 6 fills its caches until the system says little is left, and its pager gives
+ * pages back (to its page file) when an allocation fails. Told "192 MB available" no matter what it had taken,
+ * and never refused, it took 431 MB, ran its 256 MB heap window full and then its pager went round every page
+ * for good, trying to free memory that by that number never became free.
+ *
+ * The total matters as well. A retail console gives a game 213 MB (0x0D500000) and Gran Turismo 6 compares with
+ * exactly that: more means a development machine with extra memory, and it lays its heap out for one
+ * (func_00B0D088: total > 0x0D500000 and a heap window over 256 MB). The 256 MB reported before put it there.
+ * The pool the title's own allocations come out of is 208 MB of those 213 (the rest stands for its stacks; the
+ * program image is not charged, and with it charged -- a pool of 170 MB -- the game's heap ran out 19 seconds
+ * into its boot: 114 MB of heap and 55 MB of paged memory). PS3_USER_MEMORY_MB=<n> sets another pool; above
+ * 208 the total grows with it (pool + 25 MB: 380 gives the 405 MB of a debug console).
+ *
+ * What the console cannot do and a PC can: go on past the pool. Gran Turismo 6 loads 114 MB into its heap and
+ * 55 MB into its paged memory in the first 19 seconds and its heap then asks for more; refused, it sleeps and
+ * asks again, for good, with its heap locked (nothing here gives memory back at that point). So by default an
+ * allocation is never refused, and the available size is reported truthfully down to a floor of 4 MB and no
+ * lower: the title sees "nearly full" -- its pager stops growing, its caches stay small -- and still gets the
+ * megabyte it needs. PS3_USER_MEMORY_STRICT=1 refuses past the pool and reports down to 0, as the console does. */
+#define MM_TOTAL_RETAIL 0x0D500000u
+#define MM_POOL_RETAIL  (208u << 20)
+#define MM_AVAIL_FLOOR  (4u << 20)
+static uint64_t s_mm_bytes;                 /* sizes of the blocks that exist */
+static int mm_strict(void)
+{
+    static int strict = -1;
+    if (strict < 0) { const char* e = getenv("PS3_USER_MEMORY_STRICT"); strict = e && *e == '1'; }
+    return strict;
+}
+static uint64_t mm_pool(void)
+{
+    static uint64_t pool;
+    if (!pool) {
+        const char* e = getenv("PS3_USER_MEMORY_MB");
+        const unsigned long mb = e ? strtoul(e, NULL, 10) : 0;
+        pool = mb ? (uint64_t)mb << 20 : MM_POOL_RETAIL;
+    }
+    return pool;
+}
+
+/* sys_memory_get_user_memory_size: { total, available }. */
+void ps3_user_memory_size(uint32_t* total, uint32_t* available)
+{
+    const uint64_t pool = mm_pool();
+    AcquireSRWLockShared(&s_mm_lock);
+    const uint64_t used = s_mm_bytes + s_total_allocated;
+    ReleaseSRWLockShared(&s_mm_lock);
+    const uint64_t tot = pool + (25u << 20);
+    *total = pool <= MM_POOL_RETAIL ? MM_TOTAL_RETAIL : (uint32_t)(tot > 0xFFF00000ull ? 0xFFF00000ull : tot);
+    uint64_t avail = used >= pool ? 0 : pool - used;
+    if (!mm_strict() && avail < MM_AVAIL_FLOOR) avail = MM_AVAIL_FLOOR;
+    *available = (uint32_t)avail;
+}
+
 uint32_t ps3_mmapper_block_new(uint32_t size)
 {
+    const uint32_t rounded = (size + MM_PAGE - 1u) & ~(MM_PAGE - 1u);
     AcquireSRWLockExclusive(&s_mm_lock);
+    if (!rounded || (mm_strict() && s_mm_bytes + s_total_allocated + rounded > mm_pool())) {
+        ReleaseSRWLockExclusive(&s_mm_lock);
+        return 0;                                           /* ENOMEM */
+    }
     uint32_t i = s_mm_hint;
     while (i < s_mm_cap && s_mm_blocks[i].used) i++;
     if (i >= s_mm_cap) {
@@ -631,7 +692,8 @@ uint32_t ps3_mmapper_block_new(uint32_t size)
     }
     memset(&s_mm_blocks[i], 0, sizeof(mm_block));
     s_mm_blocks[i].used = 1;
-    s_mm_blocks[i].size = (size + MM_PAGE - 1u) & ~(MM_PAGE - 1u);
+    s_mm_blocks[i].size = rounded;
+    s_mm_bytes += rounded;
     s_mm_hint = i + 1u;
     ReleaseSRWLockExclusive(&s_mm_lock);
     return MM_ID_BASE + i;
@@ -711,6 +773,7 @@ int64_t ps3_mmapper_block_free(uint32_t id)
     else if (b->mapped_at)  rc = (int64_t)(int32_t)CELL_EBUSY;
     else {
         free(b->backing);
+        s_mm_bytes -= b->size;
         memset(b, 0, sizeof *b);
         if (id - MM_ID_BASE < s_mm_hint) s_mm_hint = id - MM_ID_BASE;
     }
@@ -801,6 +864,11 @@ int64_t ps3_mmapper_recover_page_fault(uint64_t tid)
     return rc;
 }
 #else   /* not implemented off Windows: blocks are ids over memory that is always there, as before */
+void ps3_user_memory_size(uint32_t* total, uint32_t* available)
+{
+    *total = 0x0D500000u;                                   /* a retail console's 213 MB, 208 MB of it free at start */
+    *available = s_total_allocated >= 0x0D000000u ? 0 : 0x0D000000u - s_total_allocated;
+}
 static uint32_t s_mm_sizes[4096], s_mm_next = 0x1000u;
 uint32_t ps3_mmapper_block_new(uint32_t size) { uint32_t id = s_mm_next++; if (id - 0x1000u < 4096u) s_mm_sizes[id - 0x1000u] = size; return id; }
 uint32_t ps3_mmapper_block_size(uint32_t id) { return id - 0x1000u < 4096u ? s_mm_sizes[id - 0x1000u] : 0; }
