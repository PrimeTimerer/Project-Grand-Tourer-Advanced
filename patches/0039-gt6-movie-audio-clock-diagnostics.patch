@@ -1741,6 +1776,7 @@ s32 cellAudioGetPortTimestamp(u32 portNum, u64 tag, u64* stamp)
     const u64 elapsed_us = (global_counter - tag) *
         (u64)CELL_AUDIO_BLOCK_SAMPLES * 1000000ULL / CELL_AUDIO_SAMPLE_RATE;
     const u64 t = port->timestamp_us > elapsed_us ? port->timestamp_us - elapsed_us : 0;
+    audio_clock_diag_locked("timestamp", portNum, tag, t, UINT64_MAX);
     mutex_unlock(&s_audio_mutex);
     vm_write64(stamp_ea, t);
