+/* PS3_FTRACE: which job module an SPU is in, and for how long [GT6 0057]. A Gran Turismo 6 frame waits for SPU jobs
+ * to write the cars' RSX commands (the walker stands parked on a self-jump, tools\ftrace_chain.py), and the
+ * timeline said only that an SPU was busy, not with what. Every job fetches its input and stores its output
+ * through the MFC, so the commands mark its run: a span opens at the first command issued from a lifted image -
+ * the resident code slot the pc is in, which is the job binary the policy module loaded, else the context's own
+ * image - and closes when a command comes from another image or the SPU goes into a channel wait
+ * (spu_ft_wait_span, spu_channels.c). Called only while recording. */
+#if defined(_MSC_VER)
+#  define SPU_FT_TLS __declspec(thread)
+#else
+#  define SPU_FT_TLS __thread
+#endif
+static inline void spu_ft_module_note(spu_context* spu, int closing)
+{
+    static SPU_FT_TLS struct { uint64_t t0, t1; int img; uint32_t n, id, wid; } r;
+    int img = -1;
+    if (!closing) {
+        const uint32_t pc = (uint32_t)spu->pc & SPU_LS_MASK;
+        img = spu->image_id;
+        for (unsigned s = 0; s < spu->resident_code_count; ++s)
+            if (spu->resident_code[s].image_id && pc >= spu->resident_code[s].lsa &&
+                pc - spu->resident_code[s].lsa < spu->resident_code[s].size) { img = spu->resident_code[s].image_id; break; }
+    }
+    if (r.n && (closing || img != r.img || r.id != spu->spu_id)) {
+        ps3_ft_span(PS3_FT_SPU_MODULE, r.id, (uint32_t)r.img, (r.n & 0xFFFFFFu) | (r.wid << 24), r.t0, r.t1);
+        r.n = 0;
+    }
+    if (closing) return;
+    const uint64_t now = ps3_ft_now();
+    if (!r.n) {
+        const uint8_t* w = spu->ls + 0x1DC;
+        r.t0 = now; r.img = img; r.id = spu->spu_id;
+        r.wid = (((uint32_t)w[0] << 24) | ((uint32_t)w[1] << 16) | ((uint32_t)w[2] << 8) | w[3]) & 0xFFu;
+    }
+    r.t1 = now; r.n++;
+}
