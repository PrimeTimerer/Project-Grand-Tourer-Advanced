+             * The FP emitter brackets source operands, so rejecting a bare
+             * comma argument is conservative and does not miss its output. */
+            if (previous.kind == ',' || (previous.kind == 1 &&
+                !((previous.end - previous.begin == 6 && !memcmp(source + previous.begin, "return", 6)) ||
+                  (previous.end - previous.begin == 4 && !memcmp(source + previous.begin, "else", 4)) ||
+                  (previous.end - previous.begin == 2 && !memcmp(source + previous.begin, "do", 2))))) goto reject;
