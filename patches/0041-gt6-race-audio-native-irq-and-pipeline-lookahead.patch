diff --git a/libs/video/tests/test_shader_compile_jobs.c b/libs/video/tests/test_shader_compile_jobs.c
new file mode 100644
index 0000000..dd2339d
--- /dev/null
+++ b/libs/video/tests/test_shader_compile_jobs.c
@@ -0,0 +1,393 @@
+/* Disposable CPU-only fixture: in-memory sources, DXBC blobs and worker threads.
+ * No game process, save data, disk shader cache, D3D device or GPU operations. */
+#define _WIN32_WINNT 0x0A00
+#define _CRT_SECURE_NO_WARNINGS
+#include <windows.h>
+#include <d3dcompiler.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+struct ld_scj_state;
+struct ld_scj_job;
+static void* fixture_allocate(size_t bytes);
+static void fixture_free(void* pointer);
+static HANDLE fixture_thread(LPTHREAD_START_ROUTINE procedure, void* argument);
+static void fixture_owned(struct ld_scj_state*, struct ld_scj_job*);
+static void fixture_before_compile(struct ld_scj_state*, struct ld_scj_job*);
+static HRESULT WINAPI fixture_compile(LPCVOID source, SIZE_T length, LPCSTR name,
+    const D3D_SHADER_MACRO* defines, ID3DInclude* include, LPCSTR entry, LPCSTR profile,
+    UINT flags, UINT flags2, ID3DBlob** blob, ID3DBlob** error);
+#define LD_SCJ_MAX_JOBS 8u
+#define LD_SCJ_MAX_PENDING 4u
+#define LD_SCJ_MAX_READY 4u
+#define LD_SCJ_MAX_SOURCE_BYTES 4096u
+#define LD_SCJ_MAX_BLOB_BYTES 8192u
+#define LD_SCJ_MAX_BLOB 4096u
+#define LD_SCJ_ALLOC fixture_allocate
+#define LD_SCJ_FREE fixture_free
+#define LD_SCJ_CREATE_THREAD fixture_thread
+#define LD_SCJ_COMPILE fixture_compile
+#define LD_SCJ_REQUEST_OWNED_HOOK fixture_owned
+#define LD_SCJ_BEFORE_COMPILE_HOOK fixture_before_compile
+#include "../rsx_shader_compile_jobs.h"
+
+static unsigned checks;
+static volatile LONG live_allocations, fail_allocation, create_calls, fail_create;
+static volatile LONG gate_enabled, entered_workers, owned_enabled;
+static volatile LONG fail_scalar_once, forced_blob_size, flags_errors, expected_vs_flags;
+static HANDLE compile_release, compile_entered, owned_release, owned_entered;
+static const char pixel_a[] = "float4 main():SV_TARGET { return float4(1,0,0,1); }";
+static const char pixel_b[] = "float4 main():SV_TARGET { return float4(0,1,0,1); }";
+static const char vertex[] = "float4 main(uint id:SV_VertexID):SV_POSITION { return float4(id,0,0,1); }";
+static const char scalar_pixel[] =
+    "struct PSInput { float4 position:SV_POSITION; float4 col0:COLOR0; };\n"
+    "float4 main(PSInput input) : SV_TARGET {\n"
+    "float4 r[48]; float4 h[48];\n"
+    "[unroll] for (int _i = 0; _i < 48; _i++) { r[_i] = (float4)0; h[_i] = (float4)0; }\n"
+    "r[0] = input.col0; h[2].x = r[0].y; return r[0] + h[2];\n}\n";
+
+static void check(int ok, const char* label)
+{
+    ++checks;
+    if (!ok) { fprintf(stderr, "FAIL: %s\n", label); exit(1); }
+    printf("PASS: %s\n", label);
+}
+
+static void* fixture_allocate(size_t bytes)
+{
+    if (InterlockedCompareExchange(&fail_allocation, 0, 1) == 1) return NULL;
+    void* pointer = malloc(bytes);
+    if (pointer) InterlockedIncrement(&live_allocations);
+    return pointer;
+}
+static void fixture_free(void* pointer)
+{ if (pointer) { InterlockedDecrement(&live_allocations); free(pointer); } }
+static HANDLE fixture_thread(LPTHREAD_START_ROUTINE procedure, void* argument)
+{
+    const LONG call = InterlockedIncrement(&create_calls);
+    if (call == InterlockedCompareExchange(&fail_create, 0, 0)) return NULL;
+    return CreateThread(NULL, 0, procedure, argument, 0, NULL);
+}
+static void fixture_owned(struct ld_scj_state* state, struct ld_scj_job* job)
+{
+    (void)state; (void)job;
+    if (InterlockedCompareExchange(&owned_enabled, 0, 1) == 1) {
+        SetEvent(owned_entered); WaitForSingleObject(owned_release, INFINITE);
+    }
+}
+static void fixture_before_compile(struct ld_scj_state* state, struct ld_scj_job* job)
+{
+    (void)state; (void)job;
+    if (InterlockedCompareExchange(&gate_enabled, 0, 0)) {
+        if (InterlockedIncrement(&entered_workers) >= 2) SetEvent(compile_entered);
+        WaitForSingleObject(compile_release, INFINITE);
+    }
+}
+static HRESULT WINAPI fixture_compile(LPCVOID source, SIZE_T length, LPCSTR name,
+    const D3D_SHADER_MACRO* defines, ID3DInclude* include, LPCSTR entry, LPCSTR profile,
+    UINT flags, UINT flags2, ID3DBlob** blob, ID3DBlob** error)
+{
+    if (flags2 || (profile[0] == 'v' ? flags != (UINT)InterlockedCompareExchange(&expected_vs_flags, 0, 0)
+                                     : flags != 0)) InterlockedIncrement(&flags_errors);
+    if (strstr((const char*)source, "_rsx_fp_") &&
+        InterlockedCompareExchange(&fail_scalar_once, 0, 1) == 1) {
+        *blob = NULL; if (error) *error = NULL; return E_FAIL;
+    }
+    const LONG bytes = InterlockedCompareExchange(&forced_blob_size, 0, 0);
+    if (bytes) {
+        if (error) *error = NULL;
+        HRESULT result = D3DCreateBlob((SIZE_T)bytes, blob);
+        if (SUCCEEDED(result)) {
+            memset((*blob)->lpVtbl->GetBufferPointer(*blob), 0xC1, (size_t)bytes);
+            memcpy((*blob)->lpVtbl->GetBufferPointer(*blob), "DXBC", 4);
+        }
+        return result;
+    }
+    return D3DCompile(source, length, name, defines, include, entry, profile, flags, flags2, blob, error);
+}
+
+static void begin(ld_scj_state* state, int trim, int scalar, UINT flags)
+{
+    InterlockedExchange(&expected_vs_flags, (LONG)flags);
+    check(ld_scj_begin(state, trim, scalar, flags), "two-worker pool begins");
+}
+static void stop(ld_scj_state* state)
+{
+    ld_scj_shutdown(state);
+    ld_scj_stats stats; ld_scj_snapshot(state, &stats);
+    check(stats.state == LD_SCJ_STOPPED && !stats.jobs && !stats.pending && !stats.running &&
+          !stats.ready && !stats.source_bytes && !stats.blob_bytes && !stats.reserved && !stats.reserved_source_bytes,
+          "shutdown joins and frees all retained state");
+    check(!InterlockedCompareExchange(&live_allocations, 0, 0), "owned job allocations balanced");
+}
+static ld_scj_job* request(ld_scj_state* state, unsigned stage, const char* source, uint64_t hash)
+{ return ld_scj_request(state, stage, source, (uint32_t)strlen(source), hash); }
+static ID3DBlob* acquire(ld_scj_state* state, unsigned stage, const char* source, uint64_t hash, int wait)
+{ return ld_scj_acquire(state, stage, source, (uint32_t)strlen(source), hash, wait); }
+static void release(ID3DBlob* blob) { if (blob) blob->lpVtbl->Release(blob); }
+static ID3DBlob* reference(const char* source, unsigned stage, UINT flags, int trim)
+{
+    size_t length = strlen(source); char* copy = NULL;
+    if (trim && stage == 'P') { copy = ld_scj_trim_copy(source, (uint32_t)length, &length); if (copy) source = copy; }
+    ID3DBlob *blob = NULL, *error = NULL;
+    HRESULT result = D3DCompile(source, length, stage == 'V' ? "xvs" : "xps", NULL, NULL,
+        "main", stage == 'V' ? "vs_5_0" : "ps_5_0", flags, 0, &blob, &error);
+    free(copy); release(error); check(SUCCEEDED(result) && blob, "reference CPU compiler succeeds"); return blob;
+}
+static void same(ID3DBlob* actual, ID3DBlob* expected)
+{
+    check(actual && expected && actual->lpVtbl->GetBufferSize(actual) == expected->lpVtbl->GetBufferSize(expected) &&
+          !memcmp(actual->lpVtbl->GetBufferPointer(actual), expected->lpVtbl->GetBufferPointer(expected),
+                  actual->lpVtbl->GetBufferSize(actual)), "entire acquired DXBC matches direct compilation");
+}
+static void gate_start(void)
+{
+    ResetEvent(compile_release); ResetEvent(compile_entered);
+    InterlockedExchange(&entered_workers, 0); InterlockedExchange(&gate_enabled, 1);
+}
+static void gate_finish(void)
+{ InterlockedExchange(&gate_enabled, 0); SetEvent(compile_release); }
+static void wait_pending(ld_scj_state* state)
+{
+    for (unsigned i = 0; i < 10000; ++i) {
+        ld_scj_stats stats; ld_scj_snapshot(state, &stats);
+        if (!stats.pending) return;
+        Sleep(1);
+    }
+    check(0, "CPU workers complete within fixture deadline");
+}
+
+typedef struct fixture_call {
+    ld_scj_state* state;
+    const char* source;
+    unsigned stage;
+    uint64_t hash;
+    ld_scj_job* job;
+    ID3DBlob* blob;
+    HANDLE done;
+} fixture_call;
+static DWORD WINAPI request_thread(void* p)
+{
+    fixture_call* call = (fixture_call*)p;
+    call->job = request(call->state, call->stage, call->source, call->hash);
+    if (call->done) SetEvent(call->done); return 0;
+}
+static DWORD WINAPI acquire_thread(void* p)
+{
+    fixture_call* call = (fixture_call*)p;
+    call->blob = acquire(call->state, call->stage, call->source, call->hash, 1);
+    if (call->done) SetEvent(call->done); return 0;
+}
+static DWORD WINAPI stop_thread(void* p)
+{ ld_scj_shutdown((ld_scj_state*)p); return 0; }
+static void join(HANDLE thread)
+{ check(WaitForSingleObject(thread, 10000) == WAIT_OBJECT_0, "fixture thread joins"); CloseHandle(thread); }
+
+int main(void)
+{
+    ld_scj_state state = { 0 };
+    compile_release = CreateEventA(NULL, TRUE, TRUE, NULL);
+    compile_entered = CreateEventA(NULL, TRUE, FALSE, NULL);
+    owned_release = CreateEventA(NULL, TRUE, FALSE, NULL);
+    owned_entered = CreateEventA(NULL, TRUE, FALSE, NULL);
+    check(compile_release && compile_entered && owned_release && owned_entered, "fixture owns synchronization events");
+    check(!request(&state, 'P', pixel_a, 1) && !acquire(&state, 'P', pixel_a, 1, 1), "calls before begin safely fall back");
+    ld_scj_shutdown(&state);
+    InterlockedExchange(&create_calls, 0); InterlockedExchange(&fail_create, 2);
+    check(!ld_scj_begin(&state, 1, 1, 4), "second worker creation failure rejects initialization");
+    check(state.state == LD_SCJ_STOPPED && !state.threads_count, "partially created worker is joined");
+    check(!request(&state, 'P', pixel_a, 1), "request after failed initialization falls back");
+    InterlockedExchange(&fail_create, 0);
+
+    begin(&state, 1, 1, 4);
+    check(!ld_scj_begin(&state, 1, 1, 4), "live pool is not reinitialized");
+    check(!request(&state, 'X', pixel_a, 1) && !ld_scj_request(&state, 'P', pixel_a, LD_SCJ_MAX_SOURCE + 1u, 1),
+          "stage and individual source cap checked before reading input");
+    InterlockedExchange(&fail_allocation, 1);
+    check(!request(&state, 'P', pixel_a, 1), "allocation failure leaves synchronous fallback available");
+    ld_scj_job* a = request(&state, 'P', pixel_a, 77);
+    check(a && request(&state, 'P', pixel_a, 77) == a, "exact duplicate returns same opaque job");
+    ld_scj_job* b = request(&state, 'P', pixel_b, 77);
+    check(b && b != a && strlen(pixel_a) == strlen(pixel_b), "equal hash and length still compare every byte");
+    check(request(&state, 'V', vertex, 88) != NULL, "independent VS job accepted");
+    ID3DBlob* actual_a = acquire(&state, 'P', pixel_a, 77, 1);
+    ID3DBlob* expected_a = reference(pixel_a, 'P', 0, 0); same(actual_a, expected_a);
+    ID3DBlob* actual_b = acquire(&state, 'P', pixel_b, 77, 1);
+    ID3DBlob* expected_b = reference(pixel_b, 'P', 0, 0); same(actual_b, expected_b);
+    ID3DBlob* actual_v = acquire(&state, 'V', vertex, 88, 1);
+    ID3DBlob* expected_v = reference(vertex, 'V', 4, 0); same(actual_v, expected_v);
+    check(!acquire(&state, 'P', pixel_a, 78, 0), "different hash cannot return another job");
+    ld_scj_job* wrong_stage = request(&state, 'V', pixel_a, 77);
+    check(wrong_stage && wrong_stage != a, "shader stage participates in exact identity");
+    check(!acquire(&state, 'V', pixel_a, 77, 1), "invalid stage program falls back after compiler error");
+    check(request(&state, 'V', pixel_a, 77) == wrong_stage && !acquire(&state, 'V', pixel_a, 77, 1),
+          "failed job is deduplicated without repeated background compilation");
+    stop(&state);
+    same(actual_a, expected_a); /* caller AddRef survives pool destruction */
+    release(actual_a); release(expected_a); release(actual_b); release(expected_b); release(actual_v); release(expected_v);
+    check(!request(&state, 'P', pixel_a, 77) && !acquire(&state, 'P', pixel_a, 77, 1), "calls after stop safely fall back");
+    ld_scj_shutdown(&state);
+
+    begin(&state, 1, 1, 0);
+    InterlockedExchange(&fail_scalar_once, 1);
+    check(request(&state, 'P', scalar_pixel, 101) != NULL, "scalar-capable PS queued");
+    ID3DBlob* scalar_blob = acquire(&state, 'P', scalar_pixel, 101, 1);
+    ID3DBlob* scalar_expected = reference(scalar_pixel, 'P', 0, 1); same(scalar_blob, scalar_expected);
+    ld_scj_stats stats; ld_scj_snapshot(&state, &stats);
+    check(stats.scalar_fallbacks == 1 && stats.compile_attempts == 2 && stats.compiled_jobs == 1,
+          "injected scalar compiler failure retries unchanged existing trim path");
+    release(scalar_blob); release(scalar_expected); stop(&state);
+
+    begin(&state, 0, 1, 0); InterlockedExchange(&fail_scalar_once, 1);
+    check(request(&state, 'P', scalar_pixel, 102) != NULL, "unmodified PS queued with trim disabled");
+    scalar_blob = acquire(&state, 'P', scalar_pixel, 102, 1);
+    scalar_expected = reference(scalar_pixel, 'P', 0, 0); same(scalar_blob, scalar_expected);
