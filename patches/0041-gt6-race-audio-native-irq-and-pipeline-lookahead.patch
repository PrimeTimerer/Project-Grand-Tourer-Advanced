--- /dev/null
+++ b/runtime/spu/spu_gt6_irq.h
@@ -0,0 +1,124 @@
+/* GT6 WWS IRQ glue translated to native C, with live byte identity checked on
+ * EVERY resolution. Nothing from this path enters the ordinary dispatch cache:
+ * the save/restore thunk at 3FEC0 changes on each invocation. The interrupt is
+ * disabled throughout these bounded blocks. AD0..AEC (including iret and its
+ * host IRQ-frame restoration) continues in the full interpreter, as the old
+ * AB4 stqx handoff did. Sending it through microstep would change host unwind.
+ * GT6_NATIVE_PDI_IRQ=1 opts in; unknown images/bytes/diagnostics fall back. */
+#ifndef SPU_GT6_IRQ_H
+#define SPU_GT6_IRQ_H
+#include "spu_gt6_irq_code.h"
+
+static void spu_gt6_irq_transfer(spu_context* ctx, uint32_t pc)
+{
+    ctx->pc = pc & 0x3FFFCu;
+    g_spu_trampoline_fn = spu_indirect_branch;
+}
+
+static void spu_gt6_irq_save(spu_context* ctx)
+{
+    spu_ls_write128(ctx, 0x1560, ctx->gpr[78]);
+    ctx->gpr[78] = spu_il(0);
+    for (unsigned r = 76; r < 80; ++r)
+        spu_ls_write128(ctx, 0x3FE80 + 16*(r-76), ctx->gpr[r]);
+    ctx->gpr[76] = spu_ila(0x3FEC0);
+    ctx->gpr[77] = spu_ls_read128(ctx, 0xA40);
+    ctx->gpr[78] = spu_ila(0x130);
+    ctx->gpr[79] = spu_ila(0x804);
+    do {
+        ctx->gpr[77] = spu_sf(ctx->gpr[79], ctx->gpr[77]);
+        ctx->gpr[78] = spu_ai(ctx->gpr[78], -16);
+        spu_ls_write128(ctx, ctx->gpr[76]._u32[0] + ctx->gpr[78]._u32[0], ctx->gpr[77]);
+    } while (ctx->gpr[78]._u32[0]);
+    ctx->gpr[79] = spu_ilhu(0x3500);
+    ctx->gpr[79] = spu_iohl(ctx->gpr[79], 0x2780);
+    spu_ls_write128(ctx, 0x3FFF0, ctx->gpr[79]);
+    /* sync is a no-op in the interpreter: DMA is already synchronous here. */
+    ctx->gpr[79] = spu_link(0xA84);
+    spu_gt6_irq_transfer(ctx, 0x3FEC0);
+}
+
+static void spu_gt6_irq_handler_call(spu_context* ctx)
+{
+    ctx->gpr[78] = spu_il(-2032);
+    ctx->gpr[1] = spu_a(ctx->gpr[1], ctx->gpr[78]);
+    ctx->gpr[0] = spu_link(0xA90);
+    spu_gt6_irq_transfer(ctx, 0x2338);
+}
+
+static void spu_gt6_irq_restore(spu_context* ctx)
+{
+    ctx->gpr[78] = spu_il(2032);
+    ctx->gpr[1] = spu_a(ctx->gpr[1], ctx->gpr[78]);
+    ctx->gpr[77] = spu_ls_read128(ctx, 0xAD0);
+    ctx->gpr[76] = spu_ila(0x3FEC0);
+    ctx->gpr[78] = spu_ila(0x130);
+    ctx->gpr[79] = spu_ila(0x804);
+    do {
+        ctx->gpr[77] = spu_sf(ctx->gpr[79], ctx->gpr[77]);
+        ctx->gpr[78] = spu_ai(ctx->gpr[78], -16);
+        spu_ls_write128(ctx, ctx->gpr[76]._u32[0] + ctx->gpr[78]._u32[0], ctx->gpr[77]);
+    } while (ctx->gpr[78]._u32[0]);
+    ctx->gpr[79] = spu_ilhu(0x3500);
+    ctx->gpr[79] = spu_iohl(ctx->gpr[79], 0x2780);
+    spu_ls_write128(ctx, 0x3FFF0, ctx->gpr[79]);
+    ctx->gpr[79] = spu_link(0xAD0);
+    spu_gt6_irq_transfer(ctx, 0x3FEC0);
+}
+
+static void spu_gt6_irq_save_regs(spu_context* ctx)
+{
+    for (unsigned r = 0; r < 76; ++r)
+        spu_ls_write128(ctx, 0x3F9C0 + 16*r, ctx->gpr[r]);
+    spu_gt6_irq_transfer(ctx, ctx->gpr[79]._u32[0]);
+}
+
+static void spu_gt6_irq_restore_regs(spu_context* ctx)
+{
+    for (unsigned r = 0; r < 76; ++r)
+        ctx->gpr[r] = spu_ls_read128(ctx, 0x3F9C0 + 16*r);
+    const uint32_t target = ctx->gpr[79]._u32[0] & 0x3FFFCu;
+    if (target == 0xAD0) {
+        /* Preserve the previous AB4 -> full-interpreter IRET contract. Its
+         * IRQ snapshot must be consumed before a drain return-PC check or a
+         * new indirect dispatch can trigger the host IRQ longjmp path. */
+        const uint32_t return_pc = ctx->drain_ret_pc;
+        spu_interp_run_until(ctx, target, return_pc);
+        if (ctx->image_id >= 0 && (ctx->status & SPU_STATUS_RUNNING) &&
+            (!return_pc || (ctx->pc & SPU_LS_MASK) != return_pc) &&
+            spu_lifted_lookup(ctx, ctx->pc))
+            g_spu_trampoline_fn = spu_indirect_branch;
+    } else {
+        spu_gt6_irq_transfer(ctx, target);
+    }
+}
+
+static spu_lifted_fn spu_gt6_irq_lookup(const spu_context* ctx, uint32_t pc)
+{
+    switch (pc) {
+    case 0xA2C: case 0xA30: case 0xA34: case 0xA84: case 0xA90: case 0x3FEC0: break;
+    default: return NULL;
+    }
+    static int enabled = -1;
+    int on = __atomic_load_n(&enabled, __ATOMIC_ACQUIRE);
+    if (on < 0) {
+        const char* env = getenv("GT6_NATIVE_PDI_IRQ");
+        on = env && env[0] == '1' && env[1] == '\0';
+        __atomic_store_n(&enabled, on, __ATOMIC_RELEASE);
+    }
+    if (!on || !ctx || ctx->image_id != 364260230 || ctx->int_enable ||
+        g_spu_ls_watch_n != 0 || g_spu_ls_probe != 0 || g_spu_smc_watch != 0 ||
+        memcmp(ctx->ls + 0xA2C, spu_gt6_irq_code, sizeof spu_gt6_irq_code)) return NULL;
+    switch (pc) {
+    case 0xA2C: case 0xA30: case 0xA34: return spu_gt6_irq_save;
+    case 0xA84: return spu_gt6_irq_handler_call;
+    case 0xA90: return spu_gt6_irq_restore;
+    default:
+        if (!memcmp(ctx->ls + 0x3FEC0, spu_gt6_irq_save_code, sizeof spu_gt6_irq_save_code))
+            return spu_gt6_irq_save_regs;
+        if (!memcmp(ctx->ls + 0x3FEC0, spu_gt6_irq_restore_code, sizeof spu_gt6_irq_restore_code))
+            return spu_gt6_irq_restore_regs;
+        return NULL;
+    }
+}
+#endif
