diff --git a/libs/video/rsx_fifo_prepare_scan.h b/libs/video/rsx_fifo_prepare_scan.h
new file mode 100644
index 0000000..c637e3e
--- /dev/null
+++ b/libs/video/rsx_fifo_prepare_scan.h
@@ -0,0 +1,89 @@
+/* Read-only, bounded lookahead of already published FIFO commands. This is
+ * only a preparation hint: it never executes a transfer, writes a label/GET,
+ * signals a flip, repairs a branch, or substitutes a draw. The real walker
+ * remains authoritative. Caller snapshots all state affected by its sink. */
+#ifndef RSX_FIFO_PREPARE_SCAN_H
+#define RSX_FIFO_PREPARE_SCAN_H
+#include <stdint.h>
+#include <string.h>
+
+typedef int (*rsx_prepare_read)(void*, uint32_t, uint32_t*);
+typedef int (*rsx_prepare_packet)(void*, uint32_t, int, const uint32_t*, uint32_t);
+typedef struct rsx_prepare_scan_result {
+    uint32_t words, packets, branches, draws, stop_io, reason;
+} rsx_prepare_scan_result;
+enum { RSX_PREPARE_PUT=1, RSX_PREPARE_UNMAPPED, RSX_PREPARE_BARRIER,
+       RSX_PREPARE_PARK, RSX_PREPARE_INVALID, RSX_PREPARE_BUDGET, RSX_PREPARE_SINK };
+
+static int rsx_prepare_barrier(uint32_t method)
+{
+    /* Host/guest-visible effects and DMA context changes. Do not speculate
+     * past a producer handshake or a report/transfer that changes memory. */
+    switch (method) {
+    case 0x0000: case 0x0050: case 0x0064: case 0x0068: case 0x006c:
+    case 0x0104: case 0x0180: case 0x01a4: case 0x01a8: case 0x1800:
+    case 0x1d6c: case 0x1d70: case 0x1d74:
+        return 1;
+    default: return 0;
+    }
+}
+
+static rsx_prepare_scan_result rsx_fifo_prepare_scan(void* reader, rsx_prepare_read read,
+    void* sink, rsx_prepare_packet packet, uint32_t cursor, uint32_t put,
+    uint32_t return_io, uint32_t word_budget, uint32_t draw_budget)
+{
+    rsx_prepare_scan_result result = {0};
+    uint32_t data[2047];
+    if (!read || !packet || (cursor & 3u) || (put & 3u)) {
+        result.reason = RSX_PREPARE_INVALID; return result;
+    }
+    while (result.words < word_budget && result.draws < draw_budget) {
+        uint32_t word;
+        result.stop_io = cursor;
+        if (cursor == put) { result.reason = RSX_PREPARE_PUT; return result; }
+        if (!read(reader, cursor, &word)) { result.reason = RSX_PREPARE_UNMAPPED; return result; }
+        ++result.words;
+        if (!word) { cursor += 4u; continue; }
+        const uint32_t type = word >> 29;
+        if (type == 1u || (word & 3u) == 2u) {
+            const uint32_t target = word & 0x1ffffffcu;
+            if (target == cursor) { result.reason = RSX_PREPARE_PARK; return result; }
+            if (++result.branches > 256u) break;
+            if (type != 1u) {
+                if (return_io) { result.reason = RSX_PREPARE_INVALID; return result; }
+                return_io = cursor + 4u;
+            }
+            cursor = target; continue;
+        }
+        if (word == 0x00020000u) {
+            if (!return_io) { result.reason = RSX_PREPARE_INVALID; return result; }
+            cursor = return_io; return_io = 0; continue;
+        }
+        if (type != 0u && type != 2u) { result.reason = RSX_PREPARE_INVALID; return result; }
+        const uint32_t count = (word >> 18) & 0x7ffu;
+        const uint32_t method = word & 0x1ffcu;
+        const uint32_t subchannel = (word >> 13) & 7u;
+        if (subchannel != 0u || !count || (type == 0u && method + (count - 1u)*4u > 0x1ffcu)) {
+            result.reason = RSX_PREPARE_BARRIER; return result;
+        }
+        const uint32_t next = cursor + 4u + count*4u;
+        if (next < cursor || (cursor < put && next > put) || count > word_budget-result.words) {
+            result.reason = RSX_PREPARE_BUDGET; return result;
+        }
+        uint32_t packet_draws=0;
+        for (uint32_t i=0; i<count; ++i) {
+            const uint32_t m = method + (type == 0u ? i*4u : 0u);
+            if (rsx_prepare_barrier(m)) { result.reason = RSX_PREPARE_BARRIER; return result; }
+            if (!read(reader, cursor+4u+i*4u, &data[i])) { result.reason = RSX_PREPARE_UNMAPPED; return result; }
+            if (m == 0x1808u && !data[i] && ++packet_draws > draw_budget-result.draws) {
+                result.reason=RSX_PREPARE_BUDGET; return result;
+            }
+        }
+        result.words += count; result.draws += packet_draws; ++result.packets;
+        if (!packet(sink, method, type == 0u, data, count)) { result.reason = RSX_PREPARE_SINK; return result; }
+        cursor = next;
+    }
+    result.stop_io = cursor; result.reason = RSX_PREPARE_BUDGET;
+    return result;
+}
+#endif
diff --git a/libs/video/rsx_fp_compile_scalar.h b/libs/video/rsx_fp_compile_scalar.h
new file mode 100644
index 0000000..8c1e53b
--- /dev/null
+++ b/libs/video/rsx_fp_compile_scalar.h
@@ -0,0 +1,251 @@
+/* Compile-input-only specialization of the FP emitter's temporary registers.
+ * Static r[n]/h[n] elements are independent float4 locals with the same zero
+ * initialization and operations. Main-body control flow is rejected because
+ * FXC may choose different branch/register optimizations. HLSL/cache identity
+ * must remain unchanged. Unsupported source returns NULL, without mutation.
+ * Returned storage is owned by the caller and must be freed with free(). */
+#ifndef RSX_FP_COMPILE_SCALAR_H
+#define RSX_FP_COMPILE_SCALAR_H
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct rsx_fp_scalar_result {
+    size_t source_length;
+    unsigned declared_registers, scalar_registers, register_references;
+} rsx_fp_scalar_result;
+
+typedef struct rsx_fp_scalar_token {
+    size_t begin, end;
+    int kind; /* 1: identifier, 2: number/string, otherwise punctuation */
+} rsx_fp_scalar_token;
+
+static int rsx_fp_scalar_space(unsigned c)
+{ return c == ' ' || c == '\t' || c == '\r' || c == '\n'; }
+static int rsx_fp_scalar_ident(unsigned c)
+{ return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'; }
+static int rsx_fp_scalar_digit(unsigned c) { return c >= '0' && c <= '9'; }
+
+static int rsx_fp_scalar_control(const char* word, size_t length)
+{
+    static const char* const words[] = {
+        "if", "else", "for", "while", "do", "switch", "case", "break", "continue", "goto"
+    };
+    for (unsigned i = 0; i < sizeof(words) / sizeof(words[0]); ++i)
+        if (strlen(words[i]) == length && !memcmp(word, words[i], length)) return 1;
+    return 0;
+}
+
+/* Comments and strings are never interpreted as register references. */
+static int rsx_fp_scalar_next(const char* s, size_t length, size_t* cursor,
+                              rsx_fp_scalar_token* token)
+{
+    size_t p = *cursor;
+    for (;;) {
+        while (p < length && rsx_fp_scalar_space((unsigned char)s[p])) ++p;
+        if (p == length) { *cursor = p; return 0; }
+        if (s[p] == '/' && p + 1 < length && s[p + 1] == '/') {
+            p += 2; while (p < length && s[p] != '\n') ++p; continue;
+        }
+        if (s[p] == '/' && p + 1 < length && s[p + 1] == '*') {
