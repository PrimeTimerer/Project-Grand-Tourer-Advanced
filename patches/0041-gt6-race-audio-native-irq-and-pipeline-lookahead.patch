+/* CPU-only, immutable HLSL -> DXBC preparation. No renderer, guest memory,
+ * disk cache, D3D device or command-list access is permitted in this helper.
+ *
+ * Zero-initialize ld_scj_state once and keep its address stable. The owner
+ * serializes begin/shutdown; request/acquire/snapshot may run concurrently.
+ * request returns an opaque success token, valid only until shutdown. Callers
+ * must use exact-source acquire rather than dereferencing/retaining that job.
+ * acquire returns an independent AddRef; it remains valid after shutdown.
+ * request never waits for compilation. acquire(wait=1) waits for its exact job.
+ */
+#ifndef RSX_SHADER_COMPILE_JOBS_H
+#define RSX_SHADER_COMPILE_JOBS_H
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <windows.h>
+#include <d3dcompiler.h>
+#include "rsx_fp_compile_init.h"
+#include "rsx_fp_compile_scalar.h"
+
+#ifndef LD_SCJ_MAX_JOBS
+#define LD_SCJ_MAX_JOBS 4096u
+#endif
+#ifndef LD_SCJ_MAX_PENDING
+#define LD_SCJ_MAX_PENDING 256u
+#endif
+#ifndef LD_SCJ_MAX_READY
+#define LD_SCJ_MAX_READY 4096u
+#endif
+#ifndef LD_SCJ_MAX_SOURCE_BYTES
+#define LD_SCJ_MAX_SOURCE_BYTES (32u * 1024u * 1024u)
+#endif
+#ifndef LD_SCJ_MAX_BLOB_BYTES
+#define LD_SCJ_MAX_BLOB_BYTES (64u * 1024u * 1024u)
+#endif
+#ifndef LD_SCJ_MAX_SOURCE
+#define LD_SCJ_MAX_SOURCE (256u * 1024u)
+#endif
+#ifndef LD_SCJ_MAX_BLOB
+#define LD_SCJ_MAX_BLOB (4u * 1024u * 1024u)
+#endif
+#define LD_SCJ_BUCKETS 2048u
+#ifndef LD_SCJ_ALLOC
+#define LD_SCJ_ALLOC malloc
+#endif
+#ifndef LD_SCJ_FREE
+#define LD_SCJ_FREE free
+#endif
+#ifndef LD_SCJ_COMPILE
+#define LD_SCJ_COMPILE D3DCompile
+#endif
+#ifndef LD_SCJ_CREATE_THREAD
+#define LD_SCJ_CREATE_THREAD(fn, argument) CreateThread(NULL, 0, fn, argument, 0, NULL)
+#endif
+#ifndef LD_SCJ_REQUEST_OWNED_HOOK
+#define LD_SCJ_REQUEST_OWNED_HOOK(state, job) ((void)0)
