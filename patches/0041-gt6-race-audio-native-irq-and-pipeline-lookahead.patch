+static IAudioRenderClientVtbl fake_render_vtable = { .GetBuffer = fake_get_buffer, .ReleaseBuffer = fake_release_buffer };
+static IAudioClient fake_client = { &fake_client_vtable };
+static IAudioRenderClient fake_render = { &fake_render_vtable };
+
+static u32 destination(u32 slot) { return (u32)s_ports[0].port_addr + slot*8192; }
+static AudioFlowRecord* mix_and_output(void)
+{
+    audio_flow_begin_block();
+    audio_mix_one_block();
+    assert(s_flow_output_record < s_flow_count);
+    AudioFlowRecord* c = &s_flow_records[s_flow_output_record];
+    assert(c->kind == 2 && c->port_generation);
+    audio_backend_submit(s_mix_buffer, 256);
+    assert(c->output.qpc_end >= c->output.qpc_begin && c->output.qpc_begin >= c->qpc_end);
+    assert(c->output.stream_generation == 7);
