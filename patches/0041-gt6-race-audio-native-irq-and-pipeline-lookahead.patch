diff --git a/runtime/syscalls/sys_usleep_trace.h b/runtime/syscalls/sys_usleep_trace.h
new file mode 100644
index 0000000..f428e39
--- /dev/null
+++ b/runtime/syscalls/sys_usleep_trace.h
@@ -0,0 +1,279 @@
+/* Opt-in, one-window Windows usleep diagnostic. Included only by sys_timer.c.
+ *
+ * The guest thread never opens/writes a file. An owned writer seals this
+ * bounded buffer at the deadline or capacity, then writes it once. Calls
+ * still in flight when sealed are reported as censored/dropped; the writer
+ * never waits for a possibly unbounded guest sleep. No guest memory is read.
+ * State has process lifetime: sys_timer_init invokes the initializer once.
+ */
+#ifndef PS3_SYS_USLEEP_TRACE_H
+#define PS3_SYS_USLEEP_TRACE_H
+
+#ifdef _WIN32
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <windows.h>
+#include "../ppu/ppu_context.h"
+
+#define SYS_UST_CAPACITY 65536u
+#define SYS_UST_MAX_WINDOW_MS 3600000u
+
+enum sys_ust_backend {
+    SYS_UST_ZERO = 0,
+    SYS_UST_HIGHRES = 1,
+    SYS_UST_TIMER = 2,
+    SYS_UST_SLEEP = 3,
+    SYS_UST_YIELD = 4
+};
+
+typedef struct sys_ust_record {
+    LONGLONG begin_qpc, end_qpc;
+    uint64_t requested_us, guest_tid, guest_lr, guest_cia;
+    uint64_t r28, r30, r31;
+    unsigned backend;
+} sys_ust_record;
+
+typedef struct sys_ust_state {
+    SRWLOCK lock;
+    /* Only a fast rejection hint. Every shared buffer access takes lock and
+     * rechecks closed. A stale positive observation cannot access freed data.
+     * Init precedes guest threads; shutdown only changes this from 1 to 0. */
+    volatile LONG enabled;
+    volatile LONG finished;
+    int closed, reason;
+    HANDLE wake;
+    char* path;
+    sys_ust_record* records;
+    unsigned capacity, count;
+    uint64_t admitted, inflight, dropped_deadline, dropped_capacity;
+    uint64_t tid, after_ms, duration_ms;
+    int filter_tid;
+    LONGLONG origin_qpc, first_qpc, deadline_qpc, close_qpc, frequency;
+} sys_ust_state;
+
+static sys_ust_state s_sys_ust;
+static INIT_ONCE s_sys_ust_once = INIT_ONCE_STATIC_INIT;
+
+static const char* sys_ust_backend_name(unsigned backend)
+{
+    switch (backend) {
+    case SYS_UST_HIGHRES: return "highres_timer";
+    case SYS_UST_TIMER: return "ordinary_timer";
+    case SYS_UST_SLEEP: return "sleep_fallback";
+    case SYS_UST_YIELD: return "subms_yield";
+    default: return "zero";
+    }
+}
+
+static DWORD WINAPI sys_ust_writer(void* arg)
+{
+    sys_ust_state* s = (sys_ust_state*)arg;
+    LARGE_INTEGER now;
+    for (;;) {
+        LONGLONG remaining;
+        DWORD wait_ms;
+        QueryPerformanceCounter(&now);
+        remaining = s->deadline_qpc - now.QuadPart;
+        if (remaining <= 0) break;
+        /* Configuration is bounded to two hours. Round upwards, then recheck
+         * QPC so the scheduler's timeout granularity cannot seal early. */
+        wait_ms = (DWORD)((remaining * 1000 + s->frequency - 1) / s->frequency);
+        if (WaitForSingleObject(s->wake, wait_ms) == WAIT_OBJECT_0) break;
+    }
+
+    AcquireSRWLockExclusive(&s->lock);
+    s->closed = 1;
+    InterlockedExchange(&s->enabled, 0);
+    QueryPerformanceCounter(&now);
+    s->close_qpc = now.QuadPart;
+    if (!s->reason) s->reason = 1; /* deadline */
+    /* After closed is published, end() leaves all counters unchanged. The
+     * header/footer are one consistent snapshot, including in-flight drops. */
+    ReleaseSRWLockExclusive(&s->lock);
+
+    {
+        FILE* f = fopen(s->path, "wb");
+        int failed = f == NULL;
+        uint64_t dropped = s->dropped_deadline + s->dropped_capacity + s->inflight;
+        if (f) {
+            fprintf(f, "# ps3_usleep_trace version=1 origin=sys_timer_init origin_qpc=%lld qpc_frequency=%lld\n",
+                    (long long)s->origin_qpc, (long long)s->frequency);
+            fprintf(f, "# after_ms=%llu duration_ms=%llu first_qpc=%lld deadline_qpc=%lld filter_tid=%s%llu capacity=%u\n",
+                    (unsigned long long)s->after_ms, (unsigned long long)s->duration_ms,
+                    (long long)s->first_qpc, (long long)s->deadline_qpc,
+                    s->filter_tid ? "" : "all:", (unsigned long long)s->tid, s->capacity);
+            fprintf(f, "# elapsed includes existing syscall diagnostics/block bookkeeping; excludes record append and file I/O\n");
+            fprintf(f, "# membership: begin_qpc>=first_qpc and end_qpc<deadline_qpc; in-flight calls at close are censored\n");
+            fprintf(f, "begin_qpc,end_qpc,from_origin_us,requested_us,elapsed_us,overshoot_us,guest_tid,guest_lr,guest_cia,r28,r30,r31,backend\n");
+            for (unsigned i = 0; i < s->count; ++i) {
+                const sys_ust_record* r = &s->records[i];
+                double elapsed = (double)(r->end_qpc - r->begin_qpc) * 1.0e6 / (double)s->frequency;
+                double from_origin = (double)(r->begin_qpc - s->origin_qpc) * 1.0e6 / (double)s->frequency;
+                fprintf(f, "%lld,%lld,%.3f,%llu,%.3f,%.3f,%llu,0x%016llX,0x%016llX,0x%016llX,0x%016llX,0x%016llX,%s\n",
+                        (long long)r->begin_qpc, (long long)r->end_qpc, from_origin,
+                        (unsigned long long)r->requested_us, elapsed, elapsed - (double)r->requested_us,
+                        (unsigned long long)r->guest_tid, (unsigned long long)r->guest_lr,
+                        (unsigned long long)r->guest_cia, (unsigned long long)r->r28,
+                        (unsigned long long)r->r30, (unsigned long long)r->r31,
+                        sys_ust_backend_name(r->backend));
+            }
+            fprintf(f, "# end reason=%s close_qpc=%lld count=%u admitted=%llu dropped=%llu dropped_deadline=%llu dropped_capacity=%llu in_flight_at_close=%llu\n",
+                    s->reason == 2 ? "capacity" : "deadline", (long long)s->close_qpc,
+                    s->count, (unsigned long long)s->admitted, (unsigned long long)dropped,
+                    (unsigned long long)s->dropped_deadline, (unsigned long long)s->dropped_capacity,
+                    (unsigned long long)s->inflight);
+            failed = ferror(f) != 0;
+            if (fclose(f) != 0) failed = 1;
+        }
+        fprintf(stderr, "[usleep-trace] %s reason=%s count=%u dropped=%llu path=%s\n",
+                failed ? "write_failed" : "saved", s->reason == 2 ? "capacity" : "deadline",
+                s->count, (unsigned long long)dropped, s->path);
+    }
+    /* All later end() calls observe closed under lock and use only their own
+     * stack token; there are no borrowed pointers into this allocation. */
+    free(s->records);
+    s->records = NULL;
+    free(s->path);
+    s->path = NULL;
+    CloseHandle(s->wake);
+    s->wake = NULL;
+    InterlockedExchange(&s->finished, 1);
+    return 0;
+}
+
+/* Called once before guest execution. Tests may use independent, zeroed
+ * process-lifetime states with smaller capacities; never restart a state. */
+static int sys_ust_start(sys_ust_state* s, const char* path, int filter_tid,
+                         uint64_t tid, uint64_t after_ms, uint64_t duration_ms,
+                         unsigned capacity)
+{
+    LARGE_INTEGER freq, now;
+    HANDLE thread;
+    size_t path_len;
+    if (!path || !*path || !capacity || capacity > SYS_UST_CAPACITY ||
+        after_ms > SYS_UST_MAX_WINDOW_MS || !duration_ms || duration_ms > SYS_UST_MAX_WINDOW_MS ||
+        !QueryPerformanceFrequency(&freq) || freq.QuadPart <= 0 || freq.QuadPart > 1000000000LL)
+        return 0;
+    path_len = strlen(path);
+    if (path_len > 32767) return 0;
+    s->path = (char*)malloc(path_len + 1);
+    s->records = (sys_ust_record*)calloc(capacity, sizeof(*s->records));
+    s->wake = CreateEventW(NULL, TRUE, FALSE, NULL);
+    if (!s->path || !s->records || !s->wake) goto fail;
+    memcpy(s->path, path, path_len + 1);
+    s->capacity = capacity;
+    s->filter_tid = filter_tid;
+    s->tid = tid;
+    s->after_ms = after_ms;
+    s->duration_ms = duration_ms;
+    s->frequency = freq.QuadPart;
+    QueryPerformanceCounter(&now);
+    s->origin_qpc = now.QuadPart;
+    s->first_qpc = s->origin_qpc + (LONGLONG)(after_ms * (uint64_t)s->frequency / 1000);
+    s->deadline_qpc = s->first_qpc + (LONGLONG)(duration_ms * (uint64_t)s->frequency / 1000);
+    thread = CreateThread(NULL, 0, sys_ust_writer, s, 0, NULL);
+    if (!thread) goto fail;
+    /* The caller may not be scheduled until a very short test deadline has
+     * elapsed. Publish under the same lock as sealing, never revive it. */
+    AcquireSRWLockExclusive(&s->lock);
+    if (!s->closed) InterlockedExchange(&s->enabled, 1);
+    ReleaseSRWLockExclusive(&s->lock);
+    CloseHandle(thread); /* worker owns itself and the allocations until done */
+    return 1;
+fail:
+    free(s->records); s->records = NULL;
+    free(s->path); s->path = NULL;
+    if (s->wake) CloseHandle(s->wake);
+    s->wake = NULL;
+    return 0;
+}
+
+static int sys_ust_env_u64(const char* name, uint64_t fallback, uint64_t* out)
+{
+    const char* value = getenv(name);
+    char* end;
+    unsigned long long parsed;
+    if (!value || !*value) { *out = fallback; return 1; }
+    for (const char* p = value; *p; ++p) if (*p < '0' || *p > '9') return 0;
+    errno = 0;
+    parsed = strtoull(value, &end, 10);
+    if (errno || *end) return 0;
+    *out = (uint64_t)parsed;
+    return 1;
+}
+
+static BOOL CALLBACK sys_ust_init_once(PINIT_ONCE once, PVOID param, PVOID* context)
+{
+    const char* path = getenv("PS3_USLEEP_TRACE");
+    uint64_t tid, after_ms, duration_ms;
+    const char* tid_env;
+    (void)once; (void)param; (void)context;
+    if (!path || !*path) return TRUE;
+    tid_env = getenv("PS3_USLEEP_TRACE_TID");
+    if (!sys_ust_env_u64("PS3_USLEEP_TRACE_TID", 0, &tid) ||
+        !sys_ust_env_u64("PS3_USLEEP_TRACE_AFTER_MS", 0, &after_ms) ||
+        !sys_ust_env_u64("PS3_USLEEP_TRACE_DURATION_MS", 15000, &duration_ms) ||
+        !sys_ust_start(&s_sys_ust, path, tid_env && *tid_env, tid,
+                       after_ms, duration_ms, SYS_UST_CAPACITY)) {
+        fprintf(stderr, "[usleep-trace] disabled: invalid configuration or initialization failure\n");
+        return TRUE;
+    }
+    fprintf(stderr, "[usleep-trace] origin=sys_timer_init origin_qpc=%lld qpc_frequency=%lld after_ms=%llu duration_ms=%llu capacity=%u\n",
+            (long long)s_sys_ust.origin_qpc, (long long)s_sys_ust.frequency,
+            (unsigned long long)after_ms, (unsigned long long)duration_ms, SYS_UST_CAPACITY);
+    return TRUE;
+}
+
+static int sys_ust_begin(sys_ust_state* s, const ppu_context* ctx, uint64_t usec,
+                         sys_ust_record* token)
+{
+    LARGE_INTEGER now;
+    if (s->filter_tid && ctx->thread_id != s->tid) return 0;
+    /* Snapshot precisely at this syscall boundary, before note_block and the
+     * existing diagnostic callbacks. No guest pointer is dereferenced. */
+    token->guest_tid = ctx->thread_id;
+    token->guest_lr = ctx->lr;
+    token->guest_cia = ctx->cia;
+    token->r28 = ctx->gpr[28];
+    token->r30 = ctx->gpr[30];
+    token->r31 = ctx->gpr[31];
+    token->requested_us = usec;
+    QueryPerformanceCounter(&now);
+    token->begin_qpc = now.QuadPart;
+    if (now.QuadPart < s->first_qpc || now.QuadPart >= s->deadline_qpc) return 0;
+    AcquireSRWLockExclusive(&s->lock);
+    if (s->closed || !s->enabled) {
+        ReleaseSRWLockExclusive(&s->lock);
+        return 0;
+    }
+    ++s->admitted;
+    ++s->inflight;
+    ReleaseSRWLockExclusive(&s->lock);
+    return 1;
+}
+
+static void sys_ust_end(sys_ust_state* s, sys_ust_record* token, unsigned backend)
+{
+    LARGE_INTEGER now;
+    QueryPerformanceCounter(&now); /* before append/locking, never includes I/O */
+    token->end_qpc = now.QuadPart;
+    token->backend = backend;
+    AcquireSRWLockExclusive(&s->lock);
+    if (!s->closed) {
+        --s->inflight;
+        if (now.QuadPart >= s->deadline_qpc) ++s->dropped_deadline;
+        else if (s->count == s->capacity) ++s->dropped_capacity;
+        else s->records[s->count++] = *token;
+        if (s->count == s->capacity || now.QuadPart >= s->deadline_qpc) {
+            if (!s->reason) s->reason = s->count == s->capacity ? 2 : 1;
+            InterlockedExchange(&s->enabled, 0);
+            SetEvent(s->wake); /* under lock: writer cannot close it yet */
+        }
+    }
+    ReleaseSRWLockExclusive(&s->lock);
+}
+#endif /* _WIN32 */
+#endif /* PS3_SYS_USLEEP_TRACE_H */
diff --git a/runtime/syscalls/tests/test_usleep_trace.c b/runtime/syscalls/tests/test_usleep_trace.c
