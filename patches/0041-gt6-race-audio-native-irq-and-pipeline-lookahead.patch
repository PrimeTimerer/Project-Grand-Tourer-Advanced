+        const int level = spu_host_priority_level(priority, g->host_priority_policy);
+        for (uint32_t i=0; i<g->num_threads && i<8; ++i) {
+            const uint32_t index = g->thread_indices[i];
+            if (index < MAX_SPU_THREADS) {
+                spu_thread_t* t = &s_spu_threads[index];
