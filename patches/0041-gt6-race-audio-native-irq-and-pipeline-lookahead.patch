+static size_t rsx_fp_scalar_name(char out[16], unsigned file, unsigned index)
+{
+    size_t n = 8;
+    memcpy(out, "_rsx_fp_", n); out[n++] = file ? 'h' : 'r';
+    if (index >= 10) out[n++] = (char)('0' + index / 10);
+    out[n++] = (char)('0' + index % 10); out[n] = 0; return n;
+}
