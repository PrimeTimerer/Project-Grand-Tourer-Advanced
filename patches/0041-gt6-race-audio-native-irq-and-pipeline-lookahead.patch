+    audio_sgx_unlock();
+}
+static void pending_join(pending_block* p)
+{
+    CHECK(WaitForSingleObject(p->thread,2000)==WAIT_OBJECT_0);
+    CloseHandle(p->thread); p->thread=NULL;
+}
+static void fill_four(unsigned first)
+{
+    CHECK(s_sgx_fifo.count==0);
+    for(unsigned i=0;i<4;++i) submit(i,first+i,NULL);
+    CHECK(s_sgx_fifo.count==4);
+}
+static void drain_four(unsigned first)
+{
+    for(unsigned i=0;i<4;++i) { mix_once(); check_mix(first+i); }
+    CHECK(!s_sgx_fifo.count);
+}
+static void arm_delayed_wake(void)
+{
+    ResetEvent(wake_held); ResetEvent(release_wake); InterlockedExchange(&hold_wake,1);
+}
+static void wait_delayed_wake(void) { CHECK(WaitForSingleObject(wake_held,1000)==WAIT_OBJECT_0); }
+
+int main(void)
+{
+    setvbuf(stdout,NULL,_IONBF,0);
+    _putenv_s("GT6_AUDIO_FIFO_WAIT","1");
+    _putenv_s("AUDIO_FLOW_TRACE","");
