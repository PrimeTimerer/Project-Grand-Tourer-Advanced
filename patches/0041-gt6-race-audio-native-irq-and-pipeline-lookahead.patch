+                if (token.begin == main_at) { entered = 1; depth = 1; }
+                else if (entered && !closed) ++depth;
+            } else if (token.kind == '}' && entered && !closed) {
+                if (--depth == 0) closed = 1;
+            }
+            if (token.kind == '#' && entered && !closed) goto reject;
+            if (token.kind == 1 && entered && !closed && token.begin >= body_at &&
+                rsx_fp_scalar_control(source + token.begin, token.end - token.begin)) goto reject;
+            if (token.kind != 1 || token.end != token.begin + 1 ||
+                (source[token.begin] != 'r' && source[token.begin] != 'h') || previous.kind == '.') {
+                previous = token; continue;
+            }
+            if (!entered || closed || depth < 1 || token.begin < body_at) goto reject;
