+/* Device-free actual cellAudio fixture. Owned VM reservation only; never calls
+ * cellAudioInit, opens an endpoint, launches a game, or accesses player data.
+ * Win32 shims inject one CV failure and a delayed return after a real wake. */
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+static HANDLE wait_entered, wake_held, release_wake;
+static volatile LONG force_wait_error, hold_wake, cv_calls, max_wait_ms;
+static BOOL WINAPI fixture_cv_wait(PCONDITION_VARIABLE cv, PSRWLOCK lock, DWORD ms, ULONG flags)
+{
+    InterlockedIncrement(&cv_calls);
+    LONG old = InterlockedCompareExchange(&max_wait_ms, 0, 0);
+    while ((DWORD)old < ms) {
+        LONG seen = InterlockedCompareExchange(&max_wait_ms, (LONG)ms, old);
+        if (seen == old) break;
+        old = seen;
+    }
+    SetEvent(wait_entered);
+    if (InterlockedExchange(&force_wait_error, 0)) {
+        SetLastError(ERROR_INVALID_PARAMETER); return FALSE;
+    }
+    BOOL result = SleepConditionVariableSRW(cv, lock, ms, flags);
+    DWORD error = result ? ERROR_SUCCESS : GetLastError();
+    if (InterlockedExchange(&hold_wake, 0)) {
+        /* Model a waiter delayed behind lifecycle/reopen work, while preserving
+         * the API contract that the caller receives the exclusive lock back. */
+        ReleaseSRWLockExclusive(lock);
+        SetEvent(wake_held);
+        WaitForSingleObject(release_wake, 2000);
+        AcquireSRWLockExclusive(lock);
+    }
+    if (!result) SetLastError(error);
+    return result;
+}
+#define SleepConditionVariableSRW fixture_cv_wait
+#define main audio_ring_fixture_main
+#include "test_audio_ring.c"
+#undef main
+#undef SleepConditionVariableSRW
+
+static unsigned checks;
+#define CHECK(x) do { assert(x); ++checks; } while (0)
+
+static u64 qpc(void)
+{
+    LARGE_INTEGER v; QueryPerformanceCounter(&v); return (u64)v.QuadPart;
+}
+static double elapsed_us(u64 a, u64 b)
+{
+    LARGE_INTEGER f; QueryPerformanceFrequency(&f); return (double)(b-a)*1000000.0/f.QuadPart;
+}
+static u32 open_port(void)
+{
+    vm_write64(0x100,8); vm_write64(0x108,16); vm_write64(0x110,0);
+    CHECK(cellAudioPortOpen((void*)0x100,(void*)0x200)==CELL_OK && vm_read32(0x200)==0);
+    CHECK(cellAudioPortStart(0)==CELL_OK);
+    return (u32)s_ports[0].port_addr;
+}
+static float sample(unsigned id, unsigned i) { return (float)id/64.0f + (float)(i%7)/4096.0f; }
+static void fill(unsigned slot, unsigned id, u8* copy)
+{
+    float* p=s_ports[0].buffer+slot*256*8;
+    memset(p,0,AUDIO_SGX_PCM_BYTES);
+    for (unsigned i=0;i<256;++i) {
+        store_sample(p+i*8,sample(id,i)); store_sample(p+i*8+1,-sample(id,i));
+    }
+    if (copy) memcpy(copy,p,AUDIO_SGX_PCM_BYTES);
+}
+static void check_mix(unsigned id)
+{
+    for (unsigned i=0;i<256;++i) {
+        CHECK(s_mix_buffer[i*2]==sample(id,i));
+        CHECK(s_mix_buffer[i*2+1]==-sample(id,i));
+    }
+}
+static void mix_once(void)
+{
+    audio_flow_begin_block(); s_mix_present_us=test_clock_us;
+    audio_mix_one_block(); test_clock_us+=5333;
+}
+static DWORD WINAPI mixer_thread(void* ignored) { (void)ignored; mix_once(); return 0; }
+static u64 submit(unsigned slot, unsigned id, u8* copy)
+{
+    const u32 base=(u32)s_ports[0].port_addr, ea=base+slot*AUDIO_SGX_PCM_BYTES;
+    const u64 cookie=cellAudio_sgx_fifo_begin(base,ea,slot); CHECK(cookie!=0);
+    fill(slot,id,copy); cellAudio_sgx_fifo_complete(cookie,base,ea,slot,id); return cookie;
+}
+typedef struct pending_block {
+    u32 base, ea, slot;
+    unsigned id;
+    u64 cookie, begin_qpc, end_qpc, completed_us;
+    HANDLE thread;
+    u8 expected[AUDIO_SGX_PCM_BYTES];
+} pending_block;
+static DWORD WINAPI producer_thread(void* opaque)
+{
+    pending_block* p=(pending_block*)opaque;
+    p->begin_qpc=qpc();
+    cellAudio_sgx_fifo_complete(p->cookie,p->base,p->ea,p->slot,p->id);
+    p->end_qpc=qpc(); return 0;
+}
+static void pending_start(pending_block* p, unsigned slot, unsigned id)
+{
+    memset(p,0,sizeof(*p)); p->slot=slot; p->id=id;
+    p->base=(u32)s_ports[0].port_addr; p->ea=p->base+slot*AUDIO_SGX_PCM_BYTES;
+    p->cookie=cellAudio_sgx_fifo_begin(p->base,p->ea,p->slot); CHECK(p->cookie!=0);
+    fill(slot,id,p->expected); p->completed_us=test_clock_us;
+    ResetEvent(wait_entered);
+    p->thread=CreateThread(NULL,0,producer_thread,p,0,NULL); CHECK(p->thread!=NULL);
+    CHECK(WaitForSingleObject(wait_entered,1000)==WAIT_OBJECT_0);
+    /* Acquiring the real lock proves producer reached the CV's unlock/wait. */
+    audio_sgx_lock();
