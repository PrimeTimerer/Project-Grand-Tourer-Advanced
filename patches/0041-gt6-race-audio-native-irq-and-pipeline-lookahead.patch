+    struct ld_scj_job *all_next, *hash_next, *queue_next;
+    uint64_t hash, generation;
+    uint32_t length;
+    unsigned stage, status;
+    HRESULT error;
+    ID3DBlob* blob;
+    char source[]; /* immutable owned bytes, plus one terminating NUL */
+} ld_scj_job;
+
+typedef struct ld_scj_stats {
+    uint64_t generation, requests, dedup_hits, rejected, allocation_failures;
+    uint64_t compile_attempts, compiled_jobs, failed_jobs, cancelled_jobs;
+    uint64_t acquire_hits, waits, wait_us, compile_us, scalar_fallbacks;
+    size_t source_bytes, blob_bytes, reserved_source_bytes;
+    unsigned state, jobs, pending, running, ready, max_running, reserved;
+} ld_scj_stats;
+
+typedef struct ld_scj_state {
+    SRWLOCK lock;
+    CONDITION_VARIABLE changed;
+    unsigned state, trim, scalar, threads_count;
+    UINT vs_flags;
+    uint64_t generation;
+    LONGLONG qpc_frequency;
+    HANDLE threads[2];
+    ld_scj_job *all, *head, *tail, *buckets[LD_SCJ_BUCKETS];
+    unsigned jobs, pending, running, ready, reserved;
+    size_t source_bytes, blob_bytes, reserved_source_bytes;
+    ld_scj_stats totals;
+} ld_scj_state;
+
+static uint64_t ld_scj_elapsed_us(LONGLONG begin, LONGLONG end, LONGLONG frequency)
+{ return frequency > 0 && end > begin ? (uint64_t)(end - begin) * UINT64_C(1000000) / (uint64_t)frequency : 0; }
+
+static unsigned ld_scj_bucket(unsigned stage, uint64_t hash)
+{ return (unsigned)(hash ^ (hash >> 32) ^ ((uint64_t)stage * 1297u)) & (LD_SCJ_BUCKETS - 1u); }
+
+/* All job lookup, publication, AddRef and list operations hold state->lock. */
+static ld_scj_job* ld_scj_find_locked(ld_scj_state* state, unsigned stage,
+                                      const char* source, uint32_t length, uint64_t hash)
+{
+    for (ld_scj_job* job = state->buckets[ld_scj_bucket(stage, hash)]; job; job = job->hash_next)
+        if (job->stage == stage && job->hash == hash && job->length == length &&
+            !memcmp(job->source, source, length)) return job;
+    return NULL;
+}
+
+static int ld_scj_has_capacity_locked(const ld_scj_state* state, uint32_t length)
+{
+    return state->jobs + state->reserved < LD_SCJ_MAX_JOBS &&
+        state->pending + state->reserved < LD_SCJ_MAX_PENDING &&
+        (size_t)length + 1u <= LD_SCJ_MAX_SOURCE_BYTES - state->source_bytes - state->reserved_source_bytes;
+}
+
+static char* ld_scj_trim_copy(const char* source, uint32_t length, size_t* compile_length)
+{
+    char* copy = (char*)malloc((size_t)length + 1u);
+    if (!copy) return NULL;
+    memcpy(copy, source, (size_t)length + 1u);
+    rsx_fp_init_reduction reduction;
+    if (rsx_fp_reduce_unused_init(copy, length, &reduction)) *compile_length = reduction.source_length;
+    return copy;
+}
+
+static ID3DBlob* ld_scj_compile_private(const ld_scj_job* job,
+    unsigned trim, unsigned scalar, UINT vs_flags, HRESULT* error,
+    unsigned* attempts, unsigned* scalar_fallback)
+{
+    const char* source = job->source;
+    size_t length = job->length;
+    char* copy = NULL;
+    int used_scalar = 0;
+    if (job->stage == 'P' && trim) {
+        if (scalar) {
+            rsx_fp_scalar_result result;
+            copy = rsx_fp_scalarize_temporaries(source, length, &result);
+            if (copy) { length = result.source_length; used_scalar = 1; }
+        }
+        if (!copy) copy = ld_scj_trim_copy(source, job->length, &length);
+        if (copy) source = copy;
+    }
+    ID3DBlob *blob = NULL, *diagnostic = NULL;
+    *attempts = 1; *scalar_fallback = 0;
+    *error = LD_SCJ_COMPILE(source, length, job->stage == 'V' ? "xvs" : "xps",
+        NULL, NULL, "main", job->stage == 'V' ? "vs_5_0" : "ps_5_0",
+        job->stage == 'V' ? vs_flags : 0, 0, &blob, &diagnostic);
+    free(copy);
+    if (diagnostic) { diagnostic->lpVtbl->Release(diagnostic); diagnostic = NULL; }
+    if (FAILED(*error) && used_scalar) {
+        if (blob) { blob->lpVtbl->Release(blob); blob = NULL; }
+        length = job->length;
+        copy = ld_scj_trim_copy(job->source, job->length, &length);
+        source = copy ? copy : job->source;
+        ++*attempts; *scalar_fallback = 1;
+        *error = LD_SCJ_COMPILE(source, length, "xps", NULL, NULL, "main", "ps_5_0",
+                                0, 0, &blob, &diagnostic);
+        free(copy);
+        if (diagnostic) diagnostic->lpVtbl->Release(diagnostic);
+    }
+    if (FAILED(*error) || !blob) {
+        if (blob) blob->lpVtbl->Release(blob);
+        if (SUCCEEDED(*error)) *error = E_FAIL;
+        return NULL;
+    }
+    return blob;
+}
+
+static DWORD WINAPI ld_scj_worker(LPVOID argument)
+{
+    ld_scj_state* state = (ld_scj_state*)argument;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    for (;;) {
+        AcquireSRWLockExclusive(&state->lock);
+        while (state->state == LD_SCJ_STARTING ||
+               (state->state == LD_SCJ_RUNNING && !state->head))
+            SleepConditionVariableSRW(&state->changed, &state->lock, INFINITE, 0);
+        if (state->state != LD_SCJ_RUNNING) { ReleaseSRWLockExclusive(&state->lock); return 0; }
+        ld_scj_job* job = state->head;
+        state->head = job->queue_next;
+        if (!state->head) state->tail = NULL;
+        job->queue_next = NULL; job->status = LD_SCJ_WORKING;
+        ++state->running;
+        if (state->running > state->totals.max_running) state->totals.max_running = state->running;
+        const unsigned trim = state->trim, scalar = state->scalar;
+        const UINT vs_flags = state->vs_flags;
+        ReleaseSRWLockExclusive(&state->lock);
+
+        LD_SCJ_BEFORE_COMPILE_HOOK(state, job);
+        LARGE_INTEGER begin, end; QueryPerformanceCounter(&begin);
+        HRESULT error = E_FAIL;
+        unsigned attempts = 0, scalar_fallback = 0;
+        ID3DBlob* blob = ld_scj_compile_private(job, trim, scalar, vs_flags,
+                                               &error, &attempts, &scalar_fallback);
+        QueryPerformanceCounter(&end);
+        const SIZE_T bytes = blob ? blob->lpVtbl->GetBufferSize(blob) : 0;
+        AcquireSRWLockExclusive(&state->lock);
+        --state->running; --state->pending;
+        state->totals.compile_attempts += attempts;
+        state->totals.scalar_fallbacks += scalar_fallback;
+        state->totals.compile_us += ld_scj_elapsed_us(begin.QuadPart, end.QuadPart, state->qpc_frequency);
+        if (state->state != LD_SCJ_RUNNING || job->generation != state->generation) {
+            job->status = LD_SCJ_CANCELLED; job->error = E_ABORT;
+            ++state->totals.cancelled_jobs;
+        } else if (!blob || bytes < 32 || bytes > LD_SCJ_MAX_BLOB ||
+                   state->ready >= LD_SCJ_MAX_READY || bytes > LD_SCJ_MAX_BLOB_BYTES - state->blob_bytes) {
+            job->status = LD_SCJ_FAILED; job->error = blob ? E_OUTOFMEMORY : error;
+            ++state->totals.failed_jobs;
+        } else {
+            job->blob = blob; blob = NULL; job->status = LD_SCJ_READY; job->error = S_OK;
+            ++state->ready; state->blob_bytes += bytes; ++state->totals.compiled_jobs;
+        }
+        WakeAllConditionVariable(&state->changed);
+        ReleaseSRWLockExclusive(&state->lock);
+        if (blob) blob->lpVtbl->Release(blob);
+    }
+}
+
+static void ld_scj_shutdown(ld_scj_state* state)
+{
+    if (!state) return;
+    HANDLE threads[2] = { NULL, NULL }; unsigned count = 0;
+    AcquireSRWLockExclusive(&state->lock);
+    if (state->state == LD_SCJ_STOPPED) { ReleaseSRWLockExclusive(&state->lock); return; }
+    state->state = LD_SCJ_STOPPING;
+    for (ld_scj_job* job = state->head; job; job = job->queue_next) {
+        job->status = LD_SCJ_CANCELLED; job->error = E_ABORT;
+        --state->pending; ++state->totals.cancelled_jobs;
+    }
+    state->head = state->tail = NULL;
+    count = state->threads_count;
+    for (unsigned i = 0; i < count; ++i) threads[i] = state->threads[i];
+    WakeAllConditionVariable(&state->changed);
+    ReleaseSRWLockExclusive(&state->lock);
+    /* D3DCompile cannot be interrupted safely. Only the at-most-two already
+     * admitted jobs finish; all pending jobs and waiting acquires are cancelled. */
+    for (unsigned i = 0; i < count; ++i) { WaitForSingleObject(threads[i], INFINITE); CloseHandle(threads[i]); }
+    AcquireSRWLockExclusive(&state->lock);
+    ld_scj_job* all = state->all;
+    state->all = NULL;
+    memset(state->buckets, 0, sizeof(state->buckets));
+    memset(state->threads, 0, sizeof(state->threads));
+    state->threads_count = state->jobs = state->pending = state->running = state->ready = 0;
+    state->source_bytes = state->blob_bytes = 0;
+    ReleaseSRWLockExclusive(&state->lock);
+    while (all) {
+        ld_scj_job* next = all->all_next;
+        if (all->blob) all->blob->lpVtbl->Release(all->blob);
+        LD_SCJ_FREE(all); all = next;
+    }
+    AcquireSRWLockExclusive(&state->lock);
+    state->state = LD_SCJ_STOPPED;
+    WakeAllConditionVariable(&state->changed);
+    ReleaseSRWLockExclusive(&state->lock);
+}
+
+static int ld_scj_begin(ld_scj_state* state, int trim, int scalar, UINT vs_flags)
+{
+    if (!state) return 0;
+    AcquireSRWLockExclusive(&state->lock);
+    if (state->state != LD_SCJ_STOPPED) { ReleaseSRWLockExclusive(&state->lock); return 0; }
+    state->state = LD_SCJ_STARTING;
+    if (++state->generation == 0) ++state->generation;
+    state->trim = trim != 0; state->scalar = trim && scalar; state->vs_flags = vs_flags;
+    LARGE_INTEGER frequency;
+    state->qpc_frequency = QueryPerformanceFrequency(&frequency) ? frequency.QuadPart : 0;
+    memset(&state->totals, 0, sizeof(state->totals));
+    ReleaseSRWLockExclusive(&state->lock);
+    for (unsigned i = 0; i < 2; ++i) {
+        HANDLE thread = LD_SCJ_CREATE_THREAD(ld_scj_worker, state);
+        if (!thread) { ld_scj_shutdown(state); return 0; }
+        AcquireSRWLockExclusive(&state->lock);
+        state->threads[state->threads_count++] = thread;
+        ReleaseSRWLockExclusive(&state->lock);
+    }
+    AcquireSRWLockExclusive(&state->lock);
+    state->state = LD_SCJ_RUNNING;
+    WakeAllConditionVariable(&state->changed);
+    ReleaseSRWLockExclusive(&state->lock);
+    return 1;
+}
+
+static ld_scj_job* ld_scj_request(ld_scj_state* state, unsigned stage,
+    const char* source, uint32_t length, uint64_t hash)
+{
+    if (!state || (stage != 'P' && stage != 'V') || !source || !length || length > LD_SCJ_MAX_SOURCE) return NULL;
+    AcquireSRWLockExclusive(&state->lock);
+    if (state->state != LD_SCJ_RUNNING) { ReleaseSRWLockExclusive(&state->lock); return NULL; }
+    ++state->totals.requests;
+    ld_scj_job* existing = ld_scj_find_locked(state, stage, source, length, hash);
+    if (existing) { ++state->totals.dedup_hits; ReleaseSRWLockExclusive(&state->lock); return existing; }
+    if (!ld_scj_has_capacity_locked(state, length)) {
+        ++state->totals.rejected; ReleaseSRWLockExclusive(&state->lock); return NULL;
+    }
+    const uint64_t generation = state->generation;
+    /* Reserve before dropping the lock: simultaneous source copies, including
+     * a delayed request from an old generation, count against the same cap. */
+    ++state->reserved; state->reserved_source_bytes += (size_t)length + 1u;
+    ReleaseSRWLockExclusive(&state->lock);
+    ld_scj_job* job = (ld_scj_job*)LD_SCJ_ALLOC(sizeof(ld_scj_job) + (size_t)length + 1u);
+    if (!job) {
+        AcquireSRWLockExclusive(&state->lock);
+        --state->reserved; state->reserved_source_bytes -= (size_t)length + 1u;
+        if (state->generation == generation) ++state->totals.allocation_failures;
+        ReleaseSRWLockExclusive(&state->lock); return NULL;
+    }
+    memset(job, 0, sizeof(*job));
+    job->hash = hash; job->generation = generation; job->stage = stage; job->length = length;
+    memcpy(job->source, source, length); job->source[length] = 0;
+    LD_SCJ_REQUEST_OWNED_HOOK(state, job);
+    AcquireSRWLockExclusive(&state->lock);
+    if (state->state != LD_SCJ_RUNNING || state->generation != generation) {
+        LD_SCJ_FREE(job);
+        --state->reserved; state->reserved_source_bytes -= (size_t)length + 1u;
+        ReleaseSRWLockExclusive(&state->lock); return NULL;
+    }
+    existing = ld_scj_find_locked(state, stage, job->source, length, hash);
+    if (existing) {
+        ++state->totals.dedup_hits; LD_SCJ_FREE(job);
+        --state->reserved; state->reserved_source_bytes -= (size_t)length + 1u;
+        ReleaseSRWLockExclusive(&state->lock); return existing;
+    }
+    --state->reserved; state->reserved_source_bytes -= (size_t)length + 1u;
+    const unsigned bucket = ld_scj_bucket(stage, hash);
+    job->all_next = state->all; state->all = job;
+    job->hash_next = state->buckets[bucket]; state->buckets[bucket] = job;
+    if (state->tail) state->tail->queue_next = job; else state->head = job;
+    state->tail = job;
+    ++state->jobs; ++state->pending; state->source_bytes += (size_t)length + 1u;
+    WakeAllConditionVariable(&state->changed);
+    ReleaseSRWLockExclusive(&state->lock);
+    return job;
+}
+
+static ID3DBlob* ld_scj_acquire(ld_scj_state* state, unsigned stage,
+    const char* source, uint32_t length, uint64_t hash, int wait)
+{
+    if (!state || (stage != 'P' && stage != 'V') || !source || !length || length > LD_SCJ_MAX_SOURCE) return NULL;
+    AcquireSRWLockExclusive(&state->lock);
+    if (state->state != LD_SCJ_RUNNING) { ReleaseSRWLockExclusive(&state->lock); return NULL; }
+    const uint64_t generation = state->generation;
+    ld_scj_job* job = ld_scj_find_locked(state, stage, source, length, hash);
+    if (!job) { ReleaseSRWLockExclusive(&state->lock); return NULL; }
+    int waited = 0;
+    LARGE_INTEGER begin = { 0 }, end;
+    ID3DBlob* result = NULL;
+    for (;;) {
+        /* Check lifecycle before dereferencing a job after a condition wait:
+         * shutdown may have freed its old generation while this thread slept. */
+        if (state->state != LD_SCJ_RUNNING || state->generation != generation) break;
+        if (job->status == LD_SCJ_READY) {
+            result = job->blob; result->lpVtbl->AddRef(result); ++state->totals.acquire_hits; break;
+        }
+        if (!wait || job->status == LD_SCJ_FAILED || job->status == LD_SCJ_CANCELLED) break;
+        if (!waited) {
+            waited = 1; ++state->totals.waits; QueryPerformanceCounter(&begin);
+            /* The actual dependent draw takes priority over future sources. */
+            if (job->status == LD_SCJ_QUEUED && state->head != job) {
+                ld_scj_job* previous = state->head;
+                while (previous && previous->queue_next != job) previous = previous->queue_next;
+                if (previous) {
+                    previous->queue_next = job->queue_next;
+                    if (state->tail == job) state->tail = previous;
+                    job->queue_next = state->head; state->head = job;
+                    WakeAllConditionVariable(&state->changed);
+                }
+            }
+        }
+        if (!SleepConditionVariableSRW(&state->changed, &state->lock, INFINITE, 0)) break;
+    }
+    if (waited && state->generation == generation) {
+        QueryPerformanceCounter(&end);
+        state->totals.wait_us += ld_scj_elapsed_us(begin.QuadPart, end.QuadPart, state->qpc_frequency);
+    }
+    ReleaseSRWLockExclusive(&state->lock);
+    return result;
+}
+
+static void ld_scj_snapshot(ld_scj_state* state, ld_scj_stats* out)
+{
+    if (!out) return;
+    memset(out, 0, sizeof(*out));
+    if (!state) return;
+    AcquireSRWLockShared(&state->lock);
+    *out = state->totals;
+    out->generation = state->generation; out->state = state->state;
+    out->jobs = state->jobs; out->pending = state->pending; out->running = state->running; out->ready = state->ready;
+    out->source_bytes = state->source_bytes; out->blob_bytes = state->blob_bytes;
+    out->reserved = state->reserved; out->reserved_source_bytes = state->reserved_source_bytes;
+    ReleaseSRWLockShared(&state->lock);
+}
+#endif
