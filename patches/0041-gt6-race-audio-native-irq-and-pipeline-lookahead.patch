diff --git a/libs/video/tests/test_fifo_prepare_scan.c b/libs/video/tests/test_fifo_prepare_scan.c
new file mode 100644
index 0000000..0b0ce93
--- /dev/null
+++ b/libs/video/tests/test_fifo_prepare_scan.c
@@ -0,0 +1,57 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include "../rsx_fifo_prepare_scan.h"
+static unsigned checks;
+static void check(int yes,const char* label) { if(!yes) { fprintf(stderr,"FAIL %s\n",label); exit(1); } ++checks; }
+typedef struct fixture { uint32_t words[512], seen[32], n, reads, limit; } fixture;
+static int read_word(void* user,uint32_t io,uint32_t* out) {
+    fixture* f=user; ++f->reads;
+    if((io&3)||io/4>=f->limit) return 0;
+    *out=f->words[io/4]; return 1;
+}
+static int packet(void* user,uint32_t method,int inc,const uint32_t* data,uint32_t count) {
+    fixture* f=user;
+    for(uint32_t i=0;i<count;++i) { if(f->n==32) return 0; f->seen[f->n++]=(method+(inc?i*4:0))^data[i]; }
+    return 1;
+}
+static rsx_prepare_scan_result run(fixture* f,uint32_t start,uint32_t put,uint32_t ret,uint32_t budget) {
+    f->n=f->reads=0; return rsx_fifo_prepare_scan(f,read_word,f,packet,start,put,ret,budget,32);
+}
+int main(void) {
+    fixture f={0}; f.limit=512;
+    f.words[0]=(2u<<18)|0x200; f.words[1]=123; f.words[2]=456;
+    f.words[3]=(1u<<18)|0x1808; f.words[4]=0;
+    rsx_prepare_scan_result r=run(&f,0,20,0,128);
+    check(r.reason==RSX_PREPARE_PUT&&r.draws==1&&r.packets==2,"incrementing stream ends at published PUT");
+    check(f.n==3&&f.seen[0]==(0x200^123)&&f.seen[1]==(0x204^456),"host order and increment preserved");
+    f.words[0]|=2u<<29; r=run(&f,0,20,0,128);
+    check(f.seen[1]==(0x200^456),"nonincrementing method unchanged");
+    f.words[0]=0x20000020; f.words[8]=(1u<<18)|0x1808; f.words[9]=0;
+    f.words[10]=0x20000040; r=run(&f,0,64,0,128);
+    check(r.draws==1&&r.branches==2&&r.reason==RSX_PREPARE_PUT,"bounded jumps follow submitted stream");
+    f.words[0]=0x20000000; r=run(&f,0,64,0,128);
+    check(r.reason==RSX_PREPARE_PARK&&f.n==0,"unfilled self-jump is never bypassed");
+    f.words[0]=0x22; f.words[1]=0x20000040; f.words[10]=0x20000;
+    r=run(&f,0,64,0,128); check(r.draws==1&&r.reason==RSX_PREPARE_PUT,"call return matches real single return slot");
+    f.words[8]=0x32; r=run(&f,0,64,0,128);
+    check(r.reason==RSX_PREPARE_INVALID,"nested call stops without repairing return");
+    f.words[0]=(1u<<18)|0x68; f.words[1]=1;
+    r=run(&f,0,64,0,128); check(r.reason==RSX_PREPARE_BARRIER&&f.n==0,"semaphore has no side effects");
+    f.words[0]=(2u<<18)|0x60; r=run(&f,0,64,0,128);
+    check(r.reason==RSX_PREPARE_BARRIER&&f.n==0,"barrier inside packet is rejected atomically");
+    f.words[0]=(1u<<18)|(2u<<13)|0x200; r=run(&f,0,64,0,128);
+    check(r.reason==RSX_PREPARE_BARRIER&&f.n==0,"transfer subchannel stops");
+    f.words[0]=(8u<<18)|0x200; r=run(&f,0,12,0,128);
+    check(r.reason==RSX_PREPARE_BUDGET&&f.n==0,"partial publication does not read beyond PUT");
+    f.limit=2; r=run(&f,0,64,0,128);
+    check(r.reason==RSX_PREPARE_UNMAPPED&&f.n==0,"unmapped packet rejected atomically");
+    f.limit=512; f.words[0]=0x20000020; f.words[8]=0x20000000;
+    r=run(&f,0,64,0,15); check(r.reason==RSX_PREPARE_BUDGET&&r.words<=15,"branch cycle has finite word budget");
+    f.words[0]=0xfead0001; r=run(&f,0,64,0,128);
+    check(r.reason==RSX_PREPARE_INVALID&&f.n==0,"flip marker cannot signal a flip");
+    r=run(&f,1,64,0,128); check(r.reason==RSX_PREPARE_INVALID&&f.reads==0,"misaligned cursor rejected");
+    memset(f.words,0,sizeof(f.words)); f.words[0]=(2u<<29)|(100u<<18)|0x1808;
+    r=run(&f,0,404,0,512);
+    check(r.reason==RSX_PREPARE_BUDGET&&f.n==0&&r.draws==0,"oversized NI END packet rejected before sink side effects");
+    printf("FIFO preparation: %u checks PASS\n",checks); return 0;
+}
diff --git a/libs/video/tests/test_fp_compile_scalar.c b/libs/video/tests/test_fp_compile_scalar.c
new file mode 100644
index 0000000..c38c2ae
--- /dev/null
+++ b/libs/video/tests/test_fp_compile_scalar.c
@@ -0,0 +1,99 @@
+#include "../rsx_fp_compile_scalar.h"
+#include <stdio.h>
+
+#ifdef FP_SCALAR_DLL
+__declspec(dllexport) char* scalar_fp(const char* text, size_t length, rsx_fp_scalar_result* result)
+{ return rsx_fp_scalarize_temporaries(text, length, result); }
+__declspec(dllexport) void scalar_free(char* text) { free(text); }
+#else
+static unsigned checks, failures;
+static void check(int ok, const char* what)
+{ ++checks; failures += !ok; printf("[%s] %s\n", ok ? "PASS" : "FAIL", what); }
+
+static char* exercise(const char* body, unsigned declared, unsigned wanted, const char* what)
+{
+    char source[8192], before[8192];
+    snprintf(source, sizeof(source), "float4 main(PSInput input) : SV_TARGET {\n"
+             "    float4 r[%u]; float4 h[%u];\n"
+             "    [unroll] for (int _i = 0; _i < %u; _i++) { r[_i] = (float4)0; h[_i] = (float4)0; }\n%s\n}\n",
+             declared, declared, declared, body);
+    memcpy(before, source, strlen(source) + 1u);
+    rsx_fp_scalar_result info;
+    char* output = rsx_fp_scalarize_temporaries(source, strlen(source), &info);
+    check(wanted ? output && info.scalar_registers == wanted && info.declared_registers == declared &&
+                           info.source_length == strlen(output)
+                 : !output && !info.source_length, what);
+    check(!strcmp(source, before), "canonical source remains unchanged");
+    return output;
+}
+
+static void reject_direct(const char* text, size_t length, const char* what)
+{
+    rsx_fp_scalar_result result;
+    char* output = rsx_fp_scalarize_temporaries(text, length, &result);
+    check(!output && !result.source_length, what); free(output);
+}
+
+int main(void)
+{
+    free(exercise("return r[0];", 48, 1, "one register"));
+    free(exercise("r[8].x = h[4].x; return r[8];", 48, 2, "both register files"));
+    free(exercise("return h[47];", 48, 1, "last 48-register index"));
+    free(exercise("return r[63] + h[63];", 64, 2, "last 64-register index"));
+    free(exercise("return r[48];", 48, 0, "out of bounds"));
+    free(exercise("return r[184467440737095516160000];", 48, 0, "index overflow"));
+    free(exercise("return r[-1];", 48, 0, "negative index"));
+    free(exercise("return r[index];", 48, 0, "dynamic index"));
+    free(exercise("return r[1+2];", 48, 0, "expression index"));
+    free(exercise("return r[01];", 48, 0, "leading-zero integer"));
+    free(exercise("return r[0x1];", 48, 0, "hex integer"));
+    free(exercise("return fn(r);", 48, 0, "whole array alias"));
+    free(exercise("return fn(h, r[0]);", 48, 0, "whole array argument"));
+    free(exercise("return fn((h[0]), r[0]);", 48, 0, "unsupported unbracketed comma operand"));
+    free(exercise("float4 r[1]; return r[0];", 48, 0, "nested array redeclaration"));
+    free(exercise("float4 temporary, r[1]; return r[0];", 48, 0, "declaration-list alias"));
+    free(exercise("return value.r * r[ 2 ];", 48, 1, "member swizzle and spaces"));
+    free(exercise("return value./* member */r * (h[1]);", 48, 1, "comment between dot and swizzle"));
+    free(exercise("float4 rr = 0; float4 r1 = rr; return r[0] + r1;", 48, 1, "identifier token boundaries"));
+    free(exercise("/* r[47] */ // h[46]\nreturn h[1];", 48, 1, "comments do not add registers"));
+    free(exercise("return r[0]; /*", 48, 0, "unterminated block comment"));
+    free(exercise("return r[0]; /*x", 48, 0, "unterminated nonempty comment"));
+    free(exercise("return r[0]; \"unterminated", 48, 0, "unterminated string"));
+    free(exercise("#define r other\nreturn r[0];", 48, 0, "body preprocessing rejected"));
+    free(exercise("return _rsx_fp_r0 + r[0];", 48, 0, "generated-name collision"));
+    free(exercise("return 1;", 48, 0, "register-free program"));
+
+    free(exercise("if (input.col0.x) { r[0].x = h[2].y; } return r[0];", 48, 0,
+                  "conditional guest flow retains original path"));
+    free(exercise("for (int j = 0; j < 2; ++j) { h[2].x += r[0].x; } return r[0];", 48, 0,
+                  "guest loop retains original path"));
+    free(exercise("while (input.col0.x) { r[0] += 1; } return r[0];", 48, 0,
+                  "while loop retains original path"));
+    free(exercise("do { r[0] += 1; } while (input.col0.x); return r[0];", 48, 0,
+                  "do loop retains original path"));
+    free(exercise("switch (input.col0.x) { case 0: r[0] = 1; break; } return r[0];", 48, 0,
+                  "switch retains original path"));
+    char* partial = exercise("r[0].x = h[2].y; h[2].x += r[0].x; return r[0] + h[2];",
+                             48, 2, "partial writes");
+    check(partial && strstr(partial, "_rsx_fp_r0.x = _rsx_fp_h2.y; _rsx_fp_h2.x += _rsx_fp_r0.x; return _rsx_fp_r0 + _rsx_fp_h2;"),
+          "partial writes and operations remain exact");
+    check(partial && strstr(partial, "_rsx_fp_r0 = (float4)0; _rsx_fp_h2 = (float4)0; ") &&
+          strstr(partial, "_rsx_fp_h2 = (float4)0;") < strstr(partial, "_rsx_fp_r0.x ="),
+          "all observed components initialized before partial reads");
+    free(partial);
+    char* order = exercise("return r[2] + r[0] + h[0] + h[1];", 48, 4, "sparse register set");
+    check(order && strstr(order, "_rsx_fp_r0 = (float4)0; _rsx_fp_h0 = (float4)0; _rsx_fp_h1 = (float4)0; _rsx_fp_r2 = (float4)0; "),
+          "original r/h interleaved initializer order");
+    free(order);
+
+    reject_direct(NULL, 0, "null source");
+    reject_direct("", 0, "empty source");
+    reject_direct("other", 5, "unknown emitter");
+    char embedded[] = "a\0b";
+    reject_direct(embedded, 3, "embedded NUL");
+    char unterminated[] = "abc";
+    reject_direct(unterminated, 2, "length without terminating NUL");
+    printf("FP compile scalar: %u checks, %u failures\n", checks, failures);
+    return failures ? 1 : 0;
+}
+#endif
