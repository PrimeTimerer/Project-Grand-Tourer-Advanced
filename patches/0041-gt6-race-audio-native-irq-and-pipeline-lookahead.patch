diff --git a/runtime/spu/tests/test_spu_gt6_irq.c b/runtime/spu/tests/test_spu_gt6_irq.c
new file mode 100644
index 0000000..a129678
--- /dev/null
+++ b/runtime/spu/tests/test_spu_gt6_irq.c
@@ -0,0 +1,121 @@
+/* Offline architecture differential: actual interpreter vs actual native IRQ
+ * helper/lookup. Synthetic private LS plus an optional captured LS/GPR pair.
+ * No game execution or player files. */
+#include "../spu_interp.c"
+#include "../spu_gt6_irq.h"
+#include <assert.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+/* Out-of-scope service boundaries must never be reached by these pure LS
+ * blocks. Abort stubs ensure a test cannot silently substitute DMA/jobs. */
+uint32_t g_barrier_sync_watch,g_ydkj_real_spurs_ea,g_ydkj_real_taskset_ea,g_ydkj_real_taskid;
+uint32_t g_spu_image_src_ea,g_spu_image_ls_start,g_spu_image_span;
+int ps3_mmapper_page_fault(uint32_t x,int w) { (void)x;(void)w;abort(); }
+unsigned long long ps3_ms_now(void) { abort(); }
+void spurs_ef_set_from_spu(uint32_t x,uint16_t y) { (void)x;(void)y;abort(); }
+void ydkj_wake_all_event_flags(void) { abort(); }
+uint64_t spurs_pm_build_context(uint8_t*x,uint32_t a0,uint32_t b0,uint32_t c0,uint32_t d0)
+{ (void)x;(void)a0;(void)b0;(void)c0;(void)d0;abort(); }
+static spu_context a, b;
+static uint8_t als[SPU_LS_SIZE], bls[SPU_LS_SIZE];
+static unsigned checks;
+static uint32_t rng = 0x8bd45;
+#define CHECK(x) do { ++checks; if (!(x)) { fprintf(stderr,"FAIL %d: %s\n",__LINE__,#x); abort(); } } while (0)
+static uint32_t rnd(void) { rng ^= rng<<13; rng ^= rng>>17; rng ^= rng<<5; return rng; }
+
+static void init(void)
+{
+    memset(&a,0,sizeof a); a.ls=als; a.image_id=364260230; a.dcache_id=0x7F000001;
+    a.status=SPU_STATUS_RUNNING; a.event_mask=2; a.event_status=2;
+    a.host_depth=1; a.drain_ret_pc=0x2D20; a.srr0=0x2CEC;
+    for(unsigned r=0;r<128;++r) for(unsigned k=0;k<4;++k) a.gpr[r]._u32[k]=rnd();
+    for(unsigned i=0;i<SPU_LS_SIZE;i+=4) { uint32_t v=rnd(); memcpy(als+i,&v,4); }
+    memcpy(als+0xA2C,spu_gt6_irq_code,sizeof spu_gt6_irq_code);
+}
+static void clone(void) { b=a; b.ls=bls; memcpy(bls,als,sizeof als); }
+static void equal(void)
+{
+    CHECK(!memcmp(als,bls,sizeof als));
+    b.ls=als;
+    if(memcmp(&a,&b,sizeof a)) {
+        unsigned shown=0;
+        for(unsigned i=0;i<sizeof a && shown<16;++i) if(((unsigned char*)&a)[i]!=((unsigned char*)&b)[i]) {
+            fprintf(stderr,"ctx difference byte %u: %02x/%02x\n",i,((unsigned char*)&a)[i],((unsigned char*)&b)[i]);++shown;
+        }
+        fprintf(stderr,"pc %x/%x status %x/%x irq_saved %u/%u depth %d/%d cache_id %u/%u\n",a.pc,b.pc,a.status,b.status,a.irq_saved,b.irq_saved,a.host_depth,b.host_depth,a.dcache_id,b.dcache_id);
+    }
+    CHECK(!memcmp(&a,&b,sizeof a)); b.ls=bls;
+}
+static void reference_until(uint32_t end)
+{
+    unsigned steps=0;
+    do { CHECK(!spu_step(&a)); CHECK(++steps<512); } while(a.pc!=end);
+}
+static void pair(uint32_t entry,uint32_t end)
+{
+    int iret = entry==0x3FEC0 && end==0xAD0;
+    if (iret) { a.drain_ret_pc=a.srr0; end=a.srr0; }
+    a.pc=entry; clone();
+    spu_lifted_fn fn=spu_lifted_lookup(&b,entry); CHECK(fn!=NULL);
+    reference_until(end);
+    g_spu_trampoline_fn=NULL;
+    if (iret) spu_indirect_branch(&b); else fn(&b);
+    CHECK(g_spu_trampoline_fn==(iret?NULL:spu_indirect_branch)); g_spu_trampoline_fn=NULL;
+    equal();
+}
+int main(int argc,char**argv)
+{
+    _putenv_s("GT6_NATIVE_PDI_IRQ","1");
+    g_spu_ls_watch_n=g_spu_ls_probe=g_spu_smc_watch=0;
+    g_spu_ls_rdiag=g_spu_ls_wdiag=g_spu_wws_probe=0;
+    for(unsigned n=0;n<256;++n) {
+        init();
+        pair(n%3==0?0xA2C:n%3==1?0xA30:0xA34,0x3FEC0);
+        CHECK(!memcmp(als+0x3FEC0,spu_gt6_irq_save_code,sizeof spu_gt6_irq_save_code));
+        pair(0x3FEC0,0xA84);
+        pair(0xA84,0x2338);
+        /* Model an arbitrary handler result and its existing IRQ snapshot. */
+        for(unsigned r=0;r<128;++r) for(unsigned k=0;k<4;++k) a.gpr[r]._u32[k]=rnd();
+        a.irq_saved=1; a.irq_resume_pc=a.srr0;
+        for(unsigned r=0;r<128;++r) for(unsigned k=0;k<4;++k) a.irq_gpr[r]._u32[k]=rnd();
+        pair(0xA90,0x3FEC0);
+        CHECK(!memcmp(als+0x3FEC0,spu_gt6_irq_restore_code,sizeof spu_gt6_irq_restore_code));
+        a.gpr[79]=spu_link(0x2220); pair(0x3FEC0,0x2220);
+        a.gpr[79]=spu_link(0xAD0);
+        pair(0x3FEC0,0xAD0);
+        /* pair invoked the actual native restore -> full interpreter path,
+         * with return_pc == SRR0. Snapshot must be consumed before returning. */
+        CHECK(a.int_enable && !a.irq_saved);
+    }
+    init();
+    for(unsigned i=0;i<sizeof spu_gt6_irq_code;++i) {
+        als[0xA2C+i]^=1; CHECK(!spu_lifted_lookup(&a,0xA34)); als[0xA2C+i]^=1;
+    }
+    for(unsigned restore=0;restore<2;++restore) {
+        memcpy(als+0x3FEC0,restore?spu_gt6_irq_restore_code:spu_gt6_irq_save_code,320);
+        for(unsigned i=0;i<320;++i) {
+            als[0x3FEC0+i]^=1; CHECK(!spu_lifted_lookup(&a,0x3FEC0)); als[0x3FEC0+i]^=1;
+        }
+    }
+    a.int_enable=1; CHECK(!spu_lifted_lookup(&a,0xA34)); a.int_enable=0;
+    a.image_id=300; CHECK(!spu_lifted_lookup(&a,0xA34)); a.image_id=364260230;
+    CHECK(!spu_lifted_lookup(&a,0xA68)); CHECK(!spu_lifted_lookup(&a,0xAD0));
+    g_spu_ls_watch_n=1; CHECK(!spu_lifted_lookup(&a,0xA34)); g_spu_ls_watch_n=0;
+    g_spu_ls_probe=1; CHECK(!spu_lifted_lookup(&a,0xA34)); g_spu_ls_probe=0;
+    g_spu_smc_watch=1; CHECK(!spu_lifted_lookup(&a,0xA34)); g_spu_smc_watch=0;
+    if(argc==3) {
+        init(); FILE*f=fopen(argv[1],"rb"); CHECK(f); CHECK(fread(als,1,sizeof als,f)==sizeof als); fclose(f);
+        f=fopen(argv[2],"rb"); CHECK(f); uint8_t regs[2048]; CHECK(fread(regs,1,sizeof regs,f)==sizeof regs); fclose(f);
+        for(unsigned r=0;r<128;++r) for(unsigned k=0;k<4;++k) {
+            unsigned o=r*16+k*4; a.gpr[r]._u32[k]=(uint32_t)regs[o]<<24|(uint32_t)regs[o+1]<<16|(uint32_t)regs[o+2]<<8|regs[o+3];
+        }
+        a.pc=0xA68; reference_until(0x3FEC0);
+        pair(0x3FEC0,0xA84);
+        pair(0xA84,0x2338);
+        pair(0xA90,0x3FEC0);
+        pair(0x3FEC0,0xAD0);
+    }
+    printf("PASS %u checks: full LS/GPR/context, 256 IRQ cycles, live-code mutation, interrupt/image/diagnostic fallback, capture=%d\n",checks,argc==3);
+    return 0;
+}
diff --git a/runtime/spu/tests/test_spu_host_priority.c b/runtime/spu/tests/test_spu_host_priority.c
new file mode 100644
index 0000000..692107a
--- /dev/null
+++ b/runtime/spu/tests/test_spu_host_priority.c
@@ -0,0 +1,162 @@
+/* Windows-only disposable fixture. Executes the production create/priority/
+ * worker/join paths with an inert SPU body; no game, file, or audio device. */
+#ifdef SPU_PRIORITY_FRAGMENT
+/* The Windows fixture driver extracts these unmodified production regions. */
+#include "spu_host_priority_under_test.inc"
+#else
+#include "../../syscalls/lv2_register.c"
+#endif
+#include <assert.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+SPU_THREAD_LOCAL uint32_t g_spu_pch[8];
+SPU_THREAD_LOCAL unsigned g_spu_pch_n;
+int spu_lifted_trace_tid(uint32_t tid) { (void)tid; return 0; }
+uint64_t spu_lifted_trace_ms(void) { return 0; }
+int sys_event_queue_push_by_id(uint32_t q, uint64_t s, uint64_t a,
+                               uint64_t b, uint64_t c)
+{ (void)q; (void)s; (void)a; (void)b; (void)c; return 0; }
+
+static HANDLE body_entered, body_release;
+static volatile LONG observed_priority;
+static unsigned native_runs, fallback_runs;
+static spu_context saved_architecture;
+static void inert_body(void)
+{
+    observed_priority = GetThreadPriority(GetCurrentThread());
+    assert(SetEvent(body_entered));
+    assert(WaitForSingleObject(body_release, 2000) == WAIT_OBJECT_0);
+}
+void spu_lifted_thread_run(spu_context* ctx, spu_lifted_thread_result* out)
+{
+    assert(!memcmp(ctx, &saved_architecture, sizeof(*ctx)));
+    ++native_runs;
+    inert_body();
+    assert(!memcmp(ctx, &saved_architecture, sizeof(*ctx)));
+    *out = (spu_lifted_thread_result){ 7, 1, 9, 0 };
+}
+void spu_lifted_thread_run_stoppable(spu_context* ctx, spu_lifted_thread_result* out)
+{ spu_lifted_thread_run(ctx, out); }
+static int32_t fallback_body(uint32_t tid, uint32_t ea, uint32_t bytes, void* user)
+{
+    assert(tid != 0 && ea == 0x120 && bytes == 32 && user == &saved_architecture);
+    ++fallback_runs;
+    inert_body();
+    return 7;
+}
+static ppu_context context(void)
+{
+    ppu_context c; memset(&c, 0xA5, sizeof(c)); return c;
+}
+static void check_only_return_changed(const ppu_context* before, const ppu_context* after)
+{
+    ppu_context expected = *before;
+    expected.gpr[3] = after->gpr[3];
+    assert(!memcmp(&expected, after, sizeof(expected)));
+}
+static int64_t set_priority(spu_group_t* g, int32_t priority)
+{
+    ppu_context c = context(); c.gpr[3] = g->id; c.gpr[4] = (uint32_t)priority;
+    ppu_context before = c;
+    int64_t result = sys_spu_thread_group_set_priority_handler(&c);
+    check_only_return_changed(&before, &c);
+    assert(c.gpr[3] == (uint64_t)result);
+    return result;
+}
+static spu_group_t* make_group(int32_t priority, const char* policy)
+{
+    assert(!_putenv_s("PS3_SPU_HOST_PRIORITY", policy));
+    ppu_context c = context();
+    c.gpr[3] = 0x100; c.gpr[4] = 1; c.gpr[5] = (uint32_t)priority; c.gpr[6] = 0;
+    ppu_context before = c;
+    assert(sys_spu_thread_group_create_handler(&c) == 0);
+    check_only_return_changed(&before, &c);
+    spu_group_t* g = spu_find_group(vm_read_be32(0x100));
+    assert(g && g->priority == priority);
+    return g;
+}
+static spu_thread_t* make_thread(spu_group_t* g)
+{
+    spu_thread_t* t = spu_alloc_thread(); assert(t);
+    t->group_id = g->id;
+    g->thread_indices[0] = (uint32_t)(t - s_spu_threads);
+    t->finish_event = CreateEvent(NULL, TRUE, FALSE, NULL); assert(t->finish_event);
+    t->sctx = &saved_architecture;
+    t->fb_handler = fallback_body;
+    t->args_ea = 0x120; t->args_size = 32; t->fb_user = &saved_architecture;
+    return t;
+}
+static void start(spu_group_t* g, spu_thread_t* t, int fallback)
+{
+    ResetEvent(body_entered); ResetEvent(body_release); ResetEvent(t->finish_event);
+    t->running = 1; t->exit_status = 0;
+    g->state = SPU_GROUP_STATE_RUNNING;
+    assert(spu_create_group_host_thread(t, fallback ? spu_fallback_thread_proc : spu_exec_thread_proc));
+    assert(WaitForSingleObject(body_entered, 2000) == WAIT_OBJECT_0);
+    assert(observed_priority == spu_host_priority_level(g->priority, g->host_priority_policy));
+    assert(GetThreadPriority(t->host_thread) == observed_priority);
+}
+static void finish(spu_group_t* g, spu_thread_t* t)
+{
+    assert(SetEvent(body_release));
+    ppu_context c = context(); c.gpr[3] = g->id; c.gpr[4] = 0x110; c.gpr[5] = 0x114;
+    ppu_context before = c;
+    assert(sys_spu_thread_group_join_handler(&c) == 0);
+    check_only_return_changed(&before, &c);
+    assert(!t->host_thread && !t->running && t->exit_status == 7);
+    assert(g->state == SPU_GROUP_STATE_STOPPED);
+    assert(!memcmp(t->sctx, &saved_architecture, sizeof(saved_architecture)));
+}
+static DWORD WINAPI priority_writer(void* arg)
+{
+    spu_group_t* g = arg;
+    for (int i=0; i<1000; ++i) assert(set_priority(g, i & 1 ? 16 : 128) == 0);
+    return 0;
+}
+int main(void)
+{
+    assert(!_putenv_s("GT6_AUDIO_PERSISTENT_WORKER", ""));
+    vm_base = calloc(1, 4096); assert(vm_base); ppu_vm_size = 4096;
+    memset(&saved_architecture, 0x6D, sizeof(saved_architecture));
+    body_entered = CreateEvent(NULL, TRUE, FALSE, NULL);
+    body_release = CreateEvent(NULL, TRUE, FALSE, NULL);
+    assert(body_entered && body_release);
+    for (int p=-1; p<=256; ++p) {
+        assert(spu_host_priority_level(p, 1) == (p == 16 ? THREAD_PRIORITY_ABOVE_NORMAL : THREAD_PRIORITY_NORMAL));
+        assert(spu_host_priority_level(p, 0) == THREAD_PRIORITY_NORMAL);
+    }
+    spu_group_t* audio = make_group(16, ""); spu_thread_t* a = make_thread(audio);
+    spu_group_t* graphics = make_group(128, "1"); spu_thread_t* p = make_thread(graphics);
+    spu_group_t* disabled = make_group(16, "0"); spu_thread_t* d = make_thread(disabled);
+    start(graphics, p, 0); finish(graphics, p);
+    start(disabled, d, 0); finish(disabled, d);
+    assert(set_priority(audio, 15) == (int64_t)(int32_t)CELL_EINVAL && audio->priority == 16);
+    assert(set_priority(audio, 256) == (int64_t)(int32_t)CELL_EINVAL && audio->priority == 16);
+    ppu_context c = context(); c.gpr[3] = audio->id; c.gpr[4] = 0x180;
+    ppu_context before = c;
+    assert(sys_spu_thread_group_get_priority_handler(&c) == 0);
+    check_only_return_changed(&before, &c);
+    assert(vm_read_be32(0x180) == 16 && vm_base[0x180] == 0 && vm_base[0x183] == 16);
+    c.gpr[3] = audio->id; c.gpr[4] = 0;
+    assert(sys_spu_thread_group_get_priority_handler(&c) == (int64_t)(int32_t)CELL_EFAULT);
+    c.gpr[3] = 0xFFFFFFFFu; c.gpr[4] = 16;
+    assert(sys_spu_thread_group_set_priority_handler(&c) == (int64_t)(int32_t)CELL_ESRCH);
+    c.gpr[3] = 0xFFFFFFFFu; c.gpr[4] = 0x180;
+    assert(sys_spu_thread_group_get_priority_handler(&c) == (int64_t)(int32_t)CELL_ESRCH);
+    for (int i=0; i<12; ++i) {
+        assert(set_priority(audio, 16) == 0);
+        start(audio, a, i & 1);
+        assert(set_priority(audio, 128) == 0 && GetThreadPriority(a->host_thread) == THREAD_PRIORITY_NORMAL);
+        assert(set_priority(audio, 16) == 0 && GetThreadPriority(a->host_thread) == THREAD_PRIORITY_ABOVE_NORMAL);
+        HANDLE writer = CreateThread(NULL, 0, priority_writer, audio, 0, NULL); assert(writer);
+        finish(audio, a);                 /* Setter races real join/handle close. */
+        assert(WaitForSingleObject(writer, 2000) == WAIT_OBJECT_0); CloseHandle(writer);
+        assert(audio->priority == 16);    /* Last stopped update survives restart. */
+    }
+    assert(native_runs == 8 && fallback_runs == 6);
+    CloseHandle(a->finish_event); CloseHandle(p->finish_event); CloseHandle(d->finish_event);
+    CloseHandle(body_entered); CloseHandle(body_release); free(vm_base);
+    puts("PASS: exact priority mapping; default/rollback/PDI; real native/fallback entry; live updates; 12 restarts; concurrent set/join; guest state unchanged");
+    return 0;
+}
diff --git a/runtime/spu/tests/test_spu_persistent_worker.c b/runtime/spu/tests/test_spu_persistent_worker.c
new file mode 100644
index 0000000..6133748
--- /dev/null
+++ b/runtime/spu/tests/test_spu_persistent_worker.c
@@ -0,0 +1,262 @@
+/* Disposable Windows fixture: production LV2 handlers + actual SPU runner,
+ * dispatcher, TLS, channel/MFC and coherency code. No game or host audio.
+ * The extraction manifest records three harness interposition boundaries. */
+#include "spu_worker_under_test.inc"
+#include "spu_helpers.h"
+#include "spu_overlay_residency.h"
+#include <assert.h>
+#include <intrin.h>
+
+uint8_t* vm_base;
+uint32_t ppu_vm_size = 0x40000;
+static HANDLE entered, release_body, setup_entered, release_setup, proc_returned, release_proc;
+static volatile LONG pause_body, pause_setup, pause_return, cancel_body;
+static volatile LONG creates, fail_creates, runs, returned, setup_calls;
+static volatile DWORD body_tid;
+static unsigned before_mxcsr, after_mxcsr;
+static unsigned short before_x87, after_x87;
+static spu_context reference, observed;
+static spu_thread_t* active_thread;
+static int exit_mode;
+extern void spu_begin_image(int);
+extern void spu_register_function(uint32_t, void (*)(spu_context*));
+extern void spu_halt(spu_context*);
+extern uint32_t spu_rchcnt(spu_context*, uint32_t);
+extern void spu_wrch(spu_context*, uint32_t, u128);
+extern int g_spu_float_rz;
+
+static HANDLE WINAPI fixture_CreateThread(LPSECURITY_ATTRIBUTES a,SIZE_T n,
+    LPTHREAD_START_ROUTINE fn,LPVOID arg,DWORD flags,LPDWORD id)
+{
+    InterlockedIncrement(&creates);
+    if (InterlockedCompareExchange(&fail_creates,0,0) > 0) {
+        InterlockedDecrement(&fail_creates); SetLastError(ERROR_NOT_ENOUGH_MEMORY); return NULL;
+    }
+    return CreateThread(a,n,fn,arg,flags,id);
+}
+static void fixture_setup(spu_context* c,const spu_lifted_thread_desc* d)
+{
+    spu_lifted_thread_setup(c,d);
+    InterlockedIncrement(&setup_calls);
+    if (pause_setup) {
+        assert(SetEvent(setup_entered));
+        assert(WaitForSingleObject(release_setup,3000)==WAIT_OBJECT_0);
+    }
+}
+static void fixture_stoppable(spu_context* c,spu_lifted_thread_result* r)
+{
+    before_mxcsr = _mm_getcsr(); __asm__ volatile("fnstcw %0" : "=m"(before_x87));
+    spu_lifted_thread_run_stoppable(c,r);
+    after_mxcsr = _mm_getcsr(); __asm__ volatile("fnstcw %0" : "=m"(after_x87));
+    assert(before_mxcsr==after_mxcsr && before_x87==after_x87);
+    assert(!r->faulted && !c->coh_listed && !g_spu_trampoline_fn);
+    InterlockedIncrement(&returned);
+    if (pause_return) {
+        assert(SetEvent(proc_returned));
+        assert(WaitForSingleObject(release_proc,3000)==WAIT_OBJECT_0);
+    }
+}
+static void guest_body(spu_context* c)
+{
+    assert(!c->host_depth && !c->drain_ret_pc && !c->irq_frame && !c->irq_saved);
+    assert(c->gpr[3]._u32[0]==0x12345678 && c->gpr[3]._u32[1]==0x87654321);
+    assert(c->gpr[3]._u32[2]==0 && c->gpr[127]._u32[0]==0);
+    assert(c->ls[0x1000]==0x51 && c->ls[0x101F]==0x70);
+    assert(c->ls[0x1100]==0xA6 && c->ls[0x33000]==0);
+    assert(c->image_id==test_image_id);
+    body_tid=GetCurrentThreadId(); InterlockedIncrement(&runs);
+    assert(SetEvent(entered));
+    if (pause_body) assert(WaitForSingleObject(release_body,3000)==WAIT_OBJECT_0);
+    if (cancel_body) {
+        while (!c->stop_request) Sleep(0);
+        (void)spu_rchcnt(c,3); /* Actual channel boundary honors external stop. */
+        abort();
+    }
+    /* Claim the actual per-context MFC engine; release must retire a TLS hit. */
+    spu_wrch(c,16,spu_splat_u32(0x1200));
+    for (unsigned r=0;r<128;++r)
+        for (unsigned lane=0;lane<4;++lane) c->gpr[r]._u32[lane]=0x82400000u+r*17u+lane;
+    for (unsigned i=0;i<SPU_LS_SIZE;++i) c->ls[i]^=(uint8_t)(i*31u+7u);
+    c->gpr[10]=spu_fa(spu_splat_u32(0x3F800000),spu_splat_u32(0x3F000000));
+    c->ch_out_mbox.value=exit_mode==1 ? (uint32_t)-7 : 91;
+    c->ch_out_mbox.count=1; c->stop_code=exit_mode==1 ? 0x102 : 0x101;
+    c->status=SPU_STATUS_STOPPED_BY_STOP;
+    spu_halt(c);
+}
+static ppu_context call_context(uint32_t id)
+{ ppu_context c;memset(&c,0,sizeof c);c.gpr[3]=id;return c; }
+static void normalize(spu_context* c)
+{
+    /* Host pointers/unique dispatch-lifetime token and recreated guest IDs differ.
+     * Every other byte, including all GPR/LS/channels/control state, is compared. */
+    assert(c->spu_id==active_thread->tid && c->spu_group_id==active_thread->group_id);
+    c->ls=NULL; c->dcache_id=0;c->spu_id=0;c->spu_group_id=0;
+}
+static void reset_events(void)
+{
+    ResetEvent(entered);ResetEvent(release_body);ResetEvent(setup_entered);
+    ResetEvent(release_setup);ResetEvent(proc_returned);ResetEvent(release_proc);
+    pause_body=pause_setup=pause_return=cancel_body=0;
+}
+static spu_group_t* make_group(void)
+{
+    memcpy(vm_base+0x200,"CellSpursKernelGroup",20);
+    vm_write_be32(0x180,20);vm_write_be32(0x184,0x200);vm_write_be32(0x188,0);
+    ppu_context c=call_context(0x100);c.gpr[4]=1;c.gpr[5]=16;c.gpr[6]=0x180;
+    assert(!sys_spu_thread_group_create_handler(&c));
+    spu_group_t* g=spu_find_group(vm_read_be32(0x100));assert(g);
+    spu_thread_t* t=spu_alloc_thread();assert(t);
+    t->group_id=g->id;t->entry_point=0x848;t->img_ea=0x300;
+    t->args[0]=0x1234567887654321ull;t->args[1]=12;t->args[2]=13;t->args[3]=14;
+    g->thread_indices[0]=(uint32_t)(t-s_spu_threads);active_thread=t;
+    vm_write_be32(0x308,0x400);vm_write_be32(0x30C,2);
+    vm_write_be32(0x400,1);vm_write_be32(0x404,0x1000);vm_write_be32(0x408,32);vm_write_be32(0x410,0x600);
+    vm_write_be32(0x418,2);vm_write_be32(0x41C,0x1100);vm_write_be32(0x420,32);vm_write_be32(0x428,0xA6);
+    for(unsigned i=0;i<32;++i)vm_base[0x600+i]=(uint8_t)(0x51+i);
+    return g;
+}
+static int64_t start(spu_group_t* g)
+{ ppu_context c=call_context(g->id);return sys_spu_thread_group_start_handler(&c); }
+static void join(spu_group_t* g)
+{
+    ppu_context c=call_context(g->id);c.gpr[4]=0x120;c.gpr[5]=0x124;
+    assert(!sys_spu_thread_group_join_handler(&c));
+    assert(!active_thread->running && g->state==SPU_GROUP_STATE_STOPPED);
+}
+static void destroy(spu_group_t* g)
+{
+    ppu_context c=call_context(g->id);assert(!sys_spu_thread_group_destroy_handler(&c));
+    assert(!g->in_use && !active_thread->in_use && !active_thread->sctx && !active_thread->reuse_worker);
+    /* Legacy finish-event lifetime is outside this change; fixture owns cleanup. */
+    if(active_thread->finish_event){CloseHandle(active_thread->finish_event);active_thread->finish_event=NULL;}
+}
+static DWORD WINAPI async_start(void* g){assert(!start(g));return 0;}
+static DWORD WINAPI async_join(void* g){join(g);return 0;}
+static DWORD WINAPI async_destroy(void* g){destroy(g);return 0;}
+static DWORD WINAPI async_terminate(void* arg)
+{
+    spu_group_t* g=arg;ppu_context c=call_context(g->id);c.gpr[4]=(uint32_t)-33;
+    assert(!sys_spu_thread_group_terminate_handler(&c));return 0;
+}
+static void done(HANDLE thread)
+{assert(WaitForSingleObject(thread,3000)==WAIT_OBJECT_0);CloseHandle(thread);}
+static void blocked(HANDLE thread)
+{assert(WaitForSingleObject(thread,20)==WAIT_TIMEOUT);}
+static void one_run(spu_group_t* g,int persistent)
+{
+    reset_events();assert(!start(g));join(g);
+    assert((active_thread->reuse_worker!=NULL)==persistent);
+    assert((active_thread->host_thread!=NULL)==persistent);
+    assert(g->cause==(exit_mode==1?SPU_GROUP_CAUSE_ALL_THREADS_EXIT:SPU_GROUP_CAUSE_GROUP_EXIT));
+    assert(g->exit_status==(exit_mode==1?-7:91));
+    observed=*active_thread->sctx;normalize(&observed);
+}
+int main(void)
+{
+    vm_base=calloc(1,ppu_vm_size);assert(vm_base);
+    entered=CreateEvent(NULL,TRUE,FALSE,NULL);release_body=CreateEvent(NULL,TRUE,FALSE,NULL);
+    setup_entered=CreateEvent(NULL,TRUE,FALSE,NULL);release_setup=CreateEvent(NULL,TRUE,FALSE,NULL);
+    proc_returned=CreateEvent(NULL,TRUE,FALSE,NULL);release_proc=CreateEvent(NULL,TRUE,FALSE,NULL);
+    assert(entered&&release_body&&setup_entered&&release_setup&&proc_returned&&release_proc);
+    spu_begin_image(274060898);spu_register_function(0x848,guest_body);
+    spu_begin_image(7);spu_register_function(0x848,guest_body);spu_begin_image(0);
+    assert(!_putenv_s("GT6_AUDIO_PERSISTENT_WORKER",""));
+    spu_group_t* g=make_group();one_run(g,0);reference=observed;
+    assert(!_putenv_s("GT6_AUDIO_PERSISTENT_WORKER","1"));
+    LONG before=creates;
+    DWORD host=0;
+    for(int i=0;i<32;++i){one_run(g,1);assert(!memcmp(&reference,&observed,sizeof reference));
+        if(!i)host=body_tid;else assert(host==body_tid);}
+    assert(creates==before+1 && active_thread->reuse_worker->requested==32 && returned==32);
+    /* Reused TLS follows a port's run-boundary RZ mode switch, not the first run. */
+    for(int mode=0;mode<2;++mode){g_spu_float_rz=mode;one_run(g,1);
+        assert(!memcmp(&reference,&observed,sizeof reference));}
+    puts("PASS: 32 generations, one host, full normalized context/LS/GPR and FP-control equivalence");
+    /* Old finish/running flags cannot authorize next generation or join. */
+    reset_events();pause_return=1;assert(!start(g));
+    assert(WaitForSingleObject(proc_returned,3000)==WAIT_OBJECT_0);
+    SetEvent(active_thread->finish_event);active_thread->running=0;
+    LONG setups=setup_calls;assert(start(g)==(int64_t)(int32_t)CELL_ESTAT && setup_calls==setups);
+    HANDLE j=CreateThread(NULL,0,async_join,g,0,NULL);blocked(j);
+    assert(active_thread->reuse_worker->completed+1==active_thread->reuse_worker->requested);
+    SetEvent(release_proc);done(j);pause_return=0;
+    puts("PASS: stale event/running=0 cannot bypass actual procedure-return ACK");
+    /* First-start setup is protected before the worker pointer is published. */
+    destroy(g);g=make_group();reset_events();pause_setup=1;pause_body=1;
+    HANDLE s=CreateThread(NULL,0,async_start,g,0,NULL);
+    assert(WaitForSingleObject(setup_entered,3000)==WAIT_OBJECT_0);
+    j=CreateThread(NULL,0,async_join,g,0,NULL);blocked(j);SetEvent(release_setup);done(s);
+    assert(WaitForSingleObject(entered,3000)==WAIT_OBJECT_0);blocked(j);SetEvent(release_body);done(j);
+    puts("PASS: first setup/publication versus early join is ordered");
+    reset_events();pause_body=1;cancel_body=1;pause_return=1;assert(!start(g));
