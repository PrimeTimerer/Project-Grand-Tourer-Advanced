+static char* rsx_fp_scalarize_temporaries(const char* source, size_t length,
+                                         rsx_fp_scalar_result* result)
+{
+    static const char decl48[] = "float4 r[48]; float4 h[48];";
+    static const char decl64[] = "float4 r[64]; float4 h[64];";
+    static const char loop48[] = "[unroll] for (int _i = 0; _i < 48; _i++) { r[_i] = (float4)0; h[_i] = (float4)0; }";
+    static const char loop64[] = "[unroll] for (int _i = 0; _i < 64; _i++) { r[_i] = (float4)0; h[_i] = (float4)0; }";
+    static const char main_float[] = "float4 main(PSInput input) : SV_TARGET {";
+    static const char main_mrt[] = "PSOutput main(PSInput input) {";
+    if (result) memset(result, 0, sizeof(*result));
+    if (!source || !length || length > 256u * 1024u || source[length] || memchr(source, 0, length)) return NULL;
+    const char* d48 = strstr(source, decl48), *d64 = strstr(source, decl64);
+    if ((!d48 && !d64) || (d48 && d64)) return NULL;
+    const char* decl = d48 ? d48 : d64;
+    const char* declaration = d48 ? decl48 : decl64;
+    const char* initialization = d48 ? loop48 : loop64;
+    const unsigned declared = d48 ? 48u : 64u;
+    const char* loop = strstr(source, initialization);
+    if (!loop || strstr(decl + 1, declaration) || strstr(loop + 1, initialization)) return NULL;
+    const char* m0 = strstr(source, main_float), *m1 = strstr(source, main_mrt);
+    if ((!m0 && !m1) || (m0 && m1)) return NULL;
+    const char* main_start = m0 ? m0 : m1;
+    const char* main_signature = m0 ? main_float : main_mrt;
+    if (strstr(main_start + 1, main_signature)) return NULL;
+    const char* main_open = main_start + strlen(main_signature) - 1u;
+    const size_t decl_length = strlen(declaration), loop_length = strlen(initialization);
+    const char* q = main_open + 1;
+    while (rsx_fp_scalar_space((unsigned char)*q)) ++q;
+    if (q != decl) return NULL;
+    q = decl + decl_length;
+    while (rsx_fp_scalar_space((unsigned char)*q)) ++q;
+    if (q != loop) return NULL;
+    /* A reserved generated name, token pasting, or escaped preprocessing line
+     * could hide an alias from the lexer. Keep the original path in each case. */
+    if (strstr(source, "_rsx_fp_") || strstr(source, "##") || strstr(source, "\\\n") || strstr(source, "\\\r")) return NULL;
+
+    const size_t decl_at = (size_t)(decl - source), loop_at = (size_t)(loop - source);
+    const size_t body_at = loop_at + loop_length, main_at = (size_t)(main_open - source);
+    uint64_t used[2] = { 0, 0 };
+    unsigned references = 0, locals = 0;
+    size_t output_length = length - decl_length - loop_length;
+    char* output = NULL;
+    /* Validate the whole immutable input before allocating or emitting. The
+     * second pass only substitutes the already validated token spans. */
+    for (unsigned pass = 0; pass < 2; ++pass) {
+        size_t cursor = 0, copied = 0, offset = 0;
+        int depth = 0, entered = 0, closed = 0, saw_decl = 0, saw_loop = 0;
+        rsx_fp_scalar_token token = { 0, 0, 0 }, previous = { 0, 0, 0 };
+        int found;
+        while ((found = rsx_fp_scalar_next(source, length, &cursor, &token)) > 0) {
+            if (token.begin == decl_at || token.begin == loop_at) {
+                const int is_decl = token.begin == decl_at;
