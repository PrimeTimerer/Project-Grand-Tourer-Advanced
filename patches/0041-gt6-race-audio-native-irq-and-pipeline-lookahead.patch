+static void rsx_fp_scalar_append(char* output, size_t* offset,
+                                  const char* text, size_t length)
+{ if (output) memcpy(output + *offset, text, length); *offset += length; }
+
+static void rsx_fp_scalar_emit_declarations(char* output, size_t* offset,
+                                            const uint64_t used[2], unsigned count)
+{
+    for (unsigned file = 0; file < 2; ++file) {
+        for (unsigned index = 0; index < count; ++index) if (used[file] & (UINT64_C(1) << index)) {
+            char name[16]; const size_t n = rsx_fp_scalar_name(name, file, index);
+            rsx_fp_scalar_append(output, offset, "float4 ", 7);
+            rsx_fp_scalar_append(output, offset, name, n);
+            rsx_fp_scalar_append(output, offset, "; ", 2);
+        }
+    }
+}
+
+static void rsx_fp_scalar_emit_initializers(char* output, size_t* offset,
+                                           const uint64_t used[2], unsigned count)
+{
+    /* Preserve the original loop's r0, h0, r1, h1... initialization order. */
+    for (unsigned index = 0; index < count; ++index) {
+        for (unsigned file = 0; file < 2; ++file) if (used[file] & (UINT64_C(1) << index)) {
+            char name[16]; const size_t n = rsx_fp_scalar_name(name, file, index);
+            rsx_fp_scalar_append(output, offset, name, n);
+            rsx_fp_scalar_append(output, offset, " = (float4)0; ", 14);
+        }
+    }
+}
