+/* Standalone Windows fixture. Includes the actual syscall implementation;
+ * only unrelated runtime services and selected Win32 failure paths are stubbed.
+ * Files and timers belong to this fixture, never a game process or user HDD. */
+#define WIN32_LEAN_AND_MEAN
+#ifndef _CRT_SECURE_NO_WARNINGS
+#define _CRT_SECURE_NO_WARNINGS
+#endif
+#include <windows.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int fail_thread, fail_highres_create, fail_timer_create, fail_highres_set;
+static HANDLE WINAPI test_create_thread(LPSECURITY_ATTRIBUTES a, SIZE_T b,
+    LPTHREAD_START_ROUTINE c, LPVOID d, DWORD e, LPDWORD f)
+{
+    return fail_thread ? NULL : CreateThread(a, b, c, d, e, f);
+}
+static HANDLE WINAPI test_create_highres(LPSECURITY_ATTRIBUTES a, LPCWSTR b, DWORD c, DWORD d)
+{
+    return fail_highres_create ? NULL : CreateWaitableTimerExW(a, b, c, d);
+}
+static HANDLE WINAPI test_create_timer(LPSECURITY_ATTRIBUTES a, BOOL b, LPCWSTR c)
+{
+    return fail_timer_create ? NULL : CreateWaitableTimerW(a, b, c);
+}
+static BOOL WINAPI test_set_highres(HANDLE a, const LARGE_INTEGER* b, LONG c,
+    PTIMERAPCROUTINE d, LPVOID e, PREASON_CONTEXT f, ULONG g)
+{
+    return fail_highres_set ? FALSE : SetWaitableTimerEx(a, b, c, d, e, f, g);
+}
+#define CreateThread test_create_thread
+#define CreateWaitableTimerExW test_create_highres
+#define CreateWaitableTimerW test_create_timer
+#define SetWaitableTimerEx test_set_highres
+#include "../sys_timer.c"
+#undef CreateThread
+#undef CreateWaitableTimerExW
+#undef CreateWaitableTimerW
+#undef SetWaitableTimerEx
+
+uint8_t* vm_base;
+sys_event_queue_info g_sys_event_queues[SYS_EVENT_QUEUE_MAX];
+static uint64_t block_tid, block_count;
+void ppu_thread_note_block(uint64_t tid) { block_tid = tid; ++block_count; }
+void ppu_log_host_chain(const char* reason) { (void)reason; }
+unsigned long long ps3_qpc_us(void)
+{
+    LARGE_INTEGER q, f;
+    QueryPerformanceCounter(&q); QueryPerformanceFrequency(&f);
+    return (unsigned long long)(q.QuadPart / (f.QuadPart / 1000000));
+}
+
+static int checks, failures;
+#define CHECK(x) do { ++checks; if (!(x)) { ++failures; fprintf(stderr, "FAIL %d: %s\n", __LINE__, #x); } } while (0)
+
+static int wait_finished(sys_ust_state* s)
+{
+    ULONGLONG deadline = GetTickCount64() + 5000;
+    while (!InterlockedCompareExchange(&s->finished, 0, 0) && GetTickCount64() < deadline) Sleep(1);
+    return s->finished != 0;
+}
+
+static void path_join(char* out, size_t size, const char* folder, const char* name)
+{
+    snprintf(out, size, "%s/%s", folder, name);
+}
+
+static unsigned csv_rows(const char* path, const char* needle, int* footer)
+{
+    char line[1024]; unsigned count = 0;
+    FILE* f = fopen(path, "rb");
+    if (!f) return UINT32_MAX;
+    *footer = 0;
+    while (fgets(line, sizeof(line), f)) {
+        if (!strncmp(line, "# end ", 6)) *footer = 1;
+        if (line[0] >= '0' && line[0] <= '9' && (!needle || strstr(line, needle))) ++count;
+    }
+    fclose(f);
+    return count;
+}
+
+static void syscall_unchanged(ppu_context* ctx, uint64_t usec)
+{
+    ppu_context before;
+    ctx->gpr[3] = usec;
+    before = *ctx;
+    CHECK(sys_timer_usleep(ctx) == CELL_OK);
+    CHECK(memcmp(&before, ctx, sizeof(before)) == 0);
+    CHECK(block_tid == ctx->thread_id);
+}
+
+static DWORD WINAPI highres_creation_failure(void* arg)
+{
+    ppu_context ctx = *(ppu_context*)arg;
+    syscall_unchanged(&ctx, 1000);
+    return 0;
+}
+
+typedef struct concurrent_arg {
+    sys_ust_state* state;
+    uint64_t tid;
+    HANDLE gate;
+    volatile LONG* ready;
+} concurrent_arg;
+static DWORD WINAPI concurrent_records(void* arg)
+{
+    concurrent_arg* a = (concurrent_arg*)arg;
+    ppu_context ctx = {0};
+    ctx.thread_id = a->tid;
+    ctx.lr = 0xAF1CECu;
+    InterlockedIncrement(a->ready);
+    WaitForSingleObject(a->gate, INFINITE);
+    for (unsigned i = 0; i < 5000; ++i) {
+        sys_ust_record token;
+        if (a->state->enabled && sys_ust_begin(a->state, &ctx, i, &token))
+            sys_ust_end(a->state, &token, SYS_UST_ZERO);
+    }
+    return 0;
+}
+
