+            while (rsx_fp_scalar_space((unsigned char)*q)) ++q;
+            if (*q++ != '[') goto reject;
+            while (rsx_fp_scalar_space((unsigned char)*q)) ++q;
+            if (!rsx_fp_scalar_digit((unsigned char)*q)) goto reject;
+            if (*q == '0' && rsx_fp_scalar_digit((unsigned char)q[1])) goto reject;
+            unsigned index = 0;
+            do {
+                index = index * 10u + (unsigned)(*q++ - '0');
+                if (index >= declared) goto reject;
+            } while (rsx_fp_scalar_digit((unsigned char)*q));
+            while (rsx_fp_scalar_space((unsigned char)*q)) ++q;
+            if (*q++ != ']') goto reject;
+            const unsigned file = source[token.begin] == 'h';
+            char name[16]; const size_t name_length = rsx_fp_scalar_name(name, file, index);
+            if (!pass) {
+                if (!(used[file] & (UINT64_C(1) << index))) ++locals;
+                used[file] |= UINT64_C(1) << index; ++references;
+                output_length += name_length;
+                output_length -= (size_t)(q - source) - token.begin;
+            } else {
+                rsx_fp_scalar_append(output, &offset, source + copied, token.begin - copied);
+                rsx_fp_scalar_append(output, &offset, name, name_length);
+            }
+            cursor = (size_t)(q - source); copied = cursor;
+            previous.kind = ']'; previous.begin = previous.end = cursor;
+        }
+        if (found < 0 || !entered || !closed || depth || !saw_decl || !saw_loop || !references) goto reject;
+        if (!pass) {
+            rsx_fp_scalar_emit_declarations(NULL, &output_length, used, declared);
+            rsx_fp_scalar_emit_initializers(NULL, &output_length, used, declared);
+            if (output_length > 1024u * 1024u) goto reject;
+            output = (char*)malloc(output_length + 1u);
+            if (!output) return NULL;
+        } else {
+            rsx_fp_scalar_append(output, &offset, source + copied, length - copied);
+            if (offset != output_length) goto reject;
+            output[offset] = 0;
+        }
+    }
+    if (result) {
+        result->source_length = output_length; result->declared_registers = declared;
+        result->scalar_registers = locals; result->register_references = references;
+    }
+    return output;
+reject:
+    free(output); return NULL;
+}
