+/* The same two for the compile workers [GT6 0050] (g_ld_scj_load / g_ld_scj_store, set when the asynchronous
+ * pipeline path is on): file work only, nothing of the renderer's. In the first frame of a race the renderer read
+ * the cached blobs of about five hundred pipelines itself, one file after the other - 0.72 s of a 1.31 s frame
+ * (b11_guard1, a track visited before). A file that does not check out is left for the renderer to judge; a
+ * compiled blob goes to the name the renderer would give it, through a temporary of the thread's own.
+ * LD_ASYNC_PSO_DISK=0 = the renderer reads and writes them, as before. */
+static u32 g_ld_scj_vs_cache_flags;      /* ld_sp_cache_flags(ld_vs_compile_flags()), taken on the renderer owner */
+static volatile LONG g_ld_scj_stored;
+static int ld_ap_disk_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_ASYNC_PSO_DISK"); on = !(e && *e == '0'); }
+    return on && g_ld_scj_load != NULL;
+}
+static ID3DBlob* ld_scj_disk_load(unsigned stage, const char* source, uint32_t length, uint64_t hash)
+{
+    char path[MAX_PATH];
+    if (g_ld_shader_disk_ready <= 0 || length > 256u * 1024u) return NULL;
+    const int n = snprintf(path, MAX_PATH, "%s\\%c_%016llX_%08X.bin", g_ld_shader_disk_dir, (char)stage,
+                           (unsigned long long)hash, length);
+    if (n <= 0 || n >= MAX_PATH) return NULL;
+    FILE* file = fopen(path, "rb");
+    if (!file) return NULL;
+    shader_disk_cache_header header;
+    memset(&header, 0, sizeof(header));
+    int valid = fread(&header, sizeof(header), 1, file) == 1 &&
+        header.magic == SHADER_DISK_CACHE_MAGIC && header.version == SHADER_DISK_CACHE_VERSION &&
+        header.stage == stage && header.source_hash == hash &&
+        (stage != 'V' || !header.reserved || header.reserved == g_ld_scj_vs_cache_flags) &&
+        header.source_length == length && header.blob_length > 0 && header.blob_length <= SHADER_DISK_CACHE_MAX_BLOB;
+    char* stored = NULL;
+    ID3DBlob* blob = NULL;
+    if (valid) {
+        stored = (char*)malloc(length ? length : 1u);
+        valid = stored != NULL && fread(stored, 1, length, file) == length && memcmp(stored, source, length) == 0;
+    }
+    if (valid)
+        valid = SUCCEEDED(D3DCreateBlob(header.blob_length, &blob)) && blob &&
+            fread(blob->lpVtbl->GetBufferPointer(blob), 1, header.blob_length, file) == header.blob_length;
+    free(stored);
+    fclose(file);
+    if (!valid && blob) { blob->lpVtbl->Release(blob); blob = NULL; }
+    return blob;
+}
+static void ld_scj_disk_store(unsigned stage, const char* source, uint32_t length, uint64_t hash, ID3DBlob* blob)
+{
+    if (g_ld_shader_disk_ready <= 0 || !blob || length > 256u * 1024u) return;
+    const size_t blob_length = blob->lpVtbl->GetBufferSize(blob);
+    if (!blob_length || blob_length > SHADER_DISK_CACHE_MAX_BLOB) return;
+    char path[MAX_PATH], temporary[MAX_PATH];
+    int n = snprintf(path, MAX_PATH, "%s\\%c_%016llX_%08X.bin", g_ld_shader_disk_dir, (char)stage,
+                     (unsigned long long)hash, length);
+    if (n <= 0 || n >= MAX_PATH) return;
+    n = snprintf(temporary, sizeof(temporary), "%s.tmp.%lu.%lu", path, (unsigned long)GetCurrentProcessId(),
+                 (unsigned long)GetCurrentThreadId());
+    if (n <= 0 || n >= (int)sizeof(temporary)) return;
+    shader_disk_cache_header header;
+    memset(&header, 0, sizeof(header));
+    header.magic = SHADER_DISK_CACHE_MAGIC;
+    header.version = SHADER_DISK_CACHE_VERSION;
+    header.stage = stage;
+    header.source_length = length;
+    header.blob_length = (u32)blob_length;
+    if (stage == 'V') header.reserved = g_ld_scj_vs_cache_flags;
+    header.source_hash = hash;
+    FILE* file = fopen(temporary, "wb");
+    if (!file) return;
+    const int wrote = fwrite(&header, sizeof(header), 1, file) == 1 &&
+        fwrite(source, 1, length, file) == length &&
+        fwrite(blob->lpVtbl->GetBufferPointer(blob), 1, blob_length, file) == blob_length &&
+        fflush(file) == 0;
+    fclose(file);
+    if (!wrote || !MoveFileExA(temporary, path, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) {
+        DeleteFileA(temporary);
+        return;
+    }
+    InterlockedIncrement(&g_ld_scj_stored);
+}
